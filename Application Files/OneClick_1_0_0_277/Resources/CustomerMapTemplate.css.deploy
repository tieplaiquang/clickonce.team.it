
html, body, #map {
    height: 100%;
    margin: 0
}

.marker-cluster-small {
    background: rgba(238,127,162,.6);
}

    .marker-cluster-small div {
        background: #EE7FA2;
    }

.marker-cluster-medium {
    background: rgba(126,87,194,.6);
}

    .marker-cluster-medium div {
        background: #7E57C2;
    }

.marker-cluster-large {
    background: rgba(192,202,51,.6);
}

    .marker-cluster-large div {
        background: #C0CA33;
    }

.marker-cluster:not(.oc-pie-mode) div {
    border-radius: 14px;
    box-shadow: 0 4px 10px rgba(0,0,0,.25);
    color: #fff;
    font-weight: 700;
}

.leaflet-marker-icon, .marker-cluster {
    cursor: pointer;
}

.leaflet-popup-content {
    margin: 10px 14px;
}

.popup-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.25;
    min-width: 0;
}

    .popup-title > .oc-pill:first-of-type {
        margin-left: auto;
    }

.oc-title-name {
    min-width: 0;
    flex: 1 1 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.25;
}

.oc-pill {
    margin-left: 0;
    flex: 0 0 auto;
    font-size: 11px;
    line-height: 1.1;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9999px;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: relative;
    top: -1px;
    user-select: none;
}

    .oc-pill::before {
        content: none;
    }

.oc-pill-ver {
    background: rgba(192,202,51,.12);
    color: #5D6A00;
    border-color: rgba(175,180,43,.45);
}

.oc-pill-seg {
    border-color: transparent;
}

    .oc-pill-seg::before {
        content: '';
        font-weight: 900;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        display: inline-block;
    }

.oc-seg-new {
    background: rgba(0,172,193,.10);
    color: #00838F;
    border-color: rgba(0,131,143,.35);
}

.oc-seg-reactivated {
    background: rgba(67,160,71,.10);
    color: #2E7D32;
    border-color: rgba(46,125,50,.35);
}

.oc-seg-regular {
    background: rgba(30,136,229,.10);
    color: #1565C0;
    border-color: rgba(21,101,192,.35);
}

.oc-seg-occasional {
    background: rgba(142,36,170,.10);
    color: #6A1B9A;
    border-color: rgba(106,27,154,.35);
}

.oc-seg-risk {
    background: rgba(251,140,0,.10);
    color: #EF6C00;
    border-color: rgba(239,108,0,.35);
}

.oc-seg-lost {
    background: rgba(158,158,158,.12);
    color: #616161;
    border-color: rgba(97,97,97,.35);
}

.oc-seg-spy {
    background: rgba(109, 76, 65, .10);
    color: #4E342E;
    border-color: rgba(78, 52, 46, .35);
}

.popup-line {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    line-height: 1.35;
    font-size: 12px;
    opacity: .9;
}

.popup-tel {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 6px;
}

.popup-tel-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    opacity: .9;
}

    .popup-line svg,
    .popup-tel-item svg {
        width: 13px;
        height: 13px;
        flex: 0 0 auto;
        opacity: .65;
    }

.popup-actions {
    margin-top: 12px;
}

.popup-navigate-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    border-radius: 9999px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: #1a73e8;
    cursor: pointer;
}

    .popup-navigate-btn:hover {
        background: #1558b0;
    }

    .popup-navigate-btn svg {
        width: 14px;
        height: 14px;
    }

.oc-popup .leaflet-popup-content {
    white-space: nowrap;
}

.oc-popup .leaflet-popup-content-wrapper {
    width: auto;
    max-width: none;
}

.oc-popup .oc-pill.oc-seg-spy::before {
    content: none !important;
}

/* Nhóm Moje poloha + Zoom lại thành 1 cột, để Satellite luôn nằm bên trái cả cụm.
   Margin đặt ở cluster (không phải từng con) để đáy/lề phải khớp chính xác với thẻ Satellite. */
.oc-zoom-cluster {
    display: flex;
    flex-direction: column;
    align-self: flex-end;
    gap: 4px;
    margin: 0 6px 8px 8px !important;
}

/* Locate / Zoom controls */
.leaflet-control-oc-locate {
    margin: 0 !important;
    box-shadow: 0 2px 6px rgba(0,0,0,.25);
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
}

    .leaflet-control-oc-locate button {
        width: 32px;
        height: 32px;
        border: 0;
        margin: 0;
        padding: 0;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: #fff;
        cursor: pointer;
    }

        .leaflet-control-oc-locate button:active {
            filter: brightness(.95);
        }

    .leaflet-control-oc-locate svg {
        width: 20px;
        height: 20px;
    }

.oc-gps-glyph {
    fill: #5f6368;
    transition: fill .15s ease;
}

.leaflet-control-oc-locate button:hover .oc-gps-glyph {
    fill: #1a73e8;
}

.leaflet-control-oc-locate button.on .oc-gps-glyph {
    fill: #1a73e8;
}

.oc-gps-stroke {
    stroke: #5f6368;
    transition: stroke .15s ease;
}

.oc-gps-dot {
    fill: #5f6368;
    transition: fill .15s ease;
}

.leaflet-control-oc-locate button:hover .oc-gps-stroke {
    stroke: #1a73e8;
}

.leaflet-control-oc-locate button:hover .oc-gps-dot {
    fill: #1a73e8;
}

.leaflet-control-oc-locate button.on .oc-gps-stroke {
    stroke: #1a73e8;
}

.leaflet-control-oc-locate button.on .oc-gps-dot {
    fill: #1a73e8;
}

/* === Zoom === */
.leaflet-control-oc-zoom {
    margin: 0 !important;
    padding: 2px 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,.25);
    overflow: hidden;
}

.oc-zoom-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.leaflet-control-oc-zoom .oc-zoom-btn + .oc-zoom-btn {
    position: relative;
}

    .leaflet-control-oc-zoom .oc-zoom-btn + .oc-zoom-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: 6px;
        right: 6px;
        height: 1px;
        background: rgba(0,0,0,.10);
    }

.leaflet-control-oc-zoom .oc-zoom-btn:hover:not(:disabled) .oc-zoom-glyph {
    fill: #1a73e8;
}

.leaflet-control-oc-zoom .oc-zoom-btn:disabled .oc-zoom-glyph {
    fill: #bdbdbd;
}

.oc-zoom-btn:active {
    transform: translateY(1px);
}

.oc-zoom-btn svg {
    width: 20px;
    height: 20px;
    display: block;
}

.oc-zoom-glyph {
    fill: #5f6368;
    transition: fill .15s ease;
}

.oc-zoom-btn:disabled {
    opacity: .45;
    cursor: not-allowed;
    box-shadow: none;
}

/* Xếp cụm Satellite + Zoom theo hàng ngang ở góc dưới-phải */
.leaflet-bottom.leaflet-right {
    display: flex;
    align-items: flex-end;
}

/* === Toggle Satellite (card kiểu Google Maps) === */
.leaflet-control-oc-sat {
    align-self: flex-end;
    margin: 0 0 8px 8px !important;
}

.oc-sat-btn {
    width: 74px;
    padding: 4px;
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,.25);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

    .oc-sat-btn:hover {
        border-color: #1a73e8;
    }

.oc-sat-thumb {
    width: 100%;
    height: 44px;
    border-radius: 5px;
    background-size: cover;
    background-position: center;
    background-color: #cfd8dc;
}

.oc-sat-label {
    font-size: 11px;
    font-weight: 600;
    color: #3c4043;
    line-height: 1;
    padding-bottom: 2px;
}

/* === Badge tổng số khách === */
.oc-count-badge {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    z-index: 1000;
    padding: 4px 12px;
    background: #fff;
    border: 1px solid rgba(0,0,0,.06);
    color: #3c4043;
    font-size: 13px;
    font-weight: 500;
    border-radius: 9999px;
    box-shadow: 0 1px 1.5px rgba(0,0,0,.08);
    white-space: nowrap;
}

    .oc-count-badge b {
        font-weight: 800;
    }

    /* !important: thắng cả display:inline-flex của biến thể route ở dưới */
    .oc-count-badge.oc-hidden {
        display: none !important;
    }

    /* Chế độ hiện tổng km plan lúc tracking — dùng đúng typografie/khoảng cách của ô tóm tắt tuyến (Navigovat) */
    .oc-count-badge.oc-count-badge-route {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border: 0;
        font-size: 14px;
        font-weight: 600;
        color: #202124;
        box-shadow: 0 1px 4px rgba(0,0,0,.3);
    }

        /* 16px + margin 4px = đúng kích thước/khoảng cách ICON_CAR đang dùng trong ô tóm tắt Navigovat
           (inline style ở đó đè lên rule 20px của .oc-route-float-summary) */
        .oc-count-badge.oc-count-badge-route svg {
            width: 16px;
            height: 16px;
            margin-right: 4px;
            color: #5f6368;
            flex: 0 0 auto;
        }

/* === Thước tỷ lệ === */
.leaflet-control-scale {
    margin: 0 8px 8px 8px !important;
}

.leaflet-control-scale-line {
    border: 2px solid #5f6368;
    border-top: none;
    background: rgba(255,255,255,.85);
    backdrop-filter: blur(2px);
    padding: 1px 6px 2px;
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    color: #3c4043;
    border-radius: 0 0 6px 6px;
    box-shadow: 0 2px 6px rgba(0,0,0,.15);
    white-space: nowrap;
}

/* My location */
.oc-my-loc {
    position: relative;
}

.oc-my-loc-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #1a73e8;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px rgba(26,115,232,.35);
}

.oc-my-loc-pulse {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(26,115,232,.22);
    border: 2px solid rgba(26,115,232,.85);
    box-sizing: border-box;
    animation: oc-pulse 2s ease-out infinite;
}

@keyframes oc-pulse {
    0% {
        width: 12px;
        height: 12px;
        opacity: .8;
    }

    100% {
        width: 60px;
        height: 60px;
        opacity: 0;
    }
}

/* ===== Search UI ===== */
.leaflet-control-oc-search {
    width: 400px;
    max-width: 92vw;
}

.oc-search-wrap {
    position: relative;
    width: 100%;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: visible;
    box-sizing: border-box;
}

.oc-search-input {
    display: flex;
    align-items: center;
    gap: 8px;
    border: none;
    border-radius: 9999px;
    padding: 10px 14px;
    background: #fff;
    box-shadow: 0 6px 16px rgba(0,0,0,.18);
    flex: 0 0 auto;
}

    .oc-search-input:focus-within {
        box-shadow: 0 0 0 4px rgba(26,115,232,.10), 0 6px 16px rgba(0,0,0,.18);
    }

.oc-kraj-wrap {
    position: relative;
    flex: 0 0 auto;
}

.oc-kraj-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    max-width: 150px;
    border: 0;
    background: transparent;
    padding: 6px 10px;
    margin-left: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #3c4043;
    cursor: pointer;
    border-radius: 9999px;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: none;
}

    /* Cố tình KHÔNG đổi gì khi hover/focus/active — ép !important vì trình duyệt tự thêm style mặc định */
    .oc-kraj-btn:hover,
    .oc-kraj-btn:focus,
    .oc-kraj-btn:focus-visible,
    .oc-kraj-btn:active,
    .oc-kraj-wrap.open .oc-kraj-btn {
        color: #3c4043 !important;
        background: transparent !important;
        outline: none !important;
        box-shadow: none !important;
        border: 0 !important;
    }

    .oc-kraj-btn span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

.oc-kraj-chevron {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: #5f6368;
    transition: transform .15s ease;
}

.oc-kraj-wrap.open .oc-kraj-chevron {
    transform: rotate(180deg);
}

/* Kraj list — bao phủ trọn ô tìm kiếm, sổ xuống dưới giống hệt dropdown gợi ý chính */
.oc-search-wrap.kraj-open {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(0,0,0,.16);
    padding: 8px;
}

    .oc-search-wrap.kraj-open .oc-search-input {
        border-radius: 12px 12px 0 0;
        box-shadow: none;
        background: #fff;
    }

#ocKrajList.open {
    display: block;
    box-sizing: border-box;
    border-radius: 0 0 12px 12px;
    border-top: 1px solid #eee;
    padding-top: 6px;
    padding-bottom: 14px;
}

.oc-search-input input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 14px;
    padding: 4px 2px;
    background: transparent;
}

.oc-search-input button {
    border: none;
    background: transparent;
    color: #5f6368;
    padding: 0;
    cursor: pointer;
    width: auto;
    height: auto;
}

    .oc-search-input button svg {
        width: 22px;
        height: 22px;
        display: block;
    }

    .oc-search-input button:hover {
        color: #1a73e8;
    }

    .oc-search-input button:disabled {
        pointer-events: none;
        color: #9e9e9e;
        opacity: .5;
    }

.oc-btn-clear {
    display: none;
}

.oc-search-list,
.oc-search-empty,
.oc-route-panel {
    flex: 1 1 auto;
    overflow-y: auto;
}

.oc-search-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: none;
    background: #fff;
    border: none;
    max-height: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,.35) transparent;
}

    .oc-search-list::-webkit-scrollbar {
        width: 8px;
    }

    .oc-search-list::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,.28);
        border-radius: 9999px;
    }

        .oc-search-list::-webkit-scrollbar-thumb:hover {
            background: rgba(0,0,0,.40);
        }

    .oc-search-list::-webkit-scrollbar-track {
        background: transparent;
    }

.oc-search-item {
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
}

    .oc-search-item:hover, .oc-search-item.active {
        background: #f5f5f5;
    }

    .oc-search-item > div {
        flex: 1 1 auto;
        min-width: 0;
    }

.oc-search-icon {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    opacity: .9;
    display: block;
}

.oc-search-name {
    display: flex;
    align-items: baseline;
    gap: 6px;
    width: 100%;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

    .oc-search-name .oc-name {
        flex: 0 1 auto;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

.oc-search-ico {
    flex: 0 0 auto;
    white-space: nowrap;
    margin-left: 0;
    font-weight: 400;
    color: #757575;
    font-size: 13px;
    max-width: 45%;
    overflow: hidden;
    text-overflow: ellipsis;
}

.oc-search-name .oc-pill {
    margin-left: auto;
}

.oc-search-ico mark {
    background: transparent;
    color: #1a73e8;
    font-weight: 700;
}

.oc-search-sub {
    font-size: 12px;
    opacity: .8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

mark {
    background: transparent;
    color: #1a73e8;
    font-weight: 700;
}

.oc-search-empty {
    font-size: 12px;
    opacity: .7;
    padding: 8px 4px;
    display: none;
    background: #fff;
}

.oc-search-wrap.open {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(0,0,0,.16);
    padding: 8px;
}

    .oc-search-wrap.open .oc-search-input {
        border-radius: 12px 12px 0 0;
        box-shadow: none;
        background: #fff;
    }

    .oc-search-wrap.open #ocSearchList {
        display: block;
        border-radius: 0 0 12px 12px;
        border-top: 1px solid #eee;
    }

    .oc-search-wrap.open .oc-search-empty {
        display: block;
        border-radius: 0 0 12px 12px;
        border-top: 1px solid #eee;
    }

.oc-pill-vip {
    background: rgba(255,215,0,.14);
    color: #B8860B;
    border-color: rgba(184,134,11,.45);
}

    .oc-pill-vip::before {
        content: '★';
        font-weight: 900;
    }

.oc-pill-ver::before {
    content: '🛡︎';
    font-weight: 900;
}

.oc-pill.oc-seg-spy::before {
    content: none !important;
}

.marker-cluster.oc-pie-mode {
    background: transparent !important;
    border: none;
}

    .marker-cluster.oc-pie-mode > div {
        box-shadow: none !important;
    }

    .marker-cluster.oc-pie-mode .oc-pie {
        background: transparent;
    }

.oc-pie {
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 3px rgba(255,255,255,.85) inset, 0 1px 4px rgba(0,0,0,.30);
}

    .oc-pie > span {
        border-radius: 50%;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #333;
    }

.marker-cluster.oc-pie-mode,
.marker-cluster.oc-pie-mode > div,
.marker-cluster.oc-pie-mode .oc-pie,
.marker-cluster.oc-pie-mode .oc-pie > span {
    border-radius: 50% !important;
}

.leaflet-control-oc-stats {
    display: flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    z-index: 1000;
    margin: 0 !important;
}

.oc-stats-nav {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,.18);
    color: #5f6368;
    cursor: pointer;
    transform: translateY(-2px);
}

    .oc-stats-nav svg {
        width: 18px;
        height: 18px;
        display: block;
    }

    .oc-stats-nav:hover:not(:disabled) {
        color: #1a73e8;
    }

    .oc-stats-nav:disabled {
        opacity: .35;
        cursor: not-allowed;
    }

.leaflet-control-oc-stats.has-nav .oc-stats-nav {
    display: flex;
}

.oc-stats-dock {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: 0;
    padding: 0px 8px;
    box-sizing: border-box;
    white-space: nowrap;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    overflow-y: hidden;
    scrollbar-width: none;
    max-width: none;
    box-shadow: none;
    height: auto;
    cursor: grab;
}

    .oc-stats-dock.dragging {
        cursor: grabbing;
    }

    .oc-stats-dock.dragging .oc-pill {
        pointer-events: none;
    }

    .oc-stats-dock::-webkit-scrollbar {
        display: none;
    }

.leaflet-control-oc-stats .oc-pill {
    position: relative;
    font-size: 13px;
    padding: 4px 12px;
    border: 1px solid rgba(0,0,0,.06);
    background: #fff;
    box-shadow: 0 1px 1.5px rgba(0,0,0,.08);
    transition: transform .14s ease, box-shadow .18s ease, background .18s ease, filter .18s ease;
    cursor: pointer;
    transform: translateY(-2px);
    will-change: transform;
}

    .leaflet-control-oc-stats .oc-pill.oc-pill-seg,
    .leaflet-control-oc-stats .oc-pill.oc-pill-vip,
    .leaflet-control-oc-stats .oc-pill.oc-pill-ver {
        background: #fff !important;
    }

        .leaflet-control-oc-stats .oc-pill.oc-pill-seg::before {
            width: 8px;
            height: 8px;
        }

    .leaflet-control-oc-stats .oc-pill b {
        margin-left: 8px;
        font-size: 13px;
        font-weight: 800;
    }

    .leaflet-control-oc-stats .oc-pill:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 16px rgba(0,0,0,.14);
    }

.oc-pill .oc-chip-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    display: inline-block;
    visibility: hidden;
}

.oc-pill.oc-seg-spy .oc-chip-icon {
    visibility: visible;
}

.leaflet-control-oc-stats .oc-pill.active {
    transform: translateY(-3px);
    background: #fff;
    box-shadow: 0 8px 22px rgba(0,0,0,.16), 0 0 0 3px color-mix(in srgb, currentColor 10%, transparent);
    outline: none;
}

    .leaflet-control-oc-stats .oc-pill.active::after {
        content: '';
        position: absolute;
        left: 10px;
        right: 10px;
        bottom: -4px;
        height: 4px;
        border-radius: 9999px;
        background: currentColor;
        opacity: .55;
        filter: blur(2px);
        pointer-events: none;
    }

.leaflet-control-oc-stats .oc-pill:focus-visible {
    outline: none;
    box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 22%, transparent), 0 6px 16px rgba(0,0,0,.14);
}

.leaflet-control-oc-stats .oc-stats-dock {
    line-height: normal; /* tránh thừa line-height khiến nhìn như lệch */
}

/* Ẩn attribution/logo */
.maplibregl-ctrl-logo,
.maptilersdk-ctrl-logo,
.maptiler-logo-control,
.maplibregl-ctrl-attrib,
.maptilersdk-ctrl-attrib,
.leaflet-control-attribution,
a[href*='maptiler'] {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
}

/* Nút Trasa */
#ocRouteBtn {
    color: #623ED0;
}

    #ocRouteBtn svg {
        width: 18px;
        height: 18px;
    }

    #ocRouteBtn:hover, #ocRouteBtn:focus-visible {
        color: #1a73e8;
    }

    #ocRouteBtn:disabled {
        color: #bdbdbd;
    }

/* Khi mở Route (icon X), dùng màu xám trung tính thay vì tím */
.oc-search-wrap.route-mode #ocRouteBtn {
    color: #5f6368;
}

    .oc-search-wrap.route-mode #ocRouteBtn:hover,
    .oc-search-wrap.route-mode #ocRouteBtn:focus-visible {
        color: #1a73e8; /* hover vẫn xanh như nút khác */
    }

/* Panel Trasa */
.oc-route-panel {
    margin: 0;
    padding: 10px 12px;
    background: #fff;
    border: none;
    display: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,.35) transparent;
    flex: 1 1 auto;
    box-sizing: border-box;
}

    .oc-route-panel::-webkit-scrollbar {
        width: 8px;
    }

    .oc-route-panel::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,.28);
        border-radius: 9999px;
    }

        .oc-route-panel::-webkit-scrollbar-thumb:hover {
            background: rgba(0,0,0,.40);
        }

.oc-search-wrap.route-mode .oc-route-panel {
    display: block;
    border-radius: 0 0 12px 12px;
    border-top: none;
}

/* Route fields */
.oc-route-row {
    display: block;
    padding: 8px 0;
}

.oc-route-label {
    font-size: 12px;
    color: #616161;
    margin: 0 0 6px 2px;
    display: none !important;
}

.oc-route-input {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #eee;
    border-radius: 10px;
    padding: 8px 12px;
    background: #fff;
    position: relative;
}

.oc-route-dd {
    position: absolute;
    /* Mở rộng khớp đúng mép trong của oc-route-panel (padding 12px): bù lại marker(20+18)+gap(10)=48 bên trái, bù padding-right của hàng (26px, có nút xóa) bên phải */
    left: -48px;
    right: -26px;
    top: 100%;
    margin-top: 14px;
    z-index: 1000;
    display: none;
}

    /* Hàng From/To (2 hàng): row hết padding-right 26px, nhưng nút swap (32px) + gap (6px) của oc-route-stops-wrap chiếm chỗ bên phải #ocRouteStops thay vào đó */
    #ocRouteStops.oc-route-stops-no-remove-gutter .oc-route-dd {
        right: -38px;
    }

    .oc-route-dd.open {
        display: block;
    }

    .oc-route-dd > .oc-search-list {
        display: block;
        border: none;
        margin: 0;
        padding: 0;
        border-radius: 0 0 12px 12px;
    }

    .oc-route-dd > .oc-search-empty {
        display: none;
        border: none;
        margin-top: 0;
    }

    .oc-route-dd.empty > .oc-search-list {
        display: none;
    }

    .oc-route-dd.empty > .oc-search-empty {
        display: block;
    }

.oc-route-input:focus-within {
    box-shadow: 0 0 0 1.5px rgba(26,115,232,.35);
    border-color: #1a73e8;
}

.oc-route-input input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 14px;
    padding: 4px 0;
    background: transparent;
}

.oc-route-suggestions {
    margin: 6px 0 0 0;
    padding: 0;
    list-style: none;
    display: none;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 10px;
}

.oc-route-empty {
    display: none;
    font-size: 12px;
    opacity: .7;
    padding: 8px 4px;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 10px;
}

.oc-route-float-summary {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    z-index: 1000;
    align-items: center;
    gap: 8px;
    background: #fff;
    border-radius: 9999px;
    box-shadow: 0 1px 4px rgba(0,0,0,.3);
    padding: 8px 10px 8px 14px;
    font-size: 14px;
    font-weight: 600;
    color: #202124;
    white-space: nowrap;
}

    .oc-route-float-summary.show {
        display: inline-flex;
    }

    .oc-route-float-summary svg:first-child {
        width: 20px;
        height: 20px;
        color: #5f6368;
        flex: 0 0 auto;
    }

.oc-route-float-close {
    box-sizing: border-box;
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0 0 0 4px;
    font: inherit;
    line-height: 0;
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: #5f6368;
    border-radius: 9999px;
}

    .oc-route-float-close:hover {
        background: rgba(0,0,0,.06);
    }

    .oc-route-float-close svg {
        display: block;
        width: 16px;
        height: 16px;
    }

/* Demo marker Obchodní zástupce — vùng bấm rộng hơn (44px) hơn hình xe hiển thị (26px) cho dễ bấm */
.oc-rep-marker {
    width: 56px;
    height: 56px;
    cursor: pointer;
}

.oc-rep-marker-wrap {
    position: relative;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
}

.oc-rep-marker-rot {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,.45));
    transition: transform .3s linear;
}

    .oc-rep-marker-rot svg {
        width: 100%;
        height: 100%;
        display: block;
    }

/* Vòng sáng khi focus — giống hiệu ứng pulse của Moje poloha */
.oc-rep-pulse {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(229,57,53,.3);
    border: 2px solid rgba(229,57,53,.9);
    box-sizing: border-box;
    animation: oc-pulse-rep 1.6s ease-out infinite;
}

/* Rep chưa được focus — vẫn hiện pulse ngay từ lúc bật tracking, màu tím thương hiệu thay vì đỏ (đỏ dành riêng cho focus) */
.oc-rep-pulse-idle {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(98,62,208,.3);
    border: 2px solid rgba(98,62,208,.9);
    box-sizing: border-box;
    animation: oc-pulse-rep 1.6s ease-out infinite;
}

@keyframes oc-pulse-rep {
    0% {
        width: 26px;
        height: 26px;
        opacity: .8;
    }

    100% {
        width: 80px;
        height: 80px;
        opacity: 0;
    }
}

.oc-rep-popup {
    font-size: 13px;
    min-width: 160px;
}

.oc-rep-popup-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 8px;
}

    .oc-rep-popup-name svg {
        width: 18px;
        height: 18px;
        flex: 0 0 auto;
        color: #623ED0;
    }

.oc-rep-popup-row {
    color: #3c4043;
    margin-top: 7px;
    line-height: 1.35;
}

.oc-rep-popup-time {
    color: #9e9e9e;
    font-size: 11px;
    margin-top: 10px;
}

/* Quãng đường + tốc độ TB đo trên đường đi thật (đường cam) */
.oc-rep-popup-distance {
    display: flex;
    align-items: center;
    gap: 7px;
}

    /* Glyph speedometer chỉ chiếm phần dưới viewBox nên trông nhỏ hơn icon người ở dòng tên — bù bằng size lớn hơn */
    .oc-rep-popup-distance svg {
        width: 18px;
        height: 18px;
        flex: 0 0 auto;
        color: #1A73E8;
    }

.oc-rep-popup-stops {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #eee;
}

.oc-rep-popup-stops-title {
    font-weight: 600;
    font-size: 11px;
    color: #757575;
    letter-spacing: .02em;
    margin-bottom: 10px;
}

.oc-rep-popup-stops-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

    .oc-rep-popup-stops-list li {
        color: #9e9e9e;
        margin-top: 12px;
        white-space: nowrap;
    }

        .oc-rep-popup-stops-list li:first-child {
            margin-top: 2px;
        }

    .oc-rep-popup-stops-list li.oc-rep-stop-item-done {
        color: #3c4043;
        font-weight: 600;
    }

    .oc-rep-popup-stops-list .oc-rep-stop-check {
        color: #34A853;
        font-weight: 700;
    }

    .oc-rep-popup-stops-list .oc-rep-stop-name {
        white-space: nowrap;
    }

    .oc-rep-popup-stops-list .oc-rep-stop-address {
        white-space: nowrap;
        margin-top: 4px;
        margin-left: 1.2em;
        color: #adadad;
    }

.oc-rep-stop-tip-name {
    white-space: nowrap;
}

.oc-rep-stop-tip-address {
    white-space: nowrap;
    margin-top: 3px;
    color: #757575;
}

/* Tooltip hover trên đoạn đường mất kết nối (đường đỏ) */
.oc-gap-tip {
    white-space: nowrap;
    color: #C62828;
    font-weight: 600;
}

/* Cảnh báo check-in cách xa địa chỉ trong plan — hồng đậm, khớp màu chấm ✕ trên map */
.oc-rep-stop-tip-warn {
    white-space: nowrap;
    margin-top: 3px;
    color: #AD1457;
    font-weight: 700;
}

/* Marker zastávka trên map — kế hoạch trasa của rep đang focus */
.oc-rep-stop-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid #9e9e9e;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    line-height: 1;
    color: #fff;
    font-weight: 700;
    box-shadow: 0 1px 3px rgba(0,0,0,.3);
}

/* Popup địa chỉ ngoài DB (TomTom Search) */
.oc-extaddr-popup {
    min-width: 180px;
    max-width: 260px;
}

.oc-extaddr-popup-name {
    font-weight: 700;
    font-size: 13.5px;
    color: #202124;
    line-height: 1.3;
}

.oc-extaddr-popup-addr {
    font-size: 12px;
    color: #5f6368;
    margin-top: 2px;
    line-height: 1.3;
}

.oc-roadwork-marker {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    padding: 5px;
    box-sizing: border-box;
    background: #FFC400;
    border: 2px solid #000;
    border-radius: 9999px;
    box-shadow: 0 1px 4px rgba(0,0,0,.4);
}

    .oc-roadwork-marker svg {
        width: 100%;
        height: 100%;
        display: block;
    }

.oc-route-hover-tip {
    background: #202124;
    color: #fff;
    border: 0;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(0,0,0,.35);
}

    .oc-route-hover-tip::before {
        border-top-color: #202124;
    }

#ocRouteStops {
    position: relative;
}

.oc-route-stops-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
}

    .oc-route-stops-wrap #ocRouteStops {
        flex: 1 1 auto;
        min-width: 0;
    }

.oc-route-swap-btn {
    display: none;
    flex: 0 0 auto;
    box-sizing: border-box;
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    font: inherit;
    line-height: 0;
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    color: #5f6368;
}

    .oc-route-swap-btn.show {
        display: grid;
        place-items: center;
    }

    .oc-route-swap-btn:hover {
        background: rgba(0,0,0,.06);
    }

    .oc-route-swap-btn svg {
        display: block;
        width: 20px;
        height: 20px;
    }

/* Đường nối — chèn thật giữa 2 hàng liên tiếp, luôn đúng 3 chấm, không bị icon che */
.oc-route-connector {
    display: flex;
    align-items: stretch;
    height: 14px;
    pointer-events: none;
}

.oc-route-connector-spacer {
    flex: 0 0 auto;
    width: 20px;
}

.oc-route-connector-dots {
    flex: 0 0 auto;
    width: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 1px 0;
}

.oc-route-connector-dot {
    width: 3px;
    height: 3px;
    border-radius: 9999px;
    background: #bbb;
}

.oc-route-row-stop {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 3px 26px 3px 0;
}

/* Chỉ 2 hàng (From/To) → nút Odebrat cíl không bao giờ hiện, khỏi chừa chỗ cho nó */
.oc-route-stops-no-remove-gutter .oc-route-row-stop {
    padding-right: 0;
}

.oc-route-row-stop .oc-route-input {
    flex: 1 1 auto;
    min-width: 0;
    position: relative;
}

.oc-route-marker {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    width: 18px;
    margin-left: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Tay cầm kéo: ẩn mặc định, đè lên khoảng trống bên trái marker, chỉ hiện khi hover đúng hàng */
.oc-route-drag-handle {
    position: absolute;
    left: -20px;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    cursor: grab;
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    color: #757575;
    padding: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity .12s ease;
}

.oc-route-row-stop:hover .oc-route-drag-handle {
    opacity: 1;
    pointer-events: auto;
}

.oc-route-drag-handle svg {
    display: block;
    width: 14px;
    height: 14px;
}

.oc-route-drag-handle:active {
    cursor: grabbing;
}

.oc-route-marker-icon-slot {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: #fff;
    color: #757575;
}

    .oc-route-marker-icon-slot svg {
        width: 16px;
        height: 16px;
        display: block;
    }

    .oc-route-marker-icon-slot.is-pin {
        color: #EA4335;
    }

        .oc-route-marker-icon-slot.is-pin svg {
            width: 20px;
            height: 20px;
        }

.oc-route-row-dragging {
    opacity: .4;
}

.oc-route-drop-before {
    box-shadow: inset 0 2px 0 0 #1a73e8;
}

.oc-route-drop-after {
    box-shadow: inset 0 -2px 0 0 #1a73e8;
}

.oc-route-stop-remove {
    box-sizing: border-box;
    position: absolute;
    right: 2px;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
    font: inherit;
    line-height: 0;
    cursor: pointer;
    width: 22px;
    height: 22px;
    display: none;
    place-items: center;
    color: #777;
    border-radius: 9999px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .12s ease;
}

    .oc-route-stop-remove.oc-route-stop-remove-enabled {
        display: grid;
    }

.oc-route-row-stop:hover .oc-route-stop-remove.oc-route-stop-remove-enabled {
    opacity: 1;
    pointer-events: auto;
}

.oc-route-stop-remove:hover {
    background: rgba(0,0,0,.06);
}

.oc-route-stop-remove svg {
    display: block;
    width: 14px;
    height: 14px;
}

.oc-route-add-stop-row {
    display: none;
    align-items: center;
    gap: 8px;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 0;
    margin-top: 14px;
    box-sizing: border-box;
    color: #3c4043;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}

    .oc-route-add-stop-row.show {
        display: flex;
    }

.oc-route-add-stop-icon {
    position: relative;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    color: #5f6368;
}

    .oc-route-add-stop-icon::before {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 9999px;
        border: 1.5px solid transparent;
    }

    .oc-route-add-stop-row:hover .oc-route-add-stop-icon::before {
        border-color: #5f6368;
        background: #f1f3f4;
    }

.oc-route-add-stop-icon svg {
    position: relative;
    width: 14px;
    height: 14px;
}

.oc-route-add-stop-text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    padding: 0 12px;
    box-sizing: border-box;
    border-radius: 10px;
    transition: background .15s ease;
}

.oc-route-add-stop-row:hover .oc-route-add-stop-text {
    background: #f1f3f4;
}

.oc-route-add-stop-text {
    flex: 1 1 auto;
    min-width: 0;
}

/* Route-mode: ẩn các control tìm kiếm, giữ nút Trasa/Close để thoát */
.oc-search-wrap.route-mode .oc-search-input {
    display: none;
}

/* Không cho list/empty của search chính hiển thị nhầm trong route-mode */
.oc-search-wrap.route-mode #ocSearchList {
    display: none !important;
}

.oc-search-wrap.route-mode #ocSearchEmpty {
    display: none !important;
}
/* Nút Trasa mini trong list gợi ý */
.oc-suggest-route {
    flex: 0 0 auto;
    border: none;
    background: transparent;
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: #623ED0;
}

    .oc-suggest-route:hover {
        background: transparent;
    }

    .oc-suggest-route:active {
        transform: translateY(1px);
    }

    .oc-suggest-route svg {
        width: 22px;
        height: 22px;
        display: block;
    }


/* Thanh chế độ di chuyển trên cùng khi mở Trasa */
.oc-route-modes {
    display: none; /* mặc định ẩn */
    gap: 10px;
    padding: 6px 8px 8px 8px;
    align-items: center;
    flex-wrap: nowrap;
    flex: 0 0 auto;
}

.oc-search-wrap.route-mode .oc-route-modes {
    display: flex;
}

/* Nút mode (tròn, icon đen) */
.oc-mode-btn {
    border: 0;
    background: transparent;
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    padding: 0;
    margin: 0;
    color: #222; /* icon màu đen */
}

    .oc-mode-btn svg {
        width: 20px;
        height: 20px;
        display: block;
    }

    /* Trạng thái hover/focus */
    .oc-mode-btn:hover {
        background: rgba(26,115,232,.10);
    }

    .oc-mode-btn:focus-visible {
        outline: 2px solid rgba(26,115,232,.35);
    }

    /* Đang chọn (nền xanh nhạt giống ảnh) */
    .oc-mode-btn.active {
        background: #cfeef8; /* xanh nhạt */
    }

/* Nút X đóng ở cuối thanh */
#ocRouteModesClose {
    margin-left: auto; /* đẩy về tận cùng bên phải */
}

.oc-route-plan-label {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 0;
    background: transparent;
    cursor: default;
    padding: 6px 4px;
    margin: 0;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #3c4043;
    white-space: nowrap;
}

    .oc-route-plan-label svg {
        width: 20px;
        height: 20px;
        flex: 0 0 auto;
        color: #623ED0;
    }

.oc-route-modes .oc-mode-close {
    margin-left: auto;
}
/* sát hơn: 8px thay vì 10px mặc định của Leaflet */
.leaflet-top .leaflet-left .leaflet-control-oc-search {
    margin-top: 8px !important;
    margin-left: 8px !important;
}

/* Panel thời tiết — thế chỗ ô tìm kiếm khi đang tracking (ẩn theo mặc định) */
.oc-weather-panel {
    display: none;
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 1000;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: #fff;
    border-radius: 9999px;
    box-shadow: 0 6px 16px rgba(0,0,0,.18);
    font-size: 14px;
    color: #3c4043;
}

    .oc-weather-panel .oc-weather-icon {
        font-size: 20px;
        line-height: 1;
    }

    .oc-weather-panel .oc-weather-temp {
        font-weight: 700;
        font-size: 15px;
    }

    .oc-weather-panel .oc-weather-label {
        color: #5f6368;
    }

    .oc-weather-panel .oc-weather-loading {
        color: #9e9e9e;
        font-size: 13px;
    }

/* Border số người đang xem Tracking — đối xứng panel thời tiết, bên phải (ẩn mặc định, chỉ hiện khi tracking) */
.oc-viewer-panel {
    display: none;
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1000;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: #fff;
    border-radius: 9999px;
    box-shadow: 0 6px 16px rgba(0,0,0,.18);
    font-size: 14px;
    color: #3c4043;
}

    .oc-viewer-panel .oc-viewer-icon {
        display: inline-flex;
        align-items: center;
        color: #623ED0;
    }

    .oc-viewer-panel .oc-viewer-count {
        font-weight: 700;
        font-size: 15px;
        color: #34A853;
    }

/* Danh sách obchodní zástupce có plan hôm nay — giữa panel thời tiết (trái) và panel người xem (phải), hiện
   kể cả khi chỉ có 1 rep. Mỗi rep 1 chip hàng ngang, cùng style pill với panel người xem. */
.oc-reps-roster-panel {
    display: none;
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    align-items: center;
    gap: 8px;
    max-width: min(640px, calc(100% - 320px));
    overflow-x: auto;
    background: none;
    box-shadow: none;
    border: none;
    padding: 0;
}

.oc-rep-roster-chip {
    display: flex;
    align-items: center;
    gap: 7px;
    flex: none;
    padding: 8px 14px;
    background: #fff;
    border-radius: 9999px;
    /* Shadow nhẹ, sát viền — chip cách nhau chỉ 8px nên shadow to/lan xa (như panel thời tiết/viewer) sẽ
       chồng lấn giữa các chip, nhìn như 1 khối nền mờ bao quanh cả nhóm. */
    box-shadow: 0 1px 4px rgba(0,0,0,.15);
    font-size: 13px;
    color: #3c4043;
    white-space: nowrap;
}

.oc-rep-roster-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
}

    .oc-rep-roster-dot.oc-online {
        background: #34A853;
        box-shadow: 0 0 0 3px rgba(52,168,83,.2);
    }

    .oc-rep-roster-dot.oc-offline {
        background: #E53935;
        box-shadow: 0 0 0 3px rgba(229,57,53,.2);
    }

/* Modal thông báo tự vẽ — thay cho alert() gốc trình duyệt (không chỉnh được tiêu đề "appassets.local says") */
.oc-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100000;
    align-items: center;
    justify-content: center;
    background: rgba(20, 12, 40, .45);
}

    .oc-modal-overlay.oc-show {
        display: flex;
    }

.oc-modal-card {
    width: min(360px, 90vw);
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(0,0,0,.28);
    overflow: hidden;
    font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    animation: oc-modal-in .16s ease-out;
}

@keyframes oc-modal-in {
    from { transform: translateY(10px) scale(.97); opacity: 0; }
    to { transform: none; opacity: 1; }
}

.oc-modal-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: #623ED0;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
}

    .oc-modal-header svg {
        width: 20px;
        height: 20px;
        flex: none;
    }

.oc-modal-body {
    padding: 20px 18px;
    color: #2b2b33;
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-line;
}

.oc-modal-footer {
    display: flex;
    justify-content: flex-end;
    padding: 0 18px 18px;
}

.oc-modal-btn {
    border: none;
    border-radius: 9999px;
    padding: 9px 24px;
    background: #623ED0;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s;
}

    .oc-modal-btn:hover {
        background: #4F32A8;
    }
