-- Fix encoding cho Name va Description
UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'Z'+NCHAR(225)+'porn'+NCHAR(233)+' mn'+NCHAR(243)+''+NCHAR(382)+'stv'+NCHAR(237),
    [Description] = N'Upozorn'+NCHAR(283)+'n'+NCHAR(237)+' na negativn'+NCHAR(237)+' skladov'+NCHAR(233)+' mn'+NCHAR(243)+''+NCHAR(382)+'stv'+NCHAR(237)
WHERE [NotificationKey] = 'Negative';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'Chyb'+NCHAR(237)+' doklad do'+NCHAR(353)+'l'+NCHAR(253),
    [Description] = N'Chyb'+NCHAR(283)+'j'+NCHAR(237)+'c'+NCHAR(237)+' doklady p'+NCHAR(345)+''+NCHAR(237)+'jmu zbo'+NCHAR(382)+NCHAR(237)
WHERE [NotificationKey] = 'MissingReceipt';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'Produkty s mar'+NCHAR(382)'+NCHAR(237)+' pod 30%',
    [Description] = N'Produkty s n'+NCHAR(237)+'zk'+NCHAR(253)+'m ziskov'+NCHAR(253)+'m mar'+NCHAR(382)'+NCHAR(225)+'n'+NCHAR(237)+'m'
WHERE [NotificationKey] = 'LowMargin';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'Ne'+NCHAR(250)+'pln'+NCHAR(233)+' produktov'+NCHAR(233)+' z'+NCHAR(225)+'znamy',
    [Description] = N'Produkty chyb'+NCHAR(237)+' v e-shopu nebo nemaj'+NCHAR(237)+' obr'+NCHAR(225)+'zek'
WHERE [NotificationKey] = 'ProductWarning';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'Chyb'+NCHAR(283)+'j'+NCHAR(237)+'c'+NCHAR(237)+' master data',
    [Description] = N'Produkty bez vypln'+NCHAR(283)+'n'+NCHAR(253)+'ch hlavn'+NCHAR(237)+'ch '+NCHAR(250)+'daj'+NCHAR(367)
WHERE [NotificationKey] = 'MasterData';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'RP - Chyb'+NCHAR(283)+'j'+NCHAR(237)+'c'+NCHAR(237)+' p'+NCHAR(345)+''+NCHAR(237)+'slu'+NCHAR(353)+'enstv'+NCHAR(237)+' a hmotnost',
    [Description] = N'Chyb'+NCHAR(237)+' informace o p'+NCHAR(345)+''+NCHAR(237)+'slu'+NCHAR(353)+'enstv'+NCHAR(237)+' a hmotnosti'
WHERE [NotificationKey] = 'ProductMissing';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'RP - V'+NCHAR(253)+'kaz',
    [Description] = N'Povinn'+NCHAR(233)+' hl'+NCHAR(225)+''+NCHAR(353)+'en'+NCHAR(237)+' v'+NCHAR(253)+'kaz'+NCHAR(367)+' recyklace'
WHERE [NotificationKey] = 'RecyclingReport';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'Objedn'+NCHAR(225)+'vky od obchodn'+NCHAR(237)+' z'+NCHAR(225)+'stupce',
    [Description] = N'Nov'+NCHAR(233)+' objedn'+NCHAR(225)+'vky od obchodn'+NCHAR(237)+'ch z'+NCHAR(225)+'stupc'+NCHAR(367)
WHERE [NotificationKey] = 'OrderTracking';

UPDATE [dbo].[NotificationTypes] SET
    [Name] = N'Neprodejn'+NCHAR(233)+' zbo'+NCHAR(382)'+NCHAR(237),
    [Description] = N'Zbo'+NCHAR(382)'+NCHAR(237)+' bez prodeje po dobu 3 m'+NCHAR(283)+'s'+NCHAR(237)+'c'+NCHAR(367)
WHERE [NotificationKey] = 'Unsold';

SELECT NotificationKey, Name, Description FROM [dbo].[NotificationTypes] ORDER BY NotificationKey;
