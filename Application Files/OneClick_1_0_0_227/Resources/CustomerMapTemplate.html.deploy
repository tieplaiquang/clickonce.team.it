<!doctype html>
<html>
<head>
    <meta charset='utf-8' />
    <title>Zákaznická mapa</title>
    <link rel='icon' type='image/svg+xml' href='data:image/svg+xml,%3Csvg xmlns=' 'http://www.w3.org/2000/svg' ' viewBox=' '0 0 16 16' '%3E%3Ccircle cx=' '8' ' cy=' '8' ' r=' '8' ' fill=' '%235E35B1' '/%3E%3C/svg%3E'>
    <link rel='shortcut icon' type='image/png' href='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR4nGNgYAAAAAMAASsJTYQAAAAASUVORK5CYII='>
    <link rel='stylesheet' href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' />
    <link rel='stylesheet' href='https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css' />
    <link rel='stylesheet' href='https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css' />
    <style>
        html, body, #map {
            height: 100%;
            margin: 0
        }

        .marker-cluster-small {
            background: rgba(238,127,162,.6);
        }

            .marker-cluster-small div {
                background: #EE7FA2;
            }

        .marker-cluster-medium {
            background: rgba(126,87,194,.6);
        }

            .marker-cluster-medium div {
                background: #7E57C2;
            }

        .marker-cluster-large {
            background: rgba(192,202,51,.6);
        }

            .marker-cluster-large div {
                background: #C0CA33;
            }

        .marker-cluster:not(.oc-pie-mode) div {
            border-radius: 14px;
            box-shadow: 0 4px 10px rgba(0,0,0,.25);
            color: #fff;
            font-weight: 700;
        }

        .leaflet-marker-icon, .marker-cluster {
            cursor: pointer;
        }

        .leaflet-popup-content {
            margin: 8px 12px;
        }

        .popup-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            margin-bottom: 4px;
            line-height: 1.25;
            min-width: 0;
        }

            .popup-title > .oc-pill:first-of-type {
                margin-left: auto;
            }

        .oc-title-name {
            min-width: 0;
            flex: 1 1 auto;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.25;
        }

        .oc-pill {
            margin-left: 0;
            flex: 0 0 auto;
            font-size: 11px;
            line-height: 1.1;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 9999px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            position: relative;
            top: -1px;
            user-select: none;
        }

            .oc-pill::before {
                content: none;
            }

        .oc-pill-ver {
            background: rgba(192,202,51,.12);
            color: #5D6A00;
            border-color: rgba(175,180,43,.45);
        }

        .oc-pill-seg {
            border-color: transparent;
        }

            .oc-pill-seg::before {
                content: '';
                font-weight: 900;
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
                display: inline-block;
            }

        .oc-seg-new {
            background: rgba(0,172,193,.10);
            color: #00838F;
            border-color: rgba(0,131,143,.35);
        }

        .oc-seg-reactivated {
            background: rgba(67,160,71,.10);
            color: #2E7D32;
            border-color: rgba(46,125,50,.35);
        }

        .oc-seg-regular {
            background: rgba(30,136,229,.10);
            color: #1565C0;
            border-color: rgba(21,101,192,.35);
        }

        .oc-seg-occasional {
            background: rgba(142,36,170,.10);
            color: #6A1B9A;
            border-color: rgba(106,27,154,.35);
        }

        .oc-seg-risk {
            background: rgba(251,140,0,.10);
            color: #EF6C00;
            border-color: rgba(239,108,0,.35);
        }

        .oc-seg-lost {
            background: rgba(158,158,158,.12);
            color: #616161;
            border-color: rgba(97,97,97,.35);
        }

        .oc-seg-spy {
            background: rgba(109, 76, 65, .10);
            color: #4E342E;
            border-color: rgba(78, 52, 46, .35);
        }

        .popup-line {
            font-size: 12px;
            opacity: .9;
        }

        .oc-popup .leaflet-popup-content {
            white-space: nowrap;
        }

        .oc-popup .leaflet-popup-content-wrapper {
            width: auto;
            max-width: none;
        }

        .oc-popup .oc-pill.oc-seg-spy::before {
            content: none !important;
        }

        /* Locate / Zoom controls */
        .leaflet-control-oc-locate {
            margin: 8px 8px 4px 8px !important;
            box-shadow: 0 2px 6px rgba(0,0,0,.25);
            border: 1px solid rgba(0,0,0,.12);
            border-radius: 10px;
            background: #fff;
            overflow: hidden;
        }

            .leaflet-control-oc-locate button {
                width: 32px;
                height: 32px;
                border: 0;
                margin: 0;
                padding: 0;
                border-radius: 10px;
                display: grid;
                place-items: center;
                background: #fff;
                cursor: pointer;
            }

                .leaflet-control-oc-locate button:active {
                    filter: brightness(.95);
                }

            .leaflet-control-oc-locate svg {
                width: 20px;
                height: 20px;
            }

        .oc-gps-glyph {
            fill: #5f6368;
            transition: fill .15s ease;
        }

        .leaflet-control-oc-locate button:hover .oc-gps-glyph {
            fill: #1a73e8;
        }

        .leaflet-control-oc-locate button.on .oc-gps-glyph {
            fill: #1a73e8;
        }

        .oc-gps-stroke {
            stroke: #5f6368;
            transition: stroke .15s ease;
        }

        .oc-gps-dot {
            fill: #5f6368;
            transition: fill .15s ease;
        }

        .leaflet-control-oc-locate button:hover .oc-gps-stroke {
            stroke: #1a73e8;
        }

        .leaflet-control-oc-locate button:hover .oc-gps-dot {
            fill: #1a73e8;
        }

        .leaflet-control-oc-locate button.on .oc-gps-stroke {
            stroke: #1a73e8;
        }

        .leaflet-control-oc-locate button.on .oc-gps-dot {
            fill: #1a73e8;
        }

        /* === Zoom === */
        .leaflet-control-oc-zoom {
            margin: 0 8px 8px 8px !important;
            display: flex;
            flex-direction: column;
            gap: 0;
            border: 1px solid rgba(0,0,0,.12);
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,.25);
            overflow: hidden;
        }

        .oc-zoom-btn {
            width: 32px;
            height: 32px;
            padding: 0;
            border: none;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .leaflet-control-oc-zoom .oc-zoom-btn + .oc-zoom-btn {
            position: relative;
        }

            .leaflet-control-oc-zoom .oc-zoom-btn + .oc-zoom-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: 6px;
                right: 6px;
                height: 1px;
                background: rgba(0,0,0,.10);
            }

        .leaflet-control-oc-zoom .oc-zoom-btn:hover:not(:disabled) .oc-zoom-glyph {
            fill: #1a73e8;
        }

        .leaflet-control-oc-zoom .oc-zoom-btn:disabled .oc-zoom-glyph {
            fill: #bdbdbd;
        }

        .oc-zoom-btn:active {
            transform: translateY(1px);
        }

        .oc-zoom-btn svg {
            width: 20px;
            height: 20px;
            display: block;
        }

        .oc-zoom-glyph {
            fill: #5f6368;
            transition: fill .15s ease;
        }

        .oc-zoom-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            box-shadow: none;
        }

        /* My location */
        .oc-my-loc {
            position: relative;
        }

        .oc-my-loc-dot {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #1a73e8;
            border: 2px solid #fff;
            box-shadow: 0 0 0 2px rgba(26,115,232,.35);
        }

        .oc-my-loc-pulse {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(26,115,232,.25);
            animation: oc-pulse 2s ease-out infinite;
        }

        @keyframes oc-pulse {
            0% {
                width: 12px;
                height: 12px;
                opacity: .7;
            }

            100% {
                width: 36px;
                height: 36px;
                opacity: 0;
            }
        }

        /* ===== Search UI ===== */
        .leaflet-control-oc-search {
            width: 400px;
            max-width: 92vw;
        }

        .oc-search-wrap {
            position: relative;
            width: 100%;
            background: transparent;
            border-radius: 0;
            box-shadow: none;
            padding: 0;
            display: flex;
            flex-direction: column;
            overflow: visible;
            box-sizing: border-box;
        }

        .oc-search-input {
            display: flex;
            align-items: center;
            gap: 8px;
            border: none;
            border-radius: 9999px;
            padding: 10px 14px;
            background: #fff;
            box-shadow: 0 6px 16px rgba(0,0,0,.18);
            flex: 0 0 auto;
        }

            .oc-search-input:focus-within {
                box-shadow: 0 0 0 4px rgba(26,115,232,.10), 0 6px 16px rgba(0,0,0,.18);
            }

            .oc-search-input input {
                flex: 1;
                border: none;
                outline: none;
                font-size: 14px;
                padding: 4px 2px;
                background: transparent;
            }

            .oc-search-input button {
                border: none;
                background: transparent;
                color: #5f6368;
                padding: 0;
                cursor: pointer;
                width: auto;
                height: auto;
            }

                .oc-search-input button svg {
                    width: 22px;
                    height: 22px;
                    display: block;
                }

                .oc-search-input button:hover {
                    color: #1a73e8;
                }

                .oc-search-input button:disabled {
                    pointer-events: none;
                    color: #9e9e9e;
                    opacity: .5;
                }

        .oc-btn-clear {
            display: none;
        }

        .oc-search-list,
        .oc-search-empty,
        .oc-route-panel {
            flex: 1 1 auto;
            overflow-y: auto;
        }

        .oc-search-list {
            margin: 0;
            padding: 0;
            list-style: none;
            display: none;
            background: #fff;
            border: none;
            max-height: none;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
            scrollbar-color: rgba(0,0,0,.35) transparent;
        }

            .oc-search-list::-webkit-scrollbar {
                width: 8px;
            }

            .oc-search-list::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,.28);
                border-radius: 9999px;
            }

                .oc-search-list::-webkit-scrollbar-thumb:hover {
                    background: rgba(0,0,0,.40);
                }

            .oc-search-list::-webkit-scrollbar-track {
                background: transparent;
            }

        .oc-search-item {
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
        }

            .oc-search-item:hover, .oc-search-item.active {
                background: #f5f5f5;
            }

            .oc-search-item > div {
                flex: 1 1 auto;
                min-width: 0;
            }

        .oc-search-icon {
            width: 30px;
            height: 30px;
            flex: 0 0 30px;
            opacity: .9;
            display: block;
        }

        .oc-search-name {
            display: flex;
            align-items: baseline;
            gap: 6px;
            width: 100%;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .oc-search-name .oc-name {
                flex: 0 1 auto;
                min-width: 0;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .oc-search-ico {
            flex: 0 0 auto;
            white-space: nowrap;
            margin-left: 0;
            font-weight: 400;
            color: #757575;
            font-size: 13px;
            max-width: 45%;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .oc-search-name .oc-pill {
            margin-left: auto;
        }

        .oc-search-ico mark {
            background: transparent;
            color: #1a73e8;
            font-weight: 700;
        }

        .oc-search-sub {
            font-size: 12px;
            opacity: .8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        mark {
            background: transparent;
            color: #1a73e8;
            font-weight: 700;
        }

        .oc-search-empty {
            font-size: 12px;
            opacity: .7;
            padding: 8px 4px;
            display: none;
            background: #fff;
        }

        .oc-search-wrap.open {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(0,0,0,.16);
            padding: 8px;
        }

            .oc-search-wrap.open .oc-search-input {
                border-radius: 12px 12px 0 0;
                box-shadow: none;
                background: #fff;
            }

            .oc-search-wrap.open .oc-search-list {
                display: block;
                border-radius: 0 0 12px 12px;
                border-top: 1px solid #eee;
            }

            .oc-search-wrap.open .oc-search-empty {
                display: block;
                border-radius: 0 0 12px 12px;
                border-top: 1px solid #eee;
            }

        .oc-pill-vip {
            background: rgba(255,215,0,.14);
            color: #B8860B;
            border-color: rgba(184,134,11,.45);
        }

            .oc-pill-vip::before {
                content: '★';
                font-weight: 900;
            }

        .oc-pill-ver::before {
            content: '🛡︎';
            font-weight: 900;
        }

        .oc-pill.oc-seg-spy::before {
            content: none !important;
        }

        .marker-cluster.oc-pie-mode {
            background: transparent !important;
            border: none;
        }

            .marker-cluster.oc-pie-mode > div {
                box-shadow: none !important;
            }

            .marker-cluster.oc-pie-mode .oc-pie {
                background: transparent;
            }

        .oc-pie {
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 0 3px rgba(255,255,255,.85) inset, 0 1px 4px rgba(0,0,0,.30);
        }

            .oc-pie > span {
                border-radius: 50%;
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                color: #333;
            }

        .marker-cluster.oc-pie-mode,
        .marker-cluster.oc-pie-mode > div,
        .marker-cluster.oc-pie-mode .oc-pie,
        .marker-cluster.oc-pie-mode .oc-pie > span {
            border-radius: 50% !important;
        }

        .leaflet-control-oc-stats {
            background: transparent;
            border: none;
            box-shadow: none;
            padding: 0;
            z-index: 1000;
            margin: 0 !important;
        }

        .oc-stats-dock {
            display: flex;
            align-items: center;
            gap: 10px;
            background: transparent;
            border: 0;
            padding: 0px 8px;
            box-sizing: border-box;
            white-space: nowrap;
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            overflow-y: hidden;
            scrollbar-width: none;
            max-width: none;
            box-shadow: none;
            height: auto;
        }

            .oc-stats-dock::-webkit-scrollbar {
                display: none;
            }

        .leaflet-control-oc-stats .oc-pill {
            position: relative;
            font-size: 13px;
            padding: 4px 12px;
            border: 1px solid rgba(0,0,0,.06);
            background: #fff;
            box-shadow: 0 1px 1.5px rgba(0,0,0,.08);
            transition: transform .14s ease, box-shadow .18s ease, background .18s ease, filter .18s ease;
            cursor: pointer;
            transform: translateY(-2px);
            will-change: transform;
        }

            .leaflet-control-oc-stats .oc-pill.oc-pill-seg,
            .leaflet-control-oc-stats .oc-pill.oc-pill-vip,
            .leaflet-control-oc-stats .oc-pill.oc-pill-ver {
                background: #fff !important;
            }

                .leaflet-control-oc-stats .oc-pill.oc-pill-seg::before {
                    width: 8px;
                    height: 8px;
                }

            .leaflet-control-oc-stats .oc-pill b {
                margin-left: 8px;
                font-size: 13px;
                font-weight: 800;
            }

            .leaflet-control-oc-stats .oc-pill:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 16px rgba(0,0,0,.14);
            }

        .oc-pill .oc-chip-icon {
            width: 16px;
            height: 16px;
            margin-right: 6px;
            display: inline-block;
            visibility: hidden;
        }

        .oc-pill.oc-seg-spy .oc-chip-icon {
            visibility: visible;
        }

        .leaflet-control-oc-stats .oc-pill.active {
            transform: translateY(-3px);
            background: #fff;
            box-shadow: 0 8px 22px rgba(0,0,0,.16), 0 0 0 3px color-mix(in srgb, currentColor 10%, transparent);
            outline: none;
        }

            .leaflet-control-oc-stats .oc-pill.active::after {
                content: '';
                position: absolute;
                left: 10px;
                right: 10px;
                bottom: -4px;
                height: 4px;
                border-radius: 9999px;
                background: currentColor;
                opacity: .55;
                filter: blur(2px);
                pointer-events: none;
            }

        .leaflet-control-oc-stats .oc-pill:focus-visible {
            outline: none;
            box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 22%, transparent), 0 6px 16px rgba(0,0,0,.14);
        }

        .leaflet-control-oc-stats .oc-stats-dock {
            line-height: normal; /* tránh thừa line-height khiến nhìn như lệch */
        }

        /* Ẩn attribution/logo */
        .maplibregl-ctrl-logo,
        .maptilersdk-ctrl-logo,
        .maptiler-logo-control,
        .maplibregl-ctrl-attrib,
        .maptilersdk-ctrl-attrib,
        .leaflet-control-attribution,
        a[href*='maptiler'] {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
        }

        /* Nút Trasa */
        #ocRouteBtn {
            color: #623ED0;
        }

            #ocRouteBtn:hover, #ocRouteBtn:focus-visible {
                color: #1a73e8;
            }

            #ocRouteBtn:disabled {
                color: #bdbdbd;
            }

        /* Khi mở Route (icon X), dùng màu xám trung tính thay vì tím */
        .oc-search-wrap.route-mode #ocRouteBtn {
            color: #5f6368;
        }

            .oc-search-wrap.route-mode #ocRouteBtn:hover,
            .oc-search-wrap.route-mode #ocRouteBtn:focus-visible {
                color: #1a73e8; /* hover vẫn xanh như nút khác */
            }

        /* Panel Trasa */
        .oc-route-panel {
            margin: 0;
            padding: 10px 12px;
            background: #fff;
            border: none;
            display: none;
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-width: thin;
            scrollbar-color: rgba(0,0,0,.35) transparent;
            flex: 1 1 auto;
            box-sizing: border-box;
        }

            .oc-route-panel::-webkit-scrollbar {
                width: 8px;
            }

            .oc-route-panel::-webkit-scrollbar-thumb {
                background: rgba(0,0,0,.28);
                border-radius: 9999px;
            }

                .oc-route-panel::-webkit-scrollbar-thumb:hover {
                    background: rgba(0,0,0,.40);
                }

        .oc-search-wrap.route-mode .oc-route-panel {
            display: block;
            border-radius: 0 0 12px 12px;
            border-top: none;
        }

        /* Route fields */
        .oc-route-row {
            display: block;
            padding: 8px 0;
        }

        .oc-route-label {
            font-size: 12px;
            color: #616161;
            margin: 0 0 6px 2px;
            display: none !important;
        }

        .oc-route-input {
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 8px 12px;
            background: #fff;
            position: relative;
        }

        .oc-route-dd {
            position: absolute;
            left: 0;
            right: 0;
            top: 100%;
            margin-top: 6px;
            z-index: 1000;
            display: none;
        }

            .oc-route-dd.open {
                display: block;
            }

            .oc-route-dd > .oc-search-list {
                display: block;
                border: 1px solid #eee;
                border-radius: 10px;
                margin: 0;
                padding: 0;
            }

            .oc-route-dd > .oc-search-empty {
                display: none;
                border: 1px solid #eee;
                border-radius: 10px;
                margin-top: 0;
            }

            .oc-route-dd.empty > .oc-search-list {
                display: none;
            }

            .oc-route-dd.empty > .oc-search-empty {
                display: block;
            }

        .oc-route-input:focus-within {
            box-shadow: 0 0 0 4px rgba(26,115,232,.08);
            border-color: #e3e3e3;
        }

        .oc-route-input input {
            flex: 1;
            border: none;
            outline: none;
            font-size: 14px;
            padding: 4px 0;
            background: transparent;
        }

        .oc-route-suggestions {
            margin: 6px 0 0 0;
            padding: 0;
            list-style: none;
            display: none;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 10px;
        }

        .oc-route-empty {
            display: none;
            font-size: 12px;
            opacity: .7;
            padding: 8px 4px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 10px;
        }

        /* Route-mode: ẩn các control tìm kiếm, giữ nút Trasa/Close để thoát */
        .oc-search-wrap.route-mode .oc-search-input {
            display: none;
        }

        /* Không cho list/empty của search chính hiển thị nhầm trong route-mode */
        .oc-search-wrap.route-mode #ocSearchList {
            display: none !important;
        }

        .oc-search-wrap.route-mode #ocSearchEmpty {
            display: none !important;
        }
        /* Nút Trasa mini trong list gợi ý */
        .oc-suggest-route {
            flex: 0 0 auto;
            border: none;
            background: transparent;
            cursor: pointer;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            color: #623ED0;
        }

            .oc-suggest-route:hover {
                background: #f0f0ff;
            }

            .oc-suggest-route:active {
                transform: translateY(1px);
            }

            .oc-suggest-route svg {
                width: 22px;
                height: 22px;
                display: block;
            }


        /* Thanh chế độ di chuyển trên cùng khi mở Trasa */
        .oc-route-modes {
            display: none; /* mặc định ẩn */
            gap: 10px;
            padding: 6px 8px 8px 8px;
            align-items: center;
            flex-wrap: nowrap;
            flex: 0 0 auto;
        }

        .oc-search-wrap.route-mode .oc-route-modes {
            display: flex;
        }

        /* Nút mode (tròn, icon đen) */
        .oc-mode-btn {
            border: 0;
            background: transparent;
            cursor: pointer;
            width: 32px;
            height: 32px;
            border-radius: 9999px;
            display: grid;
            place-items: center;
            padding: 0;
            margin: 0;
            color: #222; /* icon màu đen */
        }

            .oc-mode-btn svg {
                width: 20px;
                height: 20px;
                display: block;
            }

            /* Trạng thái hover/focus */
            .oc-mode-btn:hover {
                background: rgba(26,115,232,.10);
            }

            .oc-mode-btn:focus-visible {
                outline: 2px solid rgba(26,115,232,.35);
            }

            /* Đang chọn (nền xanh nhạt giống ảnh) */
            .oc-mode-btn.active {
                background: #cfeef8; /* xanh nhạt */
            }

        /* Nút X đóng ở cuối thanh */
        #ocRouteModesClose {
            margin-left: auto; /* đẩy về tận cùng bên phải */
        }

        .oc-route-modes .oc-mode-close {
            margin-left: auto;
        }
        /* sát hơn: 8px thay vì 10px mặc định của Leaflet */
        .leaflet-top .leaflet-left .leaflet-control-oc-search {
            margin-top: 8px !important;
            margin-left: 8px !important;
        }
    </style>
</head>
<body>
    <div id='map'></div>

    <script src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'></script>
    <script src='https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js'></script>
    <script>
        /* ===== MAP ===== */
        const map = L.map('map', { doubleClickZoom: false, preferCanvas: true, zoomControl: false }).setView([49.8, 15.4], 7);
        map.attributionControl.setPrefix('');
        map.setMinZoom(1);
        map.setMaxZoom(20);

        /* OSM fallback */
        const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, subdomains: 'abc', attribution: '' });
        let usingFallback = false, zoomInBtn = null, zoomOutBtn = null;
        function updateZoomButtons() { if (!zoomInBtn || !zoomOutBtn) return; const z = map.getZoom(); zoomOutBtn.disabled = (z <= map.getMinZoom()); zoomInBtn.disabled = (z >= map.getMaxZoom()); }
        function switchToFallback(reason) {
            if (usingFallback) return;
            usingFallback = true;
            try { if (mtRaster && map.hasLayer(mtRaster)) map.removeLayer(mtRaster); } catch (_) { }
            if (!map.hasLayer(osmLayer)) osmLayer.addTo(map);
            map.setMaxZoom(18);
            if (map.getZoom() > 18) map.setZoom(18);
            updateZoomButtons();
            console.warn('Switched to OSM fallback due to:', reason);
        }

        /* MapTiler raster */
        const MAP_ID = '{MAP_ID}';
        const MAPTILER_KEY = '{MAPTILER_KEY}';
        let mtRaster = null;
        try {
            mtRaster = L.tileLayer(
                `https://api.maptiler.com/maps/{MAP_ID}/256/{z}/{x}/{y}.png?key={MAPTILER_KEY}`,
                { maxZoom: 20, tileSize: 256, zoomOffset: 0, crossOrigin: true, detectRetina: false, attribution: '' }
            ).addTo(map);
            mtRaster.on('tileerror', () => switchToFallback('raster-tileerror'));
            let watchdog = setTimeout(() => { if (!usingFallback) switchToFallback('raster-timeout'); }, 4000);
            mtRaster.on('tileload', () => { if (watchdog) { clearTimeout(watchdog); watchdog = null; } });
        } catch (e) { console.warn('MapTiler raster init failed:', e); switchToFallback('raster-exception'); }

        map.on('dblclick', e => { const next = Math.min(map.getZoom() + 2, map.getMaxZoom()); map.setView(e.latlng, next, { animate: true }); });

        // Utils
        function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn.apply(null, a), ms); }; }
        const reflow = debounce(() => requestAnimationFrame(repositionStats), 80);
        const updateStatsDeb = debounce(updateStats, 40);

        /* ===== CLUSTERS / ICONS / SEGMENTS ===== */
        const clusters = L.markerClusterGroup({
            chunkedLoading: true, chunkInterval: 50, chunkDelay: 25,
            removeOutsideVisibleBounds: true, animateAddingMarkers: false,
            maxClusterRadius: 60, disableClusteringAtZoom: 15,
            spiderfyOnMaxZoom: true, showCoverageOnHover: false,
            polygonOptions: { color: '#7FECEE', weight: 2, opacity: .9, fillColor: '#7FECEE', fillOpacity: .18 },
            iconCreateFunction: makeClusterIcon
        });
        map.addLayer(clusters);

        const MDI_PIN_D =
            "M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z";
        const MDI_SHADOW_D =
            "M20,19C20,21.21 16.42,23 12,23C7.58,23 4,21.21 4,19C4,17.71 5.22,16.56 7.11,15.83L7.75,16.74C6.67,17.19 6,17.81 6,18.5C6,19.88 8.69,21 12,21C15.31,21 18,19.88 18,18.5C18,17.81 17.33,17.19 16.25,16.74L16.89,15.83C18.78,16.56 20,17.71 20,19Z";

        const PIN_W = 38;
        const PIN_H = 56;
        const PIN_ICON_SIZE = [PIN_W, PIN_H];
        const PIN_ICON_ANCHOR = [Math.round(PIN_W / 2), PIN_H];
        const PIN_POPUP_ANCHOR = [0, -Math.round(PIN_H * 0.8)];
        const __iconCache = new Map();

        function getIconCached(fill, stroke, opts) {
            const key = `${fill}|${stroke}|${opts.ring ? 'R' : ''}${opts.star ? 'S' : ''}`;
            let ico = __iconCache.get(key);
            if (!ico) {
                ico = L.icon({
                    iconUrl: buildPinSvg(fill, stroke, opts),
                    iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR
                });
                __iconCache.set(key, ico);
            }
            return ico;
        }

        function materialPin(fill, stroke) {
            const svg = `
                          <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                            <defs>
                              <filter id='mdShadow' x='-50%' y='-50%' width='200%' height='200%'>
                                <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                <feOffset dx='0' dy='1' result='off'/>
                                <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                              </filter>
                            </defs>
                            <path filter='url(#mdShadow)'
                                  d='M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7z'
                                  fill='${fill}' stroke='${stroke}' stroke-width='1.25'/>
                            <circle cx='12' cy='9' r='3' fill='white' fill-opacity='0.9'/>
                          </svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }
        function materialPinRadius(fill, stroke) {
            const svg = `
                          <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                            <defs>
                              <filter id='mdShadow2' x='-50%' y='-50%' width='200%' height='200%'>
                                <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                <feOffset dx='0' dy='1' result='off'/>
                                <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                              </filter>
                            </defs>

                            <g shape-rendering='geometricPrecision'>
                              <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='${fill}'  fill-opacity='0.42'/>
                              <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='none'     stroke='${stroke}'
                                       stroke-opacity='0.95' stroke-width='0.6'/>
                              <ellipse cx='12' cy='20.8' rx='5.8' ry='1.9'  fill='#fff' fill-opacity='0.10'/>
                            </g>

                            <path d='M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z'
                                  fill='${fill}' stroke='${stroke}' stroke-width='1.25' filter='url(#mdShadow2)'/>
                            <circle cx='12' cy='8' r='2' fill='white' fill-opacity='0.9'/>
                          </svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }
        function materialPinStar(fill, stroke) {
            const svg = `
                          <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                            <defs>
                              <filter id='mdShadow3' x='-50%' y='-50%' width='200%' height='200%'>
                                <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                <feOffset dx='0' dy='1' result='off'/>
                                <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                              </filter>
                            </defs>
                            <path filter='url(#mdShadow3)'
                                  d='M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7z'
                                  fill='${fill}' stroke='${stroke}' stroke-width='1.25'/>
                            <path d="M14.5 13L12 11.5L9.5 13L10.2 10.2L8 8.3L10.9 8.1L12 5.4L13.1 8L16 8.3L13.8 10.2L14.5 13Z"
                              fill="#FFFFFF" stroke="${stroke}" stroke-opacity=".9" stroke-width=".7" stroke-linejoin="round" shape-rendering="geometricPrecision"/>
                          </svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }
        function materialPinRadiusStar(fill, stroke) {
            const svg = `
                          <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                            <defs>
                              <filter id='mdShadow4' x='-50%' y='-50%' width='200%' height='200%'>
                                <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                <feOffset dx='0' dy='1' result='off'/>
                                <feComponentTransfer><feFuncA type='linear' slope='0.35'/>
                                </feComponentTransfer>
                                <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                              </filter>
                            </defs>

                            <g shape-rendering='geometricPrecision'>
                              <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='${fill}'  fill-opacity='0.42'/>
                              <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='none'     stroke='${stroke}'
                                       stroke-opacity='0.95' stroke-width='0.6'/>
                              <ellipse cx='12' cy='20.8' rx='5.8' ry='1.9'  fill='#fff' fill-opacity='0.10'/>
                            </g>

                            <path d='M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z'
                                  fill='${fill}' stroke='${stroke}' stroke-width='1.25' filter='url(#mdShadow4)'/>
                            <path d="M14.5 13L12 11.5L9.5 13L10.2 10.2L8 8.3L10.9 8.1L12 5.4L13.1 8L16 8.3L13.8 10.2L14.5 13Z"
                              fill="#FFFFFF" stroke="${stroke}" stroke-opacity=".9" stroke-width=".7" stroke-linejoin="round" shape-rendering="geometricPrecision"/>
                          </svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }

        function buildPinSvg(fill, stroke, { ring = false, star = false } = {}) {
            const ringSvg = ring ? `
                          <g shape-rendering='geometricPrecision'>
                            <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='${fill}' fill-opacity='0.42'/>
                            <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='none' stroke='${stroke}'
                                     stroke-opacity='0.95' stroke-width='0.6'/>
                            <ellipse cx='12' cy='20.8' rx='5.8' ry='1.9'  fill='#fff' fill-opacity='0.10'/>
                          </g>` : ``;

            const starSvg = star ? `
                          <path d="M14.5 13L12 11.5L9.5 13L10.2 10.2L8 8.3L10.9 8.1L12 5.4L13.1 8L16 8.3L13.8 10.2L14.5 13Z"
                              fill="#FFFFFF"
                              stroke="${stroke}" stroke-opacity=".9" stroke-width=".7"
                              stroke-linejoin="round" shape-rendering="geometricPrecision"/>` : ``;

            const centerDot = !star ? `<circle cx='12' cy='8' r='2' fill='white' fill-opacity='0.9'/>` : ``;

            const svg = `
                          <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                            <defs>
                              <filter id='mdShadowDyn' x='-50%' y='-50%' width='200%' height='200%'>
                                <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                <feOffset dx='0' dy='1' result='off'/>
                                <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                              </filter>
                            </defs>
                            ${ringSvg}
                            <path d='M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z'
                                  fill='${fill}' stroke='${stroke}' stroke-width='1.25' filter='url(#mdShadowDyn)'/>
                            ${centerDot}
                            ${starSvg}
                          </svg>`;
            return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
        }
        function iconFromColor(fill, stroke, { ring = false, star = false } = {}) {
            return L.icon({ iconUrl: buildPinSvg(fill, stroke, { ring, star }), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
        }

        const defaultIcon = L.icon({ iconUrl: materialPin('#5E35B1', '#311B92'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
        const selectedIcon = L.icon({ iconUrl: materialPin('#E53935', '#B71C1C'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
        const verifiedIcon = L.icon({ iconUrl: materialPinRadius('#C0CA33', '#9E9D24'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
        const vipIcon = L.icon({ iconUrl: materialPinStar('#FFC107', '#FF8F00'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
        const vipVerifiedIcon = L.icon({ iconUrl: materialPinRadiusStar('#C0CA33', '#9E9D24'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });

        function esc(s) { return String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])); }
        function truthyFlag(v) { if (typeof v === 'string') { const s = v.trim().toLowerCase(); return s === '1' || s === 'true' || s === 'yes' || s === 'y'; } return v === 1 || v === true; }
        function isVIPFlag(p) { const v = p?.VIP ?? p?.vip ?? p?.Vip ?? p?.IsVIP ?? p?.isVip ?? p?.isVIP; return truthyFlag(v); }
        function isVerifiedFlag(p) { const v = p?.IsVerified ?? p?.Verified ?? p?.ver ?? p?.verified; return truthyFlag(v); }

        function getSegmentRaw(p) { return (p?.Segment ?? p?.segment ?? p?.seg ?? '').toString().trim(); }
        const SEG_META = {
            'New': { cls: 'oc-seg-new', label: 'Nový', fill: '#00ACC1', stroke: '#00838F' },
            'Reactivated': { cls: 'oc-seg-reactivated', label: 'Znovu aktivní', fill: '#43A047', stroke: '#2E7D32' },
            'Regular': { cls: 'oc-seg-regular', label: 'Pravidelný', fill: '#1E88E5', stroke: '#1565C0' },
            'Occasional': { cls: 'oc-seg-occasional', label: 'Příležitostný', fill: '#8E24AA', stroke: '#6A1B9A' },
            'Risk': { cls: 'oc-seg-risk', label: 'Riziko', fill: '#FB8C00', stroke: '#EF6C00' },
            'Lost': { cls: 'oc-seg-lost', label: 'Ztracený', fill: '#9E9E9E', stroke: '#616161' },
            'Spy': { cls: 'oc-seg-spy', label: 'Bez nákupu', fill: '#6D4C41', stroke: '#4E342E' }
        };
        const SEG_HINTS_CS = {
            New: 'První nákup v posledních 30 dnech.',
            Reactivated: 'Po pauze delší než 60 dní znovu nakoupil v posledních 30 dnech.',
            Regular: 'Poslední nákup do 60 dní a alespoň dva doklady za posledních 90 dní.',
            Occasional: 'Poslední nákup do 60 dní, ale méně než dva doklady za posledních 90 dní.',
            Risk: 'Bez nákupu déle než 60 dní.',
            Lost: 'Bez nákupu déle než 180 dní nebo bez historie nákupů.',
            VIP: 'Obrat za posledních 12 měsíců přesahuje 200 000 Kč.',
            Verified: 'Adresa je v systému označená jako ověřená.',
            Spy: 'Zatím nemá žádné doklady nákupu.'
        };
        const SPY_SVG = `
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="oc-chip-icon">
                        <path d="M17.06 13C15.2 13 13.64 14.33 13.24 16.1C12.29 15.69 11.42 15.8 10.76 16.09C10.35 14.31 8.79 13 6.94 13C4.77 13 3 14.79 3 17C3 19.21 4.77 21 6.94 21C9 21 10.68 19.38 10.84 17.32C11.18 17.08 12.07 16.63 13.16 17.34C13.34 19.39 15 21 17.06 21C19.23 21 21 19.21 21 17C21 14.79 19.23 13 17.06 13M6.94 19.86C5.38 19.86 4.13 18.58 4.13 17S5.39 14.14 6.94 14.14C8.5 14.14 9.75 15.42 9.75 17S8.5 19.86 6.94 19.86M17.06 19.86C15.5 19.86 14.25 18.58 14.25 17S15.5 14.14 17.06 14.14C18.62 14.14 19.88 15.42 19.88 17S18.61 19.86 17.06 19.86M22 10.5H2V12H22V10.5M15.53 2.63C15.31 2.14 14.75 1.88 14.22 2.05L12 2.79L9.77 2.05L9.72 2.04C9.19 1.89 8.63 2.17 8.43 2.68L6 9H18L15.56 2.68L15.53 2.63Z"/>
                      </svg>`;

        const SEG_ORDER = ['New', 'Reactivated', 'Regular', 'Occasional', 'Risk', 'Lost', 'Spy'];
        const SEG_COLORS = Object.fromEntries(SEG_ORDER.map(k => [k, SEG_META[k].fill]));
        const __clusterHtmlCache = new Map();

        function makeClusterIcon(cluster) {
            const markers = cluster.getAllChildMarkers();
            const counts = Object.fromEntries(SEG_ORDER.map(k => [k, 0]));
            for (const m of markers) { const key = (m.__segKey && counts.hasOwnProperty(m.__segKey)) ? m.__segKey : 'Occasional'; counts[key] += 1; }
            const total = markers.length || 1;
            const sizeBucket = total < 10 ? 'S' : (total < 100 ? 'M' : 'L');
            const signature = sizeBucket + '|' + SEG_ORDER.map(k => counts[k]).join(',');

            let cached = __clusterHtmlCache.get(signature);
            if (!cached) {
                let acc = 0; const parts = [];
                for (const k of SEG_ORDER) {
                    const pct = counts[k] * 100 / total;
                    if (pct > 0) { parts.push(`${SEG_COLORS[k]} ${acc}% ${acc + pct}%`); acc += pct; }
                }
                const bg = parts.length ? `conic-gradient(${parts.join(',')})` : '#9E9E9E';
                const size = sizeBucket === 'S' ? 36 : (sizeBucket === 'M' ? 44 : 52);
                const inner = Math.max(24, size - 12);
                const fz = Math.round(inner / 2.6);
                const html = `<div class='oc-pie' style='width:${size}px;height:${size}px;background-image:${bg}'><span style='width:${inner}px;height:${inner}px;font-size:${fz}px'>${total}</span></div>`;
                cached = { html, size }; __clusterHtmlCache.set(signature, cached);
            }
            return L.divIcon({ html: cached.html, className: 'marker-cluster oc-pie-mode', iconSize: L.point(cached.size, cached.size) });
        }
        function getSegmentMeta(p) { const key = getSegmentRaw(p); return SEG_META[key] || null; }

        function popupHtml(p) {
            const name = esc(p.name), ico = esc(p.ico), addr = esc(p.addr);
            const v = isVerifiedFlag(p);
            const vip = isVIPFlag(p);
            const seg = getSegmentMeta(p);
            const segKey = getSegmentRaw(p);
            const segTip = SEG_HINTS_CS[segKey] || (seg?.label || '');
            const segIcon = (segKey === 'Spy') ? SPY_SVG : '';
            return `<div class='popup'>
                          <div class='popup-title'>
                            <span class='oc-title-name'>${name}</span>
                            ${vip ? `<span class='oc-pill oc-pill-vip' title='${SEG_HINTS_CS.VIP}'>VIP</span>` : ``}
                            ${seg ? `<span class='oc-pill oc-pill-seg ${seg.cls}' title='${segTip}'>${segIcon}${seg.label}</span>` : ``}
                            ${v ? `<span class='oc-pill oc-pill-ver' title='${SEG_HINTS_CS.Verified}'>Ověřená</span>` : ``}
                          </div>
                          ${ico ? `<div class='popup-line'>IČO: <b>${ico}</b></div>` : ''}
                          ${addr ? `<div class='popup-line'>${addr}</div>` : ''}
                        </div>`;
        }

        const markerIndex = new Map();
        const ALL = [];
        let ACTIVE = [];
        let statsEl = null;
        let selectedMarker = null;
        let wantSelectedPopup = false;
        let _ensureTimer = null;
        let _lastZoom = map.getZoom();

        function computeCounts(list) {
            const c = { total: 0, New: 0, Reactivated: 0, Regular: 0, Occasional: 0, Risk: 0, Lost: 0, Spy: 0, vip: 0, verified: 0 };
            for (const m of list) { c.total++; const seg = (m.__segKey && c.hasOwnProperty(m.__segKey)) ? m.__segKey : 'Occasional'; c[seg]++; if (m.__isVIP) c.vip++; if (m.__isVerified) c.verified++; }
            return c;
        }
        function chip(label, n, cls, key) {
            const title = (key === 'vip') ? SEG_HINTS_CS.VIP : (SEG_HINTS_CS[key] || label);
            const icon = (key === 'Spy') ? SPY_SVG : '';
            return `<span class='oc-pill ${cls}' data-key='${key}' role='button' tabindex='0' title='${title}'>
                                  ${icon}<span>${label}</span><b>${n}</b>
                                </span>`;
        }

        let ACTIVE_FILTER_KEY = null;
        let SUGGEST_MODE = 'search';

        // Chặn render gợi ý ngay sau khi reset (debounce epoch)
        let __suppressSuggestUntil = 0;
        function suppressSuggest(ms = 220) {
            __suppressSuggestUntil = performance.now() + ms;
        }

        // ===== Committed state & icon orchestrator =====
        let SEARCH_COMMITTED = false; // đã "chốt" tìm kiếm hay chưa

        function updatePrimaryIcons() {
            const wrap = window.__ocSearch; if (!wrap) return;
            const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
            const btnRoute = wrap.querySelector('#ocRouteBtn');
            const btnClear = wrap.querySelector('#ocSearchClear');

            const inRoute = wrapBox.classList.contains('route-mode');

            if (inRoute) {
                if (btnRoute) btnRoute.style.display = 'none';  // <-- ẩn hẳn
                if (btnClear) btnClear.style.display = 'none';
                return;
            }

            if (btnRoute) btnRoute.style.display = SEARCH_COMMITTED ? 'none' : 'inline-flex';
            if (btnClear) btnClear.style.display = SEARCH_COMMITTED ? 'inline-flex' : 'none';
        }

        function setCommittedSearchState(on) {
            SEARCH_COMMITTED = !!on;
            updatePrimaryIcons();
            requestAnimationFrame(() => { recalcListMaxHeight(); repositionStats(); });
        }

        // Reset toàn bộ về trạng thái ban đầu
        function resetSearchUI() {
            try {
                // ✅ Trả state về mặc định trước, không phụ thuộc UI
                ACTIVE_FILTER_KEY = null;
                refreshChipActive?.();
                setActiveMarkers?.(ALL);
                setSelected?.(null);
                SUGGEST_MODE = 'search';
                setCommittedSearchState?.(false);

                setChipMode?.(false);

                // Phần UI phía dưới có thể bỏ qua nếu wrap chưa sẵn sàng
                const wrap = window.__ocSearch; if (!wrap) return;

                const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
                const input = wrap.querySelector('#ocSearchBox');
                const listEl = wrap.querySelector('#ocSearchList');
                const emptyEl = wrap.querySelector('#ocSearchEmpty');
                const route = wrap.querySelector('#ocRoutePanel');

                if (input) {
                    input.value = '';
                    updateGoState?.();
                    input.removeAttribute('aria-activedescendant');
                }

                // đóng UI phụ
                if (listEl) listEl.style.display = 'none';
                if (emptyEl) emptyEl.style.display = 'none';
                if (route && !wrapBox.classList.contains('route-mode')) route.style.display = 'none';
                wrapBox.classList.remove('open');

                // local biến gợi ý (nếu có)
                try { matches = []; activeIdx = -1; } catch (_) { }
                updatePrimaryIcons?.();
            } catch (_) { }
        }

        // Đóng route nếu đang mở, sau đó reset
        function closeRouteAndReset() {
            try { window.__ocSearch?.__closeRoutePanel?.(); } catch (_) { }
            resetSearchUI();
        }

        function refreshChipActive() {
            if (!statsEl) return;
            statsEl.querySelectorAll('.oc-pill[data-key]').forEach(el => { el.classList.toggle('active', el.dataset.key === ACTIVE_FILTER_KEY); });
        }
        function applySegmentFilter(key) {
            const wrap = window.__ocSearch;
            const wrapBox = wrap?.querySelector?.('#ocSearchWrap') || wrap;

            // Nếu đang mở Route → đóng và reset trước
            if (wrapBox?.classList?.contains('route-mode')) {
                try { wrap.__closeRoutePanel?.(); } catch (_) { }
                resetSearchUI();
            }

            const prev = ACTIVE_FILTER_KEY;
            const turningOff = !!prev && (!key || key === prev);

            if (turningOff) {
                // ✅ Tắt chip: xóa khóa lọc + trả dữ liệu về ALL ngay lập tức
                ACTIVE_FILTER_KEY = null;
                refreshChipActive?.();
                setActiveMarkers?.(ALL);       // ← nạp lại toàn bộ marker
                setSelected?.(null);

                // Trạng thái nút/commit
                setCommittedSearchState?.(false);
                try {
                    const btnClr = wrap?.querySelector?.('#ocSearchClear');
                    const btnRt = wrap?.querySelector?.('#ocRouteBtn');
                    if (btnClr) btnClr.style.display = 'none';
                    if (btnRt) btnRt.style.display = 'inline-flex';
                } catch (_) { }

                // Dọn UI đề phòng
                try {
                    const listEl = wrap?.querySelector?.('#ocSearchList');
                    const emptyEl = wrap?.querySelector?.('#ocSearchEmpty');
                    const route = wrap?.querySelector?.('#ocRoutePanel');
                    const input = wrap?.querySelector?.('#ocSearchBox');
                    wrap?.classList?.remove('open');
                    if (listEl) listEl.style.display = 'none';
                    if (emptyEl) emptyEl.style.display = 'none';
                    if (route && !wrapBox?.classList?.contains('route-mode')) route.style.display = 'none';
                    if (input) {
                        input.value = '';
                        input.removeAttribute('aria-activedescendant');
                    }
                } catch (_) { }

                updateStatsDeb?.();
                requestAnimationFrame(() => { recalcListMaxHeight?.(); repositionStats?.(); });
                return;
            }

            // Bật chip
            ACTIVE_FILTER_KEY = key || null;
            refreshChipActive();

            let list = ALL;
            if (ACTIVE_FILTER_KEY) {
                list = (ACTIVE_FILTER_KEY === 'vip')
                    ? ALL.filter(m => m.__isVIP)
                    : ALL.filter(m => m.__segKey === ACTIVE_FILTER_KEY);
            }
            setActiveMarkers(list);

            try {
                const input = wrap.querySelector('#ocSearchBox');
                const listEl = wrap.querySelector('#ocSearchList');

                const label = (ACTIVE_FILTER_KEY === 'vip')
                    ? 'VIP'
                    : (SEG_META[ACTIVE_FILTER_KEY]?.label || '');
                if (input) input.value = label;

                // chốt + mở gợi ý theo chip (unlimited)
                SUGGEST_MODE = 'chip';
                setCommittedSearchState(true);   // Clear hiện, Trasa ẩn
                updatePrimaryIcons();
                wrap.__openChipSuggestions?.();

                if (listEl) listEl.style.display = 'block';
                requestAnimationFrame(() => { recalcListMaxHeight(); repositionStats(); });
            } catch (_) { }
        }
        function wireStatsChips() {
            if (!statsEl) return;
            statsEl.querySelectorAll('.oc-pill[data-key]').forEach(el => {
                const key = el.dataset.key;
                const toggle = () => applySegmentFilter(ACTIVE_FILTER_KEY === key ? null : key);
                el.addEventListener('click', toggle);
                el.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); toggle(); } });
            });
            refreshChipActive();
        }
        function updateStats() {
            if (!statsEl) return;
            const base = ACTIVE_FILTER_KEY ? ALL : (ACTIVE.length ? ACTIVE : ALL);
            const c = computeCounts(base);
            statsEl.innerHTML =
                chip('Nový', c.New, 'oc-pill-seg oc-seg-new', 'New') +
                chip('Znovu aktivní', c.Reactivated, 'oc-pill-seg oc-seg-reactivated', 'Reactivated') +
                chip('Pravidelný', c.Regular, 'oc-pill-seg oc-seg-regular', 'Regular') +
                chip('Příležitostný', c.Occasional, 'oc-pill-seg oc-seg-occasional', 'Occasional') +
                chip('Riziko', c.Risk, 'oc-pill-seg oc-seg-risk', 'Risk') +
                chip('Ztracený', c.Lost, 'oc-pill-seg oc-seg-lost', 'Lost') +
                chip('Bez nákupu', c.Spy, 'oc-pill-seg oc-seg-spy', 'Spy') +
                chip('VIP', c.vip, 'oc-pill-vip', 'vip');
            wireStatsChips();
            refreshChipActive();
            requestAnimationFrame(repositionStats);
        }
        function setActiveMarkers(list) {
            ACTIVE = list.slice();
            clusters.clearLayers();
            clusters.addLayers(ACTIVE);
            updateStatsDeb();
            scheduleEnsureSelectedPopup(60);
            ensureSelectedPopup();
        }

        function widthNeedForDock(dock) {
            const cs = getComputedStyle(dock);
            const pl = parseFloat(cs.paddingLeft) || 0, pr = parseFloat(cs.paddingRight) || 0;
            const bl = parseFloat(cs.borderLeftWidth) || 0, br = parseFloat(cs.borderRightWidth) || 0;
            const first = dock.firstElementChild, last = dock.lastElementChild;
            if (first && last) {
                const rf = first.getBoundingClientRect(), rl = last.getBoundingClientRect();
                const content = Math.ceil(rl.right - rf.left);
                return content + pl + pr + bl + br;
            }
            return Math.ceil((dock.scrollWidth || 1) + bl + br);
        }
        function repositionStats() {
            if (!statsEl) return;

            const dock = statsEl;
            const box = dock.parentElement;
            const mapEl = map.getContainer();
            const search = document.querySelector('.leaflet-control-oc-search');
            if (!box || !mapEl || !search) return;

            const GAP = 8;
            const CORNER = 8;
            const mRect = mapEl.getBoundingClientRect();

            const wrapEl = search.querySelector('#ocSearchWrap') || search;
            const inRoute = wrapEl.classList.contains('route-mode');

            // ✅ 1) Phần tử dùng để LẤY TOP: khung ngoài, KHÔNG đổi khi mở/đóng
            const topAnchorRect = search.getBoundingClientRect();

            // ✅ 2) Phần tử dùng để LẤY CHIỀU CAO dock
            const heightEl =
                (inRoute && search.querySelector('.oc-route-modes')) ||
                search.querySelector('.oc-search-input') ||
                search;
            const hRect = heightEl.getBoundingClientRect();

            // Chiều cao dock khớp ô
            const anchorH = Math.max(40, Math.round(hRect.height || 0));
            dock.style.height = anchorH + 'px';
            dock.style.display = 'flex';
            dock.style.alignItems = 'center';

            // Rộng bên phải ô tìm kiếm
            const needWidth = widthNeedForDock(dock);
            const availRight = Math.max(0, Math.floor(mRect.right - (hRect.right + GAP) - CORNER));
            const w = Math.min(needWidth, availRight);
            dock.style.width = (w > 1 ? w : 0) + 'px';
            dock.style.maxWidth = (w > 1 ? w : 0) + 'px';
            dock.style.overflowX = (w > 1 && w < needWidth) ? 'auto' : 'hidden';

            // Cố định box theo TOP của khung ngoài → hết “nhảy”
            box.style.position = 'absolute';
            box.style.left = '';
            box.style.right = CORNER + 'px';

            const boxH = (box.getBoundingClientRect().height || dock.getBoundingClientRect().height || 0);
            const topFixed = Math.round(topAnchorRect.top - mRect.top); // neo theo khung ngoài
            const topPx = Math.max(CORNER, Math.min(topFixed, mRect.height - CORNER - boxH));
            box.style.top = topPx + 'px';
        }

        const StatsControl = L.Control.extend({
            options: { position: 'topright' },
            onAdd: function () {
                const box = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-stats');
                box.innerHTML = `<div class="oc-stats-dock"></div>`;
                statsEl = box.querySelector('.oc-stats-dock');

                statsEl.addEventListener('wheel', (ev) => { if (ev.deltaY !== 0) { ev.preventDefault(); statsEl.scrollLeft += ev.deltaY; } }, { passive: false });
                L.DomEvent.disableClickPropagation(box);
                L.DomEvent.disableScrollPropagation(box);

                setTimeout(() => { updateStats(); repositionStats(); }, 0);
                return box;
            }
        });

        function setSelected(m) {
            if (selectedMarker && selectedMarker !== m) {
                selectedMarker.setIcon(selectedMarker.__iconNormal || (selectedMarker.__isVerified ? verifiedIcon : defaultIcon));
                selectedMarker.setZIndexOffset(0);
                try { selectedMarker.closePopup(); } catch (_) { }
            }
            selectedMarker = m || null;
            wantSelectedPopup = !!m;
            if (m) {
                setLocateActive(false);
                m.setIcon(selectedIcon);
                m.setZIndexOffset(1000);
                m.openPopup();
            }
        }
        function ensureSelectedPopupCore() {
            if (!selectedMarker || !wantSelectedPopup) return;
            const parent = clusters.getVisibleParent(selectedMarker);
            if (!(parent && parent === selectedMarker)) return;
            const pop = selectedMarker.getPopup && selectedMarker.getPopup();
            const isOpen = pop && (pop.isOpen ? pop.isOpen() : (map.hasLayer ? map.hasLayer(pop) : false));
            if (isOpen) return;
            let prevAuto = true;
            if (pop && pop.options) { prevAuto = !!pop.options.autoPan; pop.options.autoPan = false; }
            try { selectedMarker.setZIndexOffset(1000); selectedMarker.openPopup(); }
            finally { if (pop && pop.options) pop.options.autoPan = prevAuto; }
        }
        function scheduleEnsureSelectedPopup(delay = 80) {
            if (_ensureTimer) return;
            _ensureTimer = setTimeout(() => { _ensureTimer = null; ensureSelectedPopupCore(); }, delay);
        }
        function ensureSelectedPopup() {
            if (!selectedMarker || !wantSelectedPopup) return;
            const parent = clusters.getVisibleParent(selectedMarker);
            if (parent && parent === selectedMarker) {
                try { selectedMarker.setZIndexOffset(1000); selectedMarker.openPopup(); } catch (_) { }
            }
        }

        function wireClick(m, p) {
            m.on('click', () => {
                setSelected(m);
                try {
                    const wrap = window.__ocSearch;
                    if (wrap) {
                        const input = wrap.querySelector('#ocSearchBox');
                        const goBtn = wrap.querySelector('#ocSearchGo');
                        const clrBtn = wrap.querySelector('#ocSearchClear');
                        const list = wrap.querySelector('#ocSearchList');
                        const empty = wrap.querySelector('#ocSearchEmpty');
                        const route = wrap.querySelector('#ocRoutePanel');

                        wrap.classList.remove('open');
                        if (list) list.style.display = 'none';
                        if (empty) empty.style.display = 'none';
                        if (route) route.style.display = 'none';

                        if (input) {
                            input.value = p.name || '';
                            if (goBtn) goBtn.disabled = input.value.trim().length === 0;
                            if (clrBtn) clrBtn.style.display = input.value.trim().length > 0 ? 'inline-flex' : 'none';
                            input.blur();
                        }
                    }
                } catch (_) { }
                const payload = { type: 'markerClick', id: p.id, name: p.name, lat: p.lat, lon: p.lon, ico: p.ico, addr: p.addr, verified: isVerifiedFlag(p), vip: isVIPFlag(p), segment: getSegmentRaw(p) || null };
                if (window.chrome && window.chrome.webview) { window.chrome.webview.postMessage(JSON.stringify(payload)); }
            });
        }
        function normBase(s) { return (s ?? '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }

        function upsertMarkerFromPoint(p) {
            if (!isFinite(p.lat) || !isFinite(p.lon)) return null;
            const id = String(p.id);
            const existing = markerIndex.get(id);
            const isVerified = isVerifiedFlag(p);
            const isVip = isVIPFlag(p);
            const segMeta = getSegmentMeta(p);

            let fill = '#5E35B1', stroke = '#311B92';
            if (segMeta?.fill && segMeta?.stroke) { fill = segMeta.fill; stroke = segMeta.stroke; }
            const icon = getIconCached(fill, stroke, { ring: isVerified, star: isVip });

            if (existing) {
                existing.__p = p;
                existing.__isVerified = isVerified;
                existing.__isVIP = isVip;
                existing.__segKey = getSegmentRaw(p) || 'Occasional';
                existing.__iconNormal = icon;
                if (existing !== selectedMarker) existing.setIcon(icon);
                existing.setLatLng([p.lat, p.lon]);
                const newHtml = popupHtml(p);
                const pop = existing.getPopup && existing.getPopup();
                if (!pop || pop.getContent() !== newHtml) { existing.setPopupContent(newHtml); }
                const nName = normBase(p.name), nIco = normBase(p.ico), nAddr = normBase(p.addr);
                existing.__hay = [nName, nIco, nAddr].join('|');
                existing.__nName = nName; existing.__nIco = nIco; existing.__nAddr = nAddr;
                return null;
            }

            const m = L.marker([p.lat, p.lon], { title: p.name, icon });
            m.__isVerified = isVerified; m.__isVIP = isVip; m.__iconNormal = icon; m.__p = p;
            m.__segKey = getSegmentRaw(p) || 'Occasional';
            const nName = normBase(p.name), nIco = normBase(p.ico), nAddr = normBase(p.addr);
            m.__hay = [nName, nIco, nAddr].join('|'); m.__nName = nName; m.__nIco = nIco; m.__nAddr = nAddr;
            m.bindPopup(popupHtml(p), { className: 'oc-popup', maxWidth: 1200, autoPan: true, keepInView: false, autoPanPadding: [24, 24], closeButton: false });
            wireClick(m, p);
            markerIndex.set(id, m);
            ALL.push(m);
            return m;
        }
        function addMarkers(points) { const layers = []; for (const p of points) { const m = upsertMarkerFromPoint(p); if (m) layers.push(m); } if (layers.length) clusters.addLayers(layers); return layers.length; }
        function waitIdle() { return new Promise(r => (window.requestIdleCallback ? requestIdleCallback(() => r()) : setTimeout(r, 0))); }
        async function addMarkersChunked(points) {
            let i = 0;
            while (i < points.length) {
                const start = performance.now();
                const layers = [];
                while (i < points.length && (performance.now() - start) < 12) {
                    const m = upsertMarkerFromPoint(points[i++]);
                    if (m) layers.push(m);
                }
                if (layers.length) clusters.addLayers(layers);
                await waitIdle();
            }
        }
        function fitBoundsFrom(points) {
            const latlngs = []; for (const p of points) { if (isFinite(p.lat) && isFinite(p.lon)) latlngs.push([p.lat, p.lon]); }
            if (latlngs.length) map.fitBounds(latlngs, { padding: [20, 20] });
        }
        let firstFullDone = false; let pendingSelectOnce = null;
        function selectById(id, zoom, lat, lon, name) {
            const key = String(id);
            let m = markerIndex.get(key);
            if (!m && isFinite(lat) && isFinite(lon)) {
                const p = { id, name, lat, lon, ico: '', addr: '' };
                m = L.marker([lat, lon], { title: name || '', icon: defaultIcon });
                m.__iconNormal = defaultIcon; m.__isVerified = false; m.__p = p; m.__segKey = 'Occasional';
                m.__hay = normBase(name); m.__nName = normBase(name); m.__nIco = '';
                m.bindPopup(popupHtml(p), { className: 'oc-popup', maxWidth: 1200, autoPan: true, keepInView: false, autoPanPadding: [24, 24], closeButton: false });
                wireClick(m, p);
                markerIndex.set(key, m); ALL.push(m); clusters.addLayer(m);
            }
            if (m) {
                const ll = m.getLatLng();
                if (pendingSelectOnce) { map.off('moveend', pendingSelectOnce); pendingSelectOnce = null; }
                map.flyTo(ll, zoom || Math.max(map.getZoom(), 15), { animate: true, duration: 0.9, easeLinearity: 0.25 });
                pendingSelectOnce = () => { setSelected(m); pendingSelectOnce = null; };
                map.once('moveend', pendingSelectOnce);
            }
        }

        let boundaryLayer = null;

        function swapCoordinates(coords) {
            if (!coords || !Array.isArray(coords)) return coords;

            // Multi-polygon: [[[lng, lat], ...]]
            return coords.map(ring =>
                ring.map(point => [point[1], point[0]]) // Swap: [lng, lat] -> [lat, lng]
            );
        }

        async function handleMessage(msg) {
            if (Array.isArray(msg)) {
                clusters.clearLayers(); markerIndex.clear(); selectedMarker = null; ALL.length = 0;
                await addMarkersChunked(msg);
                setActiveMarkers(ALL);
                if (!firstFullDone) { fitBoundsFrom(msg); firstFullDone = true; }
                return;
            }
            const type = msg && msg.type ? msg.type : 'full';
            const points = (msg && msg.points) ? msg.points : [];

            if (type === 'showBoundary' && msg.coordinates) {
                // Xóa boundary cũ
                if (boundaryLayer) {
                    map.removeLayer(boundaryLayer);
                    boundaryLayer = null;
                }

                // ✅ SWAP coordinates từ GeoJSON [lng,lat] -> Leaflet [lat,lng]
                const leafletCoords = swapCoordinates(msg.coordinates);

                // Vẽ boundary mới
                boundaryLayer = L.polygon(leafletCoords, {
                    color: '#7E57C2',
                    weight: 3,
                    opacity: 0.8,
                    fillColor: '#7E57C2',
                    fillOpacity: 0.1,
                    dashArray: '5, 10'
                }).addTo(map);

                // Zoom to boundary
                map.flyToBounds(boundaryLayer.getBounds(), {
                    padding: [50, 50],
                    animate: true,
                    duration: 0.9,
                    easeLinearity: 0.25
                });
                return;
            }

            if (type === 'clearBoundary') {
                if (boundaryLayer) {
                    map.removeLayer(boundaryLayer);
                    boundaryLayer = null;
                }
                return;
            }

            if (type === 'full') {
                clusters.clearLayers(); markerIndex.clear(); selectedMarker = null; ALL.length = 0;
                await addMarkersChunked(points);
                setActiveMarkers(ALL);
                if (!firstFullDone) { fitBoundsFrom(points); firstFullDone = true; }
            } else if (type === 'append') {
                const added = addMarkers(points);
                if (added) updateStatsDeb();
            } else if (type === 'update') {
                const added = addMarkers(points);
                if (added) updateStatsDeb();
            } else if (type === 'select') {
                selectById(msg.id, msg.zoom, msg.lat, msg.lon, msg.name);
            }
        }

        /* ===== GEOLOCATION ===== */
        let meMarker = null, meAccCircle = null;
        const myLocIcon = L.divIcon({ className: 'oc-my-loc', html: "<div class='oc-my-loc-dot'></div><div class='oc-my-loc-pulse'></div>", iconSize: [36, 36], iconAnchor: [18, 18] });
        let locateActive = false, locateBtnEl = null, lastMyPos = null;
        function setLocateActive(on) { locateActive = !!on; if (locateBtnEl) locateBtnEl.classList.toggle('on', locateActive); }
        function onLocationFound(e) {
            const ll = e.latlng, acc = e.accuracy || 0;
            lastMyPos = ll;
            if (!meMarker) { meMarker = L.marker(ll, { icon: myLocIcon, zIndexOffset: 2000, interactive: false }).addTo(map); }
            else { meMarker.setLatLng(ll); }
            if (!meAccCircle) {
                meAccCircle = L.circle(ll, { radius: acc, weight: 2, color: '#1a73e8', opacity: .5, fillColor: '#1a73e8', fillOpacity: .12, interactive: false }).addTo(map);
            } else { meAccCircle.setLatLng(ll); meAccCircle.setRadius(acc); }
            setLocateActive(true);
            map.flyTo(ll, Math.max(map.getZoom(), 15), { animate: true, duration: 0.9, easeLinearity: 0.25 });
        }
        function onLocationError(e) {
            console.warn('Location error:', e);
            setLocateActive(false);
            try {
                const m = L.control({ position: 'bottomleft' });
                m.onAdd = () => {
                    const el = L.DomUtil.create('div', 'leaflet-bar');
                    el.style.padding = '6px 8px'; el.style.background = '#fff'; el.style.boxShadow = '0 1px 4px rgba(0,0,0,.2)';
                    el.textContent = 'Nelze zjistit polohu.';
                    setTimeout(() => map.removeControl(m), 2500);
                    return el;
                };
                m.addTo(map);
            } catch (_) { }
        }
        map.on('locationfound', onLocationFound);
        map.on('locationerror', onLocationError);
        function doLocate() {
            setSelected(null);
            try { const box = window.__ocSearch?.querySelector?.('#ocSearchBox'); box?.blur(); } catch (_) { }
            if (pendingSelectOnce) { map.off('moveend', pendingSelectOnce); pendingSelectOnce = null; }
            map.locate({ setView: false, enableHighAccuracy: true, timeout: 10000 });
        }
        map.on('moveend', () => { if (!locateActive || !lastMyPos) return; const center = map.getCenter(); const d = center.distanceTo(lastMyPos); const thresh = Math.max(150, (meAccCircle ? meAccCircle.getRadius() : 0) * 2); if (d > thresh) setLocateActive(false); });
        map.on('dragstart', () => { if (locateActive) setLocateActive(false); });

        /* ===== CONTROLS ===== */
        const LocateControl = L.Control.extend({
            options: { position: 'bottomright' },
            onAdd: function () {
                const container = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-locate');
                const btn = L.DomUtil.create('button', '', container);
                btn.title = 'Moje poloha'; btn.setAttribute('aria-label', 'Moje poloha');
                btn.innerHTML = `
                            <svg viewBox='0 0 24 24' aria-hidden='true'>
                              <g fill='none' stroke-width='2' class='oc-gps-stroke'>
                                <circle cx='12' cy='12' r='7'></circle>
                                <line x1='12' y1='3'  x2='12' y2='5'></line>
                                <line x1='12' y1='19' x2='12' y2='21'></line>
                                <line x1='3'  y1='12' x2='5'  y2='12'></line>
                                <line x1='19' y1='12' x2='21' y2='12'></line>
                              </g>
                              <circle cx='12' cy='12' r='4' class='oc-gps-dot'></circle>
                            </svg>`;
                L.DomEvent.disableClickPropagation(btn);
                L.DomEvent.on(btn, 'click', (ev) => { L.DomEvent.stop(ev); doLocate(); });
                locateBtnEl = btn;
                return container;
            }
        });
        const ZoomControl = L.Control.extend({
            options: { position: 'bottomright' },
            onAdd: function () {
                const wrap = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-zoom');
                const mkBtn = (title, svg, onClick) => {
                    const b = L.DomUtil.create('button', 'oc-zoom-btn', wrap);
                    b.title = title; b.innerHTML = svg; b.setAttribute('aria-label', title);
                    L.DomEvent.disableClickPropagation(b);
                    b.addEventListener('click', onClick);
                    return b;
                };
                const svgPlus = `
                            <svg viewBox='0 0 24 24' aria-hidden='true' xmlns='http://www.w3.org/2000/svg'>
                              <path class='oc-zoom-glyph' d='M20 14H14V20H10V14H4V10H10V4H14V10H20V14Z'/>
                            </svg>`;
                const svgMinus = `
                            <svg viewBox='0 0 24 24' aria-hidden='true' xmlns='http://www.w3.org/2000/svg'>
                              <path class='oc-zoom-glyph' d='M20 14H4V10H20'/>
                            </svg>`;
                zoomInBtn = mkBtn('Přiblížit', svgPlus, () => map.zoomIn());
                zoomOutBtn = mkBtn('Oddálit', svgMinus, () => map.zoomOut());
                setTimeout(updateZoomButtons, 0);
                return wrap;
            }
        });
        map.addControl(new ZoomControl());
        map.addControl(new LocateControl());
        map.on('zoomend', updateZoomButtons);
        map.on('zoomstart', () => { _lastZoom = map.getZoom(); });
        map.on('zoomend', () => { if (map.getZoom() > _lastZoom) scheduleEnsureSelectedPopup(80); });
        clusters.on('animationend', () => scheduleEnsureSelectedPopup(40));

        const T = { placeholder: 'Vyhledat ičo nebo název firmy', search: 'Hledat', directions: 'Trasa', clear: 'Vymazat', noResults: 'Žádné výsledky…', myLocation: 'Moje poloha' };

        function getBaseList() {
            if (!ACTIVE_FILTER_KEY) return ALL;
            if (ACTIVE_FILTER_KEY === 'vip') return ALL.filter(m => m.__isVIP);
            return ALL.filter(m => m.__segKey === ACTIVE_FILTER_KEY);
        }

        function setChipMode(on) {
            const wrap = window.__ocSearch; if (!wrap) return;
            const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
            wrapBox.classList.toggle('chip-mode', !!on);
        }

        function openChipSuggestions() {
            try {
                const now = performance.now();
                if (now < __suppressSuggestUntil) return;
                const wrap = window.__ocSearch; if (!wrap) return;
                const listEl = wrap.querySelector('#ocSearchList');
                const emptyEl = wrap.querySelector('#ocSearchEmpty');
                const wrapBox = wrap.querySelector('#ocSearchWrap');

                matches = getBaseList();
                activeIdx = -1;

                if (emptyEl) emptyEl.style.display = 'none';
                if (typeof showClear === 'function') showClear(true);

                // 🔽 đánh dấu chip-mode
                setChipMode(true);

                listEl.style.display = 'block';
                wrapBox.classList.add('open');
                renderList([], 9999);
                listEl.scrollTop = 0;
            } catch (_) { }
        }

        const SearchControl = L.Control.extend({
            options: { position: 'topleft' },
            onAdd: function () {
                const wrap = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-search');
                wrap.innerHTML = `
                            <div class='oc-search-wrap' id='ocSearchWrap'>
                              <div class='oc-search-input'>
                                <input id='ocSearchBox' placeholder='Vyhledat ičo nebo název firmy' autocomplete='off'
                                       role='combobox' aria-autocomplete='list' aria-haspopup='listbox'
                                       aria-expanded='false' aria-controls='ocSearchList'/>

                                <button id='ocSearchGo' title='' aria-label='Search'>
                                  <svg viewBox='0 0 24 24' aria-hidden='true'>
                                    <path fill='currentColor' d='M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.28.27h.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z'/>
                                  </svg>
                                </button>

                                <button id='ocSearchClear' class='oc-btn-clear' title='' aria-label='Clear'>
                                  <svg viewBox='0 0 24 24' aria-hidden='true'>
                                    <path fill='currentColor' d='M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z'/>
                                  </svg>
                                </button>

                                <button id='ocRouteBtn' title='' aria-label='Directions'>
                                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' aria-hidden='true'>
                                    <path fill='currentColor' d='M14,14.5V12H10V15H8V11A1,1 0 0,1 9,10H14V7.5L17.5,11M21.71,11.29L12.71,2.29H12.7C12.31,1.9 11.68,1.9 11.29,2.29L2.29,11.29C1.9,11.68 1.9,12.32 2.29,12.71L11.29,21.71C11.68,22.09 12.31,22.1 12.71,21.71L21.71,12.71C22.1,12.32 22.1,11.68 21.71,11.29Z'/>
                                  </svg>
                                </button>
                              </div>
                              <ul id='ocSearchList' class='oc-search-list' role='listbox' aria-label='Suggestions'></ul>

                              <div id='ocRoutePanel' class='oc-route-panel' aria-label='Route panel'>

                 <div class='oc-route-modes' role='toolbar' aria-label='Způsob dopravy'>
                    <button class='oc-mode-btn active' data-mode='route' title='Nejlepší režimy cestování' aria-pressed='true'>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor"
                          d="M14,14.5V12H10V15H8V11A1,1 0 0,1 9,10H14V7.5L17.5,11M21.71,11.29L12.71,2.29H12.7C12.31,1.9 11.68,1.9 11.29,2.29L2.29,11.29C1.9,11.68 1.9,12.32 2.29,12.71L11.29,21.71C11.68,22.09 12.31,22.1 12.71,21.71L21.71,12.71C22.1,12.32 22.1,11.68 21.71,11.29Z"/>
                      </svg>
                    </button>

                    <button class="oc-mode-btn oc-mode-close" data-mode="close" title="Zavřít trasu" aria-label="Zavřít">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor"
                              d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                      </svg>
                    </button>
                  </div>

                  <div class='oc-route-row'>
                    <!-- label bị ẩn bởi CSS, có thể giữ lại hoặc xóa -->
                    <div class='oc-route-input'>
                      <input id='ocRouteFrom' placeholder='Zadat výchozí bod' autocomplete='off'
                             role='combobox' aria-autocomplete='list' aria-haspopup='listbox'
                             aria-expanded='false' aria-label='Zadat výchozí bod'/>
                    </div>
                  </div>

                  <div class='oc-route-row'>
                    <!-- label bị ẩn bởi CSS, có thể giữ lại hoặc xóa -->
                    <div class='oc-route-input' id='ocRouteToWrap'>
                      <input id='ocRouteTo' placeholder='Zadat cíl' autocomplete='off'
                             role='combobox' aria-autocomplete='list' aria-haspopup='listbox'
                             aria-expanded='false' aria-label='Zadat cíl'/>
                      <div id='ocRouteDd' class='oc-route-dd' role='listbox' aria-label='Route suggestions'>
                        <ul class='oc-search-list' id='ocRouteList'></ul>
                      </div>
                    </div>
                  </div>
</div>`;

                const wrapBox = wrap.querySelector('#ocSearchWrap');
                const input = wrap.querySelector('#ocSearchBox');
                const btnGo = wrap.querySelector('#ocSearchGo');
                const btnRoute = wrap.querySelector('#ocRouteBtn');
                const btnClear = wrap.querySelector('#ocSearchClear');

                // === Icons & state cho nút Trasa ===
                const ICON_ROUTE = `
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' aria-hidden='true'>
                    <path fill='currentColor' d='M14,14.5V12H10V15H8V11A1,1 0 0,1 9,10H14V7.5L17.5,11M21.71,11.29L12.71,2.29H12.7C12.31,1.9 11.68,1.9 11.29,2.29L2.29,11.29C1.9,11.68 1.9,12.32 2.29,12.71L11.29,21.71C11.68,22.09 12.31,22.1 12.71,21.71L21.71,12.71C22.1,12.32 22.1,11.68 21.71,11.29Z'/>
                  </svg>`;
                const ICON_CLOSE = `
                  <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' aria-hidden='true'>
                    <path fill='currentColor' d='M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z'/>
                  </svg>`;
                let isRouteMode = false;
                // ép icon khởi tạo (ghi đè cái SVG tĩnh trong HTML)
                btnRoute.innerHTML = ICON_ROUTE;
                btnRoute.title = T.directions;
                btnRoute.setAttribute('aria-label', T.directions);

                const list = wrap.querySelector('#ocSearchList');
                const route = wrap.querySelector('#ocRoutePanel');

                // Route refs
                const routeFrom = wrap.querySelector('#ocRouteFrom');
                const routeTo = wrap.querySelector('#ocRouteTo');
                const routeDd = wrap.querySelector('#ocRouteDd');
                const routeList = wrap.querySelector('#ocRouteList');


                // ===== Route travel modes (chỉ UI) =====
                let ROUTE_TRAVEL_MODE = 'route'; // route | car | transit | walk | bike | air

                const modesBar = wrap.querySelector('.oc-route-modes');
                const modeBtns = modesBar ? Array.from(modesBar.querySelectorAll('.oc-mode-btn[data-mode]')) : [];

                function setRouteMode(mode) {
                    ROUTE_TRAVEL_MODE = mode;
                    modeBtns.forEach(b => {
                        const on = (b.dataset.mode === mode);
                        b.classList.toggle('active', on);
                        b.setAttribute('aria-pressed', String(on));
                    });
                    // (chưa tính đường — để sau cắm vào engine route)
                }

                modeBtns.forEach(b => {
                    b.addEventListener('click', () => {
                        const mode = b.dataset.mode;
                        setRouteMode(mode);
                    });
                });

                const closeBtn = modesBar ? modesBar.querySelector('.oc-mode-close') : null;
                closeBtn?.addEventListener('click', () => {
                    try { closeRoutePanel(); } catch (_) { }
                });

                // Khi mở Route lần đầu, đảm bảo trạng thái nút:
                setRouteMode(ROUTE_TRAVEL_MODE);

                // ⚠️ Đưa norm lên sớm để routeFilter dùng được
                const norm = s => normBase(s);

                let activeRouteField = null;   // 'from' | 'to' | null
                let routeMatches = [];
                let routeActiveIdx = -1;

                function clearRouteFields() {
                    // xóa text + ARIA
                    if (routeFrom) {
                        routeFrom.value = '';
                        routeFrom.setAttribute('aria-expanded', 'false');
                        routeFrom.removeAttribute('aria-activedescendant');
                    }
                    if (routeTo) {
                        routeTo.value = '';
                        routeTo.setAttribute('aria-expanded', 'false');
                        routeTo.removeAttribute('aria-activedescendant');
                    }
                    // đóng dropdown gợi ý của route
                    if (routeDd) routeDd.classList.remove('open', 'empty');
                    routeList.innerHTML = '';

                    // reset state bên trong route
                    routeMatches = [];
                    routeActiveIdx = -1;
                    activeRouteField = null;
                }

                function routeClose() {
                    clearTimeout(routeCloseTimer);
                    routeDd.classList.remove('open', 'empty');
                    routeFrom?.setAttribute('aria-expanded', 'false');
                    routeTo?.setAttribute('aria-expanded', 'false');
                    routeFrom?.removeAttribute('aria-activedescendant');
                    routeTo?.removeAttribute('aria-activedescendant');
                }

                let routeCloseTimer = null;

                function routeCloseSoon() {
                    clearTimeout(routeCloseTimer);
                    routeCloseTimer = setTimeout(() => {
                        const ae = document.activeElement;
                        // Chỉ đóng nếu focus không nằm trong 2 input hoặc bên trong dropdown
                        if (ae !== routeFrom && ae !== routeTo && !routeDd.contains(ae)) {
                            routeClose();
                        }
                    }, 0);
                }

                function routeOpen(hasItems) {
                    clearTimeout(routeCloseTimer);
                    routeDd.classList.add('open');
                    routeDd.classList.toggle('empty', !hasItems);
                    if (activeRouteField === 'from') routeFrom.setAttribute('aria-expanded', 'true');
                    if (activeRouteField === 'to') routeTo.setAttribute('aria-expanded', 'true');
                }
                function routeFilter(q) {
                    return filterMatches(q);
                }
                function highlightMany(original, tokens) {
                    if (!original) return '';
                    // map ký tự có/không dấu → vị trí thật trong chuỗi gốc
                    const normalizeWithMap = (s) => {
                        const str = (s ?? '').toString();
                        let normStr = '', map = [];
                        for (let i = 0; i < str.length; i++) {
                            const d = str[i].normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                            for (let k = 0; k < d.length; k++) { normStr += d[k].toLowerCase(); map.push(i); }
                        }
                        return { str, norm: normStr, map };
                    };

                    const { str, norm: n, map } = normalizeWithMap(original);
                    if (!tokens || !tokens.length) return esc(str);

                    // gom các khoảng [start,end) của tất cả token rồi merge để tránh lồng <mark>
                    let ranges = [];
                    for (const t of tokens) {
                        if (!t) continue;
                        let pos = 0;
                        while (true) {
                            const i = n.indexOf(t, pos);
                            if (i < 0) break;
                            const s = map[i];
                            const e = map[Math.min(i + t.length - 1, map.length - 1)] + 1;
                            ranges.push([s, e]);
                            pos = i + 1;
                        }
                    }
                    if (!ranges.length) return esc(str);

                    // merge chồng lấp
                    ranges.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
                    const merged = [];
                    for (const r of ranges) {
                        if (!merged.length || r[0] > merged[merged.length - 1][1]) {
                            merged.push(r.slice());
                        } else {
                            merged[merged.length - 1][1] = Math.max(merged[merged.length - 1][1], r[1]);
                        }
                    }

                    // lắp <mark>
                    let out = '', prev = 0;
                    for (const [s, e] of merged) {
                        out += esc(str.slice(prev, s));
                        out += '<mark>' + esc(str.slice(s, e)) + '</mark>';
                        prev = e;
                    }
                    out += esc(str.slice(prev));
                    return out;
                }
                function getSuggestionAccent() {
                    if (!ACTIVE_FILTER_KEY) return '#616161';
                    if (ACTIVE_FILTER_KEY === 'vip') return '#FFC107';
                    const seg = SEG_META[ACTIVE_FILTER_KEY];
                    return seg?.fill || '#616161';
                }
                function routeRender() {
                    const src = (activeRouteField === 'from') ? routeFrom : routeTo;

                    clearTimeout(routeCloseTimer);
                    if (!src) { routeClose(); return; }

                    const q = (src.value || '').trim();
                    if (!q) { routeClose(); return; }

                    // lấy danh sách đã chấm điểm và cắt TOP 5
                    const all = routeFilter(q) || [];
                    routeMatches = all.slice(0, 5);
                    routeActiveIdx = -1;

                    routeList.innerHTML = '';
                    if (routeMatches.length === 0) { routeClose(); return; }

                    const tokenList = q.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                        .toLowerCase().split(/\s+/).filter(Boolean);
                    const accent = getSuggestionAccent();

                    for (let i = 0; i < routeMatches.length; i++) {
                        const m = routeMatches[i], p = m.__p || {};
                        const li = document.createElement('li');
                        li.id = 'oc-route-opt-' + i;
                        li.setAttribute('role', 'option');
                        li.setAttribute('aria-selected', String(i === routeActiveIdx));
                        li.className = 'oc-search-item' + (i === routeActiveIdx ? ' active' : '');

                        const nameHtml = highlightMany(p.name || '', tokenList);
                        const icoHtml = highlightMany(p.ico || '', tokenList);
                        const addrHtml = highlightMany(p.addr || '', tokenList);
                        const vip = isVIPFlag(p);

                        li.innerHTML = `
                      <svg class='oc-search-icon' viewBox='0 0 24 24' aria-hidden='true' style='color:${accent}'>
                        <path d='M12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5M12,2A7,7 0 0,1 19,9C19,14.25 12,22 12,22C12,22 5,14.25 5,9A7,7 0 0,1 12,2M12,4A5,5 0 0,0 7,9C7,10 7,12 12,18.71C17,12 17,10 17,9A5,5 0 0,0 12,4Z'
                            fill='currentColor' fill-rule='evenodd'/>
                      </svg>
                      <div style='min-width:0'>
                        <div class='oc-search-name'>
                          <span class='oc-name'>${nameHtml}</span>
                          ${p.ico ? `<span class='oc-search-ico'>(${icoHtml})</span>` : ``}
                          ${vip ? `<span class='oc-pill oc-pill-vip' title='${SEG_HINTS_CS.VIP}'>VIP</span>` : ``}
                        </div>
                        <div class='oc-search-sub'>${addrHtml}</div>
                      </div>`;
                        li.addEventListener('mousedown', (ev) => { ev.preventDefault(); routePick(i); });
                        routeList.appendChild(li);
                    }

                    routeOpen(true);
                    recalcListMaxHeight();
                }
                function routePick(i) {
                    if (i < 0 || i >= routeMatches.length) return;
                    const p = routeMatches[i].__p || {};
                    if (activeRouteField === 'from') {
                        routeFrom.value = p.name || p.addr || '';
                        routeTo.focus({ preventScroll: true });
                        activeRouteField = 'to';
                        routeRender();
                    } else {
                        routeTo.value = p.name || p.addr || '';
                        routeClose();
                    }
                    try { focusToItem(i, true); } catch (_) { }
                    try {
                        const payload = { type: 'routeFieldPick', field: activeRouteField, id: p.id, name: p.name };
                        window.chrome?.webview?.postMessage?.(JSON.stringify(payload));
                    } catch (_) { }
                }
                const onFromInput = debounce(() => { activeRouteField = 'from'; routeRender(); }, 120);
                const onToInput = debounce(() => { activeRouteField = 'to'; routeRender(); }, 120);
                routeFrom.addEventListener('input', onFromInput);
                routeTo.addEventListener('input', onToInput);
                routeFrom.addEventListener('focus', () => { activeRouteField = 'from'; routeRender(); });
                routeTo.addEventListener('focus', () => { activeRouteField = 'to'; routeRender(); });
                function routeMove(sel) {
                    if (!routeMatches.length) return;
                    routeActiveIdx = Math.max(0, Math.min(
                        (routeActiveIdx < 0 ? (sel > 0 ? 0 : routeMatches.length - 1) : routeActiveIdx + sel),
                        Math.min(routeMatches.length, 5) - 1
                    ));
                    [...routeList.children].forEach((li, idx) => {
                        li.classList.toggle('active', idx === routeActiveIdx);
                        const src = (activeRouteField === 'from') ? routeFrom : routeTo;
                        if (idx === routeActiveIdx) src.setAttribute('aria-activedescendant', li.id);
                    });
                }
                [routeFrom, routeTo].forEach(inp => {
                    inp.addEventListener('keydown', (ev) => {
                        if (routeDd.classList.contains('open')) {
                            if (ev.key === 'ArrowDown') { ev.preventDefault(); routeMove(+1); }
                            else if (ev.key === 'ArrowUp') { ev.preventDefault(); routeMove(-1); }
                            else if (ev.key === 'Enter') { ev.preventDefault(); if (routeActiveIdx >= 0) routePick(routeActiveIdx); }
                            else if (ev.key === 'Escape') { ev.preventDefault(); routeClose(); }
                        }
                    });
                    // Dùng closeSoon để tránh race với focus vào ô kia/ vào dropdown
                    inp.addEventListener('blur', routeCloseSoon);

                    // Khi focus lại: hủy pending-close và render lại gợi ý ngay
                    inp.addEventListener('focus', () => {
                        clearTimeout(routeCloseTimer);
                        activeRouteField = (inp === routeFrom) ? 'from' : 'to';
                        routeRender(); // sẽ gọi routeOpen() nếu có kết quả
                    });
                });
                document.addEventListener('pointerdown', (ev) => {
                    if (routeDd.classList.contains('open')) {
                        if (!routeDd.contains(ev.target) && ev.target !== routeFrom && ev.target !== routeTo) {
                            routeClose();
                        }
                    }
                }, true);

                // ===== Search core =====
                L.DomEvent.disableClickPropagation(wrap);
                L.DomEvent.disableScrollPropagation(wrap);
                L.DomEvent.disableScrollPropagation(list);

                let activeIdx = -1, matches = [];
                let suppressBlurHide = false, selectingFromList = false;

                function currentChipLabel() {
                    if (!ACTIVE_FILTER_KEY) return '';
                    return (ACTIVE_FILTER_KEY === 'vip') ? 'VIP' : (SEG_META[ACTIVE_FILTER_KEY]?.label || '');
                }
                function getSuggestionAccentSearch() {
                    if (!ACTIVE_FILTER_KEY) return '#616161';
                    if (ACTIVE_FILTER_KEY === 'vip') return '#FFC107';
                    const seg = SEG_META[ACTIVE_FILTER_KEY];
                    return seg?.fill || '#616161';
                }
                function updateGoState() { btnGo.disabled = input.value.trim().length === 0; btnGo.setAttribute('aria-disabled', String(btnGo.disabled)); }
                function showClear(_on) {
                    // Không điều khiển icon trực tiếp ở đây nữa → dùng committed state
                    updatePrimaryIcons();

                    // Nếu list đang mở thì render lại (để per-item Trasa mini đúng trạng thái)
                    requestAnimationFrame(() => {
                        if (list && list.style.display !== 'none') {
                            const norm = s => normBase(s);
                            const isChip = (typeof SUGGEST_MODE !== 'undefined') && (SUGGEST_MODE === 'chip');
                            const lim = isChip ? 9999 : 5;
                            renderList(norm(input.value).split(/\s+/).filter(Boolean), lim);
                        }
                    });
                }
                function isCapToFive() {
                    const wrap = window.__ocSearch; if (!wrap) return false;
                    const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
                    return wrapBox.classList.contains('open')
                        && !wrapBox.classList.contains('route-mode')
                        && !wrapBox.classList.contains('chip-mode')   // ← thêm dòng này
                        && (typeof SUGGEST_MODE !== 'undefined')
                        && (SUGGEST_MODE === 'search');
                }
                function setOpen(on) {
                    wrapBox.classList.toggle('open', !!on);
                    input.setAttribute('aria-expanded', !!on);

                    // 👉 Search-mode (text) giới hạn 5 item: không ép height khung ngoài
                    if (on && isCapToFive()) {
                        wrapBox.style.height = '';
                        wrapBox.style.maxHeight = '';
                    }

                    requestAnimationFrame(() => { recalcListMaxHeight(); repositionStats(); });
                }
                function hideLists() {
                    list.style.display = 'none';

                    const inRoute = wrapBox.classList.contains('route-mode');
                    if (route && !inRoute) route.style.display = 'none';

                    setOpen(inRoute ? true : false);

                    // 🔽 rời chip-mode nếu không ở route
                    if (!inRoute) setChipMode(false);

                    input.removeAttribute('aria-activedescendant');
                    if (!inRoute) { matches = []; activeIdx = -1; }
                }
                function renderList(qTokens, limit = 5) {
                    const accent = getSuggestionAccentSearch();
                    list.innerHTML = '';
                    if (matches.length === 0) { hideLists(); return; }
                    setChipMode(SUGGEST_MODE === 'chip');
                    list.style.display = 'block'; setOpen(true);

                    const token = (qTokens.sort((a, b) => b.length - a.length)[0] || '');
                    const max = Math.min(matches.length, limit);

                    // Hiển thị nút Trasa mini chỉ khi Clear đang hiện và KHÔNG ở route-mode
                    const wantPerItemRoute = (btnClear.style.display !== 'none') && !wrapBox.classList.contains('route-mode');

                    for (let i = 0; i < max; i++) {
                        const m = matches[i]; const p = m.__p || {};
                        const li = document.createElement('li');
                        li.id = 'oc-opt-' + i;
                        li.setAttribute('role', 'option');
                        li.setAttribute('aria-selected', String(i === activeIdx));
                        li.className = 'oc-search-item' + (i === activeIdx ? ' active' : '');

                        const tokenList = (qTokens && qTokens.length ? qTokens : []);
                        const nameHtml = highlightMany(p.name || '', tokenList);
                        const icoHtml = highlightMany(p.ico || '', tokenList);
                        const addrHtml = highlightMany(p.addr || '', tokenList);
                        const vip = isVIPFlag(p);

                        // HTML của item
                        li.innerHTML = `
                      <svg class='oc-search-icon' viewBox='0 0 24 24' aria-hidden='true' style='color:${accent}'>
                        <path d='M12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5M12,2A7,7 0 0,1 19,9C19,14.25 12,22 12,22C12,22 5,14.25 5,9A7,7 0 0,1 12,2M12,4A5,5 0 0,0 7,9C7,10 7,12 12,18.71C17,12 17,10 17,9A5,5 0 0,0 12,4Z'
                              fill='currentColor' fill-rule='evenodd'/>
                      </svg>
                      <div style='min-width:0'>
                        <div class='oc-search-name'>
                          <span class='oc-name'>${nameHtml}</span>
                          ${p.ico ? `<span class='oc-search-ico'>(${icoHtml})</span>` : ``}
                          ${vip ? `<span class='oc-pill oc-pill-vip' title='${SEG_HINTS_CS.VIP}'>VIP</span>` : ``}
                        </div>
                        <div class='oc-search-sub'>${addrHtml}</div>
                      </div>
                      ${wantPerItemRoute ? `<button class="oc-suggest-route" title="${esc(T.directions)}" aria-label="${esc(T.directions)}">${ICON_ROUTE}</button>` : ``}
                    `;

                        // Giữ hành vi chọn item bằng click như cũ
                        li.addEventListener('mousedown', (ev) => {
                            ev.preventDefault();
                            input.value = p.name || '';
                            updateGoState();
                            showClear(true);
                            input.blur();
                            focusToItem(i, true);
                        });

                        // Gắn handler cho nút Trasa mini
                        if (wantPerItemRoute) {
                            const mini = li.querySelector('.oc-suggest-route');
                            // Chặn “chọn item” và blur khi bấm mini
                            mini.addEventListener('mousedown', (ev) => { ev.preventDefault(); ev.stopPropagation(); });
                            mini.addEventListener('click', (ev) => {
                                ev.preventDefault(); ev.stopPropagation();

                                btnRoute.style.display = 'inline-flex';

                                // ✅ đóng list trước, rồi mở route-panel “đầy đủ” giống hình 2
                                hideLists();                // chỉ để tắt list
                                openRoutePanel();           // hàm này đã setOpen(true) + recalcListMaxHeight()

                                if (routeTo) routeTo.value = p.name || p.addr || '';
                                if (routeFrom) routeFrom.focus({ preventScroll: true });

                                // Thông báo host (tuỳ cần)
                                try {
                                    window.chrome?.webview?.postMessage?.(JSON.stringify({
                                        type: 'routeMiniClick', id: p.id, name: p.name
                                    }));
                                } catch (_) { }
                            });
                        }

                        list.appendChild(li);
                    }

                    if (activeIdx >= 0) input.setAttribute('aria-activedescendant', 'oc-opt-' + activeIdx);
                    recalcListMaxHeight();
                }
                function filterMatches(q) {
                    const qn = norm(q);
                    const tokens = qn.split(/\s+/).filter(Boolean);
                    if (tokens.length === 0) return [];

                    const phrase = tokens.join(' ');
                    const base = getBaseList();

                    function scoreMarker(m) {
                        const name = m.__nName || '';
                        const ico = m.__nIco || '';
                        const addr = m.__nAddr || '';
                        const hay = m.__hay || '';

                        // bắt buộc: mọi token đều phải có trong haystack
                        for (const t of tokens) { if (!hay.includes(t)) return -1; }

                        let s = 0;

                        // cụm đầy đủ trong name
                        const phrasePosName = name.indexOf(phrase);
                        if (phrasePosName >= 0) { s += 120; s += Math.max(0, 20 - phrasePosName); }

                        // cụm đầy đủ trong addr (ưu tiên thấp hơn name)
                        const phrasePosAddr = addr.indexOf(phrase);
                        if (phrasePosAddr >= 0) { s += 70; s += Math.max(0, 12 - phrasePosAddr); }

                        // bắt đầu bằng token đầu ở name
                        const t0 = tokens[0];
                        const t0Pos = name.indexOf(t0);
                        if (t0Pos === 0) s += 60; else if (t0Pos > 0) s += Math.max(0, 18 - t0Pos);

                        // mật độ token trong name
                        for (const t of tokens) {
                            const rx = new RegExp(t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
                            s += (name.match(rx) || []).length * 12;
                        }

                        // xuất hiện trong addr (điểm nhẹ hơn name)
                        for (const t of tokens) {
                            if (addr.includes(t)) s += 6;
                        }

                        // xuất hiện trong ICO (nhẹ)
                        for (const t of tokens) {
                            if (ico.includes(t)) s += 8;
                        }

                        if (m.__isVIP) s += 3;
                        return s;
                    }

                    const scored = [];
                    for (const m of base) {
                        const sc = scoreMarker(m);
                        if (sc >= 0) scored.push({ m, sc });
                        if (scored.length >= 400) break;
                    }

                    // sort giảm dần theo điểm, hòa thì theo tên (ổn định)
                    scored.sort((a, b) => b.sc - a.sc || (a.m.__p?.name || '').localeCompare(b.m.__p?.name || ''));

                    // trả về tối đa 200 kết quả như cũ
                    return scored.slice(0, 200).map(x => x.m);
                }
                const doUpdateSuggestions = () => {
                    const now = performance.now();
                    if (now < __suppressSuggestUntil) {
                        // đang suppress → đóng & thoát
                        try {
                            list.style.display = 'none';
                            const emptyEl = window.__ocSearch?.querySelector?.('#ocSearchEmpty');
                            if (emptyEl) emptyEl.style.display = 'none';
                            (window.__ocSearch?.querySelector?.('#ocSearchWrap') || window.__ocSearch)?.classList?.remove('open');
                        } catch (_) { }
                        return;
                    }

                    if (ACTIVE_FILTER_KEY && SUGGEST_MODE === 'chip') {
                        matches = getBaseList();
                        renderList([], 9999);
                        updateGoState();
                        setChipMode(true);
                        return;
                    }
                    const q = input.value.trim();
                    activeIdx = -1;
                    showClear(q.length > 0);

                    if (ACTIVE_FILTER_KEY) {
                        const label = currentChipLabel();
                        if (q === '' || q === label) {
                            matches = getBaseList();
                            renderList([], 9999);
                            updateGoState();
                            return;
                        }
                    }

                    if (q.length < 1) {
                        matches = [];
                        hideLists();
                        setActiveMarkers(ALL);
                        updateGoState();
                        return;
                    }
                    matches = filterMatches(q);
                    if (matches.length === 0) {
                        hideLists();
                    } else {
                        renderList(q.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').split(/\s+/).filter(Boolean));
                    }
                    updateGoState();
                };
                const updateSuggestions = debounce(doUpdateSuggestions, 120);

                function applySearchFilter() {
                    const q = input.value.trim();
                    if (q.length === 0) { hideLists(); return; }
                    hideLists();
                    if (!matches.length) { hideLists(); return; }
                    setActiveMarkers(matches);
                    if (matches.length === 1) {
                        const p = matches[0].__p || {};
                        input.value = p.name || '';
                        updateGoState(); showClear(true); input.blur();
                        focusToItem(0, true);
                    } else {
                        const latlngs = matches.map(m => m.getLatLng());
                        const b = L.latLngBounds(latlngs);
                        map.flyToBounds(b, { padding: [20, 20], animate: true, duration: 0.9, easeLinearity: 0.25 });
                    }

                    // ✅ chốt tìm kiếm → Clear hiện, Trasa ẩn
                    setCommittedSearchState(true);
                }
                function focusToItem(idx, hideNow) {
                    if (idx < 0 || idx >= matches.length) return;
                    activeIdx = idx;
                    const m = matches[idx];
                    const ll = m.getLatLng();
                    if (pendingSelectOnce) { map.off('moveend', pendingSelectOnce); pendingSelectOnce = null; }
                    map.flyTo(ll, Math.max(map.getZoom(), 15), { animate: true, duration: 0.9, easeLinearity: 0.25 });
                    pendingSelectOnce = () => { setSelected(m); pendingSelectOnce = null; };
                    map.once('moveend', pendingSelectOnce);
                    if (hideNow) { hideLists(); activeIdx = -1; matches = []; setCommittedSearchState(true); } else { const norm = s => normBase(s); renderList(norm(input.value).split(/\s+/).filter(Boolean)[0] || ''); }
                }

                input.addEventListener('input', updateSuggestions);
                input.addEventListener('blur', () => {
                    setTimeout(() => {
                        if (suppressBlurHide && !selectingFromList) {
                            input.focus({ preventScroll: true });
                            return;
                        }
                        const ae = document.activeElement;
                        if (!wrapBox.contains(ae)) {
                            hideLists();
                            // ✅ có chữ và không ở route-mode → coi như đã chốt
                            if (input.value.trim().length > 0 && !wrapBox.classList.contains('route-mode')) {
                                setCommittedSearchState(true);
                                updatePrimaryIcons();
                            }
                        }
                    }, 0);
                });
                input.addEventListener('focus', () => {
                    if (ACTIVE_FILTER_KEY && SUGGEST_MODE === 'chip') {
                        matches = getBaseList();
                        openChipSuggestions();
                    } else {
                        const q = input.value.trim();
                        if (q.length > 0) doUpdateSuggestions();
                    }
                });
                input.addEventListener('keydown', (ev) => {
                    if (ev.key === 'Enter') {
                        ev.preventDefault();
                        if (matches.length && activeIdx >= 0) {
                            const p = matches[activeIdx].__p || {};
                            input.value = p.name || input.value;
                            updateGoState(); showClear(true); input.blur();
                            focusToItem(activeIdx, true);
                            return;
                        }
                        if (input.value.trim().length === 0) return;
                        applySearchFilter();
                        return;
                    }
                    if (matches.length) {
                        if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
                            ev.preventDefault();
                            if (SUGGEST_MODE === 'chip') {
                                matches = getBaseList();
                                activeIdx = Math.max(0, Math.min(ev.key === 'ArrowDown' ? activeIdx + 1 : activeIdx - 1, matches.length - 1));
                                renderList([], 9999);
                                return;
                            }
                            activeIdx = Math.max(0, Math.min(ev.key === 'ArrowDown' ? activeIdx + 1 : activeIdx - 1, matches.length - 1));
                            renderList(norm(input.value).split(/\s+/).filter(Boolean), 5);
                        }
                    }
                    if (ev.key === 'Escape') { hideLists(); }
                });

                btnGo.addEventListener('click', applySearchFilter);

                function closeRoutePanel() {
                    isRouteMode = false;
                    wrapBox.classList.remove('route-mode');
                    setChipMode(false);
                    if (route) route.style.display = 'none';

                    // trả icon & nhãn
                    //btnRoute.innerHTML = ICON_ROUTE;
                    //btnRoute.title = T.directions;
                    //btnRoute.setAttribute('aria-label', T.directions);

                    // Sau khi đóng route → chưa chốt → về trạng thái ban đầu (Trasa hiện, Clear ẩn)
                    setCommittedSearchState(false);

                    clearRouteFields();

                    // quay về search/chip mode
                    SUGGEST_MODE = (ACTIVE_FILTER_KEY ? 'chip' : 'search');
                    setOpen(false);
                    recalcListMaxHeight();
                    repositionStats();
                }

                // cho phép nơi khác đóng route-panel
                wrap.__closeRoutePanel = closeRoutePanel;
                // (tuỳ chọn) tiện kiểm tra
                wrap.__isRouteMode = () => isRouteMode;

                // ======= ✅ openRoutePanel(): mở panel Trasa, ẩn list/empty, setOpen() và focus From
                function openRoutePanel(prefillToText) {
                    if (isRouteMode) { closeRoutePanel(); return; }

                    // Nếu có chip hoặc đã chốt: reset trước khi mở Route
                    if (ACTIVE_FILTER_KEY || SEARCH_COMMITTED) {
                        resetSearchUI();
                    }

                    try {
                        SUGGEST_MODE = 'route';
                        isRouteMode = true;
                        setRouteMode('route'); // đưa về icon đầu (giống ảnh)
                        setChipMode(false);
                        wrapBox.classList.add('route-mode');

                        if (list) list.style.display = 'none';
                        if (route) {
                            route.style.display = 'block';
                            setOpen(true);
                            recalcListMaxHeight();
                            repositionStats();
                            route.scrollTop = 0;
                        }

                        // đổi icon → Close
                        //btnRoute.innerHTML = ICON_CLOSE;
                        //btnRoute.title = 'Zavřít';
                        //btnRoute.setAttribute('aria-label', 'Zavřít');

                        // Route-mode: Trasa hiện, Clear ẩn
                        setCommittedSearchState(false);
                        updatePrimaryIcons();

                        // 💡 Điền sẵn "Kam" nếu có
                        if (typeof prefillToText === 'string' && prefillToText.trim().length) {
                            routeTo.value = prefillToText.trim();
                        }

                        // ARIA + focus vào Odkud
                        routeFrom?.setAttribute('aria-expanded', 'true');
                        routeTo?.setAttribute('aria-expanded', 'false');

                        routeFrom?.focus({ preventScroll: true });
                    } catch (_) { }

                    try { window.chrome?.webview?.postMessage?.(JSON.stringify({ type: 'routeUiClick' })); } catch (_) { }
                }

                // GẮN 1 LẦN DUY NHẤT – bấm Trasa chính
                btnRoute.addEventListener('click', () => {
                    let prefill = (input?.value || '').trim();

                    const listOpen = wrapBox.classList.contains('open') && list?.style.display !== 'none';
                    if (listOpen && prefill.length && Array.isArray(matches) && matches.length) {
                        const chosen = (typeof activeIdx === 'number' && activeIdx >= 0 && activeIdx < matches.length)
                            ? matches[activeIdx]
                            : matches[0];
                        const p = chosen?.__p || {};
                        prefill = p.name || p.addr || prefill;
                    } else if (prefill.length) {
                        const best = filterMatches(prefill)[0];
                        if (best) { const p = best.__p || {}; prefill = p.name || p.addr || prefill; }
                    } else {
                        prefill = ''; // không “kế thừa” matches cũ
                    }

                    // mở Route + (nếu có) prefill vào Kam
                    openRoutePanel(prefill);

                    // 🔹 sau khi dùng thì dọn state
                    matches = [];
                    activeIdx = -1;
                });

                // Clear
                btnClear.addEventListener('click', () => {
                    // chặn gợi ý tự bật lại do debounce
                    suppressSuggest(300);

                    // đóng route nếu có + reset sạch
                    closeRouteAndReset();

                    // đảm bảo list/empty tắt hẳn
                    const listEl = wrap.querySelector('#ocSearchList');
                    const emptyEl = wrap.querySelector('#ocSearchEmpty');
                    if (listEl) listEl.style.display = 'none';
                    if (emptyEl) emptyEl.style.display = 'none';

                    input.focus();
                });

                // Misc
                input.addEventListener('input', () => {
                    const q = input.value.trim();
                    if (ACTIVE_FILTER_KEY) {
                        SUGGEST_MODE = (q === '' || q === currentChipLabel()) ? 'chip' : 'search';
                    } else { SUGGEST_MODE = 'search'; }
                    updateSuggestions();

                    const inRoute = wrapBox.classList.contains('route-mode');
                    if (!inRoute) setCommittedSearchState(false);
                });
                window.addEventListener('keydown', (ev) => { if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 'f') { ev.preventDefault(); input.focus(); input.select(); } });

                wrap.__applyFilter = (text, run = true) => { input.value = text ?? ''; doUpdateSuggestions(); if (run) applySearchFilter(); };
                wrap.__openChipSuggestions = () => { SUGGEST_MODE = 'chip'; matches = getBaseList(); activeIdx = -1; list.style.display = 'block'; setOpen(true); renderList([], 9999); list.scrollTop = 0; recalcListMaxHeight(); };

                // Giữ focus khi chọn list
                ['pointerdown', 'mousedown', 'touchstart'].forEach(evName => {
                    list.addEventListener(evName, (ev) => { suppressBlurHide = true; selectingFromList = !!ev.target.closest('.oc-search-item'); }, { passive: true });
                });
                ['pointerup', 'mouseup', 'touchend', 'touchcancel', 'mouseleave'].forEach(evName => {
                    list.addEventListener(evName, () => { setTimeout(() => { suppressBlurHide = false; selectingFromList = false; }, 0); }, { passive: true });
                });

                function __measureModesHeight(modes) {
                    if (!modes) return 0;
                    const prev = modes.style.display;
                    modes.style.display = 'flex';                         // bật tạm để đo
                    const h = Math.ceil(modes.getBoundingClientRect().height || 0);
                    modes.style.display = prev || '';                     // trả lại trạng thái cũ
                    return h;
                }

                function recalcListMaxHeight() {
                    const mapEl = map.getContainer();
                    const mRect = mapEl.getBoundingClientRect();

                    const wrap = window.__ocSearch; if (!wrap) return;
                    const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
                    const inEl = wrap.querySelector('.oc-search-input') || wrap;
                    const list = wrap.querySelector('#ocSearchList');
                    const route = wrap.querySelector('#ocRoutePanel');
                    const modes = wrap.querySelector('.oc-route-modes'); // <-- header route

                    const inRect = inEl.getBoundingClientRect();

                    const GAP = 8;   // khoảng cách ngay dưới input/header
                    const MARGIN = 16;  // biên an toàn
                    const BOTTOM_GAP = 4;  // chừa đáy map

                    const csWrap = getComputedStyle(wrapBox);
                    const padTop = parseFloat(csWrap.paddingTop) || 0;
                    const padBottom = parseFloat(csWrap.paddingBottom) || 0;
                    const padY = padTop + padBottom;

                    // Không gian tối đa dưới input (khi search) hoặc dưới top của card (khi route)
                    let avail = Math.max(
                        120,
                        Math.floor(mRect.bottom - inRect.bottom - GAP - MARGIN - padBottom - BOTTOM_GAP)
                    );

                    const listVisible = !!(list && list.style.display !== 'none');
                    const inRouteMode = wrapBox.classList.contains('route-mode');
                    const inChipMode = wrapBox.classList.contains('chip-mode');

                    // --- Search text: cap 5 item chỉ khi KHÔNG chip-mode
                    if (wrapBox.classList.contains('open') && list && listVisible && !inRouteMode && !inChipMode) {
                        let itemH = 0;
                        for (const child of list.children) {
                            if (child.classList?.contains('oc-search-item')) {
                                const r = child.getBoundingClientRect();
                                itemH = Math.max(itemH, r.height || 0);
                                if (itemH) break;
                            }
                        }
                        if (!itemH) itemH = 56;

                        const count = Math.min(5, list.children.length || 0);
                        const wantedListH = Math.max(0, Math.round(count * itemH));

                        list.style.maxHeight = wantedListH + 'px';
                        if (route) route.style.maxHeight = avail + 'px';

                        wrapBox.style.height = '';
                        wrapBox.style.maxHeight = '';
                        return;
                    }

                    // --- Route-mode hoặc Chip-mode: full-height như panel
                    let routeAvail = avail;
                    if ((inRouteMode || inChipMode) && modes) {
                        // route-mode: đo trực tiếp; chip-mode: đo bằng helper để lấy đúng chiều cao
                        const mH = inRouteMode
                            ? Math.ceil(modes.getBoundingClientRect().height || 0)
                            : __measureModesHeight(modes);
                        routeAvail = Math.max(80, avail - mH);
                    }

                    if (wrapBox.classList.contains('open')) {
                        const boxH = Math.max(inRect.height + avail + padY, inRect.height + 120);
                        wrapBox.style.height = boxH + 'px';
                        wrapBox.style.maxHeight = boxH + 'px';
                    } else {
                        wrapBox.style.height = '';
                        wrapBox.style.maxHeight = '';
                    }

                    if (list) list.style.maxHeight = (inChipMode ? routeAvail : avail) + 'px';
                    if (route) route.style.maxHeight = routeAvail + 'px';

                    // Dropdown gợi ý trong route (From/To)
                    const rdd = wrap.querySelector('#ocRouteDd');
                    if (rdd) {
                        const ul = rdd.querySelector('.oc-search-list');
                        if (ul) ul.style.maxHeight = routeAvail + 'px';
                    }
                }

                window.addEventListener('resize', recalcListMaxHeight);
                map.on('resize zoomend moveend', recalcListMaxHeight);

                input.placeholder = T.placeholder;
                btnGo.title = T.search; btnGo.setAttribute('aria-label', T.search);
                btnRoute.title = T.directions; btnRoute.setAttribute('aria-label', T.directions);
                btnClear.title = T.clear; btnClear.setAttribute('aria-label', T.clear);
                const locateBtn = locateBtnEl; if (locateBtn) { locateBtn.title = T.myLocation; locateBtn.setAttribute('aria-label', T.myLocation); }

                if (!window.__ocBoundOutsideClose) {
                    document.addEventListener('pointerdown', (ev) => { if (!wrapBox.contains(ev.target)) hideLists(); }, true);
                    window.__ocBoundOutsideClose = true;
                }

                updateGoState();
                window.__ocSearch = wrap;
                return wrap;
            }
        });
        map.addControl(new SearchControl());
        map.addControl(new StatsControl());

        window.addEventListener('resize', reflow);
        map.on('moveend zoomend resize', reflow);
        requestAnimationFrame(repositionStats);

        /* ===== Bridge tới .NET host ===== */
        setTimeout(() => { map.invalidateSize(); updateZoomButtons(); }, 0);
        window.addEventListener('resize', () => map.invalidateSize());
        window.chrome?.webview?.addEventListener('message', e => { try { handleMessage(JSON.parse(e.data)); } catch (ex) { console.error(ex); } });
    </script>
</body>
</html>
