USE [OCS]
GO

IF OBJECT_ID('dbo.usp_GetKPILeaflet', 'P') IS NOT NULL
	DROP PROCEDURE dbo.usp_GetKPILeaflet;
GO

CREATE PROCEDURE [dbo].[usp_GetKPILeaflet]
(
	@AsOf        DATETIME2(0) = NULL,
	@PeriodType  NVARCHAR(10) = 'MTD',   -- MTD | QTD | YTD | CUSTOM
	@CustomStart DATE         = NULL,
	@CustomEnd   DATE         = NULL
)
AS
BEGIN
	SET NOCOUNT ON;
	BEGIN TRY
		IF @AsOf IS NULL SET @AsOf = SYSUTCDATETIME();

		DECLARE @Today DATE = CONVERT(date, @AsOf);

		-- ── 1. Výpočet kalendářního okna pro filtrování letáků ────────────────
		DECLARE @FilterStart DATE, @FilterEnd DATE;

		IF UPPER(ISNULL(@PeriodType, 'MTD')) = 'MTD'
		BEGIN
			SET @FilterStart = DATEFROMPARTS(YEAR(@Today), MONTH(@Today), 1);
			SET @FilterEnd   = @Today;
		END
		ELSE IF UPPER(@PeriodType) = 'QTD'
		BEGIN
			SET @FilterStart = CONVERT(date, DATEADD(QUARTER, DATEDIFF(QUARTER, 0, @Today), 0));
			SET @FilterEnd   = @Today;
		END
		ELSE IF UPPER(@PeriodType) = 'YTD'
		BEGIN
			SET @FilterStart = DATEFROMPARTS(YEAR(@Today), 1, 1);
			SET @FilterEnd   = @Today;
		END
		ELSE IF UPPER(@PeriodType) = 'CUSTOM'
		BEGIN
			IF @CustomStart IS NULL OR @CustomEnd IS NULL
			BEGIN
				RAISERROR('CUSTOM requires @CustomStart and @CustomEnd', 16, 1);
				RETURN;
			END
			SET @FilterStart = @CustomStart;
			SET @FilterEnd   = @CustomEnd;
		END
		ELSE
		BEGIN
			SET @FilterStart = DATEFROMPARTS(YEAR(@Today), MONTH(@Today), 1);
			SET @FilterEnd   = @Today;
		END

		-- ── 2. Sestavit všechny letáky s parsovanými datumy platnosti ─────────
		CREATE TABLE #AllLeaflets (
			Artikl_ID   UNIQUEIDENTIFIER,
			Nazev       NVARCHAR(400),
			Katalog     NVARCHAR(200),
			CarovyKod   NVARCHAR(200),
			KlicKod     NVARCHAR(100),
			KlicNazev   NVARCHAR(400),
			PlatnostOd  DATE,
			PlatnostDo  DATE
		);

		INSERT INTO #AllLeaflets
			(Artikl_ID, Nazev, Katalog, CarovyKod, KlicKod, KlicNazev, PlatnostOd, PlatnostDo)
		SELECT
			A.ID,
			A.Nazev,
			A.Katalog,
			A.CarovyKod,
			PK.Kod,
			PK.Nazev,
			TRY_CONVERT(date, v6.odFinal, 104) AS PlatnostOd,
			TRY_CONVERT(date, v6.doFinal, 104) AS PlatnostDo
		FROM [S5_Agenda_001_20190131130454].[dbo].[Artikly_Artikl] A WITH (NOLOCK)
		JOIN [S5_Agenda_001_20190131130454].[dbo].[Artikly_ArtiklProduktovyKlic] APK WITH (NOLOCK)
			ON APK.Parent_ID = A.ID AND APK.Deleted = 0
		JOIN [S5_Agenda_001_20190131130454].[dbo].[Artikly_ProduktovyKlic] PK WITH (NOLOCK)
			ON PK.ID = APK.ProduktovyKlic_ID
		   AND PK.Kod LIKE 'L%'
		   AND PK.Deleted = 0
		   AND PK.Nazev LIKE '%(%'
		CROSS APPLY (VALUES(
			CASE
				WHEN CHARINDEX('(', PK.Nazev) > 0
					 AND CHARINDEX(')', PK.Nazev, CHARINDEX('(', PK.Nazev)) > CHARINDEX('(', PK.Nazev)
				THEN SUBSTRING(PK.Nazev,
							   CHARINDEX('(', PK.Nazev) + 1,
							   CHARINDEX(')', PK.Nazev, CHARINDEX('(', PK.Nazev))
							   - CHARINDEX('(', PK.Nazev) - 1)
				ELSE NULL
			END
		)) AS v(inside)
		CROSS APPLY (VALUES(
			LTRIM(RTRIM(CASE WHEN inside IS NOT NULL AND CHARINDEX('-', inside) > 0
							 THEN LEFT(inside, CHARINDEX('-', inside) - 1)
							 ELSE inside END)),
			LTRIM(RTRIM(CASE WHEN inside IS NOT NULL AND CHARINDEX('-', inside) > 0
							 THEN SUBSTRING(inside, CHARINDEX('-', inside) + 1, 8000)
							 ELSE NULL END))
		)) AS v2(leftPart, rightPart)
		CROSS APPLY (VALUES(
			REPLACE(REPLACE(v2.leftPart,  ' ', ''), ')', ''),
			REPLACE(REPLACE(v2.rightPart, ' ', ''), ')', '')
		)) AS v3(leftClean, rightClean)
		CROSS APPLY (VALUES(
			CASE WHEN RIGHT(v3.leftClean,  1) = '.' THEN LEFT(v3.leftClean,  LEN(v3.leftClean)  - 1) ELSE v3.leftClean  END,
			CASE WHEN RIGHT(v3.rightClean, 1) = '.' THEN LEFT(v3.rightClean, LEN(v3.rightClean) - 1) ELSE v3.rightClean END
		)) AS v4(leftNoDot, rightNoDot)
		CROSS APPLY (VALUES(
			CASE WHEN TRY_CAST(RIGHT(v4.rightNoDot, 4) AS int) BETWEEN 1900 AND 2100 THEN RIGHT(v4.rightNoDot, 4) ELSE NULL END,
			CASE WHEN TRY_CAST(RIGHT(v4.leftNoDot,  4) AS int) BETWEEN 1900 AND 2100 THEN RIGHT(v4.leftNoDot,  4) ELSE NULL END
		)) AS v5(yearFromRight, yearFromLeft)
		CROSS APPLY (VALUES(
			CASE
				WHEN v5.yearFromLeft IS NOT NULL AND RIGHT(v4.leftNoDot, 4) = v5.yearFromLeft
					 THEN v4.leftNoDot
				WHEN v5.yearFromRight IS NOT NULL
					 THEN v4.leftNoDot + '.' + v5.yearFromRight
				ELSE v4.leftNoDot
			END,
			CASE
				WHEN v5.yearFromRight IS NOT NULL THEN v4.rightNoDot
				WHEN v5.yearFromLeft  IS NOT NULL THEN v4.rightNoDot + '.' + v5.yearFromLeft
				ELSE v4.rightNoDot
			END
		)) AS v6(odFinal, doFinal);

		DELETE FROM #AllLeaflets WHERE PlatnostOd IS NULL OR PlatnostDo IS NULL;

		-- ── 3. Filtrovat letáky aktivní v daném kalendářním období ────────────
		-- Leták je relevantní pokud se jeho platnostní okno PŘEKRÝVÁ s @FilterStart–@FilterEnd.
		-- Předchůdci jsou přidáni samostatně v kroku 5, takže zde bereme pouze aktuální letáky.
		SELECT DISTINCT KlicKod, MIN(PlatnostOd) AS LeafletOd, MAX(PlatnostDo) AS LeafletDo
		INTO #CurrentLeaflets
		FROM #AllLeaflets
		WHERE PlatnostDo >= @FilterStart AND PlatnostOd <= @FilterEnd
		GROUP BY KlicKod;

		IF NOT EXISTS (SELECT 1 FROM #CurrentLeaflets)
		BEGIN
			DROP TABLE #CurrentLeaflets;
			DROP TABLE #AllLeaflets;
			RETURN;
		END

		-- ── 4. Pro každý aktuální leták najít předchůdce ──────────────────────
		-- Přechůdce = leták (v #AllLeaflets) s nejvyšším LeafletDo < LeafletOd tohoto letáku.
		-- Přechůdce nemusí být v @FilterStart–@FilterEnd — hledáme ho v celé historii.
		SELECT DISTINCT KlicKod, MIN(PlatnostOd) AS LeafletOd, MAX(PlatnostDo) AS LeafletDo
		INTO #AllLeafletWindows
		FROM #AllLeaflets
		GROUP BY KlicKod;

		SELECT
			cl.KlicKod,
			cl.LeafletOd,
			cl.LeafletDo,
			prev.KlicKod   AS PrevKlicKod,
			prev.LeafletOd AS PrevLeafletOd,
			prev.LeafletDo AS PrevLeafletDo
		INTO #LeafletWithPrev
		FROM #CurrentLeaflets cl
		OUTER APPLY (
			SELECT TOP 1
				p.KlicKod,
				p.LeafletOd,
				p.LeafletDo
			FROM #AllLeafletWindows p
			WHERE p.LeafletDo < cl.LeafletOd
			ORDER BY p.LeafletDo DESC
		) prev;

		-- ── 5. Rozsah prodejů = union platnostních oken (curr + prev) ─────────
		DECLARE @MinSaleDate DATE, @MaxSaleDate DATE;
		SELECT
			@MinSaleDate = MIN(ISNULL(PrevLeafletOd, LeafletOd)),
			@MaxSaleDate = MAX(LeafletDo)
		FROM #LeafletWithPrev;

		CREATE NONCLUSTERED INDEX IX_AllLeaflets_Artikl ON #AllLeaflets(Artikl_ID);

		-- ── 6. Denní prodeje v celém okně ─────────────────────────────────────
		CREATE TABLE #SalesDaily (
			Artikl_ID    UNIQUEIDENTIFIER,
			SaleDate     DATE,
			QuantitySum  DECIMAL(18,6),
			SalePriceSum DECIMAL(18,2)
		);

		INSERT INTO #SalesDaily (Artikl_ID, SaleDate, QuantitySum, SalePriceSum)
		SELECT Artikl_ID, SaleDate, SUM(QuantitySum), SUM(SalePriceSum)
		FROM (
			-- WinShop skladový prodej
			SELECT OPA.Artikl_ID,
				   CAST(SD.DatumVystaveni AS DATE) AS SaleDate,
				   SUM(CASE WHEN SD.ZapornyPohyb = 0 THEN  PSD.Mnozstvi  ELSE -PSD.Mnozstvi  END) AS QuantitySum,
				   SUM(CASE WHEN SD.ZapornyPohyb = 0 THEN  PSD.DphZaklad ELSE -PSD.DphZaklad END) AS SalePriceSum
			FROM [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_PolozkaSkladovehoDokladu] PSD WITH (NOLOCK)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_SkladovyDoklad] SD WITH (NOLOCK)
				ON PSD.Parent_ID = SD.ID
			   AND SD.Nazev LIKE 'Prodej WinShop%'
			   AND SD.Deleted = 0
			   AND SD.DatumVystaveni >= @MinSaleDate
			   AND SD.DatumVystaveni <  DATEADD(DAY, 1, @MaxSaleDate)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Obchod_ObsahPolozkySArtiklem] OPA WITH (NOLOCK)
				ON PSD.ObsahPolozky_ID = OPA.ID AND OPA.Deleted = 0
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Sklady_Sklad] S WITH (NOLOCK)
				ON OPA.Sklad_ID = S.ID
			   AND S.Kod NOT IN ('REKLAMACE','PUTORIUS','VÝPRODEJ','1')
			   AND S.Deleted = 0
			WHERE PSD.Deleted = 0
			  AND PSD.Nazev NOT LIKE 'Recyklační příspěvek%'
			GROUP BY OPA.Artikl_ID, CAST(SD.DatumVystaveni AS DATE)

			UNION ALL

			-- Dodací listy vydané
			SELECT OPA.Artikl_ID,
				   CAST(DV.DatumVystaveni AS DATE) AS SaleDate,
				   SUM(CASE WHEN DV.ZapornyPohyb = 0 THEN  PDV.Mnozstvi  ELSE -PDV.Mnozstvi  END) AS QuantitySum,
				   SUM(CASE WHEN DV.ZapornyPohyb = 0 THEN  PDV.DphZaklad ELSE -PDV.DphZaklad END) AS SalePriceSum
			FROM [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_PolozkaDodacihoListuVydaneho] PDV WITH (NOLOCK)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_DodaciListVydany] DV WITH (NOLOCK)
				ON PDV.Parent_ID = DV.ID
			   AND DV.Deleted = 0
			   AND DV.DatumVystaveni >= @MinSaleDate
			   AND DV.DatumVystaveni <  DATEADD(DAY, 1, @MaxSaleDate)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Obchod_ObsahPolozkySArtiklem] OPA WITH (NOLOCK)
				ON PDV.ObsahPolozky_ID = OPA.ID AND OPA.Deleted = 0
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Sklady_Sklad] S WITH (NOLOCK)
				ON OPA.Sklad_ID = S.ID
			   AND S.Kod NOT IN ('REKLAMACE','PUTORIUS','VÝPRODEJ','1')
			   AND S.Deleted = 0
			WHERE PDV.Deleted = 0
			  AND PDV.Nazev NOT LIKE 'Recyklační příspěvek%'
			GROUP BY OPA.Artikl_ID, CAST(DV.DatumVystaveni AS DATE)
		) t
		GROUP BY Artikl_ID, SaleDate;

		CREATE CLUSTERED INDEX IX_SalesDaily ON #SalesDaily(Artikl_ID, SaleDate);

		-- ── 7. Aggregace per (Artikl_ID, KlicKod) ─────────────────────────────
		-- SaleCurr = validity okno TOHOTO letáku
		-- SalePrev = validity okno PŘEDCHŮDCE (pro tentýž artikl)
		-- Pouze artikly letáků v #CurrentLeaflets (= aktivní v daném @PeriodType)
		;WITH Agg AS (
			SELECT
				al.Artikl_ID,
				al.KlicKod,
				al.Nazev,
				al.Katalog,
				al.CarovyKod,
				al.PlatnostOd,
				al.PlatnostDo,
				lwp.PrevKlicKod,
				lwp.PrevLeafletOd,
				lwp.PrevLeafletDo,
				COALESCE(SUM(CASE WHEN s.SaleDate BETWEEN al.PlatnostOd AND al.PlatnostDo
								  THEN s.SalePriceSum ELSE 0 END), 0) AS SaleCurr,
				COALESCE(SUM(CASE WHEN lwp.PrevLeafletOd IS NOT NULL
									   AND s.SaleDate BETWEEN lwp.PrevLeafletOd AND lwp.PrevLeafletDo
								  THEN s.SalePriceSum ELSE 0 END), 0) AS SalePrev,
				COALESCE(SUM(CASE WHEN s.SaleDate BETWEEN al.PlatnostOd AND al.PlatnostDo
								  THEN s.QuantitySum  ELSE 0 END), 0) AS QuantityCurr,
				COALESCE(SUM(CASE WHEN lwp.PrevLeafletOd IS NOT NULL
									   AND s.SaleDate BETWEEN lwp.PrevLeafletOd AND lwp.PrevLeafletDo
								  THEN s.QuantitySum  ELSE 0 END), 0) AS QuantityPrev
			FROM #AllLeaflets al
			JOIN #LeafletWithPrev lwp ON lwp.KlicKod = al.KlicKod
			LEFT JOIN #SalesDaily s   ON s.Artikl_ID = al.Artikl_ID
			GROUP BY
				al.Artikl_ID, al.KlicKod, al.Nazev, al.Katalog, al.CarovyKod,
				al.PlatnostOd, al.PlatnostDo,
				lwp.PrevKlicKod, lwp.PrevLeafletOd, lwp.PrevLeafletDo
		)

		-- ── 8. Výstup ──────────────────────────────────────────────────────────
		SELECT
			a.Nazev,
			a.Katalog,
			a.CarovyKod,

			CAST(a.SaleCurr AS DECIMAL(18,2))  AS SaleCurr,
			CAST(a.SalePrev AS DECIMAL(18,2))  AS SalePrev,

			CAST(ROUND(a.QuantityCurr, 0) AS INT) AS QuantityCurr,
			CAST(ROUND(a.QuantityPrev, 0) AS INT) AS QuantityPrev,

			CAST(
				CASE WHEN a.SalePrev = 0 THEN NULL
					 ELSE ROUND(100.0 * (a.SaleCurr - a.SalePrev) / a.SalePrev, 2)
				END
			AS DECIMAL(18,2)) AS DeltaSalePct,

			CAST(
				CASE WHEN a.QuantityPrev = 0 THEN NULL
					 ELSE ROUND(100.0 * (a.QuantityCurr - a.QuantityPrev) / a.QuantityPrev, 2)
				END
			AS DECIMAL(18,2)) AS DeltaQtyPct,

			a.KlicKod        AS LeafletCode,
			a.PlatnostOd,
			a.PlatnostDo,
			a.PrevKlicKod    AS PrevLeafletCode,
			a.PrevLeafletOd  AS PrevPlatnostOd,
			a.PrevLeafletDo  AS PrevPlatnostDo

		FROM Agg a
		ORDER BY a.KlicKod, a.Nazev;

		DROP TABLE #SalesDaily;
		DROP TABLE #LeafletWithPrev;
		DROP TABLE #AllLeafletWindows;
		DROP TABLE #CurrentLeaflets;
		DROP TABLE #AllLeaflets;

	END TRY
	BEGIN CATCH
		DECLARE @ErrMsg   NVARCHAR(4000) = ERROR_MESSAGE();
		DECLARE @ErrSev   INT            = ERROR_SEVERITY();
		DECLARE @ErrState INT            = ERROR_STATE();
		RAISERROR(@ErrMsg, @ErrSev, @ErrState);
	END CATCH
END;
GO

AS
BEGIN
	SET NOCOUNT ON;
	BEGIN TRY
		IF @AsOf IS NULL SET @AsOf = SYSUTCDATETIME();

		DECLARE @Today DATE = CONVERT(date, @AsOf);

		-- ── 1. Sestavit všechny letáky s parsovanými datumy platnosti ─────────
		CREATE TABLE #AllLeaflets (
			Artikl_ID   UNIQUEIDENTIFIER,
			Nazev       NVARCHAR(400),
			Katalog     NVARCHAR(200),
			CarovyKod   NVARCHAR(200),
			KlicKod     NVARCHAR(100),
			KlicNazev   NVARCHAR(400),
			PlatnostOd  DATE,
			PlatnostDo  DATE
		);

		INSERT INTO #AllLeaflets
			(Artikl_ID, Nazev, Katalog, CarovyKod, KlicKod, KlicNazev, PlatnostOd, PlatnostDo)
		SELECT
			A.ID,
			A.Nazev,
			A.Katalog,
			A.CarovyKod,
			PK.Kod,
			PK.Nazev,
			TRY_CONVERT(date, v6.odFinal, 104) AS PlatnostOd,
			TRY_CONVERT(date, v6.doFinal, 104) AS PlatnostDo
		FROM [S5_Agenda_001_20190131130454].[dbo].[Artikly_Artikl] A WITH (NOLOCK)
		JOIN [S5_Agenda_001_20190131130454].[dbo].[Artikly_ArtiklProduktovyKlic] APK WITH (NOLOCK)
			ON APK.Parent_ID = A.ID AND APK.Deleted = 0
		JOIN [S5_Agenda_001_20190131130454].[dbo].[Artikly_ProduktovyKlic] PK WITH (NOLOCK)
			ON PK.ID = APK.ProduktovyKlic_ID
		   AND PK.Kod LIKE 'L%'
		   AND PK.Deleted = 0
		   AND PK.Nazev LIKE '%(%'
		CROSS APPLY (VALUES(
			CASE
				WHEN CHARINDEX('(', PK.Nazev) > 0
					 AND CHARINDEX(')', PK.Nazev, CHARINDEX('(', PK.Nazev)) > CHARINDEX('(', PK.Nazev)
				THEN SUBSTRING(PK.Nazev,
							   CHARINDEX('(', PK.Nazev) + 1,
							   CHARINDEX(')', PK.Nazev, CHARINDEX('(', PK.Nazev))
							   - CHARINDEX('(', PK.Nazev) - 1)
				ELSE NULL
			END
		)) AS v(inside)
		CROSS APPLY (VALUES(
			LTRIM(RTRIM(CASE WHEN inside IS NOT NULL AND CHARINDEX('-', inside) > 0
							 THEN LEFT(inside, CHARINDEX('-', inside) - 1)
							 ELSE inside END)),
			LTRIM(RTRIM(CASE WHEN inside IS NOT NULL AND CHARINDEX('-', inside) > 0
							 THEN SUBSTRING(inside, CHARINDEX('-', inside) + 1, 8000)
							 ELSE NULL END))
		)) AS v2(leftPart, rightPart)
		CROSS APPLY (VALUES(
			REPLACE(REPLACE(v2.leftPart,  ' ', ''), ')', ''),
			REPLACE(REPLACE(v2.rightPart, ' ', ''), ')', '')
		)) AS v3(leftClean, rightClean)
		CROSS APPLY (VALUES(
			CASE WHEN RIGHT(v3.leftClean,  1) = '.' THEN LEFT(v3.leftClean,  LEN(v3.leftClean)  - 1) ELSE v3.leftClean  END,
			CASE WHEN RIGHT(v3.rightClean, 1) = '.' THEN LEFT(v3.rightClean, LEN(v3.rightClean) - 1) ELSE v3.rightClean END
		)) AS v4(leftNoDot, rightNoDot)
		CROSS APPLY (VALUES(
			CASE WHEN TRY_CAST(RIGHT(v4.rightNoDot, 4) AS int) BETWEEN 1900 AND 2100 THEN RIGHT(v4.rightNoDot, 4) ELSE NULL END,
			CASE WHEN TRY_CAST(RIGHT(v4.leftNoDot,  4) AS int) BETWEEN 1900 AND 2100 THEN RIGHT(v4.leftNoDot,  4) ELSE NULL END
		)) AS v5(yearFromRight, yearFromLeft)
		CROSS APPLY (VALUES(
			CASE
				WHEN v5.yearFromLeft IS NOT NULL AND RIGHT(v4.leftNoDot, 4) = v5.yearFromLeft
					 THEN v4.leftNoDot
				WHEN v5.yearFromRight IS NOT NULL
					 THEN v4.leftNoDot + '.' + v5.yearFromRight
				ELSE v4.leftNoDot
			END,
			CASE
				WHEN v5.yearFromRight IS NOT NULL THEN v4.rightNoDot
				WHEN v5.yearFromLeft  IS NOT NULL THEN v4.rightNoDot + '.' + v5.yearFromLeft
				ELSE v4.rightNoDot
			END
		)) AS v6(odFinal, doFinal);

		DELETE FROM #AllLeaflets WHERE PlatnostOd IS NULL OR PlatnostDo IS NULL;

		-- Pouze letáky jejichž platnost již začala (<= dnes)
		DELETE FROM #AllLeaflets WHERE PlatnostOd > @Today;

		IF NOT EXISTS (SELECT 1 FROM #AllLeaflets)
		BEGIN
			DROP TABLE #AllLeaflets;
			RETURN;
		END

		-- ── 2. Ke každému (Artikl_ID, KlicKod) najít předchůdce ──────────────
		-- Předchůdce = jiný KlicKod ve stejné skupině artiklu,
		-- jehož PlatnostDo je nejblíže nižší než PlatnostOd aktuálního letáku.
		-- Skupinou rozumíme: všechny letáky kde se daný Artikl_ID vyskytuje.
		-- (Jinými slovy: předchůdce nemusí mít stejný artikl — porovnáváme
		--  celý leták jako celek; ale pro výpočet SalePrev potřebujeme
		--  použít OKNO předchůdce na TEN SAMÝ artikl.)

		-- Nejdříve sestavíme unikátní přehled leták-kód → jeho platnostní okno
		-- (agregace přes všechny artikly v daném letáku)
		SELECT DISTINCT
			KlicKod,
			MIN(PlatnostOd) OVER (PARTITION BY KlicKod) AS LeafletOd,
			MAX(PlatnostDo) OVER (PARTITION BY KlicKod) AS LeafletDo
		INTO #LeafletWindows
		FROM #AllLeaflets;

		-- Ke každému letáku přiřadíme předchůdce: leták s nejvyšším LeafletDo < LeafletOd tohoto letáku
		SELECT
			lw.KlicKod,
			lw.LeafletOd,
			lw.LeafletDo,
			prev.KlicKod    AS PrevKlicKod,
			prev.LeafletOd  AS PrevLeafletOd,
			prev.LeafletDo  AS PrevLeafletDo
		INTO #LeafletWithPrev
		FROM #LeafletWindows lw
		OUTER APPLY (
			SELECT TOP 1
				p.KlicKod,
				p.LeafletOd,
				p.LeafletDo
			FROM #LeafletWindows p
			WHERE p.LeafletDo < lw.LeafletOd
			ORDER BY p.LeafletDo DESC
		) prev;

		-- ── 3. Určit rozsah pro načtení prodejů ──────────────────────────────
		DECLARE @MinSaleDate DATE, @MaxSaleDate DATE;
		SELECT
			@MinSaleDate = MIN(ISNULL(PrevLeafletOd, LeafletOd)),
			@MaxSaleDate = MAX(LeafletDo)
		FROM #LeafletWithPrev;

		CREATE NONCLUSTERED INDEX IX_AllLeaflets_Artikl ON #AllLeaflets(Artikl_ID);

		-- ── 4. Denní prodeje v celém okně ────────────────────────────────────
		CREATE TABLE #SalesDaily (
			Artikl_ID    UNIQUEIDENTIFIER,
			SaleDate     DATE,
			QuantitySum  DECIMAL(18,6),
			SalePriceSum DECIMAL(18,2)
		);

		INSERT INTO #SalesDaily (Artikl_ID, SaleDate, QuantitySum, SalePriceSum)
		SELECT Artikl_ID, SaleDate, SUM(QuantitySum), SUM(SalePriceSum)
		FROM (
			-- WinShop skladový prodej
			SELECT OPA.Artikl_ID,
				   CAST(SD.DatumVystaveni AS DATE) AS SaleDate,
				   SUM(CASE WHEN SD.ZapornyPohyb = 0 THEN  PSD.Mnozstvi  ELSE -PSD.Mnozstvi  END) AS QuantitySum,
				   SUM(CASE WHEN SD.ZapornyPohyb = 0 THEN  PSD.DphZaklad ELSE -PSD.DphZaklad END) AS SalePriceSum
			FROM [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_PolozkaSkladovehoDokladu] PSD WITH (NOLOCK)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_SkladovyDoklad] SD WITH (NOLOCK)
				ON PSD.Parent_ID = SD.ID
			   AND SD.Nazev LIKE 'Prodej WinShop%'
			   AND SD.Deleted = 0
			   AND SD.DatumVystaveni >= @MinSaleDate
			   AND SD.DatumVystaveni <  DATEADD(DAY, 1, @MaxSaleDate)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Obchod_ObsahPolozkySArtiklem] OPA WITH (NOLOCK)
				ON PSD.ObsahPolozky_ID = OPA.ID AND OPA.Deleted = 0
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Sklady_Sklad] S WITH (NOLOCK)
				ON OPA.Sklad_ID = S.ID
			   AND S.Kod NOT IN ('REKLAMACE','PUTORIUS','VÝPRODEJ','1')
			   AND S.Deleted = 0
			WHERE PSD.Deleted = 0
			  AND PSD.Nazev NOT LIKE 'Recyklační příspěvek%'
			GROUP BY OPA.Artikl_ID, CAST(SD.DatumVystaveni AS DATE)

			UNION ALL

			-- Dodací listy vydané
			SELECT OPA.Artikl_ID,
				   CAST(DV.DatumVystaveni AS DATE) AS SaleDate,
				   SUM(CASE WHEN DV.ZapornyPohyb = 0 THEN  PDV.Mnozstvi  ELSE -PDV.Mnozstvi  END) AS QuantitySum,
				   SUM(CASE WHEN DV.ZapornyPohyb = 0 THEN  PDV.DphZaklad ELSE -PDV.DphZaklad END) AS SalePriceSum
			FROM [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_PolozkaDodacihoListuVydaneho] PDV WITH (NOLOCK)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[SkladovyDoklad_DodaciListVydany] DV WITH (NOLOCK)
				ON PDV.Parent_ID = DV.ID
			   AND DV.Deleted = 0
			   AND DV.DatumVystaveni >= @MinSaleDate
			   AND DV.DatumVystaveni <  DATEADD(DAY, 1, @MaxSaleDate)
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Obchod_ObsahPolozkySArtiklem] OPA WITH (NOLOCK)
				ON PDV.ObsahPolozky_ID = OPA.ID AND OPA.Deleted = 0
			JOIN [S5_Agenda_001_20190131130454].[dbo].[Sklady_Sklad] S WITH (NOLOCK)
				ON OPA.Sklad_ID = S.ID
			   AND S.Kod NOT IN ('REKLAMACE','PUTORIUS','VÝPRODEJ','1')
			   AND S.Deleted = 0
			WHERE PDV.Deleted = 0
			  AND PDV.Nazev NOT LIKE 'Recyklační příspěvek%'
			GROUP BY OPA.Artikl_ID, CAST(DV.DatumVystaveni AS DATE)
		) t
		GROUP BY Artikl_ID, SaleDate;

		CREATE CLUSTERED INDEX IX_SalesDaily ON #SalesDaily(Artikl_ID, SaleDate);

		-- ── 5. Aggregace: SaleCurr = okno aktuálního letáku,
		--                  SalePrev = okno předchůdce (pro TEN SAMÝ artikl) ───
		;WITH Agg AS (
			SELECT
				al.Artikl_ID,
				al.KlicKod,
				al.Nazev,
				al.Katalog,
				al.CarovyKod,
				al.PlatnostOd,
				al.PlatnostDo,
				lwp.PrevKlicKod,
				lwp.PrevLeafletOd,
				lwp.PrevLeafletDo,
				-- Aktuální: prodeje v okně TOHOTO letáku
				COALESCE(SUM(CASE WHEN s.SaleDate BETWEEN al.PlatnostOd AND al.PlatnostDo
								  THEN s.SalePriceSum ELSE 0 END), 0) AS SaleCurr,
				-- Předchozí: prodeje v okně PŘEDCHŮDCE (stejný artikl)
				COALESCE(SUM(CASE WHEN lwp.PrevLeafletOd IS NOT NULL
									   AND s.SaleDate BETWEEN lwp.PrevLeafletOd AND lwp.PrevLeafletDo
								  THEN s.SalePriceSum ELSE 0 END), 0) AS SalePrev,
				COALESCE(SUM(CASE WHEN s.SaleDate BETWEEN al.PlatnostOd AND al.PlatnostDo
								  THEN s.QuantitySum  ELSE 0 END), 0) AS QuantityCurr,
				COALESCE(SUM(CASE WHEN lwp.PrevLeafletOd IS NOT NULL
									   AND s.SaleDate BETWEEN lwp.PrevLeafletOd AND lwp.PrevLeafletDo
								  THEN s.QuantitySum  ELSE 0 END), 0) AS QuantityPrev
			FROM #AllLeaflets al
			JOIN #LeafletWithPrev lwp ON lwp.KlicKod = al.KlicKod
			LEFT JOIN #SalesDaily s   ON s.Artikl_ID = al.Artikl_ID
			GROUP BY
				al.Artikl_ID, al.KlicKod, al.Nazev, al.Katalog, al.CarovyKod,
				al.PlatnostOd, al.PlatnostDo,
				lwp.PrevKlicKod, lwp.PrevLeafletOd, lwp.PrevLeafletDo
		)

		-- ── 6. Výstup ─────────────────────────────────────────────────────────
		SELECT
			a.Nazev,
			a.Katalog,
			a.CarovyKod,

			CAST(a.SaleCurr AS DECIMAL(18,2))  AS SaleCurr,
			CAST(a.SalePrev AS DECIMAL(18,2))  AS SalePrev,

			CAST(ROUND(a.QuantityCurr, 0) AS INT) AS QuantityCurr,
			CAST(ROUND(a.QuantityPrev, 0) AS INT) AS QuantityPrev,

			-- Δ % revenue
			CAST(
				CASE WHEN a.SalePrev = 0 THEN NULL
					 ELSE ROUND(100.0 * (a.SaleCurr - a.SalePrev) / a.SalePrev, 2)
				END
			AS DECIMAL(18,2)) AS DeltaSalePct,

			-- Δ % quantity
			CAST(
				CASE WHEN a.QuantityPrev = 0 THEN NULL
					 ELSE ROUND(100.0 * (a.QuantityCurr - a.QuantityPrev) / a.QuantityPrev, 2)
				END
			AS DECIMAL(18,2)) AS DeltaQtyPct,

			a.KlicKod        AS LeafletCode,
			a.PlatnostOd,
			a.PlatnostDo,
			a.PrevKlicKod    AS PrevLeafletCode,
			a.PrevLeafletOd  AS PrevPlatnostOd,
			a.PrevLeafletDo  AS PrevPlatnostDo

		FROM Agg a
		ORDER BY a.KlicKod, a.Nazev;

		DROP TABLE #SalesDaily;
		DROP TABLE #LeafletWithPrev;
		DROP TABLE #LeafletWindows;
		DROP TABLE #AllLeaflets;

	END TRY
	BEGIN CATCH
		DECLARE @ErrMsg   NVARCHAR(4000) = ERROR_MESSAGE();
		DECLARE @ErrSev   INT            = ERROR_SEVERITY();
		DECLARE @ErrState INT            = ERROR_STATE();
		RAISERROR(@ErrMsg, @ErrSev, @ErrState);
	END CATCH
END;
GO