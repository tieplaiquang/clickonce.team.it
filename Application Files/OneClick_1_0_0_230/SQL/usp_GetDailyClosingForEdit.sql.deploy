IF EXISTS (SELECT 1 FROM sys.procedures WHERE name = 'usp_GetDailyClosingForEdit')
	DROP PROCEDURE [dbo].[usp_GetDailyClosingForEdit];
GO

CREATE PROCEDURE [dbo].[usp_GetDailyClosingForEdit]
	@Closing_Date DATE,
	@Closing_Id   BIGINT = NULL   -- optional: load a specific run directly
AS
BEGIN
	SET NOCOUNT ON;

	-- If @Closing_Id is given, return that specific run only.
	-- Otherwise return ALL runs for the date (so the UI can let the user pick).
	SELECT
		dc.Closing_Id,
		dc.Closing_Date,
		dc.Closing_Run,
		dc.Cash_CZK,
		dc.Cash_EUR,
		dc.Cash_USD,
		dc.Rate_EUR,
		dc.Rate_USD,
		dc.Coins,
		dc.Note,
		dc.Albacon,
		dc.Balance,
		dc.Balance_EUR,
		dc.Balance_USD,
		dc.Is_Manual_Balance,
		CASE WHEN dc.Is_Manual_Balance = 1 THEN dc.Balance ELSE NULL END AS Manual_Balance_CZK
	FROM [dbo].[DailyClosing] dc WITH (NOLOCK)
	WHERE dc.Closing_Date = @Closing_Date
	  AND (@Closing_Id IS NULL OR dc.Closing_Id = @Closing_Id)
	ORDER BY dc.Closing_Run ASC;
END;
GO
