IF OBJECT_ID('dbo.usp_RepairWrongDateClosing', 'P') IS NOT NULL
	DROP PROCEDURE dbo.usp_RepairWrongDateClosing;
GO

SET QUOTED_IDENTIFIER ON;
GO

CREATE PROCEDURE [dbo].[usp_RepairWrongDateClosing]
	@Closing_Id BIGINT,
	@New_Closing_Date DATE,
	@Updated_By NVARCHAR(200) = NULL
AS
BEGIN
	SET NOCOUNT ON;
	SET XACT_ABORT ON;

	IF @Closing_Id IS NULL
	BEGIN
		RAISERROR(N'Closing_Id je povinný.', 16, 1);
		RETURN;
	END;

	IF @New_Closing_Date IS NULL
	BEGIN
		RAISERROR(N'New_Closing_Date je povinný.', 16, 1);
		RETURN;
	END;

	DECLARE
		@Old_Closing_Date DATE,
		@Old_Closing_Run INT,
		@Cash_CZK DECIMAL(18,2),
		@Cash_EUR DECIMAL(18,2),
		@Cash_USD DECIMAL(18,2),
		@Rate_EUR DECIMAL(18,6),
		@Rate_USD DECIMAL(18,6),
		@Coins DECIMAL(18,2),
		@Note NVARCHAR(500),
		@Manual_Balance_CZK DECIMAL(18,2),
		@Is_Manual_Balance BIT;

	SELECT
		@Old_Closing_Date = DC.Closing_Date,
		@Old_Closing_Run = DC.Closing_Run,
		@Cash_CZK = DC.Cash_CZK,
		@Cash_EUR = DC.Cash_EUR,
		@Cash_USD = DC.Cash_USD,
		@Rate_EUR = DC.Rate_EUR,
		@Rate_USD = DC.Rate_USD,
		@Coins = DC.Coins,
		@Note = DC.Note,
		@Manual_Balance_CZK = CASE WHEN DC.Is_Manual_Balance = 1 THEN DC.Balance ELSE NULL END,
		@Is_Manual_Balance = DC.Is_Manual_Balance
	FROM dbo.DailyClosing DC
	WHERE DC.Closing_Id = @Closing_Id;

	IF @Old_Closing_Date IS NULL
	BEGIN
		RAISERROR(N'Uzávěrka s Closing_Id=%I64d nebyla nalezena.', 16, 1, @Closing_Id);
		RETURN;
	END;

	IF @Old_Closing_Date = @New_Closing_Date
	BEGIN
		RAISERROR(N'Nové datum je stejné jako původní.', 16, 1);
		RETURN;
	END;

	BEGIN TRANSACTION;

	-- Update the closing row date first; keep the same run and content.
	UPDATE dbo.DailyClosing
	SET Closing_Date = @New_Closing_Date
	WHERE Closing_Id = @Closing_Id;

	-- Re-link all vault transfers that were tied to the old closing date/run
	UPDATE VT
	SET
		VT.Closing_Date = @New_Closing_Date,
		VT.Closing_Id = @Closing_Id
	FROM dbo.VaultTransfer VT
	WHERE VT.Closing_Date = @Old_Closing_Date
	  AND VT.Source = N'Pokladna'
	  AND VT.Direction = N'In';

	-- Refresh the moved closing's cashdesk availability.
	EXEC dbo.usp_UpdateDailyClosing
		@Closing_Id = @Closing_Id,
		@Cash_CZK = @Cash_CZK,
		@Cash_EUR = @Cash_EUR,
		@Cash_USD = @Cash_USD,
		@Rate_EUR = @Rate_EUR,
		@Rate_USD = @Rate_USD,
		@Coins = @Coins,
		@Note = @Note,
		@Manual_Balance_CZK = @Manual_Balance_CZK,
		@Updated_By = @Updated_By;

	COMMIT;

	DECLARE @From_Date DATE = CASE WHEN @Old_Closing_Date < @New_Closing_Date THEN @Old_Closing_Date ELSE @New_Closing_Date END;
	BEGIN TRY
		EXEC dbo.usp_RebuildBalanceChainFromDate @From_Date = @From_Date;
	END TRY
	BEGIN CATCH
		PRINT N'Warning: usp_RebuildBalanceChainFromDate failed for date ' + CONVERT(NVARCHAR(10), @From_Date);
	END CATCH;

	SELECT
		@Closing_Id AS Closing_Id,
		@Old_Closing_Date AS Old_Closing_Date,
		@New_Closing_Date AS New_Closing_Date,
		@Old_Closing_Run AS Old_Closing_Run,
		@Closing_Id AS Target_Closing_Id;
END;
GO