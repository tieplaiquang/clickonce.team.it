-- =============================================
-- Fix 1: Sửa stored procedure usp_GetUserByUsername
-- Thêm cột MustChangePassword vào kết quả trả về
-- =============================================
ALTER PROCEDURE [dbo].[usp_GetUserByUsername]
    @Username NVARCHAR(100)
AS
BEGIN
    SELECT [UserId], [Username], [PasswordHash], [FullName], [Email], [IsActive],
           ISNULL([MustChangePassword], 0) AS [MustChangePassword]
    FROM [dbo].[Users]
    WHERE [Username] = @Username AND [IsActive] = 1;
END;
GO

-- =============================================
-- Fix 2: Sửa Password Hash cho admin
-- C# dùng SHA256 -> Base64 encoding
-- SHA256("admin123") Base64 = JAvlGPq9JyTdtvBO6x2llnRI1+gxwIyPqCKAn3THIKk=
-- =============================================
IF EXISTS (SELECT 1 FROM [dbo].[Users] WHERE [Username] = 'admin')
BEGIN
    UPDATE [dbo].[Users]
    SET [PasswordHash] = 'JAvlGPq9JyTdtvBO6x2llnRI1+gxwIyPqCKAn3THIKk=',
        [IsActive] = 1,
        [MustChangePassword] = 0
    WHERE [Username] = 'admin';
    PRINT 'Admin password updated!';
END
ELSE
BEGIN
    -- Admin chưa tồn tại, tạo mới
    INSERT INTO [dbo].[Users] ([Username], [PasswordHash], [FullName], [Email], [IsActive], [MustChangePassword])
    VALUES (
        'admin',
        'JAvlGPq9JyTdtvBO6x2llnRI1+gxwIyPqCKAn3THIKk=',
        'Administrator',
        'admin@oneclick.cz',
        1,
        0
    );
    PRINT 'Admin user created!';
END
GO

-- =============================================
-- Fix 3: Đảm bảo admin có role Admin
-- =============================================
DECLARE @AdminUserId UNIQUEIDENTIFIER;
DECLARE @AdminRoleId UNIQUEIDENTIFIER;

SELECT @AdminUserId = [UserId] FROM [dbo].[Users] WHERE [Username] = 'admin';
SELECT @AdminRoleId = [RoleId] FROM [dbo].[Roles] WHERE [RoleName] = 'Admin';

IF @AdminUserId IS NOT NULL AND @AdminRoleId IS NOT NULL
BEGIN
    IF NOT EXISTS (SELECT 1 FROM [dbo].[UserRoles] WHERE [UserId] = @AdminUserId AND [RoleId] = @AdminRoleId)
    BEGIN
        INSERT INTO [dbo].[UserRoles] ([UserId], [RoleId]) VALUES (@AdminUserId, @AdminRoleId);
        PRINT 'Admin role assigned!';
    END

    -- Đảm bảo Admin role có tất cả modules
    INSERT INTO [dbo].[RoleModules] ([RoleId], [ModuleId])
    SELECT @AdminRoleId, m.[ModuleId] FROM [dbo].[Modules] m
    WHERE NOT EXISTS (
        SELECT 1 FROM [dbo].[RoleModules] rm
        WHERE rm.[RoleId] = @AdminRoleId AND rm.[ModuleId] = m.[ModuleId]
    );
    PRINT 'Admin modules updated!';
END
GO

-- =============================================
-- Kiểm tra kết quả
-- =============================================
SELECT
    u.[Username],
    LEFT(u.[PasswordHash], 30) + '...' AS [PasswordHash_Preview],
    u.[IsActive],
    u.[MustChangePassword],
    STRING_AGG(r.[RoleName], ', ') AS [Roles],
    COUNT(rm.[ModuleId]) AS [ModuleCount]
FROM [dbo].[Users] u
LEFT JOIN [dbo].[UserRoles] ur ON u.[UserId] = ur.[UserId]
LEFT JOIN [dbo].[Roles] r ON ur.[RoleId] = r.[RoleId]
LEFT JOIN [dbo].[RoleModules] rm ON r.[RoleId] = rm.[RoleId]
WHERE u.[Username] = 'admin'
GROUP BY u.[Username], u.[PasswordHash], u.[IsActive], u.[MustChangePassword];

-- Đăng nhập với:
-- Username: admin
-- Password: admin123
