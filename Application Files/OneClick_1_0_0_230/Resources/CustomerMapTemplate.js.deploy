                                                                                                                                        <button id='ocRouteBtn' title='' aria-label='Directions'>
                                                                                                                                          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                                            <path fill='currentColor' d='M14,14.5V12H10V15H8V11A1,1 0 0,1 9,10H14V7.5L17.5,11M21.71,11.29L12.71,2.29H12.7C12.31,1.9 11.68,1.9 11.29,2.29L2.29,11.29C1.9,11.68 1.9,12.32 2.29,12.71L11.29,21.71C11.68,22.09 12.31,22.1 12.71,21.71L21.71,12.71C22.1,12.32 22.1,11.68 21.71,11.29Z'/>
                                                                                                                                          </svg>
                                                                                                                                        </button>
                                                                                                                                        <div id='ocKrajWrap' class='oc-kraj-wrap'>
                                                                                                                                          <button type='button' id='ocKrajBtn' class='oc-kraj-btn' title='Filtrovat kraje' aria-label='Filtrovat kraje' aria-haspopup='listbox'>
                                                                                                                                            <span id='ocKrajBtnLabel'>Kraj</span>
                                                                                                                                            <svg class='oc-kraj-chevron' viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M7,10L12,15L17,10H7Z'/></svg>
                                                                                                                                          </button>
