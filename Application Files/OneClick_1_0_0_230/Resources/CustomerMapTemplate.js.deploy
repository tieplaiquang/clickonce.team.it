                                                                                                                          <button type='button' id='ocRouteSwap' class='oc-route-swap-btn' title='Prohodit výchozí bod a cíl' aria-label='Prohodit výchozí bod a cíl'>
                                                                                                                            <svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M9,3L5,7H8V14H10V7H13M16,17V10H14V17H11L15,21L19,17H16Z'/></svg>
                                                                                                                          </button>
