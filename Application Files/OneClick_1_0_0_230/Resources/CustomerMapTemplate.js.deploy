                                                                                                                              <svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z'/></svg>
                                                                                                                            </span>
                                                                                                                            <span class='oc-route-add-stop-text'>Přidat cíl</span>
                                                                                                                          </button>
</div>`;

        const wrapBox = wrap.querySelector('#ocSearchWrap');
        const input = wrap.querySelector('#ocSearchBox');
        const btnGo = wrap.querySelector('#ocSearchGo');
        const btnRoute = wrap.querySelector('#ocRouteBtn');
        const btnClear = wrap.querySelector('#ocSearchClear');

        // === Combobox lọc kraj — điền option + xử lý đổi kraj ngay trong map ===
        const krajWrap = wrap.querySelector('#ocKrajWrap');
        const krajBtn = wrap.querySelector('#ocKrajBtn');
        const krajListEl = wrap.querySelector('#ocKrajList');
        const krajBtnLabel = wrap.querySelector('#ocKrajBtnLabel');
        let closeKrajDd = function () { }; // gán thật bên dưới nếu kraj UI tồn tại — khai báo ở đây để search input cũng gọi được
        if (krajWrap && krajBtn && krajListEl) {
            L.DomEvent.disableClickPropagation(krajWrap);
            L.DomEvent.disableClickPropagation(krajListEl);

            const krajOptions = [{ code: 'ALL', name: 'Všechny kraje' }]
                .concat(Object.keys(KRAJ_DATA).map(code => ({ code, name: KRAJ_DATA[code].name })));

            closeKrajDd = function () {
                krajWrap.classList.remove('open');
                wrapBox.classList.remove('kraj-open');
                krajListEl.classList.remove('open');
                wrapBox.style.height = '';
                wrapBox.style.maxHeight = '';
            }
            function openKrajDd() {
                // Đóng list gợi ý tìm kiếm chính để tránh chồng nhau khi mở kraj
                if (list) list.style.display = 'none';
                krajWrap.classList.add('open');
                wrapBox.classList.add('kraj-open');
                krajListEl.classList.add('open');
                recalcListMaxHeight();
            }
            function selectKraj(code, name) {
                if (krajBtnLabel) krajBtnLabel.textContent = name;
                closeKrajDd();
                applyKrajFilter(code);
            }

            krajOptions.forEach(({ code, name }) => {
                const li = document.createElement('li');
                li.className = 'oc-search-item';
                li.setAttribute('role', 'option');
                li.innerHTML = `
                  <svg class='oc-search-icon' viewBox='0 0 24 24' aria-hidden='true' style='color:#616161'>
                    <path d='M12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5M12,2A7,7 0 0,1 19,9C19,14.25 12,22 12,22C12,22 5,14.25 5,9A7,7 0 0,1 12,2M12,4A5,5 0 0,0 7,9C7,10 7,12 12,18.71C17,12 17,10 17,9A5,5 0 0,0 12,4Z'
                        fill='currentColor' fill-rule='evenodd'/>
                  </svg>
                  <div><div class='oc-search-name'><span class='oc-name'>${esc(name)}</span></div></div>`;
                li.addEventListener('mousedown', (ev) => { ev.preventDefault(); selectKraj(code, name); });
                krajListEl.appendChild(li);
            });

            krajBtn.addEventListener('click', () => {
                if (krajWrap.classList.contains('open')) closeKrajDd(); else openKrajDd();
            });
            document.addEventListener('pointerdown', (ev) => {
                if (krajWrap.classList.contains('open') && !krajWrap.contains(ev.target) && !krajListEl.contains(ev.target)) closeKrajDd();
            }, true);
        }

        // === Icons & state cho nút Trasa ===
        const ICON_ROUTE = `
                                                                                                                          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                            <path fill='currentColor' d='M14,14.5V12H10V15H8V11A1,1 0 0,1 9,10H14V7.5L17.5,11M21.71,11.29L12.71,2.29H12.7C12.31,1.9 11.68,1.9 11.29,2.29L2.29,11.29C1.9,11.68 1.9,12.32 2.29,12.71L11.29,21.71C11.68,22.09 12.31,22.1 12.71,21.71L21.71,12.71C22.1,12.32 22.1,11.68 21.71,11.29Z'/>
                                                                                                                          </svg>`;
        const ICON_CLOSE = `
                                                                                                                          <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                            <path fill='currentColor' d='M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z'/>
                                                                                                                          </svg>`;
        let isRouteMode = false;
        // ép icon khởi tạo (ghi đè cái SVG tĩnh trong HTML)
        btnRoute.innerHTML = ICON_ROUTE;
        btnRoute.title = T.directions;
        btnRoute.setAttribute('aria-label', T.directions);

        const list = wrap.querySelector('#ocSearchList');
        const route = wrap.querySelector('#ocRoutePanel');

        // Route refs
        const routeFrom = wrap.querySelector('#ocRouteFrom');
        const routeTo = wrap.querySelector('#ocRouteTo');
        const routeDd = wrap.querySelector('#ocRouteDd');
        const routeList = wrap.querySelector('#ocRouteList');

        // ===== Route engine (OSRM, driving) =====
        let routeFromPoint = null;   // { lat, lon, label }
        let routeToPoint = null;
        let routeExtraStops = [];    // [{ point, rowEl }]  — cíle přidané přes "+ Přidat cíl"
        let routeLineLayer = null;
        let routeEndpointMarkers = [];
        let routeHoverDot = null;
        let routeTrafficLayers = [];
        let routeReqSeq = 0;

        const TOMTOM_KEY = 'GElHw3tQzvJrXFI1iS2HV3db16OHw9Fj';
        const ICON_CAR = `<svg viewBox='0 0 24 24' aria-hidden='true' style='width:16px;height:16px;vertical-align:-3px;margin-right:4px'>
                                                                                                                          <path fill='currentColor' d='M5,11L6.5,6.5H17.5L19,11M17.5,16A1.5,1.5 0 0,1 16,14.5A1.5,1.5 0 0,1 17.5,13A1.5,1.5 0 0,1 19,14.5A1.5,1.5 0 0,1 17.5,16M6.5,16A1.5,1.5 0 0,1 5,14.5A1.5,1.5 0 0,1 6.5,13A1.5,1.5 0 0,1 8,14.5A1.5,1.5 0 0,1 6.5,16M18.92,6C18.72,5.42 18.16,5 17.5,5H6.5C5.84,5 5.28,5.42 5.08,6L3,12V20A1,1 0 0,0 4,21H5A1,1 0 0,0 6,20V19H18V20A1,1 0 0,0 19,21H20A1,1 0 0,0 21,20V12L18.92,6Z'/>
                                                                                                                        </svg>`;
        const ICON_STOP_REMOVE = `<svg viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                          <path fill='currentColor' d='M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z'/>
                                                                                                                        </svg>`;
        const ICON_MYLOC = `<svg viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                          <path fill='currentColor' d='M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M20,11H22V13H20V11M2,11H4V13H2V11M11,2H13V4H11V2M11,20H13V22H11V20Z'/>
                                                                                                                        </svg>`;
        const ICON_DRAG_HANDLE = `<svg viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                          <path fill='currentColor' d='M9,3A2,2 0 0,1 11,5A2,2 0 0,1 9,7A2,2 0 0,1 7,5A2,2 0 0,1 9,3M9,9A2,2 0 0,1 11,11A2,2 0 0,1 9,13A2,2 0 0,1 7,11A2,2 0 0,1 9,9M9,15A2,2 0 0,1 11,17A2,2 0 0,1 9,19A2,2 0 0,1 7,17A2,2 0 0,1 9,15M15,3A2,2 0 0,1 17,5A2,2 0 0,1 15,7A2,2 0 0,1 13,5A2,2 0 0,1 15,3M15,9A2,2 0 0,1 17,11A2,2 0 0,1 15,13A2,2 0 0,1 13,11A2,2 0 0,1 15,9M15,15A2,2 0 0,1 17,17A2,2 0 0,1 15,19A2,2 0 0,1 13,17A2,2 0 0,1 15,15Z'/>
                                                                                                                        </svg>`;
        const ICON_ROUTE_DOT = `<svg viewBox='0 0 24 24' aria-hidden='true' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='5'/></svg>`;
        const ICON_ROUTE_PIN = `<svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2M12,6A2,2 0 0,0 10,8A2,2 0 0,0 12,10A2,2 0 0,0 14,8A2,2 0 0,0 12,6Z'/></svg>`;
        function makeConnectorEl() {
            const el = document.createElement('div');
            el.className = 'oc-route-connector';
            el.innerHTML = `
                                                                                                                                <div class='oc-route-connector-spacer'></div>
                                                                                                                                <div class='oc-route-connector-dots'>
                                                                                                                                  <span class='oc-route-connector-dot'></span>
                                                                                                                                  <span class='oc-route-connector-dot'></span>
                                                                                                                                  <span class='oc-route-connector-dot'></span>
                                                                                                                                </div>`;
            return el;
        }
        function refreshRouteMarkerIcons() {
            routeStopsContainer.querySelectorAll('.oc-route-connector').forEach(el => el.remove());

            const rows = Array.from(routeStopsContainer.children).filter(el => el.classList.contains('oc-route-row-stop'));
            const canRemove = rows.length >= 3;
            swapBtn?.classList.toggle('show', rows.length === 2);
            routeStopsContainer.classList.toggle('oc-route-stops-no-remove-gutter', !canRemove);

            rows.forEach((row, i) => {
                const isLast = i === rows.length - 1;

                const slot = row.querySelector('.oc-route-marker-icon-slot');
                if (slot) {
                    slot.className = 'oc-route-marker-icon-slot' + (isLast ? ' is-pin' : '');
                    slot.innerHTML = isLast ? ICON_ROUTE_PIN : ICON_ROUTE_DOT;
                }

                const removeBtn = row.querySelector('.oc-route-stop-remove');
                if (removeBtn) removeBtn.classList.toggle('oc-route-stop-remove-enabled', canRemove);

                if (i < rows.length - 1) row.after(makeConnectorEl());
            });
        }

        // ===== Drag & drop reorder cílů =====
        let dragSrcRow = null;
        function wireDragReorder(rowDiv, handleEl) {
            if (handleEl) {
                handleEl.draggable = true;
                handleEl.addEventListener('dragstart', (ev) => {
                    dragSrcRow = rowDiv;
                    rowDiv.classList.add('oc-route-row-dragging');
                    try { ev.dataTransfer.effectAllowed = 'move'; ev.dataTransfer.setData('text/plain', ''); } catch (_) { }
                });
                handleEl.addEventListener('dragend', () => {
                    rowDiv.classList.remove('oc-route-row-dragging');
                    routeStopsContainer.querySelectorAll('.oc-route-drop-before,.oc-route-drop-after')
                        .forEach(el => el.classList.remove('oc-route-drop-before', 'oc-route-drop-after'));
                    dragSrcRow = null;
                });
            }
            // Vždy funguje jako cíl dropu (i řádky bez rukojeti — Odkud/Cíl), aby na ně šlo přetáhnout jiný bod.
            rowDiv.addEventListener('dragover', (ev) => {
                if (!dragSrcRow || dragSrcRow === rowDiv) return;
                ev.preventDefault();
                const rect = rowDiv.getBoundingClientRect();
                const after = (ev.clientY - rect.top) > rect.height / 2;
                rowDiv.classList.toggle('oc-route-drop-after', after);
                rowDiv.classList.toggle('oc-route-drop-before', !after);
            });
            rowDiv.addEventListener('dragleave', () => {
                rowDiv.classList.remove('oc-route-drop-before', 'oc-route-drop-after');
            });
            rowDiv.addEventListener('drop', (ev) => {
                ev.preventDefault();
                if (!dragSrcRow || dragSrcRow === rowDiv) return;
                const rect = rowDiv.getBoundingClientRect();
                const after = (ev.clientY - rect.top) > rect.height / 2;
                routeStopsContainer.insertBefore(dragSrcRow, after ? rowDiv.nextSibling : rowDiv);
                rowDiv.classList.remove('oc-route-drop-before', 'oc-route-drop-after');
                refreshRouteMarkerIcons();
                tryComputeRoute();
            });
        }
        function getOrderedStopRefs() {
            return Array.from(routeStopsContainer.children).map(row => {
                if (row.id === 'ocRouteFromRow') {
                    return {
                        point: routeFromPoint,
                        setPoint: (p) => { routeFromPoint = p; routeFrom.value = p.label || ''; }
                    };
                }
                if (row.id === 'ocRouteToRow') {
                    return {
                        point: routeToPoint,
                        setPoint: (p) => { routeToPoint = p; routeTo.value = p.label || ''; }
                    };
                }
                const stop = routeExtraStops.find(s => s.rowEl === row);
                if (!stop) return null;
                return {
                    point: stop.point,
                    setPoint: (p) => {
                        stop.point = p;
                        const inp = stop.rowEl.querySelector('input');
                        if (inp) inp.value = p.label || '';
                    }
                };
            }).filter(Boolean);
        }

        // ===== Điền ô routing đang focus khi bấm marker khách trên map =====
        let focusedRouteRef = null;
        function setFocusedRouteRef(ref) { focusedRouteRef = ref; }
        wrap.__fillFocusedRouteField = function (point) {
            if (!focusedRouteRef) return false;
            focusedRouteRef.setPoint(point);
            return true;
        };

        // ===== "Moje poloha" jako volba v seznamu, když je pole prázdné =====
        let pendingMyLocationApply = null;
        function applyOrDeferMyLocation(applyFn) {
            if (lastMyPos) { applyFn(lastMyPos); }
            else { pendingMyLocationApply = applyFn; try { doLocate(); } catch (_) { } }
        }
        wrap.__resolvePendingMyLocation = function (pos) {
            if (!pendingMyLocationApply) return;
            const fn = pendingMyLocationApply;
            pendingMyLocationApply = null;
            fn(pos);
        };
        wrap.__cancelPendingMyLocation = function () {
            pendingMyLocationApply = null;
            setRouteSummary('Polohu se nepodařilo zjistit.');
        };
        function buildMyLocationLi(accent, onPick) {
            const li = document.createElement('li');
            li.className = 'oc-search-item';
            li.setAttribute('role', 'option');
            li.innerHTML = `
                                                                                                                              <svg class='oc-search-icon' viewBox='0 0 24 24' aria-hidden='true' style='color:${accent}'>${ICON_MYLOC.replace(/^<svg[^>]*>|<\/svg>$/g, '')}</svg>
                                                                                                                              <div style='min-width:0'><div class='oc-search-name'><span class='oc-name'>${esc(T.myLocation)}</span></div></div>`;
            li.addEventListener('mousedown', (ev) => { ev.preventDefault(); onPick(); });
            return li;
        }
        function setRouteSummary(text, withCarIcon) {
            if (!text) { setFloatingRouteSummary(''); return; }
            setFloatingRouteSummary((withCarIcon ? ICON_CAR : '') + `<span>${esc(text)}</span>`, true);
        }
        function clearRouteLine() {
            if (routeLineLayer) { map.removeLayer(routeLineLayer); routeLineLayer = null; }
            if (routeHoverDot) { map.removeLayer(routeHoverDot); routeHoverDot = null; }
            routeTrafficLayers.forEach(l => map.removeLayer(l));
            routeTrafficLayers = [];
            routeEndpointMarkers.forEach(m => map.removeLayer(m));
            routeEndpointMarkers = [];
            // trasa xong/hủy → hiện lại toàn bộ khách + tečku skutečné polohy
            if (!map.hasLayer(clusters)) map.addLayer(clusters);
            if (meMarker && !map.hasLayer(meMarker)) map.addLayer(meMarker);
            if (meAccCircle && !map.hasLayer(meAccCircle)) map.addLayer(meAccCircle);
        }
        function makeDraggableStopMarker(point, icon, tooltip, onMoved) {
            const marker = L.marker([point.lat, point.lon], { icon, zIndexOffset: 1000, draggable: true }).addTo(map);
            if (point.customerData) {
                marker.bindPopup(popupHtml(point.customerData), { className: 'oc-popup', maxWidth: 1200, autoPan: true, keepInView: false, autoPanPadding: [24, 24], closeButton: false });
            } else if (tooltip) {
                marker.bindTooltip(tooltip);
            }
            marker.on('dragend', () => {
                const ll = marker.getLatLng();
                onMoved({ lat: ll.lat, lon: ll.lng, label: 'Vlastní bod' });
            });
            return marker;
        }
        function updateAddStopVisibility() {
            const refs = getOrderedStopRefs();
            const allFilled = refs.length >= 2 && refs.every(r => r.point);
            btnAddStop?.classList.toggle('show', allFilled);
            return allFilled;
        }
        async function tryComputeRoute() {
            clearRouteLine();

            // Tất cả pole (Odkud + cíle) jsou v jednom pořadí — 1. místo v DOM = start.
            // Km/min se zobrazí, jen když jsou VŠECHNY pole vyplněná.
            const refs = getOrderedStopRefs();
            const allFilled = updateAddStopVisibility();

            if (!allFilled) { setRouteSummary(''); return; }

            const points = refs.map(r => r.point);
            const seq = ++routeReqSeq;
            setRouteSummary('Počítám trasu…');

            try {
                const coordStr = points.map(p => `${p.lat},${p.lon}`).join(':');
                const url = `https://api.tomtom.com/routing/1/calculateRoute/${coordStr}/json?key=${TOMTOM_KEY}&traffic=true&sectionType=traffic&travelMode=car`;
                const res = await fetch(url);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                if (seq !== routeReqSeq) return;
                if (!data.routes || !data.routes.length) throw new Error('NO_ROUTE');

                const r = data.routes[0];
                const latlngs = r.legs.flatMap(leg => leg.points.map(p => [p.latitude, p.longitude]));
                routeLineLayer = L.polyline(latlngs, {
                    color: '#3730F5', weight: 8, opacity: 1, lineCap: 'round', lineJoin: 'round'
                }).addTo(map);

                // Tô màu đoạn tắc đường theo mức độ (magnitudeOfDelay: 1=nhẹ,2=vừa,3=nặng,4=tắc/đóng đường)
                const TRAFFIC_COLORS = { 1: '#FFEB3B', 2: '#FF9100', 3: '#FF1744', 4: '#D50000' };
                // simpleCategory riêng cho công trình/sửa đường và đóng đường — ưu tiên hơn màu theo mức độ chung
                const CATEGORY_COLORS = { ROAD_WORK: '#FF6F00', ROAD_CLOSURE: '#616161' };
                const CATEGORY_LABELS = { ROAD_WORK: 'Probíhá oprava silnice', ROAD_CLOSURE: 'Uzavírka silnice' };
                const ICON_ROADWORK = `<div class='oc-roadwork-marker'>
                                              <svg viewBox='0 0 576 512' aria-hidden='true'><path fill='#000' d='M208 64a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zM9.8 214.8c5.1-12.2 19.1-18 31.4-12.9L60.7 210l22.9-38.1C99.9 144.6 129.3 128 161 128c51.4 0 97 32.9 113.3 81.7l34.6 103.7 79.3 33.1 34.2-45.6c6.4-8.5 16.6-13.3 27.2-12.8s20.3 6.4 25.8 15.5l96 160c5.9 9.9 6.1 22.2 .4 32.2s-16.3 16.2-27.8 16.2l-256 0c-11.1 0-21.4-5.7-27.2-15.2s-6.4-21.2-1.4-31.1l16-32c5.4-10.8 16.5-17.7 28.6-17.7l32 0 22.5-30L22.8 246.2c-12.2-5.1-18-19.1-12.9-31.4zm82.8 91.8l112 48c11.8 5 19.4 16.6 19.4 29.4l0 96c0 17.7-14.3 32-32 32s-32-14.3-32-32l0-74.9-60.6-26-37 111c-5.6 16.8-23.7 25.8-40.5 20.2S-3.9 486.6 1.6 469.9l48-144 11-33 32 13.7z'/></svg>
                                            </div>`;

                (r.sections || []).forEach(s => {
                    if (s.sectionType !== 'TRAFFIC') return;
                    const category = s.simpleCategory;
                    const color = CATEGORY_COLORS[category] || TRAFFIC_COLORS[s.magnitudeOfDelay];
                    if (!color) return;
                    const seg = latlngs.slice(s.startPointIndex, s.endPointIndex + 1);
                    if (seg.length < 2) return;

                    const isSpecial = category === 'ROAD_WORK' || category === 'ROAD_CLOSURE';
                    routeTrafficLayers.push(
                        L.polyline(seg, {
                            color, weight: 8, opacity: .95, lineCap: 'round', lineJoin: 'round',
                            interactive: false, dashArray: category === 'ROAD_WORK' ? '10,6' : null
                        }).addTo(map)
                    );

                    if (isSpecial) {
                        const mid = seg[Math.floor(seg.length / 2)];
                        const marker = L.marker(mid, {
                            icon: L.divIcon({ className: 'oc-roadwork-icon', html: ICON_ROADWORK, iconSize: [30, 30], iconAnchor: [15, 15] }),
                            zIndexOffset: 900
                        }).bindTooltip(CATEGORY_LABELS[category], { direction: 'top' }).addTo(map);
                        routeTrafficLayers.push(marker);
                    }
                });

                // Hover trên tuyến đường → hiện khoảng cách từ điểm hover tới điểm đầu/cuối + chấm đánh dấu vị trí
                const hoverLatLngs = latlngs.map(ll => L.latLng(ll[0], ll[1]));
                const hoverCumDist = [0];
                for (let i = 1; i < hoverLatLngs.length; i++) {
                    hoverCumDist[i] = hoverCumDist[i - 1] + hoverLatLngs[i - 1].distanceTo(hoverLatLngs[i]);
                }
                const hoverTotalDist = hoverCumDist[hoverCumDist.length - 1] || 0;
                routeLineLayer.bindTooltip('', { sticky: true, direction: 'top', className: 'oc-route-hover-tip', opacity: 1 });
                routeLineLayer.on('mouseover', () => {
                    if (!routeHoverDot) {
                        routeHoverDot = L.circleMarker(hoverLatLngs[0], {
                            radius: 7, color: '#fff', weight: 2, fillColor: '#1a73e8', fillOpacity: 1, interactive: false
                        }).addTo(map);
                    }
                });
                routeLineLayer.on('mousemove', (e) => {
                    let bestIdx = 0, bestDist = Infinity;
                    for (let i = 0; i < hoverLatLngs.length; i++) {
                        const d = e.latlng.distanceTo(hoverLatLngs[i]);
                        if (d < bestDist) { bestDist = d; bestIdx = i; }
                    }
                    if (routeHoverDot) routeHoverDot.setLatLng(hoverLatLngs[bestIdx]);
                    const fromStart = (hoverCumDist[bestIdx] / 1000).toFixed(1);
                    const toEnd = ((hoverTotalDist - hoverCumDist[bestIdx]) / 1000).toFixed(1);
                    routeLineLayer.setTooltipContent(`Od začátku: ${fromStart} km · Do cíle: ${toEnd} km`);
                });
                routeLineLayer.on('mouseout', () => {
                    if (routeHoverDot) { map.removeLayer(routeHoverDot); routeHoverDot = null; }
                });

                // Trasa hiển thị → ẩn toàn bộ khách khác + tečku skutečné polohy (duplicitní s markerem "Start"), jen điểm đi/đến cho đỡ rối
                if (map.hasLayer(clusters)) map.removeLayer(clusters);
                if (meMarker && map.hasLayer(meMarker)) map.removeLayer(meMarker);
                if (meAccCircle && map.hasLayer(meAccCircle)) map.removeLayer(meAccCircle);

                const newMarkers = points.map((p, idx) => {
                    const isFirst = idx === 0;
                    const isLast = idx === points.length - 1;
                    const icon = isFirst ? myLocIcon : (isLast ? iconFromColor('#EA4335', '#B71C1C') : iconFromColor('#1A73E8', '#0D47A1'));
                    return makeDraggableStopMarker(p, icon, p.label || (isFirst ? 'Start' : ('Cíl ' + idx)), (moved) => {
                        refs[idx].setPoint(moved);
                        tryComputeRoute();
                    });
                });
                routeEndpointMarkers = newMarkers;

                map.fitBounds(routeLineLayer.getBounds(), { padding: [48, 48] });

                const km = (r.summary.lengthInMeters / 1000).toFixed(1);
                const totalMins = Math.round(r.summary.travelTimeInSeconds / 60);
                const h = Math.floor(totalMins / 60);
                const m = totalMins % 60;
                const durationText = h > 0 ? `${h} h ${m} min` : `${m} min`;
                setRouteSummary(`${km} km · ${durationText}`, true);
            } catch (err) {
                if (seq !== routeReqSeq) return;
                console.warn('TomTom route error:', err);
                setRouteSummary('Trasu se nepodařilo spočítat.');
            }
        }
        wrap.__tryComputeRoute = tryComputeRoute;

        // Navigovat z popup zákazníka → otevřít Trasu s cílem přednastaveným + Odkud = Moje poloha
        wrap.__navigateTo = function (lat, lon, label, customerData) {
            if (!isRouteMode) openRoutePanel();
            routeTo.value = label || '';
            routeToPoint = { lat, lon, label: label || '', customerData: customerData || null };

            if (!routeFromPoint) {
                applyOrDeferMyLocation((pos) => {
                    routeFrom.value = T.myLocation;
                    routeFromPoint = { lat: pos.lat, lon: pos.lng, label: T.myLocation };
                    tryComputeRoute();
                });
            }

            tryComputeRoute();
        };

        // ===== "+ Přidat cíl" — víceatoové trasy =====
        const routeStopsContainer = wrap.querySelector('#ocRouteStops');
        const btnAddStop = wrap.querySelector('#ocRouteAddStop');
        const swapBtn = wrap.querySelector('#ocRouteSwap');
        let routeStopSeq = 0;

        swapBtn?.addEventListener('click', () => {
            const fromVal = routeFrom.value, toVal = routeTo.value;
            const fromPt = routeFromPoint, toPt = routeToPoint;
            routeFrom.value = toVal;
            routeFromPoint = toPt;
            routeTo.value = fromVal;
            routeToPoint = fromPt;
            tryComputeRoute();
        });

        const routeFromRow = wrap.querySelector('#ocRouteFromRow');
        if (routeFromRow) wireDragReorder(routeFromRow, routeFromRow.querySelector('.oc-route-drag-handle'));
        routeFromRow?.querySelector('[data-clear-only]')?.addEventListener('click', () => {
            routeFrom.value = '';
            routeFromPoint = null;
            refreshRouteMarkerIcons();
            tryComputeRoute();
        });

        const routeToRow = wrap.querySelector('#ocRouteToRow');
        if (routeToRow) wireDragReorder(routeToRow, routeToRow.querySelector('.oc-route-drag-handle'));
        routeToRow?.querySelector('[data-clear-only]')?.addEventListener('click', () => {
            routeTo.value = '';
            routeToPoint = null;
            refreshRouteMarkerIcons();
            tryComputeRoute();
        });

        refreshRouteMarkerIcons();

        function createRouteAutocomplete(inputEl, ddEl, listEl, onPick) {
            let acMatches = [];
            let acActiveIdx = -1;
            let acCloseTimer = null;

            function close() {
                clearTimeout(acCloseTimer);
                ddEl.classList.remove('open', 'empty');
                inputEl.setAttribute('aria-expanded', 'false');
                inputEl.removeAttribute('aria-activedescendant');
                if (route) route.style.overflow = '';
                updateAddStopVisibility();
            }
            function closeSoon() {
                clearTimeout(acCloseTimer);
                acCloseTimer = setTimeout(() => {
                    const ae = document.activeElement;
                    if (ae !== inputEl && !ddEl.contains(ae)) close();
                }, 0);
            }
            function open(hasItems) {
                clearTimeout(acCloseTimer);
                ddEl.classList.add('open');
                ddEl.classList.toggle('empty', !hasItems);
                if (route) route.style.overflow = 'visible';
                btnAddStop?.classList.remove('show');
                inputEl.setAttribute('aria-expanded', 'true');
            }
            function render() {
                clearTimeout(acCloseTimer);
                const q = (inputEl.value || '').trim();
                if (!q) {
                    acMatches = [];
                    acActiveIdx = -1;
                    listEl.innerHTML = '';
                    listEl.appendChild(buildMyLocationLi(getSuggestionAccent(), () => {
                        close();
                        applyOrDeferMyLocation((pos) => {
                            inputEl.value = T.myLocation;
                            onPick({ lat: pos.lat, lon: pos.lng, label: T.myLocation });
                        });
                    }));
                    open(true);
                    recalcListMaxHeight();
                    return;
                }
                const all = routeFilter(q) || [];
                acMatches = all.slice(0, 5);
                acActiveIdx = -1;
                listEl.innerHTML = '';
                if (!acMatches.length) { close(); return; }

                const tokenList = q.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().split(/\s+/).filter(Boolean);
                const accent = getSuggestionAccent();

                acMatches.forEach((m, i) => {
                    const p = m.__p || {};
                    const li = document.createElement('li');
                    li.setAttribute('role', 'option');
                    li.className = 'oc-search-item';
                    const nameHtml = highlightMany(p.name || '', tokenList);
                    const icoHtml = highlightMany(p.ico || '', tokenList);
                    const addrHtml = highlightMany(p.addr || '', tokenList);
                    const vip = isVIPFlag(p);
                    li.innerHTML = `
                                                                                                                                  <svg class='oc-search-icon' viewBox='0 0 24 24' aria-hidden='true' style='color:${accent}'>
                                                                                                                                    <path d='M12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5M12,2A7,7 0 0,1 19,9C19,14.25 12,22 12,22C12,22 5,14.25 5,9A7,7 0 0,1 12,2M12,4A5,5 0 0,0 7,9C7,10 7,12 12,18.71C17,12 17,10 17,9A5,5 0 0,0 12,4Z'
                                                                                                                                          fill='currentColor' fill-rule='evenodd'/>
                                                                                                                                  </svg>
                                                                                                                                  <div style='min-width:0'>
                                                                                                                                    <div class='oc-search-name'>
                                                                                                                                      <span class='oc-name'>${nameHtml}</span>
                                                                                                                                      ${p.ico ? `<span class='oc-search-ico'>(${icoHtml})</span>` : ``}
                                                                                                                                      ${vip ? `<span class='oc-pill oc-pill-vip' title='${SEG_HINTS_CS.VIP}'>VIP</span>` : ``}
                                                                                                                                    </div>
                                                                                                                                    <div class='oc-search-sub'>${addrHtml}</div>
                                                                                                                                  </div>`;
                    li.addEventListener('mousedown', (ev) => { ev.preventDefault(); pick(i); });
                    listEl.appendChild(li);
                });
                open(true);
                recalcListMaxHeight();
            }
            function pick(i) {
                if (i < 0 || i >= acMatches.length) return;
                const marker = acMatches[i];
                const p = marker.__p || {};
                const ll = (typeof marker.getLatLng === 'function') ? marker.getLatLng() : { lat: p.lat, lng: p.lon };
                const point = { lat: ll.lat, lon: ll.lng, label: p.name || p.addr || '', customerData: p };
                inputEl.value = point.label;
                close();
                onPick(point);
            }
            function move(sel) {
                if (!acMatches.length) return;
                acActiveIdx = Math.max(0, Math.min(
                    (acActiveIdx < 0 ? (sel > 0 ? 0 : acMatches.length - 1) : acActiveIdx + sel),
                    Math.min(acMatches.length, 5) - 1
                ));
                [...listEl.children].forEach((li, idx) => li.classList.toggle('active', idx === acActiveIdx));
            }

            inputEl.addEventListener('input', debounce(() => {
                if (!inputEl.value.trim()) { onPick(null); }
                render();
            }, 120));
            inputEl.addEventListener('focus', () => {
                setFocusedRouteRef({ setPoint: (point) => { inputEl.value = point.label || ''; onPick(point); } });
                render();
            });
            inputEl.addEventListener('blur', closeSoon);
            inputEl.addEventListener('keydown', (ev) => {
                if (!ddEl.classList.contains('open')) return;
                if (ev.key === 'ArrowDown') { ev.preventDefault(); move(+1); }
                else if (ev.key === 'ArrowUp') { ev.preventDefault(); move(-1); }
                else if (ev.key === 'Enter') { ev.preventDefault(); if (acActiveIdx >= 0) pick(acActiveIdx); }
                else if (ev.key === 'Escape') { ev.preventDefault(); close(); }
            });
            document.addEventListener('pointerdown', (ev) => {
                if (ddEl.classList.contains('open') && !ddEl.contains(ev.target) && ev.target !== inputEl) close();
            }, true);

            return { close };
        }

        function addDestinationRow() {
            const rowDiv = document.createElement('div');
            rowDiv.className = 'oc-route-row oc-route-row-stop';
            rowDiv.innerHTML = `
                                                                                                                                <div class='oc-route-marker'>
                                                                                                                                  <button type='button' class='oc-route-drag-handle' title='Přetáhnout pro změnu pořadí' aria-label='Přetáhnout pro změnu pořadí'>${ICON_DRAG_HANDLE}</button>
                                                                                                                                  <span class='oc-route-marker-icon-slot'></span>
                                                                                                                                </div>
                                                                                                                                <div class='oc-route-input'>
                                                                                                                                  <input placeholder='Zadat další cíl' autocomplete='off'
                                                                                                                                         role='combobox' aria-autocomplete='list' aria-haspopup='listbox' aria-expanded='false'/>
                                                                                                                                  <div class='oc-route-dd' role='listbox'><ul class='oc-search-list'></ul></div>
                                                                                                                                </div>
                                                                                                                                <button type='button' class='oc-route-stop-remove' title='Odebrat cíl' aria-label='Odebrat cíl'>${ICON_STOP_REMOVE}</button>`;
            routeStopsContainer.appendChild(rowDiv);

            const inputEl = rowDiv.querySelector('input');
            const ddEl = rowDiv.querySelector('.oc-route-dd');
            const listEl = rowDiv.querySelector('ul');
            const removeBtn = rowDiv.querySelector('.oc-route-stop-remove');
            const handleEl = rowDiv.querySelector('.oc-route-drag-handle');
            wireDragReorder(rowDiv, handleEl);

            const stop = { point: null, rowEl: rowDiv };
            routeExtraStops.push(stop);

            createRouteAutocomplete(inputEl, ddEl, listEl, (point) => {
                stop.point = point;
                tryComputeRoute();
            });

            removeBtn.addEventListener('click', () => {
                rowDiv.remove();
                routeExtraStops = routeExtraStops.filter(s => s !== stop);
                refreshRouteMarkerIcons();
                tryComputeRoute();
            });

            refreshRouteMarkerIcons();
            updateAddStopVisibility();
            inputEl.focus({ preventScroll: true });
        }
        btnAddStop?.addEventListener('click', addDestinationRow);

        // ===== Route travel modes (chỉ UI) =====
        let ROUTE_TRAVEL_MODE = 'route'; // route | car | transit | walk | bike | air

        const modesBar = wrap.querySelector('.oc-route-modes');
        const modeBtns = modesBar ? Array.from(modesBar.querySelectorAll('.oc-mode-btn[data-mode]')) : [];

        function setRouteMode(mode) {
            ROUTE_TRAVEL_MODE = mode;
            modeBtns.forEach(b => {
                const on = (b.dataset.mode === mode);
                b.classList.toggle('active', on);
                b.setAttribute('aria-pressed', String(on));
            });
            // (chưa tính đường — để sau cắm vào engine route)
        }

        modeBtns.forEach(b => {
            b.addEventListener('click', () => {
                const mode = b.dataset.mode;
                setRouteMode(mode);
            });
        });

        const closeBtn = modesBar ? modesBar.querySelector('.oc-mode-close') : null;
        closeBtn?.addEventListener('click', () => {
            try { closeRoutePanel(); } catch (_) { }
        });

        // Khi mở Route lần đầu, đảm bảo trạng thái nút:
        setRouteMode(ROUTE_TRAVEL_MODE);

        // ⚠️ Đưa norm lên sớm để routeFilter dùng được
        const norm = s => normBase(s);

        let activeRouteField = null;   // 'from' | 'to' | null
        let routeMatches = [];
        let routeActiveIdx = -1;

        function clearRouteFields() {
            // xóa text + ARIA
            if (routeFrom) {
                routeFrom.value = '';
                routeFrom.setAttribute('aria-expanded', 'false');
                routeFrom.removeAttribute('aria-activedescendant');
            }
            if (routeTo) {
                routeTo.value = '';
                routeTo.setAttribute('aria-expanded', 'false');
                routeTo.removeAttribute('aria-activedescendant');
            }
            // đóng dropdown gợi ý của route
            if (routeDd) routeDd.classList.remove('open', 'empty');
            routeList.innerHTML = '';

            // reset state bên trong route
            routeMatches = [];
            routeActiveIdx = -1;
            activeRouteField = null;
            focusedRouteRef = null;

            // reset điểm đã chọn + xóa đường vẽ trên map
            routeFromPoint = null;
            routeToPoint = null;
            routeExtraStops.forEach(s => s.rowEl?.remove());
            routeExtraStops = [];
            refreshRouteMarkerIcons();
            btnAddStop?.classList.remove('show');
            clearRouteLine();
            setRouteSummary('');
        }

        function routeClose() {
            clearTimeout(routeCloseTimer);
            routeDd.classList.remove('open', 'empty');
            routeFrom?.setAttribute('aria-expanded', 'false');
            routeTo?.setAttribute('aria-expanded', 'false');
            routeFrom?.removeAttribute('aria-activedescendant');
            routeTo?.removeAttribute('aria-activedescendant');
            if (route) route.style.overflow = '';
            updateAddStopVisibility();
            recalcListMaxHeight();
        }

        let routeCloseTimer = null;

        function routeCloseSoon() {
            clearTimeout(routeCloseTimer);
            routeCloseTimer = setTimeout(() => {
                const ae = document.activeElement;
                // Chỉ đóng nếu focus không nằm trong 2 input hoặc bên trong dropdown
                if (ae !== routeFrom && ae !== routeTo && !routeDd.contains(ae)) {
                    routeClose();
                }
            }, 0);
        }

        function routeOpen(hasItems) {
            clearTimeout(routeCloseTimer);
            routeDd.classList.add('open');
            routeDd.classList.toggle('empty', !hasItems);
            if (route) route.style.overflow = 'visible';
            btnAddStop?.classList.remove('show');
            if (activeRouteField === 'from') routeFrom.setAttribute('aria-expanded', 'true');
            if (activeRouteField === 'to') routeTo.setAttribute('aria-expanded', 'true');
            recalcListMaxHeight();
        }
        function routeFilter(q) {
            return filterMatches(q);
        }
        function highlightMany(original, tokens) {
            if (!original) return '';
            // map ký tự có/không dấu → vị trí thật trong chuỗi gốc
            const normalizeWithMap = (s) => {
                const str = (s ?? '').toString();
                let normStr = '', map = [];
                for (let i = 0; i < str.length; i++) {
                    const d = str[i].normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                    for (let k = 0; k < d.length; k++) { normStr += d[k].toLowerCase(); map.push(i); }
                }
                return { str, norm: normStr, map };
            };

            const { str, norm: n, map } = normalizeWithMap(original);
            if (!tokens || !tokens.length) return esc(str);

            // gom các khoảng [start,end) của tất cả token rồi merge để tránh lồng <mark>
            let ranges = [];
            for (const t of tokens) {
                if (!t) continue;
                let pos = 0;
                while (true) {
                    const i = n.indexOf(t, pos);
                    if (i < 0) break;
                    const s = map[i];
                    const e = map[Math.min(i + t.length - 1, map.length - 1)] + 1;
                    ranges.push([s, e]);
                    pos = i + 1;
                }
            }
            if (!ranges.length) return esc(str);

            // merge chồng lấp
            ranges.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
            const merged = [];
            for (const r of ranges) {
                if (!merged.length || r[0] > merged[merged.length - 1][1]) {
                    merged.push(r.slice());
                } else {
                    merged[merged.length - 1][1] = Math.max(merged[merged.length - 1][1], r[1]);
                }
            }

            // lắp <mark>
            let out = '', prev = 0;
            for (const [s, e] of merged) {
                out += esc(str.slice(prev, s));
                out += '<mark>' + esc(str.slice(s, e)) + '</mark>';
                prev = e;
            }
            out += esc(str.slice(prev));
            return out;
        }
        function getSuggestionAccent() {
            if (!ACTIVE_FILTER_KEY) return '#616161';
            if (ACTIVE_FILTER_KEY === 'vip') return '#FFC107';
            const seg = SEG_META[ACTIVE_FILTER_KEY];
            return seg?.fill || '#616161';
        }
        function routeRender() {
            const src = (activeRouteField === 'from') ? routeFrom : routeTo;

            clearTimeout(routeCloseTimer);
            if (!src) { routeClose(); return; }

            const q = (src.value || '').trim();
            if (!q) {
                routeMatches = [];
                routeActiveIdx = -1;
                routeList.innerHTML = '';
                const field = activeRouteField;
                routeList.appendChild(buildMyLocationLi(getSuggestionAccent(), () => {
                    routeClose();
                    applyOrDeferMyLocation((pos) => {
                        const point = { lat: pos.lat, lon: pos.lng, label: T.myLocation };
                        if (field === 'from') { routeFrom.value = T.myLocation; routeFromPoint = point; }
                        else { routeTo.value = T.myLocation; routeToPoint = point; }
                        tryComputeRoute();
                    });
                }));
                routeOpen(true);
                recalcListMaxHeight();
                return;
            }

            // lấy danh sách đã chấm điểm và cắt TOP 5
            const all = routeFilter(q) || [];
            routeMatches = all.slice(0, 5);
            routeActiveIdx = -1;

            routeList.innerHTML = '';
            if (routeMatches.length === 0) { routeClose(); return; }

            const tokenList = q.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .toLowerCase().split(/\s+/).filter(Boolean);
            const accent = getSuggestionAccent();

            for (let i = 0; i < routeMatches.length; i++) {
                const m = routeMatches[i], p = m.__p || {};
                const li = document.createElement('li');
                li.id = 'oc-route-opt-' + i;
                li.setAttribute('role', 'option');
                li.setAttribute('aria-selected', String(i === routeActiveIdx));
                li.className = 'oc-search-item' + (i === routeActiveIdx ? ' active' : '');

                const nameHtml = highlightMany(p.name || '', tokenList);
                const icoHtml = highlightMany(p.ico || '', tokenList);
                const addrHtml = highlightMany(p.addr || '', tokenList);
                const vip = isVIPFlag(p);

                li.innerHTML = `
                                                                                                                              <svg class='oc-search-icon' viewBox='0 0 24 24' aria-hidden='true' style='color:${accent}'>
                                                                                                                                <path d='M12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5M12,2A7,7 0 0,1 19,9C19,14.25 12,22 12,22C12,22 5,14.25 5,9A7,7 0 0,1 12,2M12,4A5,5 0 0,0 7,9C7,10 7,12 12,18.71C17,12 17,10 17,9A5,5 0 0,0 12,4Z'
                                                                                                                                    fill='currentColor' fill-rule='evenodd'/>
                                                                                                                              </svg>
                                                                                                                              <div style='min-width:0'>
                                                                                                                                <div class='oc-search-name'>
                                                                                                                                  <span class='oc-name'>${nameHtml}</span>
                                                                                                                                  ${p.ico ? `<span class='oc-search-ico'>(${icoHtml})</span>` : ``}
                                                                                                                                  ${vip ? `<span class='oc-pill oc-pill-vip' title='${SEG_HINTS_CS.VIP}'>VIP</span>` : ``}
                                                                                                                                </div>
                                                                                                                                <div class='oc-search-sub'>${addrHtml}</div>
                                                                                                                              </div>`;
                li.addEventListener('mousedown', (ev) => { ev.preventDefault(); routePick(i); });
                routeList.appendChild(li);
            }

            routeOpen(true);
            recalcListMaxHeight();
        }
        function routePick(i) {
            if (i < 0 || i >= routeMatches.length) return;
            const marker = routeMatches[i];
            const p = marker.__p || {};
            const ll = (typeof marker.getLatLng === 'function') ? marker.getLatLng() : { lat: p.lat, lng: p.lon };
            const point = { lat: ll.lat, lon: ll.lng, label: p.name || p.addr || '' };

            if (activeRouteField === 'from') {
                routeFrom.value = point.label;
                routeFromPoint = point;
                routeTo.focus({ preventScroll: true });
                activeRouteField = 'to';
                routeRender();
            } else {
                routeTo.value = point.label;
                routeToPoint = point;
                routeClose();
            }
            try { focusToItem(i, true); } catch (_) { }
            try {
                const payload = { type: 'routeFieldPick', field: activeRouteField, id: p.id, name: p.name };
                window.chrome?.webview?.postMessage?.(JSON.stringify(payload));
            } catch (_) { }
            tryComputeRoute();
        }
        const onFromInput = debounce(() => {
            activeRouteField = 'from';
            if (!routeFrom.value.trim()) { routeFromPoint = null; tryComputeRoute(); }
            routeRender();
        }, 120);
        const onToInput = debounce(() => {
            activeRouteField = 'to';
            if (!routeTo.value.trim()) { routeToPoint = null; tryComputeRoute(); }
            routeRender();
        }, 120);
        routeFrom.addEventListener('input', onFromInput);
        routeTo.addEventListener('input', onToInput);
        routeFrom.addEventListener('focus', () => {
            activeRouteField = 'from';
            setFocusedRouteRef({ setPoint: (point) => { routeFrom.value = point.label || ''; routeFromPoint = point; tryComputeRoute(); } });
            routeRender();
        });
        routeTo.addEventListener('focus', () => {
            activeRouteField = 'to';
            setFocusedRouteRef({ setPoint: (point) => { routeTo.value = point.label || ''; routeToPoint = point; tryComputeRoute(); } });
            routeRender();
        });
        function routeMove(sel) {
            if (!routeMatches.length) return;
            routeActiveIdx = Math.max(0, Math.min(
                (routeActiveIdx < 0 ? (sel > 0 ? 0 : routeMatches.length - 1) : routeActiveIdx + sel),
                Math.min(routeMatches.length, 5) - 1
            ));
            [...routeList.children].forEach((li, idx) => {
                li.classList.toggle('active', idx === routeActiveIdx);
                const src = (activeRouteField === 'from') ? routeFrom : routeTo;
                if (idx === routeActiveIdx) src.setAttribute('aria-activedescendant', li.id);
            });
        }
        [routeFrom, routeTo].forEach(inp => {
            inp.addEventListener('keydown', (ev) => {
                if (routeDd.classList.contains('open')) {
                    if (ev.key === 'ArrowDown') { ev.preventDefault(); routeMove(+1); }
                    else if (ev.key === 'ArrowUp') { ev.preventDefault(); routeMove(-1); }
                    else if (ev.key === 'Enter') { ev.preventDefault(); if (routeActiveIdx >= 0) routePick(routeActiveIdx); }
                    else if (ev.key === 'Escape') { ev.preventDefault(); routeClose(); }
                }
            });
            // Dùng closeSoon để tránh race với focus vào ô kia/ vào dropdown
            inp.addEventListener('blur', routeCloseSoon);

            // Khi focus lại: hủy pending-close và render lại gợi ý ngay
            inp.addEventListener('focus', () => {
                clearTimeout(routeCloseTimer);
                activeRouteField = (inp === routeFrom) ? 'from' : 'to';
                routeRender(); // sẽ gọi routeOpen() nếu có kết quả
            });
        });
        document.addEventListener('pointerdown', (ev) => {
            if (routeDd.classList.contains('open')) {
                if (!routeDd.contains(ev.target) && ev.target !== routeFrom && ev.target !== routeTo) {
                    routeClose();
                }
            }
        }, true);

        // ===== Search core =====
        L.DomEvent.disableClickPropagation(wrap);
        L.DomEvent.disableScrollPropagation(wrap);
        L.DomEvent.disableScrollPropagation(list);

        let activeIdx = -1, matches = [];
        let suppressBlurHide = false, selectingFromList = false;

        function currentChipLabel() {
            if (!ACTIVE_FILTER_KEY) return '';
            return (ACTIVE_FILTER_KEY === 'vip') ? 'VIP' : (SEG_META[ACTIVE_FILTER_KEY]?.label || '');
        }
        function getSuggestionAccentSearch() {
            if (!ACTIVE_FILTER_KEY) return '#616161';
            if (ACTIVE_FILTER_KEY === 'vip') return '#FFC107';
            const seg = SEG_META[ACTIVE_FILTER_KEY];
            return seg?.fill || '#616161';
        }
        function updateGoState() { btnGo.disabled = input.value.trim().length === 0; btnGo.setAttribute('aria-disabled', String(btnGo.disabled)); }
        function showClear(_on) {
            // Không điều khiển icon trực tiếp ở đây nữa → dùng committed state
            updatePrimaryIcons();

            // Nếu list đang mở thì render lại (để per-item Trasa mini đúng trạng thái)
            requestAnimationFrame(() => {
                if (list && list.style.display !== 'none') {
                    const norm = s => normBase(s);
                    const isChip = (typeof SUGGEST_MODE !== 'undefined') && (SUGGEST_MODE === 'chip');
                    const lim = isChip ? 9999 : 5;
                    renderList(norm(input.value).split(/\s+/).filter(Boolean), lim);
                }
            });
        }
        function isCapToFive() {
            const wrap = window.__ocSearch; if (!wrap) return false;
            const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
            return wrapBox.classList.contains('open')
                && !wrapBox.classList.contains('route-mode')
                && !wrapBox.classList.contains('chip-mode')   // ← thêm dòng này
                && (typeof SUGGEST_MODE !== 'undefined')
                && (SUGGEST_MODE === 'search');
        }
        function setOpen(on) {
            wrapBox.classList.toggle('open', !!on);
            input.setAttribute('aria-expanded', !!on);

            // 👉 Search-mode (text) giới hạn 5 item: không ép height khung ngoài
            if (on && isCapToFive()) {
                wrapBox.style.height = '';
                wrapBox.style.maxHeight = '';
            }

            requestAnimationFrame(() => { recalcListMaxHeight(); repositionStats(); });
        }
        function hideLists() {
            list.style.display = 'none';

            const inRoute = wrapBox.classList.contains('route-mode');
            if (route && !inRoute) route.style.display = 'none';

            setOpen(inRoute ? true : false);

            // 🔽 rời chip-mode nếu không ở route
            if (!inRoute) setChipMode(false);

            input.removeAttribute('aria-activedescendant');
            if (!inRoute) { matches = []; activeIdx = -1; }
        }
        function renderList(qTokens, limit = 5) {
            const accent = getSuggestionAccentSearch();
            list.innerHTML = '';
            if (matches.length === 0) { hideLists(); return; }
            setChipMode(SUGGEST_MODE === 'chip');
            list.style.display = 'block'; setOpen(true);

            const token = (qTokens.sort((a, b) => b.length - a.length)[0] || '');
            const max = Math.min(matches.length, limit);

            // Hiển thị nút Trasa mini chỉ khi Clear đang hiện và KHÔNG ở route-mode
            const wantPerItemRoute = (btnClear.style.display !== 'none') && !wrapBox.classList.contains('route-mode');

            for (let i = 0; i < max; i++) {
                const m = matches[i]; const p = m.__p || {};
                const li = document.createElement('li');
                li.id = 'oc-opt-' + i;
                li.setAttribute('role', 'option');
                li.setAttribute('aria-selected', String(i === activeIdx));
                li.className = 'oc-search-item' + (i === activeIdx ? ' active' : '');

                const tokenList = (qTokens && qTokens.length ? qTokens : []);
                const nameHtml = highlightMany(p.name || '', tokenList);
                const icoHtml = highlightMany(p.ico || '', tokenList);
                const addrHtml = highlightMany(p.addr || '', tokenList);
                const vip = isVIPFlag(p);

                // HTML của item
                li.innerHTML = `
                                                                                                                              <svg class='oc-search-icon' viewBox='0 0 24 24' aria-hidden='true' style='color:${accent}'>
                                                                                                                                <path d='M12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5M12,2A7,7 0 0,1 19,9C19,14.25 12,22 12,22C12,22 5,14.25 5,9A7,7 0 0,1 12,2M12,4A5,5 0 0,0 7,9C7,10 7,12 12,18.71C17,12 17,10 17,9A5,5 0 0,0 12,4Z'
                                                                                                                                      fill='currentColor' fill-rule='evenodd'/>
                                                                                                                              </svg>
                                                                                                                              <div style='min-width:0'>
                                                                                                                                <div class='oc-search-name'>
                                                                                                                                  <span class='oc-name'>${nameHtml}</span>
                                                                                                                                  ${p.ico ? `<span class='oc-search-ico'>(${icoHtml})</span>` : ``}
                                                                                                                                  ${vip ? `<span class='oc-pill oc-pill-vip' title='${SEG_HINTS_CS.VIP}'>VIP</span>` : ``}
                                                                                                                                </div>
                                                                                                                                <div class='oc-search-sub'>${addrHtml}</div>
                                                                                                                              </div>
                                                                                                                              ${wantPerItemRoute ? `<button class="oc-suggest-route" title="${esc(T.directions)}" aria-label="${esc(T.directions)}">${ICON_ROUTE}</button>` : ``}
                                                                                                                            `;

                // Giữ hành vi chọn item bằng click như cũ
                li.addEventListener('mousedown', (ev) => {
                    ev.preventDefault();
                    input.value = p.name || '';
                    updateGoState();
                    showClear(true);
                    input.blur();
                    focusToItem(i, true);
                });

                // Gắn handler cho nút Trasa mini
                if (wantPerItemRoute) {
                    const mini = li.querySelector('.oc-suggest-route');
                    // Chặn “chọn item” và blur khi bấm mini
                    mini.addEventListener('mousedown', (ev) => { ev.preventDefault(); ev.stopPropagation(); });
                    mini.addEventListener('click', (ev) => {
                        ev.preventDefault(); ev.stopPropagation();

                        btnRoute.style.display = 'inline-flex';

                        // ✅ đóng list trước, rồi mở route-panel “đầy đủ” giống hình 2
                        hideLists();                // chỉ để tắt list
                        openRoutePanel();           // hàm này đã setOpen(true) + recalcListMaxHeight()

                        if (routeTo) routeTo.value = p.name || p.addr || '';
                        if (routeFrom) routeFrom.focus({ preventScroll: true });

                        const ll = (typeof m.getLatLng === 'function') ? m.getLatLng() : { lat: p.lat, lng: p.lon };
                        routeToPoint = { lat: ll.lat, lon: ll.lng, label: p.name || p.addr || '', customerData: p };
                        tryComputeRoute();

                        // Thông báo host (tuỳ cần)
                        try {
                            window.chrome?.webview?.postMessage?.(JSON.stringify({
                                type: 'routeMiniClick', id: p.id, name: p.name
                            }));
                        } catch (_) { }
                    });
                }

                list.appendChild(li);
            }

            if (activeIdx >= 0) input.setAttribute('aria-activedescendant', 'oc-opt-' + activeIdx);
            recalcListMaxHeight();
        }
        function filterMatches(q) {
            const qn = norm(q);
            const tokens = qn.split(/\s+/).filter(Boolean);
            if (tokens.length === 0) return [];

            const phrase = tokens.join(' ');
            const base = getBaseList();

            function scoreMarker(m) {
                const name = m.__nName || '';
                const ico = m.__nIco || '';
                const addr = m.__nAddr || '';
                const hay = m.__hay || '';

                // bắt buộc: mọi token đều phải có trong haystack
                for (const t of tokens) { if (!hay.includes(t)) return -1; }

                let s = 0;

                // cụm đầy đủ trong name
                const phrasePosName = name.indexOf(phrase);
                if (phrasePosName >= 0) { s += 120; s += Math.max(0, 20 - phrasePosName); }

                // cụm đầy đủ trong addr (ưu tiên thấp hơn name)
                const phrasePosAddr = addr.indexOf(phrase);
                if (phrasePosAddr >= 0) { s += 70; s += Math.max(0, 12 - phrasePosAddr); }

                // bắt đầu bằng token đầu ở name
                const t0 = tokens[0];
                const t0Pos = name.indexOf(t0);
                if (t0Pos === 0) s += 60; else if (t0Pos > 0) s += Math.max(0, 18 - t0Pos);

                // mật độ token trong name
                for (const t of tokens) {
                    const rx = new RegExp(t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
                    s += (name.match(rx) || []).length * 12;
                }

                // xuất hiện trong addr (điểm nhẹ hơn name)
                for (const t of tokens) {
                    if (addr.includes(t)) s += 6;
                }

                // xuất hiện trong ICO (nhẹ)
                for (const t of tokens) {
                    if (ico.includes(t)) s += 8;
                }

                if (m.__isVIP) s += 3;
                return s;
            }

            const scored = [];
            for (const m of base) {
                const sc = scoreMarker(m);
                if (sc >= 0) scored.push({ m, sc });
                if (scored.length >= 400) break;
            }

            // sort giảm dần theo điểm, hòa thì theo tên (ổn định)
            scored.sort((a, b) => b.sc - a.sc || (a.m.__p?.name || '').localeCompare(b.m.__p?.name || ''));

            // trả về tối đa 200 kết quả như cũ
            return scored.slice(0, 200).map(x => x.m);
        }
        const doUpdateSuggestions = () => {
            const now = performance.now();
            if (now < __suppressSuggestUntil) {
                // đang suppress → đóng & thoát
                try {
                    list.style.display = 'none';
                    const emptyEl = window.__ocSearch?.querySelector?.('#ocSearchEmpty');
                    if (emptyEl) emptyEl.style.display = 'none';
                    (window.__ocSearch?.querySelector?.('#ocSearchWrap') || window.__ocSearch)?.classList?.remove('open');
                } catch (_) { }
                return;
            }

            if (ACTIVE_FILTER_KEY && SUGGEST_MODE === 'chip') {
                matches = getBaseList();
                renderList([], 9999);
                updateGoState();
                setChipMode(true);
                return;
            }
            const q = input.value.trim();
            activeIdx = -1;
            showClear(q.length > 0);

            if (ACTIVE_FILTER_KEY) {
                const label = currentChipLabel();
                if (q === '' || q === label) {
                    matches = getBaseList();
                    renderList([], 9999);
                    updateGoState();
                    return;
                }
            }

            if (q.length < 1) {
                matches = [];
                hideLists();
                setActiveMarkers(ALL);
                updateGoState();
                return;
            }
            matches = filterMatches(q);
            if (matches.length === 0) {
                hideLists();
            } else {
                renderList(q.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').split(/\s+/).filter(Boolean));
            }
            updateGoState();
        };
        const updateSuggestions = debounce(doUpdateSuggestions, 120);

        function applySearchFilter() {
            const q = input.value.trim();
            if (q.length === 0) { hideLists(); return; }
            hideLists();
            if (!matches.length) { hideLists(); return; }
            setActiveMarkers(matches);
            if (matches.length === 1) {
                const p = matches[0].__p || {};
                input.value = p.name || '';
                updateGoState(); showClear(true); input.blur();
                focusToItem(0, true);
            } else {
                const latlngs = matches.map(m => m.getLatLng());
                const b = L.latLngBounds(latlngs);
                map.flyToBounds(b, { padding: [20, 20], animate: true, duration: 0.9, easeLinearity: 0.25 });
            }

            // ✅ chốt tìm kiếm → Clear hiện, Trasa ẩn
            setCommittedSearchState(true);
        }
        function focusToItem(idx, hideNow) {
            if (idx < 0 || idx >= matches.length) return;
            activeIdx = idx;
            const m = matches[idx];
            const ll = m.getLatLng();
            if (pendingSelectOnce) { map.off('moveend', pendingSelectOnce); pendingSelectOnce = null; }
            map.flyTo(ll, Math.max(map.getZoom(), 15), { animate: true, duration: 0.9, easeLinearity: 0.25 });
            pendingSelectOnce = () => { setSelected(m); pendingSelectOnce = null; };
            map.once('moveend', pendingSelectOnce);
            if (hideNow) { hideLists(); activeIdx = -1; matches = []; setCommittedSearchState(true); } else { const norm = s => normBase(s); renderList(norm(input.value).split(/\s+/).filter(Boolean)[0] || ''); }
        }

        input.addEventListener('input', updateSuggestions);
        input.addEventListener('focus', () => closeKrajDd());
        input.addEventListener('blur', () => {
            setTimeout(() => {
                if (suppressBlurHide && !selectingFromList) {
                    input.focus({ preventScroll: true });
                    return;
                }
                const ae = document.activeElement;
                if (!wrapBox.contains(ae)) {
                    hideLists();
                    // ✅ có chữ và không ở route-mode → coi như đã chốt
                    if (input.value.trim().length > 0 && !wrapBox.classList.contains('route-mode')) {
                        setCommittedSearchState(true);
                        updatePrimaryIcons();
                    }
                }
            }, 0);
        });
        input.addEventListener('focus', () => {
            if (ACTIVE_FILTER_KEY && SUGGEST_MODE === 'chip') {
                matches = getBaseList();
                openChipSuggestions();
            } else {
                const q = input.value.trim();
                if (q.length > 0) doUpdateSuggestions();
            }
        });
        input.addEventListener('keydown', (ev) => {
            if (ev.key === 'Enter') {
                ev.preventDefault();
                if (matches.length && activeIdx >= 0) {
                    const p = matches[activeIdx].__p || {};
                    input.value = p.name || input.value;
                    updateGoState(); showClear(true); input.blur();
                    focusToItem(activeIdx, true);
                    return;
                }
                if (input.value.trim().length === 0) return;
                applySearchFilter();
                return;
            }
            if (matches.length) {
                if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
                    ev.preventDefault();
                    if (SUGGEST_MODE === 'chip') {
                        matches = getBaseList();
                        activeIdx = Math.max(0, Math.min(ev.key === 'ArrowDown' ? activeIdx + 1 : activeIdx - 1, matches.length - 1));
                        renderList([], 9999);
                        return;
                    }
                    activeIdx = Math.max(0, Math.min(ev.key === 'ArrowDown' ? activeIdx + 1 : activeIdx - 1, matches.length - 1));
                    renderList(norm(input.value).split(/\s+/).filter(Boolean), 5);
                }
            }
            if (ev.key === 'Escape') { hideLists(); }
        });

        btnGo.addEventListener('click', applySearchFilter);

        function closeRoutePanel() {
            isRouteMode = false;
            wrapBox.classList.remove('route-mode');
            setChipMode(false);
            if (route) route.style.display = 'none';

            // trả icon & nhãn
            //btnRoute.innerHTML = ICON_ROUTE;
            //btnRoute.title = T.directions;
            //btnRoute.setAttribute('aria-label', T.directions);

            // Sau khi đóng route → chưa chốt → về trạng thái ban đầu (Trasa hiện, Clear ẩn)
            setCommittedSearchState(false);

            clearRouteFields();

            // quay về search/chip mode
            SUGGEST_MODE = (ACTIVE_FILTER_KEY ? 'chip' : 'search');
            setOpen(false);
            recalcListMaxHeight();
            repositionStats();
        }

        // cho phép nơi khác đóng route-panel
        wrap.__closeRoutePanel = closeRoutePanel;
        // (tuỳ chọn) tiện kiểm tra
        wrap.__isRouteMode = () => isRouteMode;

        // ======= ✅ openRoutePanel(): mở panel Trasa, ẩn list/empty, setOpen() và focus From
        function openRoutePanel(prefillToText) {
            if (isRouteMode) { closeRoutePanel(); return; }

            // Nếu có chip hoặc đã chốt: reset trước khi mở Route
            if (ACTIVE_FILTER_KEY || SEARCH_COMMITTED) {
                resetSearchUI();
            }

            try {
                SUGGEST_MODE = 'route';
                isRouteMode = true;
                setRouteMode('route'); // đưa về icon đầu (giống ảnh)
                setChipMode(false);
                wrapBox.classList.add('route-mode');

                if (list) list.style.display = 'none';
                if (route) {
                    route.style.display = 'block';
                    setOpen(true);
                    recalcListMaxHeight();
                    repositionStats();
                    route.scrollTop = 0;
                }

                // đổi icon → Close
                //btnRoute.innerHTML = ICON_CLOSE;
                //btnRoute.title = 'Zavřít';
                //btnRoute.setAttribute('aria-label', 'Zavřít');

                // Route-mode: Trasa hiện, Clear ẩn
                setCommittedSearchState(false);
                updatePrimaryIcons();

                // 💡 Điền sẵn "Kam" nếu có
                if (typeof prefillToText === 'string' && prefillToText.trim().length) {
                    routeTo.value = prefillToText.trim();
                }

                // ARIA + focus vào Odkud
                routeFrom?.setAttribute('aria-expanded', 'true');
                routeTo?.setAttribute('aria-expanded', 'false');

                routeFrom?.focus({ preventScroll: true });
            } catch (_) { }

            try { window.chrome?.webview?.postMessage?.(JSON.stringify({ type: 'routeUiClick' })); } catch (_) { }
        }

        // GẮN 1 LẦN DUY NHẤT – bấm Trasa chính
        btnRoute.addEventListener('click', () => {
            let prefill = (input?.value || '').trim();
            let prefillMarker = null;

            const listOpen = wrapBox.classList.contains('open') && list?.style.display !== 'none';
            if (listOpen && prefill.length && Array.isArray(matches) && matches.length) {
                const chosen = (typeof activeIdx === 'number' && activeIdx >= 0 && activeIdx < matches.length)
                    ? matches[activeIdx]
                    : matches[0];
                const p = chosen?.__p || {};
                prefill = p.name || p.addr || prefill;
                prefillMarker = chosen;
            } else if (prefill.length) {
                const best = filterMatches(prefill)[0];
                if (best) { const p = best.__p || {}; prefill = p.name || p.addr || prefill; prefillMarker = best; }
            } else {
                prefill = ''; // không “kế thừa” matches cũ
            }

            // mở Route + (nếu có) prefill vào Kam
            openRoutePanel(prefill);

            if (prefillMarker) {
                const p = prefillMarker.__p || {};
                const ll = (typeof prefillMarker.getLatLng === 'function') ? prefillMarker.getLatLng() : { lat: p.lat, lng: p.lon };
                routeToPoint = { lat: ll.lat, lon: ll.lng, label: prefill, customerData: p };
                tryComputeRoute();
            }

            // 🔹 sau khi dùng thì dọn state
            matches = [];
            activeIdx = -1;
        });

        // Clear
        btnClear.addEventListener('click', () => {
            // chặn gợi ý tự bật lại do debounce
            suppressSuggest(300);

            // đóng route nếu có + reset sạch
            closeRouteAndReset();

            // đảm bảo list/empty tắt hẳn
            const listEl = wrap.querySelector('#ocSearchList');
            const emptyEl = wrap.querySelector('#ocSearchEmpty');
            if (listEl) listEl.style.display = 'none';
            if (emptyEl) emptyEl.style.display = 'none';

            input.focus();
        });

        // Misc
        input.addEventListener('input', () => {
            const q = input.value.trim();
            if (ACTIVE_FILTER_KEY) {
                SUGGEST_MODE = (q === '' || q === currentChipLabel()) ? 'chip' : 'search';
            } else { SUGGEST_MODE = 'search'; }
            updateSuggestions();

            const inRoute = wrapBox.classList.contains('route-mode');
            if (!inRoute) setCommittedSearchState(false);
        });
        window.addEventListener('keydown', (ev) => { if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 'f') { ev.preventDefault(); input.focus(); input.select(); } });

        wrap.__applyFilter = (text, run = true) => { input.value = text ?? ''; doUpdateSuggestions(); if (run) applySearchFilter(); };
        wrap.__openChipSuggestions = () => { SUGGEST_MODE = 'chip'; matches = getBaseList(); activeIdx = -1; list.style.display = 'block'; setOpen(true); renderList([], 9999); list.scrollTop = 0; recalcListMaxHeight(); };

        // Giữ focus khi chọn list
        ['pointerdown', 'mousedown', 'touchstart'].forEach(evName => {
            list.addEventListener(evName, (ev) => { suppressBlurHide = true; selectingFromList = !!ev.target.closest('.oc-search-item'); }, { passive: true });
        });
        ['pointerup', 'mouseup', 'touchend', 'touchcancel', 'mouseleave'].forEach(evName => {
            list.addEventListener(evName, () => { setTimeout(() => { suppressBlurHide = false; selectingFromList = false; }, 0); }, { passive: true });
        });

        function __measureModesHeight(modes) {
            if (!modes) return 0;
            const prev = modes.style.display;
            modes.style.display = 'flex';                         // bật tạm để đo
            const h = Math.ceil(modes.getBoundingClientRect().height || 0);
            modes.style.display = prev || '';                     // trả lại trạng thái cũ
            return h;
        }

        function recalcListMaxHeight() {
            const mapEl = map.getContainer();
            const mRect = mapEl.getBoundingClientRect();

            const wrap = window.__ocSearch; if (!wrap) return;
            const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
            const inEl = wrap.querySelector('.oc-search-input') || wrap;
            const list = wrap.querySelector('#ocSearchList');
            const krajListEl = wrap.querySelector('#ocKrajList');
            const route = wrap.querySelector('#ocRoutePanel');
            const modes = wrap.querySelector('.oc-route-modes'); // <-- header route

            const inRect = inEl.getBoundingClientRect();

            const GAP = 8;   // khoảng cách ngay dưới input/header
            const MARGIN = 16;  // biên an toàn
            const BOTTOM_GAP = 4;  // chừa đáy map

            const csWrap = getComputedStyle(wrapBox);
            const padTop = parseFloat(csWrap.paddingTop) || 0;
            const padBottom = parseFloat(csWrap.paddingBottom) || 0;
            const padY = padTop + padBottom;

            // Không gian tối đa dưới input (khi search) hoặc dưới top của card (khi route)
            let avail = Math.max(
                120,
                Math.floor(mRect.bottom - inRect.bottom - GAP - MARGIN - padBottom - BOTTOM_GAP)
            );

            const listVisible = !!(list && list.style.display !== 'none');
            const inRouteMode = wrapBox.classList.contains('route-mode');
            const inChipMode = wrapBox.classList.contains('chip-mode');
            const inKrajOpen = wrapBox.classList.contains('kraj-open');

            // --- Chip-mode (segmentace) & Kraj: dùng CHUNG 1 công thức chừa đáy map (gấp đôi khoảng cách top)
            if (inChipMode || inKrajOpen) {
                const topGap = inRect.top - mRect.top;
                avail = Math.max(120, Math.floor(mRect.bottom - inRect.bottom - topGap * 2));
            }

            if (inKrajOpen && krajListEl) {
                krajListEl.style.maxHeight = avail + 'px';
                const boxH = Math.max(inRect.height + avail + padY, inRect.height + 120);
                wrapBox.style.height = boxH + 'px';
                wrapBox.style.maxHeight = boxH + 'px';
                return;
            }

            // --- Search text: cap 5 item chỉ khi KHÔNG chip-mode
            if (wrapBox.classList.contains('open') && list && listVisible && !inRouteMode && !inChipMode) {
                let itemH = 0;
                for (const child of list.children) {
                    if (child.classList?.contains('oc-search-item')) {
                        const r = child.getBoundingClientRect();
                        itemH = Math.max(itemH, r.height || 0);
                        if (itemH) break;
                    }
                }
                if (!itemH) itemH = 56;

                const count = Math.min(5, list.children.length || 0);
                const wantedListH = Math.max(0, Math.round(count * itemH));

                list.style.maxHeight = wantedListH + 'px';
                if (route) route.style.maxHeight = avail + 'px';

                wrapBox.style.height = '';
                wrapBox.style.maxHeight = '';
                return;
            }

            // --- Route-mode: full-height như panel (trừ chiều cao thanh chọn chế độ)
            let routeAvail = avail;
            if (inRouteMode && modes) {
                const mH = Math.ceil(modes.getBoundingClientRect().height || 0);
                routeAvail = Math.max(80, avail - mH);
            }

            if (wrapBox.classList.contains('open') && !inRouteMode) {
                const boxH = Math.max(inRect.height + avail + padY, inRect.height + 120);
                wrapBox.style.height = boxH + 'px';
                wrapBox.style.maxHeight = boxH + 'px';
            } else if (inRouteMode) {
                // Co dãn theo nội dung, nhưng nếu dropdown gợi ý của ô From/To đang mở thì
                // cộng thêm chiều cao của nó để card bao trọn (tránh dropdown lòi ra ngoài card)
                wrapBox.style.height = '';
                wrapBox.style.maxHeight = '';
                const openDd = wrap.querySelector('.oc-route-dd.open');
                if (openDd) {
                    const naturalH = wrapBox.getBoundingClientRect().height;
                    const ddH = Math.ceil(openDd.getBoundingClientRect().height || 0);
                    // + padBottom để khoảng cách dưới dropdown bằng khoảng cách trên (padding-top của card)
                    const wantedH = Math.min(naturalH + ddH + padBottom, inRect.height + avail + padY);
                    wrapBox.style.height = wantedH + 'px';
                    wrapBox.style.maxHeight = wantedH + 'px';
                }
            } else {
                wrapBox.style.height = '';
                wrapBox.style.maxHeight = '';
            }

            if (list) list.style.maxHeight = (inChipMode ? avail : (inRouteMode ? routeAvail : avail)) + 'px';
            if (route) route.style.maxHeight = routeAvail + 'px';

            // Dropdown gợi ý trong route (From/To)
            const rdd = wrap.querySelector('#ocRouteDd');
            if (rdd) {
                const ul = rdd.querySelector('.oc-search-list');
                if (ul) ul.style.maxHeight = routeAvail + 'px';
            }
        }

        window.addEventListener('resize', recalcListMaxHeight);
        map.on('resize zoomend moveend', recalcListMaxHeight);

        input.placeholder = T.placeholder;
        btnGo.title = T.search; btnGo.setAttribute('aria-label', T.search);
        btnRoute.title = T.directions; btnRoute.setAttribute('aria-label', T.directions);
        btnClear.title = T.clear; btnClear.setAttribute('aria-label', T.clear);
        const locateBtn = locateBtnEl; if (locateBtn) { locateBtn.title = T.myLocation; locateBtn.setAttribute('aria-label', T.myLocation); }

        if (!window.__ocBoundOutsideClose) {
            document.addEventListener('pointerdown', (ev) => { if (!wrapBox.contains(ev.target)) hideLists(); }, true);
            window.__ocBoundOutsideClose = true;
        }

        updateGoState();
        window.__ocSearch = wrap;
        return wrap;
    }
});
map.addControl(new SearchControl());
map.addControl(new StatsControl());

window.addEventListener('resize', reflow);
map.on('moveend zoomend resize', reflow);
requestAnimationFrame(repositionStats);

/* ===== Bridge tới .NET host ===== */
setTimeout(() => { map.invalidateSize(); updateZoomButtons(); }, 0);
window.addEventListener('resize', () => map.invalidateSize());
window.chrome?.webview?.addEventListener('message', e => { try { handleMessage(JSON.parse(e.data)); } catch (ex) { console.error(ex); } });
