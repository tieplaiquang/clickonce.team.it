
/* ===== MAP ===== */
const map = L.map('map', { doubleClickZoom: false, preferCanvas: true, zoomControl: false }).setView([49.8, 15.4], 7);
map.attributionControl.setPrefix('');
map.setMinZoom(1);
map.setMaxZoom(20);

/* OSM fallback */
const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, subdomains: 'abc', attribution: '' });
let usingFallback = false, zoomInBtn = null, zoomOutBtn = null;
function updateZoomButtons() { if (!zoomInBtn || !zoomOutBtn) return; const z = map.getZoom(); zoomOutBtn.disabled = (z <= map.getMinZoom()); zoomInBtn.disabled = (z >= map.getMaxZoom()); }
function switchToFallback(reason) {
    if (usingFallback) return;
    usingFallback = true;
    try { if (mtRaster && map.hasLayer(mtRaster)) map.removeLayer(mtRaster); } catch (_) { }
    if (!map.hasLayer(osmLayer)) osmLayer.addTo(map);
    map.setMaxZoom(18);
    if (map.getZoom() > 18) map.setZoom(18);
    updateZoomButtons();
    console.warn('Switched to OSM fallback due to:', reason);
}

/* MapTiler raster */
const MAP_ID = '{MAP_ID}';
const MAPTILER_KEY = '{MAPTILER_KEY}';
let mtRaster = null;
try {
    mtRaster = L.tileLayer(
        `https://api.maptiler.com/maps/{MAP_ID}/256/{z}/{x}/{y}.png?key={MAPTILER_KEY}`,
        { maxZoom: 20, tileSize: 256, zoomOffset: 0, crossOrigin: true, detectRetina: false, attribution: '' }
    ).addTo(map);
    mtRaster.on('tileerror', () => switchToFallback('raster-tileerror'));
    let watchdog = setTimeout(() => { if (!usingFallback) switchToFallback('raster-timeout'); }, 4000);
    mtRaster.on('tileload', () => { if (watchdog) { clearTimeout(watchdog); watchdog = null; } });
} catch (e) { console.warn('MapTiler raster init failed:', e); switchToFallback('raster-exception'); }

map.on('dblclick', e => { const next = Math.min(map.getZoom() + 2, map.getMaxZoom()); map.setView(e.latlng, next, { animate: true }); });

// Utils
function debounce(fn, ms) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn.apply(null, a), ms); }; }
const reflow = debounce(() => requestAnimationFrame(repositionStats), 80);
const updateStatsDeb = debounce(updateStats, 40);

/* ===== CLUSTERS / ICONS / SEGMENTS ===== */
const clusters = L.markerClusterGroup({
    chunkedLoading: true, chunkInterval: 50, chunkDelay: 25,
    removeOutsideVisibleBounds: true, animateAddingMarkers: false,
    maxClusterRadius: 60, disableClusteringAtZoom: 15,
    spiderfyOnMaxZoom: true, showCoverageOnHover: false,
    polygonOptions: { color: '#7FECEE', weight: 2, opacity: .9, fillColor: '#7FECEE', fillOpacity: .18 },
    iconCreateFunction: makeClusterIcon
});
map.addLayer(clusters);

const MDI_PIN_D =
    "M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z";
const MDI_SHADOW_D =
    "M20,19C20,21.21 16.42,23 12,23C7.58,23 4,21.21 4,19C4,17.71 5.22,16.56 7.11,15.83L7.75,16.74C6.67,17.19 6,17.81 6,18.5C6,19.88 8.69,21 12,21C15.31,21 18,19.88 18,18.5C18,17.81 17.33,17.19 16.25,16.74L16.89,15.83C18.78,16.56 20,17.71 20,19Z";

const PIN_W = 38;
const PIN_H = 56;
const PIN_ICON_SIZE = [PIN_W, PIN_H];
const PIN_ICON_ANCHOR = [Math.round(PIN_W / 2), PIN_H];
const PIN_POPUP_ANCHOR = [0, -Math.round(PIN_H * 0.8)];
const __iconCache = new Map();

function getIconCached(fill, stroke, opts) {
    const key = `${fill}|${stroke}|${opts.ring ? 'R' : ''}${opts.star ? 'S' : ''}`;
    let ico = __iconCache.get(key);
    if (!ico) {
        ico = L.icon({
            iconUrl: buildPinSvg(fill, stroke, opts),
            iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR
        });
        __iconCache.set(key, ico);
    }
    return ico;
}

function materialPin(fill, stroke) {
    const svg = `
                                                                                                                                  <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                                                                                                                                    <defs>
                                                                                                                                      <filter id='mdShadow' x='-50%' y='-50%' width='200%' height='200%'>
                                                                                                                                        <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                                                                                                                        <feOffset dx='0' dy='1' result='off'/>
                                                                                                                                        <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                                                                                                                        <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                                                                                                                                      </filter>
                                                                                                                                    </defs>
                                                                                                                                    <path filter='url(#mdShadow)'
                                                                                                                                          d='M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7z'
                                                                                                                                          fill='${fill}' stroke='${stroke}' stroke-width='1.25'/>
                                                                                                                                    <circle cx='12' cy='9' r='3' fill='white' fill-opacity='0.9'/>
                                                                                                                                  </svg>`;
    return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
}
function materialPinRadius(fill, stroke) {
    const svg = `
                                                                                                                                  <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                                                                                                                                    <defs>
                                                                                                                                      <filter id='mdShadow2' x='-50%' y='-50%' width='200%' height='200%'>
                                                                                                                                        <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                                                                                                                        <feOffset dx='0' dy='1' result='off'/>
                                                                                                                                        <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                                                                                                                        <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                                                                                                                                      </filter>
                                                                                                                                    </defs>

                                                                                                                                    <g shape-rendering='geometricPrecision'>
                                                                                                                                      <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='${fill}'  fill-opacity='0.42'/>
                                                                                                                                      <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='none'     stroke='${stroke}'
                                                                                                                                               stroke-opacity='0.95' stroke-width='0.6'/>
                                                                                                                                      <ellipse cx='12' cy='20.8' rx='5.8' ry='1.9'  fill='#fff' fill-opacity='0.10'/>
                                                                                                                                    </g>

                                                                                                                                    <path d='M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z'
                                                                                                                                          fill='${fill}' stroke='${stroke}' stroke-width='1.25' filter='url(#mdShadow2)'/>
                                                                                                                                    <circle cx='12' cy='8' r='2' fill='white' fill-opacity='0.9'/>
                                                                                                                                  </svg>`;
    return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
}
function materialPinStar(fill, stroke) {
    const svg = `
                                                                                                                                  <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                                                                                                                                    <defs>
                                                                                                                                      <filter id='mdShadow3' x='-50%' y='-50%' width='200%' height='200%'>
                                                                                                                                        <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                                                                                                                        <feOffset dx='0' dy='1' result='off'/>
                                                                                                                                        <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                                                                                                                        <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                                                                                                                                      </filter>
                                                                                                                                    </defs>
                                                                                                                                    <path filter='url(#mdShadow3)'
                                                                                                                                          d='M12 2C8.14 2 5 5.14 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.86-3.14-7-7-7z'
                                                                                                                                          fill='${fill}' stroke='${stroke}' stroke-width='1.25'/>
                                                                                                                                    <path d="M14.5 13L12 11.5L9.5 13L10.2 10.2L8 8.3L10.9 8.1L12 5.4L13.1 8L16 8.3L13.8 10.2L14.5 13Z"
                                                                                                                                      fill="#FFFFFF" stroke="${stroke}" stroke-opacity=".9" stroke-width=".7" stroke-linejoin="round" shape-rendering="geometricPrecision"/>
                                                                                                                                  </svg>`;
    return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
}
function materialPinRadiusStar(fill, stroke) {
    const svg = `
                                                                                                                                  <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                                                                                                                                    <defs>
                                                                                                                                      <filter id='mdShadow4' x='-50%' y='-50%' width='200%' height='200%'>
                                                                                                                                        <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                                                                                                                        <feOffset dx='0' dy='1' result='off'/>
                                                                                                                                        <feComponentTransfer><feFuncA type='linear' slope='0.35'/>
                                                                                                                                        </feComponentTransfer>
                                                                                                                                        <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                                                                                                                                      </filter>
                                                                                                                                    </defs>

                                                                                                                                    <g shape-rendering='geometricPrecision'>
                                                                                                                                      <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='${fill}'  fill-opacity='0.42'/>
                                                                                                                                      <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='none'     stroke='${stroke}'
                                                                                                                                               stroke-opacity='0.95' stroke-width='0.6'/>
                                                                                                                                      <ellipse cx='12' cy='20.8' rx='5.8' ry='1.9'  fill='#fff' fill-opacity='0.10'/>
                                                                                                                                    </g>

                                                                                                                                    <path d='M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z'
                                                                                                                                          fill='${fill}' stroke='${stroke}' stroke-width='1.25' filter='url(#mdShadow4)'/>
                                                                                                                                    <path d="M14.5 13L12 11.5L9.5 13L10.2 10.2L8 8.3L10.9 8.1L12 5.4L13.1 8L16 8.3L13.8 10.2L14.5 13Z"
                                                                                                                                      fill="#FFFFFF" stroke="${stroke}" stroke-opacity=".9" stroke-width=".7" stroke-linejoin="round" shape-rendering="geometricPrecision"/>
                                                                                                                                  </svg>`;
    return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
}

function buildPinSvg(fill, stroke, { ring = false, star = false } = {}) {
    const ringSvg = ring ? `
                                                                                                                                  <g shape-rendering='geometricPrecision'>
                                                                                                                                    <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='${fill}' fill-opacity='0.42'/>
                                                                                                                                    <ellipse cx='12' cy='20.8' rx='6.9' ry='2.35' fill='none' stroke='${stroke}'
                                                                                                                                             stroke-opacity='0.95' stroke-width='0.6'/>
                                                                                                                                    <ellipse cx='12' cy='20.8' rx='5.8' ry='1.9'  fill='#fff' fill-opacity='0.10'/>
                                                                                                                                  </g>` : ``;

    const starSvg = star ? `
                                                                                                                                  <path d="M14.5 13L12 11.5L9.5 13L10.2 10.2L8 8.3L10.9 8.1L12 5.4L13.1 8L16 8.3L13.8 10.2L14.5 13Z"
                                                                                                                                      fill="#FFFFFF"
                                                                                                                                      stroke="${stroke}" stroke-opacity=".9" stroke-width=".7"
                                                                                                                                      stroke-linejoin="round" shape-rendering="geometricPrecision"/>` : ``;

    const centerDot = !star ? `<circle cx='12' cy='8' r='2' fill='white' fill-opacity='0.9'/>` : ``;

    const svg = `
                                                                                                                                  <svg xmlns='http://www.w3.org/2000/svg' width='${PIN_W}' height='${PIN_H}' viewBox='0 0 24 24'>
                                                                                                                                    <defs>
                                                                                                                                      <filter id='mdShadowDyn' x='-50%' y='-50%' width='200%' height='200%'>
                                                                                                                                        <feGaussianBlur in='SourceAlpha' stdDeviation='1.25'/>
                                                                                                                                        <feOffset dx='0' dy='1' result='off'/>
                                                                                                                                        <feComponentTransfer><feFuncA type='linear' slope='0.35'/></feComponentTransfer>
                                                                                                                                        <feMerge><feMergeNode/><feMergeNode in='SourceGraphic'/></feMerge>
                                                                                                                                      </filter>
                                                                                                                                    </defs>
                                                                                                                                    ${ringSvg}
                                                                                                                                    <path d='M12,2C15.31,2 18,4.66 18,7.95C18,12.41 12,19 12,19C12,19 6,12.41 6,7.95C6,4.66 8.69,2 12,2Z'
                                                                                                                                          fill='${fill}' stroke='${stroke}' stroke-width='1.25' filter='url(#mdShadowDyn)'/>
                                                                                                                                    ${centerDot}
                                                                                                                                    ${starSvg}
                                                                                                                                  </svg>`;
    return 'data:image/svg+xml;charset=UTF-8,' + encodeURIComponent(svg);
}
function iconFromColor(fill, stroke, { ring = false, star = false } = {}) {
    return L.icon({ iconUrl: buildPinSvg(fill, stroke, { ring, star }), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
}

const defaultIcon = L.icon({ iconUrl: materialPin('#5E35B1', '#311B92'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
const selectedIcon = L.icon({ iconUrl: materialPin('#E53935', '#B71C1C'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
const verifiedIcon = L.icon({ iconUrl: materialPinRadius('#C0CA33', '#9E9D24'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
const vipIcon = L.icon({ iconUrl: materialPinStar('#FFC107', '#FF8F00'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });
const vipVerifiedIcon = L.icon({ iconUrl: materialPinRadiusStar('#C0CA33', '#9E9D24'), iconSize: PIN_ICON_SIZE, iconAnchor: PIN_ICON_ANCHOR, popupAnchor: PIN_POPUP_ANCHOR });

function esc(s) { return String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])); }
function truthyFlag(v) { if (typeof v === 'string') { const s = v.trim().toLowerCase(); return s === '1' || s === 'true' || s === 'yes' || s === 'y'; } return v === 1 || v === true; }
function isVIPFlag(p) { const v = p?.VIP ?? p?.vip ?? p?.Vip ?? p?.IsVIP ?? p?.isVip ?? p?.isVIP; return truthyFlag(v); }
function isVerifiedFlag(p) { const v = p?.IsVerified ?? p?.Verified ?? p?.ver ?? p?.verified; return truthyFlag(v); }

function getSegmentRaw(p) { return (p?.Segment ?? p?.segment ?? p?.seg ?? '').toString().trim(); }
const SEG_META = {
    'New': { cls: 'oc-seg-new', label: 'Nový', fill: '#00ACC1', stroke: '#00838F' },
    'Reactivated': { cls: 'oc-seg-reactivated', label: 'Znovu aktivní', fill: '#43A047', stroke: '#2E7D32' },
    'Regular': { cls: 'oc-seg-regular', label: 'Pravidelný', fill: '#1E88E5', stroke: '#1565C0' },
    'Occasional': { cls: 'oc-seg-occasional', label: 'Příležitostný', fill: '#8E24AA', stroke: '#6A1B9A' },
    'Risk': { cls: 'oc-seg-risk', label: 'Riziko', fill: '#FB8C00', stroke: '#EF6C00' },
    'Lost': { cls: 'oc-seg-lost', label: 'Ztracený', fill: '#9E9E9E', stroke: '#616161' },
    'Spy': { cls: 'oc-seg-spy', label: 'Bez nákupu', fill: '#6D4C41', stroke: '#4E342E' }
};
const SEG_HINTS_CS = {
    New: 'První nákup v posledních 30 dnech.',
    Reactivated: 'Po pauze delší než 60 dní znovu nakoupil v posledních 30 dnech.',
    Regular: 'Poslední nákup do 60 dní a alespoň dva doklady za posledních 90 dní.',
    Occasional: 'Poslední nákup do 60 dní, ale méně než dva doklady za posledních 90 dní.',
    Risk: 'Bez nákupu déle než 60 dní.',
    Lost: 'Bez nákupu déle než 180 dní nebo bez historie nákupů.',
    VIP: 'Obrat za posledních 12 měsíců přesahuje 200 000 Kč.',
    Verified: 'Adresa je v systému označená jako ověřená.',
    Spy: 'Zatím nemá žádné doklady nákupu.'
};
const SPY_SVG = `
                                                                                                                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="oc-chip-icon">
                                                                                                                                <path d="M17.06 13C15.2 13 13.64 14.33 13.24 16.1C12.29 15.69 11.42 15.8 10.76 16.09C10.35 14.31 8.79 13 6.94 13C4.77 13 3 14.79 3 17C3 19.21 4.77 21 6.94 21C9 21 10.68 19.38 10.84 17.32C11.18 17.08 12.07 16.63 13.16 17.34C13.34 19.39 15 21 17.06 21C19.23 21 21 19.21 21 17C21 14.79 19.23 13 17.06 13M6.94 19.86C5.38 19.86 4.13 18.58 4.13 17S5.39 14.14 6.94 14.14C8.5 14.14 9.75 15.42 9.75 17S8.5 19.86 6.94 19.86M17.06 19.86C15.5 19.86 14.25 18.58 14.25 17S15.5 14.14 17.06 14.14C18.62 14.14 19.88 15.42 19.88 17S18.61 19.86 17.06 19.86M22 10.5H2V12H22V10.5M15.53 2.63C15.31 2.14 14.75 1.88 14.22 2.05L12 2.79L9.77 2.05L9.72 2.04C9.19 1.89 8.63 2.17 8.43 2.68L6 9H18L15.56 2.68L15.53 2.63Z"/>
                                                                                                                              </svg>`;

const SEG_ORDER = ['New', 'Reactivated', 'Regular', 'Occasional', 'Risk', 'Lost', 'Spy'];
const SEG_COLORS = Object.fromEntries(SEG_ORDER.map(k => [k, SEG_META[k].fill]));
const __clusterHtmlCache = new Map();

function makeClusterIcon(cluster) {
    const markers = cluster.getAllChildMarkers();
    const counts = Object.fromEntries(SEG_ORDER.map(k => [k, 0]));
    for (const m of markers) { const key = (m.__segKey && counts.hasOwnProperty(m.__segKey)) ? m.__segKey : 'Occasional'; counts[key] += 1; }
    const total = markers.length || 1;
    const sizeBucket = total < 10 ? 'S' : (total < 100 ? 'M' : 'L');
    const signature = sizeBucket + '|' + SEG_ORDER.map(k => counts[k]).join(',');

    let cached = __clusterHtmlCache.get(signature);
    if (!cached) {
        let acc = 0; const parts = [];
        for (const k of SEG_ORDER) {
            const pct = counts[k] * 100 / total;
            if (pct > 0) { parts.push(`${SEG_COLORS[k]} ${acc}% ${acc + pct}%`); acc += pct; }
        }
        const bg = parts.length ? `conic-gradient(${parts.join(',')})` : '#9E9E9E';
        const size = sizeBucket === 'S' ? 36 : (sizeBucket === 'M' ? 44 : 52);
        const inner = Math.max(24, size - 12);
        const fz = Math.round(inner / 2.6);
        const html = `<div class='oc-pie' style='width:${size}px;height:${size}px;background-image:${bg}'><span style='width:${inner}px;height:${inner}px;font-size:${fz}px'>${total}</span></div>`;
        cached = { html, size }; __clusterHtmlCache.set(signature, cached);
    }
    return L.divIcon({ html: cached.html, className: 'marker-cluster oc-pie-mode', iconSize: L.point(cached.size, cached.size) });
}
function getSegmentMeta(p) { const key = getSegmentRaw(p); return SEG_META[key] || null; }

function popupHtml(p) {
    const name = esc(p.name), ico = esc(p.ico), addr = esc(p.addr);
    const v = isVerifiedFlag(p);
    const vip = isVIPFlag(p);
    const seg = getSegmentMeta(p);
    const segKey = getSegmentRaw(p);
    const segTip = SEG_HINTS_CS[segKey] || (seg?.label || '');
    const segIcon = (segKey === 'Spy') ? SPY_SVG : '';
    return `<div class='popup'>
                                                                                                                                  <div class='popup-title'>
                                                                                                                                    <span class='oc-title-name'>${name}</span>
                                                                                                                                    ${vip ? `<span class='oc-pill oc-pill-vip' title='${SEG_HINTS_CS.VIP}'>VIP</span>` : ``}
                                                                                                                                    ${seg ? `<span class='oc-pill oc-pill-seg ${seg.cls}' title='${segTip}'>${segIcon}${seg.label}</span>` : ``}
                                                                                                                                    ${v ? `<span class='oc-pill oc-pill-ver' title='${SEG_HINTS_CS.Verified}'>Ověřená</span>` : ``}
                                                                                                                                  </div>
                                                                                                                                  ${ico ? `<div class='popup-line'>IČO: <b>${ico}</b></div>` : ''}
                                                                                                                                  ${addr ? `<div class='popup-line'>${addr}</div>` : ''}
                                                                                                                                  <div class='popup-actions'>
                                                                                                                                    <button type='button' class='popup-navigate-btn' data-id='${esc(p.id)}' data-lat='${p.lat}' data-lon='${p.lon}' data-name='${name}'>
                                                                                                                                      <svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M21.71,11.29L12.71,2.29H12.7C12.31,1.9 11.68,1.9 11.29,2.29L2.29,11.29C1.9,11.68 1.9,12.32 2.29,12.71L11.29,21.71C11.68,22.09 12.31,22.1 12.71,21.71L21.71,12.71C22.1,12.32 22.1,11.68 21.71,11.29M14,14.5V12H10V15H8V11A1,1 0 0,1 9,10H14V7.5L17.5,11L14,14.5Z'/></svg>
                                                                                                                                      Navigovat
                                                                                                                                    </button>
                                                                                                                                  </div>
                                                                                                                                </div>`;
}

document.addEventListener('click', (ev) => {
    const btn = ev.target.closest('.popup-navigate-btn');
    if (!btn) return;
    const lat = parseFloat(btn.dataset.lat), lon = parseFloat(btn.dataset.lon);
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;
    const customerData = btn.dataset.id ? markerIndex.get(btn.dataset.id)?.__p : null;
    try { window.__ocSearch?.__navigateTo?.(lat, lon, btn.dataset.name || '', customerData); } catch (_) { }
});

const markerIndex = new Map();
const ALL = [];
let ACTIVE = [];
let statsEl = null;
let countBadgeEl = null;
function updateCountBadge() {
    if (!countBadgeEl) return;
    countBadgeEl.innerHTML = `<b>${ACTIVE.length}</b> z ${ALL.length} zákazníků`;
}
let selectedMarker = null;
let wantSelectedPopup = false;
let _ensureTimer = null;
let _lastZoom = map.getZoom();

function computeCounts(list) {
    const c = { total: 0, New: 0, Reactivated: 0, Regular: 0, Occasional: 0, Risk: 0, Lost: 0, Spy: 0, vip: 0, verified: 0 };
    for (const m of list) { c.total++; const seg = (m.__segKey && c.hasOwnProperty(m.__segKey)) ? m.__segKey : 'Occasional'; c[seg]++; if (m.__isVIP) c.vip++; if (m.__isVerified) c.verified++; }
    return c;
}
function chip(label, n, cls, key) {
    const title = (key === 'vip') ? SEG_HINTS_CS.VIP : (SEG_HINTS_CS[key] || label);
    const icon = (key === 'Spy') ? SPY_SVG : '';
    return `<span class='oc-pill ${cls}' data-key='${key}' role='button' tabindex='0' title='${title}'>
                                                                                                                                          ${icon}<span>${label}</span><b>${n}</b>
                                                                                                                                        </span>`;
}

let ACTIVE_FILTER_KEY = null;
let SUGGEST_MODE = 'search';

// Chặn render gợi ý ngay sau khi reset (debounce epoch)
let __suppressSuggestUntil = 0;
function suppressSuggest(ms = 220) {
    __suppressSuggestUntil = performance.now() + ms;
}

// ===== Committed state & icon orchestrator =====
let SEARCH_COMMITTED = false; // đã "chốt" tìm kiếm hay chưa

function updatePrimaryIcons() {
    const wrap = window.__ocSearch; if (!wrap) return;
    const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
    const btnRoute = wrap.querySelector('#ocRouteBtn');
    const btnClear = wrap.querySelector('#ocSearchClear');

    const inRoute = wrapBox.classList.contains('route-mode');

    if (inRoute) {
        if (btnRoute) btnRoute.style.display = 'none';  // <-- ẩn hẳn
        if (btnClear) btnClear.style.display = 'none';
        return;
    }

    if (btnRoute) btnRoute.style.display = SEARCH_COMMITTED ? 'none' : 'inline-flex';
    if (btnClear) btnClear.style.display = SEARCH_COMMITTED ? 'inline-flex' : 'none';
}

function setCommittedSearchState(on) {
    SEARCH_COMMITTED = !!on;
    updatePrimaryIcons();
    requestAnimationFrame(() => { recalcListMaxHeight(); repositionStats(); });
}

// Reset toàn bộ về trạng thái ban đầu
function resetSearchUI() {
    try {
        // ✅ Trả state về mặc định trước, không phụ thuộc UI
        ACTIVE_FILTER_KEY = null;
        refreshChipActive?.();
        setActiveMarkers?.(ALL);
        setSelected?.(null);
        SUGGEST_MODE = 'search';
        setCommittedSearchState?.(false);

        setChipMode?.(false);

        // Phần UI phía dưới có thể bỏ qua nếu wrap chưa sẵn sàng
        const wrap = window.__ocSearch; if (!wrap) return;

        const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
        const input = wrap.querySelector('#ocSearchBox');
        const listEl = wrap.querySelector('#ocSearchList');
        const emptyEl = wrap.querySelector('#ocSearchEmpty');
        const route = wrap.querySelector('#ocRoutePanel');

        if (input) {
            input.value = '';
            updateGoState?.();
            input.removeAttribute('aria-activedescendant');
        }

        // đóng UI phụ
        if (listEl) listEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'none';
        if (route && !wrapBox.classList.contains('route-mode')) route.style.display = 'none';
        wrapBox.classList.remove('open');

        // local biến gợi ý (nếu có)
        try { matches = []; activeIdx = -1; } catch (_) { }
        updatePrimaryIcons?.();
    } catch (_) { }
}

// Đóng route nếu đang mở, sau đó reset
function closeRouteAndReset() {
    try { window.__ocSearch?.__closeRoutePanel?.(); } catch (_) { }
    resetSearchUI();
}

function refreshChipActive() {
    if (!statsEl) return;
    statsEl.querySelectorAll('.oc-pill[data-key]').forEach(el => { el.classList.toggle('active', el.dataset.key === ACTIVE_FILTER_KEY); });
}
function applySegmentFilter(key) {
    const wrap = window.__ocSearch;
    const wrapBox = wrap?.querySelector?.('#ocSearchWrap') || wrap;

    // Nếu đang mở Route → đóng và reset trước
    if (wrapBox?.classList?.contains('route-mode')) {
        try { wrap.__closeRoutePanel?.(); } catch (_) { }
        resetSearchUI();
    }

    const prev = ACTIVE_FILTER_KEY;
    const turningOff = !!prev && (!key || key === prev);

    if (turningOff) {
        // ✅ Tắt chip: xóa khóa lọc + trả dữ liệu về ALL ngay lập tức
        ACTIVE_FILTER_KEY = null;
        refreshChipActive?.();
        setActiveMarkers?.(ALL);       // ← nạp lại toàn bộ marker
        setSelected?.(null);

        // Trạng thái nút/commit
        setCommittedSearchState?.(false);
        try {
            const btnClr = wrap?.querySelector?.('#ocSearchClear');
            const btnRt = wrap?.querySelector?.('#ocRouteBtn');
            if (btnClr) btnClr.style.display = 'none';
            if (btnRt) btnRt.style.display = 'inline-flex';
        } catch (_) { }

        // Dọn UI đề phòng
        try {
            const listEl = wrap?.querySelector?.('#ocSearchList');
            const emptyEl = wrap?.querySelector?.('#ocSearchEmpty');
            const route = wrap?.querySelector?.('#ocRoutePanel');
            const input = wrap?.querySelector?.('#ocSearchBox');
            wrap?.classList?.remove('open');
            if (listEl) listEl.style.display = 'none';
            if (emptyEl) emptyEl.style.display = 'none';
            if (route && !wrapBox?.classList?.contains('route-mode')) route.style.display = 'none';
            if (input) {
                input.value = '';
                input.removeAttribute('aria-activedescendant');
            }
        } catch (_) { }

        updateStatsDeb?.();
        requestAnimationFrame(() => { recalcListMaxHeight?.(); repositionStats?.(); });
        return;
    }

    // Bật chip
    ACTIVE_FILTER_KEY = key || null;
    refreshChipActive();

    let list = ALL;
    if (ACTIVE_FILTER_KEY) {
        list = (ACTIVE_FILTER_KEY === 'vip')
            ? ALL.filter(m => m.__isVIP)
            : ALL.filter(m => m.__segKey === ACTIVE_FILTER_KEY);
    }
    setActiveMarkers(list);

    try {
        const input = wrap.querySelector('#ocSearchBox');
        const listEl = wrap.querySelector('#ocSearchList');

        const label = (ACTIVE_FILTER_KEY === 'vip')
            ? 'VIP'
            : (SEG_META[ACTIVE_FILTER_KEY]?.label || '');
        if (input) input.value = label;

        // chốt + mở gợi ý theo chip (unlimited)
        SUGGEST_MODE = 'chip';
        setCommittedSearchState(true);   // Clear hiện, Trasa ẩn
        updatePrimaryIcons();
        wrap.__openChipSuggestions?.();

        if (listEl) listEl.style.display = 'block';
        requestAnimationFrame(() => { recalcListMaxHeight(); repositionStats(); });
    } catch (_) { }
}
function wireStatsChips() {
    if (!statsEl) return;
    statsEl.querySelectorAll('.oc-pill[data-key]').forEach(el => {
        const key = el.dataset.key;
        const toggle = () => applySegmentFilter(ACTIVE_FILTER_KEY === key ? null : key);
        el.addEventListener('click', toggle);
        el.addEventListener('keydown', (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); toggle(); } });
    });
    refreshChipActive();
}
function updateStats() {
    if (!statsEl) return;
    const base = ACTIVE_FILTER_KEY ? ALL : (ACTIVE.length ? ACTIVE : ALL);
    const c = computeCounts(base);
    statsEl.innerHTML =
        chip('Nový', c.New, 'oc-pill-seg oc-seg-new', 'New') +
        chip('Znovu aktivní', c.Reactivated, 'oc-pill-seg oc-seg-reactivated', 'Reactivated') +
        chip('Pravidelný', c.Regular, 'oc-pill-seg oc-seg-regular', 'Regular') +
        chip('Příležitostný', c.Occasional, 'oc-pill-seg oc-seg-occasional', 'Occasional') +
        chip('Riziko', c.Risk, 'oc-pill-seg oc-seg-risk', 'Risk') +
        chip('Ztracený', c.Lost, 'oc-pill-seg oc-seg-lost', 'Lost') +
        chip('Bez nákupu', c.Spy, 'oc-pill-seg oc-seg-spy', 'Spy') +
        chip('VIP', c.vip, 'oc-pill-vip', 'vip');
    wireStatsChips();
    refreshChipActive();
    requestAnimationFrame(() => { repositionStats(); updateStatsNavVisibility(); });
}
function setActiveMarkers(list) {
    ACTIVE = list.slice();
    clusters.clearLayers();
    clusters.addLayers(ACTIVE);
    updateStatsDeb();
    updateCountBadge();
    scheduleEnsureSelectedPopup(60);
    ensureSelectedPopup();
}

function widthNeedForDock(dock) {
    const cs = getComputedStyle(dock);
    const pl = parseFloat(cs.paddingLeft) || 0, pr = parseFloat(cs.paddingRight) || 0;
    const bl = parseFloat(cs.borderLeftWidth) || 0, br = parseFloat(cs.borderRightWidth) || 0;
    const first = dock.firstElementChild, last = dock.lastElementChild;
    if (first && last) {
        const rf = first.getBoundingClientRect(), rl = last.getBoundingClientRect();
        const content = Math.ceil(rl.right - rf.left);
        return content + pl + pr + bl + br;
    }
    return Math.ceil((dock.scrollWidth || 1) + bl + br);
}
function repositionStats() {
    if (!statsEl) return;

    const dock = statsEl;
    const box = dock.parentElement;
    const mapEl = map.getContainer();
    const search = document.querySelector('.leaflet-control-oc-search');
    if (!box || !mapEl || !search) return;

    const GAP = 8;
    const CORNER = 8;
    const mRect = mapEl.getBoundingClientRect();

    const wrapEl = search.querySelector('#ocSearchWrap') || search;
    const inRoute = wrapEl.classList.contains('route-mode');

    // ✅ 1) Phần tử dùng để LẤY TOP: khung ngoài, KHÔNG đổi khi mở/đóng
    const topAnchorRect = search.getBoundingClientRect();

    // ✅ 2) Phần tử dùng để LẤY CHIỀU CAO dock
    const heightEl =
        (inRoute && search.querySelector('.oc-route-modes')) ||
        search.querySelector('.oc-search-input') ||
        search;
    const hRect = heightEl.getBoundingClientRect();

    // Chiều cao dock khớp ô
    const anchorH = Math.max(40, Math.round(hRect.height || 0));
    dock.style.height = anchorH + 'px';
    dock.style.display = 'flex';
    dock.style.alignItems = 'center';

    // Rộng bên phải ô tìm kiếm (trừ chỗ cho 2 nút prev/next nếu list phải cuộn)
    const NAV_RESERVE = 2 * 32;
    const needWidth = widthNeedForDock(dock);
    const availRight = Math.max(0, Math.floor(mRect.right - (hRect.right + GAP) - CORNER) - NAV_RESERVE);
    const w = Math.min(needWidth, availRight);
    dock.style.width = (w > 1 ? w : 0) + 'px';
    dock.style.maxWidth = (w > 1 ? w : 0) + 'px';
    dock.style.overflowX = (w > 1 && w < needWidth) ? 'auto' : 'hidden';

    // Cố định box theo TOP của khung ngoài → hết “nhảy”
    box.style.position = 'absolute';
    box.style.left = '';
    box.style.right = CORNER + 'px';

    const boxH = (box.getBoundingClientRect().height || dock.getBoundingClientRect().height || 0);
    const topFixed = Math.round(topAnchorRect.top - mRect.top); // neo theo khung ngoài
    const topPx = Math.max(CORNER, Math.min(topFixed, mRect.height - CORNER - boxH));
    box.style.top = topPx + 'px';

    updateStatsNavVisibility();
}

function updateStatsNavVisibility() {
    if (!statsEl) return;
    const box = statsEl.parentElement;
    if (!box) return;
    const prevBtn = box.querySelector('.oc-stats-prev');
    const nextBtn = box.querySelector('.oc-stats-next');
    if (!prevBtn || !nextBtn) return;

    const overflowing = statsEl.scrollWidth > statsEl.clientWidth + 1;
    box.classList.toggle('has-nav', overflowing);
    if (!overflowing) return;

    prevBtn.disabled = statsEl.scrollLeft <= 0;
    nextBtn.disabled = statsEl.scrollLeft + statsEl.clientWidth >= statsEl.scrollWidth - 1;
}

const StatsControl = L.Control.extend({
    options: { position: 'topright' },
    onAdd: function () {
        const box = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-stats');
        box.innerHTML = `
                                                                                                                                    <button type='button' class='oc-stats-nav oc-stats-prev' aria-label='Předchozí' title='Předchozí'>
                                                                                                                                      <svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M15.41,7.41L14,6L8,12L14,18L15.41,16.59L10.83,12Z'/></svg>
                                                                                                                                    </button>
                                                                                                                                    <div class="oc-stats-dock"></div>
                                                                                                                                    <button type='button' class='oc-stats-nav oc-stats-next' aria-label='Další' title='Další'>
                                                                                                                                      <svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M8.59,16.59L13.17,12L8.59,7.41L10,6L16,12L10,18Z'/></svg>
                                                                                                                                    </button>`;
        statsEl = box.querySelector('.oc-stats-dock');
        const prevBtn = box.querySelector('.oc-stats-prev');
        const nextBtn = box.querySelector('.oc-stats-next');

        statsEl.addEventListener('wheel', (ev) => { if (ev.deltaY !== 0) { ev.preventDefault(); statsEl.scrollLeft += ev.deltaY; } }, { passive: false });
        statsEl.addEventListener('scroll', updateStatsNavVisibility, { passive: true });

        // Kéo giữ để cuộn ngang
        let dragActive = false, dragMoved = false, dragStartX = 0, dragStartScroll = 0;
        statsEl.addEventListener('mousedown', (ev) => {
            dragActive = true; dragMoved = false;
            dragStartX = ev.clientX;
            dragStartScroll = statsEl.scrollLeft;
        });
        window.addEventListener('mousemove', (ev) => {
            if (!dragActive) return;
            const dx = ev.clientX - dragStartX;
            if (!dragMoved && Math.abs(dx) <= 3) return; // bỏ qua rung tay nhỏ để click vẫn hoạt động bình thường
            dragMoved = true;
            statsEl.classList.add('dragging');
            statsEl.scrollLeft = dragStartScroll - dx;
        });
        window.addEventListener('mouseup', () => {
            if (!dragActive) return;
            dragActive = false;
            statsEl.classList.remove('dragging');
        });
        // Chặn click lên chip nếu vừa kéo (tránh vô tình chọn segmentace khi thả chuột)
        statsEl.addEventListener('click', (ev) => {
            if (dragMoved) { ev.stopPropagation(); ev.preventDefault(); }
        }, true);
        prevBtn.addEventListener('click', () => statsEl.scrollBy({ left: -statsEl.clientWidth * 0.7, behavior: 'smooth' }));
        nextBtn.addEventListener('click', () => statsEl.scrollBy({ left: statsEl.clientWidth * 0.7, behavior: 'smooth' }));
        L.DomEvent.disableClickPropagation(box);
        L.DomEvent.disableScrollPropagation(box);

        setTimeout(() => { updateStats(); repositionStats(); updateStatsNavVisibility(); }, 0);
        window.addEventListener('resize', updateStatsNavVisibility);
        return box;
    }
});

function setSelected(m) {
    if (selectedMarker && selectedMarker !== m) {
        selectedMarker.setIcon(selectedMarker.__iconNormal || (selectedMarker.__isVerified ? verifiedIcon : defaultIcon));
        selectedMarker.setZIndexOffset(0);
        try { selectedMarker.closePopup(); } catch (_) { }
    }
    selectedMarker = m || null;
    wantSelectedPopup = !!m;
    if (m) {
        setLocateActive(false);
        m.setIcon(selectedIcon);
        m.setZIndexOffset(1000);
        m.openPopup();
        try { showCountryBoundary(detectCountryCode(m.__p?.addr)); } catch (_) { }
    }
}
function ensureSelectedPopupCore() {
    if (!selectedMarker || !wantSelectedPopup) return;
    const parent = clusters.getVisibleParent(selectedMarker);
    if (!(parent && parent === selectedMarker)) return;
    const pop = selectedMarker.getPopup && selectedMarker.getPopup();
    const isOpen = pop && (pop.isOpen ? pop.isOpen() : (map.hasLayer ? map.hasLayer(pop) : false));
    if (isOpen) return;
    let prevAuto = true;
    if (pop && pop.options) { prevAuto = !!pop.options.autoPan; pop.options.autoPan = false; }
    try { selectedMarker.setZIndexOffset(1000); selectedMarker.openPopup(); }
    finally { if (pop && pop.options) pop.options.autoPan = prevAuto; }
}
function scheduleEnsureSelectedPopup(delay = 80) {
    if (_ensureTimer) return;
    _ensureTimer = setTimeout(() => { _ensureTimer = null; ensureSelectedPopupCore(); }, delay);
}
function ensureSelectedPopup() {
    if (!selectedMarker || !wantSelectedPopup) return;
    const parent = clusters.getVisibleParent(selectedMarker);
    if (parent && parent === selectedMarker) {
        try { selectedMarker.setZIndexOffset(1000); selectedMarker.openPopup(); } catch (_) { }
    }
}

function wireClick(m, p) {
    m.on('click', () => {
        setSelected(m);
        try {
            const wrap = window.__ocSearch;
            if (wrap && wrap.__isRouteMode?.() &&
                wrap.__fillFocusedRouteField?.({ lat: p.lat, lon: p.lon, label: p.name || p.addr || '', customerData: p })) {
                return;
            }
        } catch (_) { }
        try {
            const wrap = window.__ocSearch;
            if (wrap) {
                const input = wrap.querySelector('#ocSearchBox');
                const goBtn = wrap.querySelector('#ocSearchGo');
                const clrBtn = wrap.querySelector('#ocSearchClear');
                const list = wrap.querySelector('#ocSearchList');
                const empty = wrap.querySelector('#ocSearchEmpty');
                const route = wrap.querySelector('#ocRoutePanel');

                wrap.classList.remove('open');
                if (list) list.style.display = 'none';
                if (empty) empty.style.display = 'none';
                if (route) route.style.display = 'none';

                if (input) {
                    input.value = p.name || '';
                    if (goBtn) goBtn.disabled = input.value.trim().length === 0;
                    if (clrBtn) clrBtn.style.display = input.value.trim().length > 0 ? 'inline-flex' : 'none';
                    input.blur();
                }
            }
        } catch (_) { }
        const payload = { type: 'markerClick', id: p.id, name: p.name, lat: p.lat, lon: p.lon, ico: p.ico, addr: p.addr, verified: isVerifiedFlag(p), vip: isVIPFlag(p), segment: getSegmentRaw(p) || null };
        if (window.chrome && window.chrome.webview) { window.chrome.webview.postMessage(JSON.stringify(payload)); }
    });
}
function normBase(s) { return (s ?? '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }

function upsertMarkerFromPoint(p) {
    if (!isFinite(p.lat) || !isFinite(p.lon)) return null;
    const id = String(p.id);
    const existing = markerIndex.get(id);
    const isVerified = isVerifiedFlag(p);
    const isVip = isVIPFlag(p);
    const segMeta = getSegmentMeta(p);

    let fill = '#5E35B1', stroke = '#311B92';
    if (segMeta?.fill && segMeta?.stroke) { fill = segMeta.fill; stroke = segMeta.stroke; }
    const icon = getIconCached(fill, stroke, { ring: isVerified, star: isVip });

    if (existing) {
        existing.__p = p;
        existing.__isVerified = isVerified;
        existing.__isVIP = isVip;
        existing.__segKey = getSegmentRaw(p) || 'Occasional';
        existing.__iconNormal = icon;
        if (existing !== selectedMarker) existing.setIcon(icon);
        existing.setLatLng([p.lat, p.lon]);
        const newHtml = popupHtml(p);
        const pop = existing.getPopup && existing.getPopup();
        if (!pop || pop.getContent() !== newHtml) { existing.setPopupContent(newHtml); }
        const nName = normBase(p.name), nIco = normBase(p.ico), nAddr = normBase(p.addr);
        existing.__hay = [nName, nIco, nAddr].join('|');
        existing.__nName = nName; existing.__nIco = nIco; existing.__nAddr = nAddr;
        return null;
    }

    const m = L.marker([p.lat, p.lon], { title: p.name, icon });
    m.__isVerified = isVerified; m.__isVIP = isVip; m.__iconNormal = icon; m.__p = p;
    m.__segKey = getSegmentRaw(p) || 'Occasional';
    const nName = normBase(p.name), nIco = normBase(p.ico), nAddr = normBase(p.addr);
    m.__hay = [nName, nIco, nAddr].join('|'); m.__nName = nName; m.__nIco = nIco; m.__nAddr = nAddr;
    m.bindPopup(popupHtml(p), { className: 'oc-popup', maxWidth: 1200, autoPan: true, keepInView: false, autoPanPadding: [24, 24], closeButton: false });
    wireClick(m, p);
    markerIndex.set(id, m);
    ALL.push(m);
    return m;
}
function addMarkers(points) { const layers = []; for (const p of points) { const m = upsertMarkerFromPoint(p); if (m) layers.push(m); } if (layers.length) clusters.addLayers(layers); return layers.length; }
function waitIdle() { return new Promise(r => (window.requestIdleCallback ? requestIdleCallback(() => r()) : setTimeout(r, 0))); }
async function addMarkersChunked(points) {
    let i = 0;
    while (i < points.length) {
        const start = performance.now();
        const layers = [];
        while (i < points.length && (performance.now() - start) < 12) {
            const m = upsertMarkerFromPoint(points[i++]);
            if (m) layers.push(m);
        }
        if (layers.length) clusters.addLayers(layers);
        await waitIdle();
    }
}
function fitBoundsFrom(points) {
    const latlngs = []; for (const p of points) { if (isFinite(p.lat) && isFinite(p.lon)) latlngs.push([p.lat, p.lon]); }
    if (latlngs.length) map.fitBounds(latlngs, { padding: [20, 20] });
}
let firstFullDone = false; let pendingSelectOnce = null;
function selectById(id, zoom, lat, lon, name) {
    const key = String(id);
    let m = markerIndex.get(key);
    if (!m && isFinite(lat) && isFinite(lon)) {
        const p = { id, name, lat, lon, ico: '', addr: '' };
        m = L.marker([lat, lon], { title: name || '', icon: defaultIcon });
        m.__iconNormal = defaultIcon; m.__isVerified = false; m.__p = p; m.__segKey = 'Occasional';
        m.__hay = normBase(name); m.__nName = normBase(name); m.__nIco = '';
        m.bindPopup(popupHtml(p), { className: 'oc-popup', maxWidth: 1200, autoPan: true, keepInView: false, autoPanPadding: [24, 24], closeButton: false });
        wireClick(m, p);
        markerIndex.set(key, m); ALL.push(m); clusters.addLayer(m);
    }
    if (m) {
        const ll = m.getLatLng();
        if (pendingSelectOnce) { map.off('moveend', pendingSelectOnce); pendingSelectOnce = null; }
        map.flyTo(ll, zoom || Math.max(map.getZoom(), 15), { animate: true, duration: 0.9, easeLinearity: 0.25 });
        pendingSelectOnce = () => { setSelected(m); pendingSelectOnce = null; };
        map.once('moveend', pendingSelectOnce);
    }
}


