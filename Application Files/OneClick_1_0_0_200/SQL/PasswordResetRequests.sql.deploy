-- ============================================================
-- PasswordResetRequests table + stored procedures
-- Run once against the OneClick database
-- ============================================================

-- 1. Table
IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'PasswordResetRequests')
BEGIN
	CREATE TABLE [dbo].[PasswordResetRequests] (
		[RequestId]   UNIQUEIDENTIFIER NOT NULL DEFAULT NEWSEQUENTIALID(),
		[UserId]      UNIQUEIDENTIFIER NOT NULL,   -- who is requesting reset
		[RequestedAt] DATETIME2        NOT NULL DEFAULT SYSUTCDATETIME(),
		[IsHandled]   BIT              NOT NULL DEFAULT 0,
		[HandledAt]   DATETIME2        NULL,
		[HandledBy]   UNIQUEIDENTIFIER NULL,       -- admin/manager who approved
		CONSTRAINT [PK_PasswordResetRequests] PRIMARY KEY ([RequestId]),
		CONSTRAINT [FK_PRR_User]    FOREIGN KEY ([UserId])    REFERENCES [dbo].[Users]([UserId]),
		CONSTRAINT [FK_PRR_Handler] FOREIGN KEY ([HandledBy]) REFERENCES [dbo].[Users]([UserId])
	);
END
GO

-- 2. usp_SendPasswordResetRequest
--    Inserts a new (unhandled) request; cancels any previous pending one for the same user first.
CREATE OR ALTER PROCEDURE [dbo].[usp_SendPasswordResetRequest]
	@UserId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	-- Mark previous pending requests as handled (replaced)
	UPDATE [dbo].[PasswordResetRequests]
	SET [IsHandled] = 1, [HandledAt] = SYSUTCDATETIME()
	WHERE [UserId] = @UserId AND [IsHandled] = 0;

	INSERT INTO [dbo].[PasswordResetRequests] ([UserId])
	VALUES (@UserId);
END
GO

-- 3. usp_GetPendingResetRequestForUser
--    Returns the pending reset request row for a given UserId (or empty).
CREATE OR ALTER PROCEDURE [dbo].[usp_GetPendingResetRequestForUser]
	@UserId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	SELECT TOP 1
		r.[RequestId],
		r.[UserId],
		r.[RequestedAt],
		u.[Username],
		u.[FullName]
	FROM [dbo].[PasswordResetRequests] r
	JOIN [dbo].[Users] u ON u.[UserId] = r.[UserId]
	WHERE r.[UserId] = @UserId AND r.[IsHandled] = 0
	ORDER BY r.[RequestedAt] DESC;
END
GO

-- 4. usp_ApproveResetRequest
--    Resets password to hash of '123456', sets MustChangePassword=1, marks request as handled.
CREATE OR ALTER PROCEDURE [dbo].[usp_ApproveResetRequest]
	@RequestId  UNIQUEIDENTIFIER,
	@HandledBy  UNIQUEIDENTIFIER,
	@NewHash    NVARCHAR(256)          -- SHA-256 hash of '123456' computed by app
AS
BEGIN
	SET NOCOUNT ON;

	DECLARE @UserId UNIQUEIDENTIFIER;
	SELECT @UserId = [UserId]
	FROM [dbo].[PasswordResetRequests]
	WHERE [RequestId] = @RequestId AND [IsHandled] = 0;

	IF @UserId IS NULL
	BEGIN
		RAISERROR('Request not found or already handled.', 16, 1);
		RETURN;
	END

	-- Reset password + force change on next login
	UPDATE [dbo].[Users]
	SET [PasswordHash]      = @NewHash,
		[MustChangePassword] = 1,
		[UpdatedAt]          = SYSUTCDATETIME()
	WHERE [UserId] = @UserId;

	-- Mark request as handled
	UPDATE [dbo].[PasswordResetRequests]
	SET [IsHandled] = 1,
		[HandledAt] = SYSUTCDATETIME(),
		[HandledBy] = @HandledBy
	WHERE [RequestId] = @RequestId;
END
GO

-- 5. usp_CancelResetRequest
--    Cancels (dismisses) a pending reset request without resetting the password.
CREATE OR ALTER PROCEDURE [dbo].[usp_CancelResetRequest]
	@RequestId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	UPDATE [dbo].[PasswordResetRequests]
	SET [IsHandled] = 1,
		[HandledAt] = SYSUTCDATETIME()
	WHERE [RequestId] = @RequestId AND [IsHandled] = 0;
END
GO
