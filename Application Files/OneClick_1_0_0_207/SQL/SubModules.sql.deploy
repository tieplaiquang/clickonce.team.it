-- =============================================
-- SubModules.sql
-- Thêm sub-module keys cho 5 modules chính.
-- Mỗi tab bên trong module là một module con riêng,
-- có thể cấp/thu quyền độc lập qua Admin UI.
--
-- Logic runtime:
--   - Nếu user được cấp ít nhất 1 sub-module của parent → chỉ hiển thị các tabs được cấp
--   - Nếu user không được cấp sub-module nào → hiển thị tất cả tabs (backward compat)
--   - Menu item chính ẩn nếu không có cả parent lẫn sub-module nào được cấp
--
-- Chạy script này trong SQL Server Management Studio.
-- =============================================

-- ─── Assistant ────────────────────────────────────────────────────────────
IF NOT EXISTS (SELECT 1 FROM dbo.Modules WHERE ModuleKey = 'Assistant.Compare')
	INSERT INTO dbo.Modules (ModuleId, ModuleKey, ModuleName, IsActive, CreatedAt)
	VALUES (NEWID(), 'Assistant.Compare', 'Asistent – Porovnání', 1, SYSUTCDATETIME());

IF NOT EXISTS (SELECT 1 FROM dbo.Modules WHERE ModuleKey = 'Assistant.Report')
	INSERT INTO dbo.Modules (ModuleId, ModuleKey, ModuleName, IsActive, CreatedAt)
	VALUES (NEWID(), 'Assistant.Report', 'Asistent – Nahlásit ceny', 1, SYSUTCDATETIME());

