	INSERT INTO dbo.Modules (ModuleId, ModuleKey, ModuleName, IsActive, CreatedAt)
	VALUES (NEWID(), 'Assistant.Calculation', 'Asistent – Výpočet ceny letáků', 1, SYSUTCDATETIME());

IF NOT EXISTS (SELECT 1 FROM dbo.Modules WHERE ModuleKey = 'Assistant.Promotion')
	INSERT INTO dbo.Modules (ModuleId, ModuleKey, ModuleName, IsActive, CreatedAt)
	VALUES (NEWID(), 'Assistant.Promotion', 'Asistent – Propagace', 1, SYSUTCDATETIME());

IF NOT EXISTS (SELECT 1 FROM dbo.Modules WHERE ModuleKey = 'Assistant.CheckBarcode')
	INSERT INTO dbo.Modules (ModuleId, ModuleKey, ModuleName, IsActive, CreatedAt)
	VALUES (NEWID(), 'Assistant.CheckBarcode', 'Asistent – Kontrola čárového kódu', 1, SYSUTCDATETIME());

