-- ============================================================
-- Fix_BalanceChain.sql
-- Restores correct Balance and Remaining for all DailyClosing
-- rows by recomputing each row's Balance as:
--   Balance(run) = Remaining(prev_last_run) - VaultTransfer(prev_date)
-- Same-day runs: Balance(run N) = Remaining(run N-1), no vault deduction.
-- ============================================================

SET NOCOUNT ON;

DECLARE @ClosingId     BIGINT;
DECLARE @ClosingDate   DATE;
DECLARE @ClosingRun    INT;
DECLARE @CashCZK       DECIMAL(18,2);
DECLARE @CashEUR       DECIMAL(18,2);
DECLARE @CashUSD       DECIMAL(18,2);
DECLARE @RateEUR       DECIMAL(18,6);
DECLARE @RateUSD       DECIMAL(18,6);
DECLARE @Coins         DECIMAL(18,2);
DECLARE @IsManual      BIT;
DECLARE @ManualBal     DECIMAL(18,2);

DECLARE @PrevDate      DATE         = NULL;
DECLARE @PrevRun       INT          = NULL;
DECLARE @PrevRemain    DECIMAL(18,2) = 0;
DECLARE @PrevRemEUR    DECIMAL(18,2) = 0;
DECLARE @PrevRemUSD    DECIMAL(18,2) = 0;

DECLARE @NewBalance    DECIMAL(18,2);
DECLARE @NewBalEUR     DECIMAL(18,2);
DECLARE @NewBalUSD     DECIMAL(18,2);
DECLARE @VaultCZK      DECIMAL(18,2);
DECLARE @VaultEUR      DECIMAL(18,2);
DECLARE @VaultUSD      DECIMAL(18,2);

DECLARE FixCursor CURSOR LOCAL FAST_FORWARD FOR
	SELECT
		dc.Closing_Id,
		dc.Closing_Date,
		dc.Closing_Run,
		dc.Cash_CZK,
		dc.Cash_EUR,
		dc.Cash_USD,
		dc.Rate_EUR,
		dc.Rate_USD,
		dc.Coins,
		dc.Is_Manual_Balance,
		dc.Balance   -- used as manual balance value when Is_Manual_Balance=1
	FROM dbo.DailyClosing dc
	ORDER BY dc.Closing_Date ASC, dc.Closing_Run ASC;

OPEN FixCursor;
FETCH NEXT FROM FixCursor INTO
	@ClosingId, @ClosingDate, @ClosingRun,
	@CashCZK, @CashEUR, @CashUSD,
	@RateEUR, @RateUSD, @Coins,
	@IsManual, @ManualBal;

WHILE @@FETCH_STATUS = 0
BEGIN
	IF @PrevDate IS NULL
	BEGIN
		-- First row ever: keep Balance as-is (it is either the very first opening balance or manual)
		SET @NewBalance = @ManualBal;
		SET @NewBalEUR  = 0;
		SET @NewBalUSD  = 0;
	END
	ELSE IF @ClosingDate = @PrevDate
	BEGIN
		-- Same-day subsequent run: Balance = Remaining of previous run (no vault between runs)
		SET @NewBalance = @PrevRemain;
		SET @NewBalEUR  = @PrevRemEUR;
		SET @NewBalUSD  = @PrevRemUSD;
	END
	ELSE
	BEGIN
		-- New date: Balance = Remaining(prev last run) - VaultTransfer(prev date -> vault)
		SELECT
			@VaultCZK = ISNULL(SUM(vt.Amount_CZK), 0),
			@VaultEUR = ISNULL(SUM(vt.Amount_EUR), 0),
			@VaultUSD = ISNULL(SUM(vt.Amount_USD), 0)
		FROM dbo.VaultTransfer vt
		WHERE vt.Closing_Date = @PrevDate
		  AND vt.Source    = N'Pokladna'
		  AND vt.Direction = N'In';

		IF @IsManual = 1
		BEGIN
			-- Manual balance row: user supplied the opening balance directly
			SET @NewBalance = @ManualBal;
		END
		ELSE
		BEGIN
			SET @NewBalance = @PrevRemain - @VaultCZK;
		END
		SET @NewBalEUR = @PrevRemEUR - @VaultEUR;
		SET @NewBalUSD = @PrevRemUSD - @VaultUSD;
	END

	-- Compute new Remaining
	DECLARE @NewRemain  DECIMAL(18,2) = ROUND(@CashCZK + @Coins + @NewBalance, 2);
	DECLARE @NewRemEUR  DECIMAL(18,2) = ROUND(@NewBalEUR + ISNULL(@CashEUR, 0), 2);
	DECLARE @NewRemUSD  DECIMAL(18,2) = ROUND(@NewBalUSD + ISNULL(@CashUSD, 0), 2);

	UPDATE dbo.DailyClosing
	SET
		Balance       = @NewBalance,
		Balance_EUR   = @NewBalEUR,
		Balance_USD   = @NewBalUSD,
		Remaining     = @NewRemain,
		Remaining_EUR = @NewRemEUR,
		Remaining_USD = @NewRemUSD
	WHERE Closing_Id = @ClosingId;

	-- Chain forward
	SET @PrevDate   = @ClosingDate;
	SET @PrevRun    = @ClosingRun;
	SET @PrevRemain = @NewRemain;
	SET @PrevRemEUR = @NewRemEUR;
	SET @PrevRemUSD = @NewRemUSD;

	FETCH NEXT FROM FixCursor INTO
		@ClosingId, @ClosingDate, @ClosingRun,
		@CashCZK, @CashEUR, @CashUSD,
		@RateEUR, @RateUSD, @Coins,
		@IsManual, @ManualBal;
END

CLOSE FixCursor;
DEALLOCATE FixCursor;

-- Show result
SELECT
	Closing_Id, Closing_Date, Closing_Run,
	Cash_CZK, Cash_EUR, Rate_EUR, Coins,
	Balance, Remaining, Balance_EUR, Remaining_EUR,
	Is_Manual_Balance
FROM dbo.DailyClosing
ORDER BY Closing_Date, Closing_Run;
