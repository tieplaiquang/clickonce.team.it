CREATE PROCEDURE dbo.usp_GetDeliverySchedule
	@CisloDokladu NVARCHAR(100) = NULL,
	@OnlyFuture   BIT           = 1
AS
BEGIN
	SET NOCOUNT ON;

	WITH ObjednavkaVydana AS (
		SELECT
			OV.PlatnostDo AS DatumDodani,
			OV.CisloDokladu,
			OV.AdresaNazev AS Dodavatel,
			(
				SELECT COUNT(*)
				FROM [S5_Agenda_001_20190131130454].[dbo].[Objednavky_PolozkaObjednavkyVydane] POV WITH (NOLOCK)
				WHERE POV.Parent_ID = OV.ID
				  AND POV.Deleted   = 0
				  AND POV.PriznakVyrizeno = 0
			) AS PocetPolozek,
			OV.SumaCelkem AS Celkem
		FROM [S5_Agenda_001_20190131130454].[dbo].[Objednavky_ObjednavkaVydana] OV WITH (NOLOCK)
		WHERE OV.Deleted          = 0
		  AND OV.PriznakVyrizeno  = 0
		  AND (@CisloDokladu IS NULL OR OV.CisloDokladu = @CisloDokladu)
		  AND (@OnlyFuture = 0 OR CONVERT(DATE, OV.PlatnostDo) > CONVERT(DATE, GETDATE()))
	)
	SELECT
		DatumDodani,
		CisloDokladu,
		Dodavatel,
		PocetPolozek,
		Celkem
	FROM ObjednavkaVydana
	ORDER BY DatumDodani;
END
GO
