-- ============================================================
-- Stored Procedure: usp_VaultTransferReassign
-- Database:         OCS
-- Description:      Přesune VaultTransfer záznam na jiný Closing_Date / Closing_Id.
--                   Použití: oprava převodu do trezoru zaznamenaného pod špatným
--                   datem uzávěrky.
--
-- Parametry:
--   @Transfer_Id       : ID záznamu VaultTransfer k přesunutí
--   @New_Closing_Date  : Cílový datum uzávěrky (povinné)
--   @New_Closing_Id    : Cílové Closing_Id (NULL = automaticky se dohledá
--                        poslední run pro @New_Closing_Date)
--   @Updated_By        : Jméno uživatele pro audit
-- ============================================================

IF EXISTS (SELECT 1 FROM sys.procedures WHERE name = 'usp_VaultTransferReassign')
	DROP PROCEDURE [dbo].[usp_VaultTransferReassign];
GO

SET QUOTED_IDENTIFIER ON;
GO

CREATE PROCEDURE [dbo].[usp_VaultTransferReassign]
	@Transfer_Id        BIGINT,
	@New_Closing_Date   DATE,
	@New_Closing_Id     BIGINT = NULL,
	@New_Amount_CZK     DECIMAL(18,2) = NULL,
	@New_Amount_EUR     DECIMAL(18,2) = NULL,
	@New_Amount_USD     DECIMAL(18,2) = NULL,
	@New_Rate_EUR       DECIMAL(18,6) = NULL,
	@New_Rate_USD       DECIMAL(18,6) = NULL,
	@Updated_By         NVARCHAR(200) = NULL
AS
BEGIN
	SET NOCOUNT ON;
	SET XACT_ABORT ON;

	-- ----------------------------------------------------------------
	-- Validace vstupů
	-- ----------------------------------------------------------------
	IF @Transfer_Id IS NULL
	BEGIN
		RAISERROR(N'Transfer_Id je povinný.', 16, 1);
		RETURN;
	END;

	IF @New_Closing_Date IS NULL
	BEGIN
		RAISERROR(N'New_Closing_Date je povinný.', 16, 1);
		RETURN;
	END;

	-- ----------------------------------------------------------------
	-- Načti původní Transfer
	-- ----------------------------------------------------------------
	DECLARE
		@Old_Closing_Date DATE,
		@Old_Closing_Id   BIGINT,
		@Old_Source       NVARCHAR(100),
		@Amount_CZK       DECIMAL(18,2),
		@Amount_EUR       DECIMAL(18,2),
		@Amount_USD       DECIMAL(18,2),
		@Direction        CHAR(3);

	SELECT
		@Old_Closing_Date = VT.Closing_Date,
		@Old_Closing_Id   = VT.Closing_Id,
		@Old_Source       = VT.Source,
		@Amount_CZK       = VT.Amount_CZK,
		@Amount_EUR       = VT.Amount_EUR,
		@Amount_USD       = VT.Amount_USD,
		@Direction        = VT.Direction
	FROM [dbo].[VaultTransfer] VT
	WHERE VT.Transfer_Id = @Transfer_Id;

	IF @Old_Closing_Date IS NULL
	BEGIN
		RAISERROR(N'Převod do trezoru s Transfer_Id=%I64d nebyl nalezen.', 16, 1, @Transfer_Id);
		RETURN;
	END;

	-- Pokud je datum stejné, není co dělat
	IF @Old_Closing_Date = @New_Closing_Date AND ISNULL(@Old_Closing_Id, -1) = ISNULL(@New_Closing_Id, -1)
	BEGIN
		RAISERROR(N'Datum a Closing_Id jsou stejné jako původní — není co přesunout.', 16, 1);
		RETURN;
	END;

	-- ----------------------------------------------------------------
	-- Zjisti cílové Closing_Id (pokud nebylo zadáno explicitně)
	-- ----------------------------------------------------------------
	IF @New_Closing_Id IS NULL
	BEGIN
		SELECT TOP 1 @New_Closing_Id = DC.Closing_Id
		FROM [dbo].[DailyClosing] DC WITH (NOLOCK)
		WHERE DC.Closing_Date = @New_Closing_Date
		ORDER BY DC.Closing_Run DESC;
		-- Pokud pro cílový den ještě neexistuje uzávěrka, Closing_Id zůstane NULL
	END;

	BEGIN TRANSACTION;

	-- ----------------------------------------------------------------
	-- 1. Aktualizuj VaultTransfer: přepiš Closing_Date + Closing_Id a volitelně amounty/kurzy
	-- ----------------------------------------------------------------
	DECLARE @Final_CZK DECIMAL(18,2) = ISNULL(@New_Amount_CZK, @Amount_CZK);
	DECLARE @Final_EUR DECIMAL(18,2) = ISNULL(@New_Amount_EUR, @Amount_EUR);
	DECLARE @Final_USD DECIMAL(18,2) = ISNULL(@New_Amount_USD, @Amount_USD);
	DECLARE @Final_Rate_EUR DECIMAL(18,6) = ISNULL(@New_Rate_EUR, NULL);
	DECLARE @Final_Rate_USD DECIMAL(18,6) = ISNULL(@New_Rate_USD, NULL);

	-- If new rates are not provided, keep existing rates from VT
	IF @Final_Rate_EUR IS NULL
		SELECT @Final_Rate_EUR = VT.Rate_EUR FROM dbo.VaultTransfer VT WHERE VT.Transfer_Id = @Transfer_Id;
	IF @Final_Rate_USD IS NULL
		SELECT @Final_Rate_USD = VT.Rate_USD FROM dbo.VaultTransfer VT WHERE VT.Transfer_Id = @Transfer_Id;

	DECLARE @Final_Total_CZK DECIMAL(18,2) = ISNULL(@Final_CZK, 0)
		+ CASE WHEN ISNULL(@Final_EUR, 0) > 0 AND ISNULL(@Final_Rate_EUR, 0) > 0 THEN @Final_EUR * @Final_Rate_EUR ELSE 0 END
		+ CASE WHEN ISNULL(@Final_USD, 0) > 0 AND ISNULL(@Final_Rate_USD, 0) > 0 THEN @Final_USD * @Final_Rate_USD ELSE 0 END;

	UPDATE [dbo].[VaultTransfer]
	SET
		Closing_Date    = @New_Closing_Date,
		Closing_Id      = @New_Closing_Id,
		Amount_CZK      = @Final_CZK,
		Amount_EUR      = @Final_EUR,
		Amount_USD      = @Final_USD,
		Rate_EUR        = @Final_Rate_EUR,
		Rate_USD        = @Final_Rate_USD,
		Amount_Total_CZK = @Final_Total_CZK
	WHERE Transfer_Id = @Transfer_Id;

	-- ----------------------------------------------------------------
	-- 2. Oprav Is_CashdeskTransferred na PŮVODNÍM closing
	--    (pokud byl spojen s konkrétním Closing_Id)
	-- ----------------------------------------------------------------
	IF @Old_Closing_Id IS NOT NULL AND @Old_Source = N'Pokladna' AND @Direction = 'In'
	BEGIN
		-- Zkontroluj, zda ještě zbývají jiné Pokladna-In transfery pro tento closing
		DECLARE @StillHasTransfer BIT = 0;
		IF EXISTS (
			SELECT 1 FROM [dbo].[VaultTransfer] VT
			WHERE VT.Closing_Id = @Old_Closing_Id
			  AND VT.Source     = N'Pokladna'
			  AND VT.Direction  = 'In'
			  AND VT.Transfer_Id <> @Transfer_Id
		)
			SET @StillHasTransfer = 1;

		UPDATE [dbo].[DailyClosing]
		SET Is_CashdeskTransferred = @StillHasTransfer
		WHERE Closing_Id = @Old_Closing_Id;
	END;

	-- ----------------------------------------------------------------
	-- 3. Nastavit Is_CashdeskTransferred na NOVÉM closing (pokud existuje)
	-- ----------------------------------------------------------------
	IF @New_Closing_Id IS NOT NULL AND @Old_Source = N'Pokladna' AND @Direction = 'In'
	BEGIN
		UPDATE [dbo].[DailyClosing]
		SET Is_CashdeskTransferred = 1
		WHERE Closing_Id = @New_Closing_Id;
	END;

	COMMIT;

	-- ----------------------------------------------------------------
	-- 4. Repopuluj DailyClosingControl pro obě dotčená data
	-- ----------------------------------------------------------------
	BEGIN TRY
		EXEC [dbo].[usp_PopulateDailyClosingControl]
			@From = @Old_Closing_Date,
			@To   = @Old_Closing_Date;
	END TRY
	BEGIN CATCH
		PRINT N'Warning: usp_PopulateDailyClosingControl failed for old date ' + CONVERT(NVARCHAR(10), @Old_Closing_Date);
	END CATCH;

	IF @New_Closing_Date <> @Old_Closing_Date
	BEGIN
		BEGIN TRY
			EXEC [dbo].[usp_PopulateDailyClosingControl]
				@From = @New_Closing_Date,
				@To   = @New_Closing_Date;
		END TRY
		BEGIN CATCH
			PRINT N'Warning: usp_PopulateDailyClosingControl failed for new date ' + CONVERT(NVARCHAR(10), @New_Closing_Date);
		END CATCH;
	END;

	-- ----------------------------------------------------------------
	-- 5. Vrať výsledek
	-- ----------------------------------------------------------------
	SELECT
		@Transfer_Id      AS Transfer_Id,
		@Old_Closing_Date AS Old_Closing_Date,
		@Old_Closing_Id   AS Old_Closing_Id,
		@New_Closing_Date AS New_Closing_Date,
		@New_Closing_Id   AS New_Closing_Id;
END;
GO
