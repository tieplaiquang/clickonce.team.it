-- =============================================
-- Admin Extensions: CRUD + Module per User + Notif per Role
-- =============================================

-- 1. UPDATE User
IF OBJECT_ID('dbo.usp_UpdateUser','P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateUser; GO
CREATE PROCEDURE dbo.usp_UpdateUser
    @UserId   UNIQUEIDENTIFIER,
    @FullName NVARCHAR(200),
    @Email    NVARCHAR(200)
AS BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.Users SET FullName=@FullName, Email=@Email WHERE UserId=@UserId;
END
GO

-- 2. DELETE User
IF OBJECT_ID('dbo.usp_DeleteUser','P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteUser; GO
CREATE PROCEDURE dbo.usp_DeleteUser
    @UserId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.UserRoles                  WHERE UserId=@UserId;
    DELETE FROM dbo.UserNotificationPermissions WHERE UserId=@UserId;
    DELETE FROM dbo.Users                       WHERE UserId=@UserId;
END
GO

-- 3. CREATE Role
IF OBJECT_ID('dbo.usp_CreateRole','P') IS NOT NULL DROP PROCEDURE dbo.usp_CreateRole; GO
CREATE PROCEDURE dbo.usp_CreateRole
    @RoleName   NVARCHAR(100),
    @Description NVARCHAR(500)
AS BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1 FROM dbo.Roles WHERE RoleName=@RoleName)
        INSERT INTO dbo.Roles (RoleId,RoleName,Description,IsActive,CreatedAt)
        VALUES (NEWID(),@RoleName,@Description,1,GETDATE());
END
GO

-- 4. UPDATE Role
IF OBJECT_ID('dbo.usp_UpdateRole','P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateRole; GO
CREATE PROCEDURE dbo.usp_UpdateRole
    @RoleId      UNIQUEIDENTIFIER,
    @RoleName    NVARCHAR(100),
    @Description NVARCHAR(500)
AS BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.Roles SET RoleName=@RoleName, Description=@Description WHERE RoleId=@RoleId;
END
GO

-- 5. DELETE Role
IF OBJECT_ID('dbo.usp_DeleteRole','P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteRole; GO
CREATE PROCEDURE dbo.usp_DeleteRole
    @RoleId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.RoleModules WHERE RoleId=@RoleId;
    DELETE FROM dbo.UserRoles   WHERE RoleId=@RoleId;
    DELETE FROM dbo.Roles       WHERE RoleId=@RoleId;
END
GO

-- 6. CREATE Module
IF OBJECT_ID('dbo.usp_CreateModule','P') IS NOT NULL DROP PROCEDURE dbo.usp_CreateModule; GO
CREATE PROCEDURE dbo.usp_CreateModule
    @ModuleKey  NVARCHAR(100),
    @ModuleName NVARCHAR(200)
AS BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1 FROM dbo.Modules WHERE ModuleKey=@ModuleKey)
        INSERT INTO dbo.Modules (ModuleId,ModuleKey,ModuleName,IsActive)
        VALUES (NEWID(),@ModuleKey,@ModuleName,1);
END
GO

-- 7. UPDATE Module
IF OBJECT_ID('dbo.usp_UpdateModule','P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateModule; GO
CREATE PROCEDURE dbo.usp_UpdateModule
    @ModuleId   UNIQUEIDENTIFIER,
    @ModuleKey  NVARCHAR(100),
    @ModuleName NVARCHAR(200)
AS BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.Modules SET ModuleKey=@ModuleKey, ModuleName=@ModuleName WHERE ModuleId=@ModuleId;
END
GO

-- 8. DELETE Module
IF OBJECT_ID('dbo.usp_DeleteModule','P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteModule; GO
CREATE PROCEDURE dbo.usp_DeleteModule
    @ModuleId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.RoleModules WHERE ModuleId=@ModuleId;
    DELETE FROM dbo.Modules     WHERE ModuleId=@ModuleId;
END
GO

-- 9. CREATE NotificationType
IF OBJECT_ID('dbo.usp_CreateNotificationType','P') IS NOT NULL DROP PROCEDURE dbo.usp_CreateNotificationType; GO
CREATE PROCEDURE dbo.usp_CreateNotificationType
    @NotificationKey NVARCHAR(100),
    @Name            NVARCHAR(255),
    @Description     NVARCHAR(MAX)
AS BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1 FROM dbo.NotificationTypes WHERE NotificationKey=@NotificationKey)
        INSERT INTO dbo.NotificationTypes (NotificationTypeId,NotificationKey,Name,Description,IsActive,CreatedAt)
        VALUES (NEWID(),@NotificationKey,@Name,@Description,1,GETDATE());
END
GO

-- 10. UPDATE NotificationType
IF OBJECT_ID('dbo.usp_UpdateNotificationType','P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateNotificationType; GO
CREATE PROCEDURE dbo.usp_UpdateNotificationType
    @NotificationTypeId UNIQUEIDENTIFIER,
    @NotificationKey    NVARCHAR(100),
    @Name               NVARCHAR(255),
    @Description        NVARCHAR(MAX)
AS BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.NotificationTypes
    SET NotificationKey=@NotificationKey, Name=@Name, Description=@Description
    WHERE NotificationTypeId=@NotificationTypeId;
END
GO

-- 11. DELETE NotificationType
IF OBJECT_ID('dbo.usp_DeleteNotificationType','P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteNotificationType; GO
CREATE PROCEDURE dbo.usp_DeleteNotificationType
    @NotificationTypeId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.UserNotificationPermissions WHERE NotificationTypeId=@NotificationTypeId;
    DELETE FROM dbo.NotificationTypes           WHERE NotificationTypeId=@NotificationTypeId;
END
GO

-- 12. Bảng RoleNotificationPermissions (Notif per Role)
IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='RoleNotificationPermissions')
BEGIN
    CREATE TABLE dbo.RoleNotificationPermissions (
        PermissionId       UNIQUEIDENTIFIER NOT NULL DEFAULT NEWID() PRIMARY KEY,
        RoleId             UNIQUEIDENTIFIER NOT NULL,
        NotificationTypeId UNIQUEIDENTIFIER NOT NULL,
        CreatedAt          DATETIME         NOT NULL DEFAULT GETDATE(),
        CONSTRAINT FK_RoleNotif_Role FOREIGN KEY (RoleId)             REFERENCES dbo.Roles(RoleId)             ON DELETE CASCADE,
        CONSTRAINT FK_RoleNotif_Type FOREIGN KEY (NotificationTypeId) REFERENCES dbo.NotificationTypes(NotificationTypeId) ON DELETE CASCADE,
        CONSTRAINT UQ_RoleNotif      UNIQUE (RoleId, NotificationTypeId)
    );
END
GO

-- 13. usp_GetRoleNotificationPermissions
IF OBJECT_ID('dbo.usp_GetRoleNotificationPermissions','P') IS NOT NULL DROP PROCEDURE dbo.usp_GetRoleNotificationPermissions; GO
CREATE PROCEDURE dbo.usp_GetRoleNotificationPermissions
    @RoleId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    SELECT nt.NotificationTypeId, nt.NotificationKey, nt.Name, nt.Description
    FROM   dbo.NotificationTypes nt
    INNER JOIN dbo.RoleNotificationPermissions rnp ON nt.NotificationTypeId=rnp.NotificationTypeId
    WHERE  rnp.RoleId=@RoleId AND nt.IsActive=1;
END
GO

-- 14. usp_AssignNotificationToRole
IF OBJECT_ID('dbo.usp_AssignNotificationToRole','P') IS NOT NULL DROP PROCEDURE dbo.usp_AssignNotificationToRole; GO
CREATE PROCEDURE dbo.usp_AssignNotificationToRole
    @RoleId             UNIQUEIDENTIFIER,
    @NotificationTypeId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1 FROM dbo.RoleNotificationPermissions WHERE RoleId=@RoleId AND NotificationTypeId=@NotificationTypeId)
        INSERT INTO dbo.RoleNotificationPermissions (RoleId,NotificationTypeId) VALUES (@RoleId,@NotificationTypeId);
END
GO

-- 15. usp_RemoveNotificationFromRole
IF OBJECT_ID('dbo.usp_RemoveNotificationFromRole','P') IS NOT NULL DROP PROCEDURE dbo.usp_RemoveNotificationFromRole; GO
CREATE PROCEDURE dbo.usp_RemoveNotificationFromRole
    @RoleId             UNIQUEIDENTIFIER,
    @NotificationTypeId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.RoleNotificationPermissions WHERE RoleId=@RoleId AND NotificationTypeId=@NotificationTypeId;
END
GO

-- 16. usp_GetUserModules (Module per User - direct assignment)
IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='UserModules')
BEGIN
    CREATE TABLE dbo.UserModules (
        UserModuleId UNIQUEIDENTIFIER NOT NULL DEFAULT NEWID() PRIMARY KEY,
        UserId       UNIQUEIDENTIFIER NOT NULL,
        ModuleId     UNIQUEIDENTIFIER NOT NULL,
        CreatedAt    DATETIME         NOT NULL DEFAULT GETDATE(),
        CONSTRAINT FK_UserMod_User   FOREIGN KEY (UserId)   REFERENCES dbo.Users(UserId)   ON DELETE CASCADE,
        CONSTRAINT FK_UserMod_Module FOREIGN KEY (ModuleId) REFERENCES dbo.Modules(ModuleId) ON DELETE CASCADE,
        CONSTRAINT UQ_UserModule     UNIQUE (UserId, ModuleId)
    );
END
GO

-- 17. usp_GetUserDirectModules (modules assigned directly to user, NOT via role)
IF OBJECT_ID('dbo.usp_GetUserDirectModules','P') IS NOT NULL DROP PROCEDURE dbo.usp_GetUserDirectModules; GO
CREATE PROCEDURE dbo.usp_GetUserDirectModules
    @UserId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    SELECT m.ModuleId, m.ModuleKey, m.ModuleName
    FROM   dbo.Modules m
    INNER JOIN dbo.UserModules um ON m.ModuleId=um.ModuleId
    WHERE  um.UserId=@UserId AND m.IsActive=1;
END
GO

-- 18. usp_AssignModuleToUser
IF OBJECT_ID('dbo.usp_AssignModuleToUser','P') IS NOT NULL DROP PROCEDURE dbo.usp_AssignModuleToUser; GO
CREATE PROCEDURE dbo.usp_AssignModuleToUser
    @UserId   UNIQUEIDENTIFIER,
    @ModuleId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1 FROM dbo.UserModules WHERE UserId=@UserId AND ModuleId=@ModuleId)
        INSERT INTO dbo.UserModules (UserId,ModuleId) VALUES (@UserId,@ModuleId);
END
GO

-- 19. usp_RemoveModuleFromUser
IF OBJECT_ID('dbo.usp_RemoveModuleFromUser','P') IS NOT NULL DROP PROCEDURE dbo.usp_RemoveModuleFromUser; GO
CREATE PROCEDURE dbo.usp_RemoveModuleFromUser
    @UserId   UNIQUEIDENTIFIER,
    @ModuleId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.UserModules WHERE UserId=@UserId AND ModuleId=@ModuleId;
END
GO

-- 20. usp_GetUserModules: chỉ via Department và Direct (không via Role)
ALTER PROCEDURE dbo.usp_GetUserModules
    @UserId UNIQUEIDENTIFIER
AS BEGIN
    SET NOCOUNT ON;
    SELECT DISTINCT m.ModuleId, m.ModuleKey, m.ModuleName
    FROM dbo.Modules m
    WHERE m.IsActive=1 AND (
        -- via Department (không bị deny)
        EXISTS (
            SELECT 1 FROM dbo.DepartmentModules dm
            INNER JOIN dbo.UserDepartments ud ON ud.DepartmentId = dm.DepartmentId
            WHERE ud.UserId = @UserId AND dm.ModuleId = m.ModuleId
        )
        OR
        -- direct (cấp trực tiếp cho user)
        EXISTS (SELECT 1 FROM dbo.UserModules um WHERE um.UserId=@UserId AND um.ModuleId=m.ModuleId)
    );
END
GO

PRINT 'AdminExtensions.sql completed successfully.';
