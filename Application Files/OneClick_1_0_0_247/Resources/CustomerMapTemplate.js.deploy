.6205,47.7889],[8.6222,47.7949],[8.6179,47.796],[8.6186,47.7983],[8.6114,47.8019],[8.6009,47.803],[8.5929,47.7987],[8.5877,47.8027],[8.5754,47.7996],[8.5731,47.8061],[8.5689,47.8072]],[[8.7013,47.7152],[8.7046,47.7134],[8.7118,47.7017],[8.7114,47.6963],[8.7176,47.6949],[8.7179,47.6907],[8.7074,47.6896],[8.6903,47.6954],[8.6777,47.6872],[8.6704,47.6849],[8.6634,47.6858],[8.6641,47.6881],[8.6597,47.6895],[8.6586,47.6913],[8.6684,47.6921],[8.6681,47.6932],[8.6736,47.6951],[8.6741,47.6979],[8.6764,47.6981],[8.6736,47.7049],[8.666,47.7079],[8.6647,47.7134],[8.6714,47.711],[8.6742,47.7127],[8.6813,47.7124],[8.6799,47.7106],[8.6863,47.7086],[8.6903,47.7095],[8.6897,47.7117],[8.7013,47.7152]],[[8.9671,45.9841],[8.9776,45.9826],[8.9763,45.9759],[8.9772,45.9719],[8.9794,45.971],[8.9756,45.9616],[8.9685,45.9619],[8.9682,45.963],[8.9585,45.9648],[8.9671,45.9841]]]}};
const COUNTRY_ALIASES = {
    CZ: ['ceska republika', 'cesko', 'czech republic', 'czechia', 'cr'],
    SK: ['slovenska republika', 'slovensko', 'slovakia'],
    DE: ['spolkova republika nemecko', 'nemecko', 'germany', 'deutschland'],
    AT: ['rakousko', 'austria', 'osterreich'],
    PL: ['polsko', 'polska', 'poland'],
    ES: ['spanelsko', 'espana', 'spain', 'reino de espana'],
    BE: ['belgie', 'belgium', 'belgique'],
    BG: ['bulharsko', 'bulgaria'],
    HR: ['chorvatsko', 'croatia', 'hrvatska'],
    CY: ['kypr', 'cyprus'],
    DK: ['dansko', 'denmark', 'danmark'],
    EE: ['estonsko', 'estonia', 'eesti'],
    FI: ['finsko', 'finland', 'suomi'],
    FR: ['francie', 'france'],
    GR: ['recko', 'greece', 'ellada'],
    HU: ['madarsko', 'hungary', 'magyarorszag'],
    IE: ['irsko', 'ireland'],
    IT: ['italie', 'italy', 'italia'],
    LV: ['lotyssko', 'latvia'],
    LT: ['litva', 'lithuania'],
    LU: ['lucembursko', 'luxembourg', 'luxemburg'],
    MT: ['malta'],
    NL: ['nizozemsko', 'netherlands', 'holandsko', 'holland'],
    PT: ['portugalsko', 'portugal'],
    RO: ['rumunsko', 'romania'],
    SI: ['slovinsko', 'slovenia'],
    SE: ['svedsko', 'sweden', 'sverige'],
    IS: ['island', 'iceland'],
    LI: ['lichtenstejnsko', 'liechtenstein'],
    NO: ['norsko', 'norway', 'norge'],
    CH: ['svycarsko', 'switzerland', 'schweiz', 'suisse']
};

function detectCountryCode(addr) {
    if (!addr) return 'CZ';
    const lastComma = addr.lastIndexOf(',');
    const tail = normBase(lastComma === -1 ? addr : addr.substring(lastComma + 1));
    for (const [code, aliases] of Object.entries(COUNTRY_ALIASES)) {
        if (aliases.some(a => tail.includes(a))) return code;
    }
    return 'CZ';
}

let countryBoundaryLayer = null;
let currentCountryCode = null;

function swapCoordsDeep(coords) {
    if (!Array.isArray(coords)) return coords;
    if (typeof coords[0] === 'number') return [coords[1], coords[0]];
    return coords.map(swapCoordsDeep);
}
function showCountryBoundary(code) {
    if (code === currentCountryCode) return;
    if (countryBoundaryLayer) { map.removeLayer(countryBoundaryLayer); countryBoundaryLayer = null; }
    const data = COUNTRY_BOUNDARIES[code] || COUNTRY_BOUNDARIES.CZ;
    if (!data) return;
    currentCountryCode = code;
    countryBoundaryLayer = L.polygon(swapCoordsDeep(data.coordinates), {
        color: '#0B3D91', weight: 3, opacity: 0.95, fillColor: '#0B3D91', fillOpacity: 0.05, dashArray: '6,6', interactive: false
    }).addTo(map);
}

// ===== Lọc theo kraj (vùng/tỉnh) — chạy hoàn toàn trong JS =====
let krajBoundaryLayer = null;

function isCzechAddress(addr) {
    if (!addr) return false;
    const lastComma = addr.lastIndexOf(',');
    if (lastComma === -1) return true;
    const lastPart = addr.substring(lastComma + 1).trim();
    return normBase(lastPart) === normBase('Česká republika');
}

function matchesKrajPostcode(addr, min, max) {
    if (!addr) return false;
    const m = addr.match(/\b(\d{3})\s?(\d{2})\b/);
    if (!m) return false;
    const psc = parseInt(m[1] + m[2], 10);
    return psc >= min && psc <= max;
}

function clearKrajBoundary() {
    if (krajBoundaryLayer) { map.removeLayer(krajBoundaryLayer); krajBoundaryLayer = null; }
}

// Áp lại filter segmentace/VIP đang chọn (nếu có) lên trên nền vừa đổi (kraj hoặc ALL)
function reapplySegmentFilterOnTop() {
    const base = baseListForFilters();
    if (!ACTIVE_FILTER_KEY) { setActiveMarkers(base); return; }
    const list = (ACTIVE_FILTER_KEY === 'vip')
        ? base.filter(m => m.__isVIP)
        : base.filter(m => m.__segKey === ACTIVE_FILTER_KEY);
    setActiveMarkers(list);
}

function applyKrajFilter(code) {
    clearKrajBoundary();

    if (!code || code === 'ALL') {
        KRAJ_FILTERED_LIST = null;
        reapplySegmentFilterOnTop();
        return;
    }

    const kraj = KRAJ_DATA[code];
    if (!kraj) { KRAJ_FILTERED_LIST = null; reapplySegmentFilterOnTop(); return; }

    const filtered = ALL.filter(m => {
        const addr = m.__p && m.__p.addr;
        return isCzechAddress(addr) && matchesKrajPostcode(addr, kraj.postcodeMin, kraj.postcodeMax);
    });
    KRAJ_FILTERED_LIST = filtered;
    reapplySegmentFilterOnTop();

    if (kraj.coordinates) {
        krajBoundaryLayer = L.polygon(swapCoordsDeep(kraj.coordinates), {
            color: '#7E57C2', weight: 3, opacity: 0.8, fillColor: '#7E57C2', fillOpacity: 0.1, dashArray: '5,10'
        }).addTo(map);
        map.flyToBounds(krajBoundaryLayer.getBounds(), { padding: [50, 50], animate: true, duration: 0.9, easeLinearity: 0.25 });
    }
}

// Mặc định hiện biên giới Séc ngay khi load map — chỉ đổi khi chọn khách ở nước khác
showCountryBoundary('CZ');

async function handleMessage(msg) {
    if (Array.isArray(msg)) {
        clusters.clearLayers(); markerIndex.clear(); selectedMarker = null; ALL.length = 0;
        await addMarkersChunked(msg);
        setActiveMarkers(ALL);
        if (!firstFullDone) { fitBoundsFrom(msg); firstFullDone = true; }
        return;
    }
    const type = msg && msg.type ? msg.type : 'full';
    const points = (msg && msg.points) ? msg.points : [];

    if (type === 'full') {
        clusters.clearLayers(); markerIndex.clear(); selectedMarker = null; ALL.length = 0;
        await addMarkersChunked(points);
        setActiveMarkers(ALL);
        if (!firstFullDone) { fitBoundsFrom(points); firstFullDone = true; }
    } else if (type === 'append') {
        const added = addMarkers(points);
        if (added) updateStatsDeb();
    } else if (type === 'update') {
        const added = addMarkers(points);
        if (added) updateStatsDeb();
    } else if (type === 'select') {
        selectById(msg.id, msg.zoom, msg.lat, msg.lon, msg.name);
    } else if (type === 'repsData') {
        // Dữ liệu rep thật từ C# (Lark + Supabase + SQL Server). C# không gửi màu (presentation, không phải data).
        // MOCK_REPS chỉ chứa rep ĐANG ONLINE — repMarkers phải khớp INDEX với MOCK_REPS (nhiều chỗ dựa vào đó,
        // vd applyRepPositions/refreshRepIcons), nên rep offline sẵn từ đầu (online=false) KHÔNG được đưa vào
        // đây, chỉ xuất hiện trong danh sách roster đầy đủ (allReps) — xem toggleRepTracking/showRepsRosterPanel.
        const allReps = (msg.reps || []).map(r => ({ ...r, color: REP_COLOR, _visitedIcos: new Set(r.visitedIcos || []) }));
        MOCK_REPS.length = 0;
        MOCK_REPS.push(...allReps.filter(r => r.online !== false));
        if (pendingRepsResolve) { pendingRepsResolve({ reps: allReps, emptyReason: msg.emptyReason || null }); pendingRepsResolve = null; }
    } else if (type === 'repsPosition') {
        const positions = msg.positions || [];
        if (pendingPositionsResolve) {
            // Đang chờ phản hồi cho 1 lần poll cụ thể → trả kết quả cho promise đó
            pendingPositionsResolve(positions);
            pendingPositionsResolve = null;
        } else {
            // Không có poll nào đang chờ → đây là tin đẩy bất ngờ từ Realtime (ping mới vừa insert), áp dụng ngay
            applyRepPositions(positions);
        }
    } else if (type === 'repsHistory') {
        if (pendingHistoryResolve) { pendingHistoryResolve({ profileId: msg.profileId, points: msg.points || [] }); pendingHistoryResolve = null; }
    } else if (type === 'visitedIcos') {
        if (pendingVisitedResolve) {
            pendingVisitedResolve({ profileId: msg.profileId, icos: msg.icos || [], extras: msg.extras || [] });
            pendingVisitedResolve = null;
        }
    } else if (type === 'visitInserted') {
        // Realtime: rep vừa check-in 1 khách hàng (bảng visits) — đánh dấu checked ngay trên plan/popup. Nếu ICO
        // này KHÔNG có trong plan (rep bỏ qua 1 điểm, tự ghé khách khác gần đó) thì bổ sung luôn zastávka mới.
        const idx = MOCK_REPS.findIndex(r => r.profileId === msg.profileId);
        if (idx !== -1 && msg.ico) {
            const rep = MOCK_REPS[idx];
            if (!rep._visitedIcos) rep._visitedIcos = new Set();
            rep._visitedIcos.add(msg.ico);
            const marker = repMarkers[idx];
            const changed = mergeExtraStopsIntoRep(rep, [{ ico: msg.ico, name: msg.name, lat: msg.lat, lon: msg.lon }]);
            if (changed) {
                fetchRepRoute(rep).then(() => {
                    if (marker?.isPopupOpen()) marker.setPopupContent(repPopupHtml(rep, rep.lastWeather));
                    if (selectedRepId === rep.id) drawRepPlan(rep);
                }).catch(e => console.warn('Không tính lại được route sau khi thêm zastávka ngoài kế hoạch:', e));
            } else if (marker) {
                if (marker.isPopupOpen()) marker.setPopupContent(repPopupHtml(rep, rep.lastWeather));
                if (selectedRepId === rep.id) drawRepPlan(rep);
            }
        }
    } else if (type === 'repOffline') {
        // Server tự phát hiện rep này mất kết nối (tracking_disabled_reason='auto_no_signal', tự đổi
        // tracking_enabled về false luôn) — báo cho người dùng biết rồi chỉ gỡ đúng rep này khỏi tracking,
        // giữ nguyên các rep khác vẫn đang track bình thường.
        const rep = MOCK_REPS.find(r => r.code === msg.code);
        const label = rep?.name || msg.code;
        setRepRosterOnline(msg.code, false);

        // Đang track nhiều rep VÀ đây là người CUỐI CÙNG vừa rớt (tất cả đều mất kết nối) → gộp 1 thông báo
        // chung thay vì hiện thêm 1 dialog riêng nữa (đỡ dồn dập nếu nhiều rep rớt gần nhau). Chỉ 1 rep hoặc
        // vẫn còn rep khác đang hoạt động thì vẫn báo riêng đúng người vừa rớt như cũ.
        const allOffline = repsRoster.length > 1 && repsRoster.every(r => !r.online);
        if (allOffline) {
            const names = repsRoster.map(r => r.name).join(', ');
            await showAlert(`⚠️ ${names} neodpovídají — možná mají výpadek připojení.\nSledování všech bylo automaticky zastaveno.`);
        } else {
            await showAlert(`⚠️ ${label} neodpovídá — možná má výpadek připojení.\nSledování této osoby bylo automaticky zastaveno.`);
        }
        if (repTimer) removeRepFromTracking(msg.code);
    } else if (type === 'repReconnected') {
        // Rep vừa kết nối lại (server tự đổi tracking_disabled_reason về null, C# đã bật lại tracking_enabled) —
        // tự thêm lại vào bản đồ, không cần bấm lại Tracking.
        setRepRosterOnline(msg.rep?.code, true);
        addRepBackToTracking(msg.rep);
    } else if (type === 'viewerCount') {
        // Presence "tracking-viewers" vừa đồng bộ lại (có PC khác vào/ra) — cập nhật badge, chỉ hiện khi đang tracking
        if (viewerPanelEl.style.display !== 'none') renderViewerCount(msg.count);
    }
}

/* ===== DEMO: theo dõi nhiều Obchodní zástupce cùng lúc (dữ liệu giả — sau này thay bằng toạ độ thật từ DB qua CommandJson) =====
   Mỗi người có tuyến đường THẬT riêng từ TomTom Routing API (mỗi tuyến đi hướng khác nhau quanh Praha) để marker
   chạy đúng theo đường, không tự đoán toạ độ. Bấm vào marker của ai thì hiện popup thông tin người đó. */
const REP_COLOR = '#623ED0'; // tím thương hiệu (đồng bộ icon Trasa/route)
const REP_COLOR_SELECTED = '#E53935'; // đỏ — xe đang được focus
let selectedRepId = null;
// Rỗng ban đầu — được điền bằng dữ liệu THẬT (Lark + Supabase + SQL Server) qua message 'repsData' từ C#
// mỗi lần bấm Tracking (xem requestRepsData()/handleMessage()).
const MOCK_REPS = [];
let pendingRepsResolve = null;
// 15s cũ hẹp — pipeline giờ có thêm hỏi cache (~1.5-4s), Lark phân trang, PATCH Supabase, và
// GetVisitedCustomersAsync cho từng rep, cộng dồn dễ vượt 15s khi mạng/server đang chậm — dễ hiện nhầm
// "không có kế hoạch hôm nay" trong khi C# vẫn đang chạy, chỉ là JS bỏ cuộc sớm.
function requestRepsData(timeoutMs = 45000) {
    return new Promise((resolve) => {
        pendingRepsResolve = resolve;
        window.chrome?.webview?.postMessage?.(JSON.stringify({ type: 'trackingRequest' }));
        setTimeout(() => {
            // So sánh đúng resolve của LẦN GỌI NÀY — nếu 1 request khác đã bắt đầu sau và ghi đè
            // pendingRepsResolve, timeout của request cũ này không được phép resolve nhầm sang request mới.
            if (pendingRepsResolve === resolve) { pendingRepsResolve({ reps: [], emptyReason: null }); pendingRepsResolve = null; }
        }, timeoutMs);
    });
}
let repMarkers = [], repTimer = null;
const repLayerGroup = L.layerGroup(); // group riêng cho marker tracking — clearLayers() đảm bảo dọn sạch 100%, tránh sót marker

// Vị trí hiện tại của rep lấy từ GPS ping thật (sales_location_pings), poll định kỳ thay vì mô phỏng di chuyển
// THỬ NGHIỆM Realtime: vị trí mới giờ chủ yếu đến qua đẩy WebSocket (tức thời), poll này chỉ còn là lưới an toàn
// dự phòng khi Realtime rớt kết nối/không tới được (vd self-host chưa mở đúng path) — nên giãn ra 60s.
const POSITION_POLL_MS = 60000;
let pendingPositionsResolve = null;
function requestRepPositions(profileIds, planDate, timeoutMs = 10000) {
    return new Promise((resolve) => {
        pendingPositionsResolve = resolve;
        window.chrome?.webview?.postMessage?.(JSON.stringify({ type: 'positionRequest', profileIds, planDate }));
        setTimeout(() => {
            if (pendingPositionsResolve === resolve) { pendingPositionsResolve([]); pendingPositionsResolve = null; }
        }, timeoutMs);
    });
}
// Đường đi THẬT đã di chuyển hôm nay (nối các ping cũ hơn trong sales_location_pings) — chỉ lấy khi focus vào rep,
// vẽ màu khác để không lẫn với đường plan (kế hoạch).
let pendingHistoryResolve = null;
function requestRepHistory(profileId, planDate, timeoutMs = 10000) {
    return new Promise((resolve) => {
        pendingHistoryResolve = resolve;
        window.chrome?.webview?.postMessage?.(JSON.stringify({ type: 'historyRequest', profileId, planDate }));
        setTimeout(() => {
            if (pendingHistoryResolve === resolve) { pendingHistoryResolve({ profileId, points: [] }); pendingHistoryResolve = null; }
        }, timeoutMs);
    });
}
// Danh sách ICO đã ghé thăm THẬT (bảng visits, lọc theo profiles_id + visit_date = ngày plan, join customers lấy ico)
// — chỉ lấy khi focus vào rep, thay cho cách đoán cũ dựa trên khoảng cách GPS.
let pendingVisitedResolve = null;
function requestVisitedIcos(profileId, planDate, timeoutMs = 10000) {
    return new Promise((resolve) => {
        pendingVisitedResolve = resolve;
        window.chrome?.webview?.postMessage?.(JSON.stringify({ type: 'visitedRequest', profileId, planDate }));
        setTimeout(() => {
            if (pendingVisitedResolve === resolve) { pendingVisitedResolve({ profileId, icos: [], extras: [] }); pendingVisitedResolve = null; }
        }, timeoutMs);
    });
}
const REP_ACTUAL_PATH_COLOR = '#FB8C00';
const REP_ACTUAL_PATH_GAP_COLOR = '#E53935'; // đỏ — đoạn thiết bị mất mạng, ping gửi lên trễ (xem gap ở dưới)
// TomTom calculateRoute giới hạn ~150 điểm/request (chừa margin an toàn) và hay reject nếu 2 điểm liên tiếp
// trùng/quá gần nhau (rep đứng yên tại 1 khách hàng lâu, ping nhiều lần cùng chỗ) — cả 2 trường hợp đều khiến
// request lỗi và rơi vào fallback nối thẳng (đường chim bay) ở drawRepActualPath bên dưới.
const ACTUAL_PATH_MAX_WAYPOINTS = 100;
const ACTUAL_PATH_MIN_GAP_M = 25;
// Rút gọn danh sách ping thô trước khi gửi TomTom: bỏ điểm quá gần điểm ngay trước (đứng yên), rồi nếu vẫn còn
// quá nhiều thì lấy đều theo bước nhảy — luôn giữ điểm đầu/cuối để không đổi điểm xuất phát/hiện tại thật.
// Điểm bị bỏ mà có gap=true thì gán đè gap đó lên điểm còn lại (giữ được kế cận) để không mất dấu đoạn mất mạng.
function reduceActualPathPoints(points) {
    const deduped = [points[0]];
    for (let i = 1; i < points.length; i++) {
        const prev = deduped[deduped.length - 1];
        if (haversineMeters(prev.lat, prev.lon, points[i].lat, points[i].lon) >= ACTUAL_PATH_MIN_GAP_M) {
            deduped.push(points[i]);
        } else if (points[i].gap) {
            prev.gap = true;
        }
    }
    const last = points[points.length - 1];
    if (deduped[deduped.length - 1] !== last) {
        if (last.gap) deduped[deduped.length - 1].gap = true;
        deduped.push(last);
    }
    if (deduped.length <= ACTUAL_PATH_MAX_WAYPOINTS) return deduped;

    const step = (deduped.length - 1) / (ACTUAL_PATH_MAX_WAYPOINTS - 1);
    const sampled = [];
    for (let i = 0; i < ACTUAL_PATH_MAX_WAYPOINTS; i++) sampled.push(deduped[Math.round(i * step)]);
    return sampled;
}
// Nối các ping GPS thô bằng đường thẳng cắt ngang nhà cửa trông sai — cho qua TomTom routing như waypoint để
// bám đúng đường thật, giống hệt cách vẽ đường plan. TomTom trả legs[] khớp đúng từng cặp waypoint liên tiếp —
// leg[i] là đoạn từ reduced[i] tới reduced[i+1], tô đỏ nếu điểm ĐẾN (reduced[i+1]) là ping gửi trễ do mất mạng.
async function fetchActualPathRoute(points) {
    const reduced = reduceActualPathPoints(points);
    const coordStr = reduced.map(p => `${p.lat},${p.lon}`).join(':');
    const url = `https://api.tomtom.com/routing/1/calculateRoute/${coordStr}/json?key=${TOMTOM_KEY}&travelMode=car`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status} (${reduced.length}/${points.length} điểm): ${await res.text().catch(() => '')}`);
    const data = await res.json();
    const r = data.routes[0];
    return r.legs.map((leg, i) => ({
        points: leg.points.map(p => [p.latitude, p.longitude]),
        gap: !!reduced[i + 1]?.gap
    }));
}
// Vẽ lại từ dữ liệu ĐÃ CACHE (rep._actualPathRouted) — không refetch. Gọi lại mỗi khi drawRepPlan chạy lại
// (vd mỗi lần poll vị trí khi đang mở popup) để đường không bị "biến mất" do clearRepPlan() xoá cả layer group.
// Mỗi đoạn (segment) vẽ 1 polyline riêng để tô đúng màu cam/đỏ theo từng đoạn.
function redrawActualPathLayer(rep) {
    if (rep._actualPathLayers) {
        rep._actualPathLayers.forEach(l => { try { repPlanLayerGroup.removeLayer(l); } catch (_) { } });
        rep._actualPathLayers = null;
    }
    if (!rep._actualPathRouted) return;
    rep._actualPathLayers = rep._actualPathRouted.map(seg => L.polyline(seg.points, {
        color: seg.gap ? REP_ACTUAL_PATH_GAP_COLOR : REP_ACTUAL_PATH_COLOR,
        weight: 4, opacity: .9, lineCap: 'round', interactive: false
    }).addTo(repPlanLayerGroup));
}
async function drawRepActualPath(rep, points) {
    if (!points || points.length < 2) { rep._actualPathRouted = null; return; }
    let segments;
    try {
        segments = await fetchActualPathRoute(points);
    } catch (e) {
        console.warn('Không tính được đường đi thật theo bản đồ, tạm nối thẳng các điểm ping:', e);
        // Fallback nối thẳng từng cặp điểm liên tiếp — vẫn giữ tô đỏ đúng đoạn mất mạng
        segments = [];
        for (let i = 0; i < points.length - 1; i++) {
            segments.push({
                points: [[points[i].lat, points[i].lon], [points[i + 1].lat, points[i + 1].lon]],
                gap: !!points[i + 1].gap
            });
        }
    }
    // Đợi TomTom trong lúc đó có thể đã đổi focus sang rep khác/đóng popup — bỏ kết quả trễ
    if (selectedRepId !== rep.id) return;
    rep._actualPathRouted = segments;
    redrawActualPathLayer(rep);
}
// Dùng chung cho cả kết quả poll VÀ tin đẩy bất ngờ từ Realtime — áp dụng từng vị trí vào đúng rep/marker.
function applyRepPositions(positions) {
    (positions || []).forEach(p => {
        if (typeof p.lat !== 'number' || typeof p.lng !== 'number') return;
        const idx = MOCK_REPS.findIndex(r => r.profileId === p.profileId);
        if (idx === -1 || !repMarkers[idx]) return;
        applyRepPosition(MOCK_REPS[idx], repMarkers[idx], p.lat, p.lng, p.accuracy);
    });
}
async function pollRepPositions() {
    const profileIds = MOCK_REPS.map(r => r.profileId).filter(Boolean);
    if (!profileIds.length) return;
    // Cùng 1 lần build reps (BuildTodayRepsAsync) → mọi rep chung 1 planDate, lấy đại diện từ rep đầu tiên.
    const planDate = MOCK_REPS[0]?.planDate;
    const positions = await requestRepPositions(profileIds, planDate);
    applyRepPositions(positions);
}
// Cập nhật marker theo vị trí GPS thật mới nhất: xoay đầu xe theo hướng di chuyển thật, vẽ vòng tròn accuracy,
// chấm zastávka đã ghé qua (proximity), và refresh popup/kế hoạch nếu đang mở.
function applyRepPosition(rep, marker, lat, lon, accuracy) {
    const prevLat = rep.curLat, prevLon = rep.curLon;
    if (prevLat != null && (prevLat !== lat || prevLon !== lon)) {
        rep.angle = bearing([prevLat, prevLon], [lat, lon]);
    }
    rep.curLat = lat;
    rep.curLon = lon;

    const sel = rep.id === selectedRepId;
    marker.setLatLng([lat, lon]);
    marker.setIcon(repIcon(sel ? REP_COLOR_SELECTED : rep.color, rep.angle, sel));

    if (marker.isPopupOpen()) {
        marker.setPopupContent(repPopupHtml(rep, rep.lastWeather));
        drawRepPlan(rep);
        maybeRefreshRepWeather(rep, marker);
    }
}
const repPlanLayerGroup = L.layerGroup(); // kế hoạch trasa (đường + zastávka) của rep đang được focus
function clearRepPlan() {
    repPlanLayerGroup.clearLayers();
    if (map.hasLayer(repPlanLayerGroup)) map.removeLayer(repPlanLayerGroup);
}
function drawRepPlan(rep) {
    clearRepPlan();
    // Route đang tính lại qua TomTom (vd vừa bổ sung zastávka ngoài kế hoạch, xem mergeExtraStopsIntoRep) —
    // đợi fetchRepRoute xong rồi vẽ, tránh L.polyline(null) khi có vị trí mới cập nhật ngay lúc đang chờ.
    if (!rep.route) return;
    const visited = computeVisitedFlags(rep);
    L.polyline(rep.route, {
        color: '#3730F5', weight: 5, opacity: .8, dashArray: '2,10', lineCap: 'round', interactive: false
    }).addTo(repPlanLayerGroup);
    rep.waypoints.forEach((wp, i) => {
        const isStart = i === 0;
        const isReturn = i === rep.waypoints.length - 1;
        const done = visited[i];
        const stopName = rep.stops?.[i - 1]?.name;
        const label = isStart ? 'Start' : (isReturn ? 'Návrat na start' : (stopName ? `${i}. ${stopName}` : `Zastávka ${i}`));
        L.marker(wp, {
            icon: L.divIcon({
                className: 'oc-rep-stop-marker' + (done ? ' oc-rep-stop-done' : ''),
                html: `<div class='oc-rep-stop-dot' style='${done ? `background:${rep.color};border-color:${rep.color};color:#fff` : 'color:#616161'}'>${done ? '✓' : (isStart || isReturn ? '' : i)}</div>`,
                iconSize: [26, 26], iconAnchor: [13, 13]
            }),
            interactive: true, zIndexOffset: 1400
        }).bindTooltip(label, { direction: 'top', offset: [0, -8] }).addTo(repPlanLayerGroup);
    });
    repPlanLayerGroup.addTo(map);
    // Đang thực sự focus rep này (không phải hiển thị mặc định khi chỉ có 1 rep) → vẽ lại đường đi thật đã cache,
    // tránh bị mất do clearRepPlan() ở trên xoá sạch layer group mỗi lần drawRepPlan chạy lại.
    if (selectedRepId === rep.id) redrawActualPathLayer(rep);
}
function repStopsListHtml(rep) {
    const visited = computeVisitedFlags(rep);
    // Chỉ liệt kê zastávka thật — bỏ điểm bắt đầu/kết thúc cố định (i=0 và i cuối), không có ý nghĩa để hiển thị
    const items = rep.waypoints.map((wp, i) => {
        const isStart = i === 0;
        const isReturn = i === rep.waypoints.length - 1;
        if (isStart || isReturn) return '';
        const stopName = rep.stops?.[i - 1]?.name || `Zastávka ${i}`;
        const done = visited[i];
        return `<li class='${done ? 'oc-rep-stop-item-done' : ''}'>${i}. ${esc(stopName)}${done ? " <span class='oc-rep-stop-check'>✓</span>" : ''}</li>`;
    }).join('');
    return `<div class='oc-rep-popup-stops'>
                                                                                                                                    <div class='oc-rep-popup-stops-title'>Plán trasy</div>
                                                                                                                                    <ol class='oc-rep-popup-stops-list'>${items}</ol>
                                                                                                                                  </div>`;
}

async function fetchRepRoute(rep) {
    if (rep.route) return rep.route;
    const coordStr = rep.waypoints.map(p => `${p[0]},${p[1]}`).join(':');
    const url = `https://api.tomtom.com/routing/1/calculateRoute/${coordStr}/json?key=${TOMTOM_KEY}&travelMode=car`;
    const res = await fetch(url);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    const r = data.routes[0];
    rep.route = r.legs.flatMap(leg => leg.points.map(p => [p.latitude, p.longitude]));
    // Vị trí (index trong rep.route) mà mỗi zastávka (rep.waypoints) thực sự đạt tới — dùng để biết đã đến/chưa đến
    let cum = 0;
    rep.waypointRouteIdx = [0];
    r.legs.forEach(leg => { cum += leg.points.length; rep.waypointRouteIdx.push(cum - 1); });
    return rep.route;
}
// Zastávka nào "đã đến" — dựa vào dữ liệu THẬT bảng visits (join customers.ico), nạp vào rep._visitedIcos
// khi focus rep (xem requestVisitedIcos trong marker.on('click', ...)), không còn đoán theo khoảng cách GPS.
function computeVisitedFlags(rep) {
    return rep.waypoints.map((wp, i) => {
        if (i === 0) return true; // điểm bắt đầu — luôn coi như đã qua
        if (i === rep.waypoints.length - 1) return false; // điểm kết thúc — chưa có ý nghĩa "hoàn thành"
        const stop = rep.stops?.[i - 1];
        return !!(stop && stop.ico && rep._visitedIcos?.has(stop.ico));
    });
}
function haversineMeters(lat1, lon1, lat2, lon2) {
    const R = 6371000;
    const toRad = d => d * Math.PI / 180;
    const dLat = toRad(lat2 - lat1), dLon = toRad(lon2 - lon1);
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}
// Sắp lại toàn bộ zastávka (kể cả zastávka ngoài kế hoạch vừa bổ sung) theo nearest-neighbor từ điểm xuất
// phát — y hệt thuật toán OrderStops bên C# (RepTrackingService), để thứ tự nhất quán 2 phía.
function reorderStopsByNearest(startLat, startLon, stops) {
    const remaining = stops.slice();
    const ordered = [];
    let curLat = startLat, curLon = startLon;
    while (remaining.length > 0) {
        let nearestIdx = 0, nearestDist = Infinity;
        remaining.forEach((s, i) => {
            const d = haversineMeters(curLat, curLon, s.lat, s.lon);
            if (d < nearestDist) { nearestDist = d; nearestIdx = i; }
        });
        const next = remaining.splice(nearestIdx, 1)[0];
        ordered.push(next);
        curLat = next.lat; curLon = next.lon;
    }
    return ordered;
}
// Rep bỏ qua 1 điểm trong plan, tự ghé 1 khách khác gần đó ngoài kế hoạch — bổ sung thêm zastávka cho ICO đó
// (toạ độ lấy từ visits.lat/lng), sắp lại toàn tuyến theo khoảng cách. Trả true nếu có bổ sung thật (để caller
// biết cần refetch route qua TomTom + vẽ lại), false nếu không có ICO nào mới.
function mergeExtraStopsIntoRep(rep, extras) {
    if (!extras || !extras.length) return false;
    const existingIcos = new Set((rep.stops || []).map(s => s.ico).filter(Boolean));
    const fresh = extras.filter(e => e.ico && !existingIcos.has(e.ico) && typeof e.lat === 'number' && typeof e.lon === 'number');
    if (!fresh.length) return false;

    const startLat = rep.waypoints[0][0], startLon = rep.waypoints[0][1];
    const allStops = (rep.stops || []).concat(fresh.map(e => ({ name: e.name || e.ico, ico: e.ico, lat: e.lat, lon: e.lon })));
    const ordered = reorderStopsByNearest(startLat, startLon, allStops);

    rep.stops = ordered;
    rep.waypoints = [[startLat, startLon], ...ordered.map(s => [s.lat, s.lon]), [startLat, startLon]];

    if (!rep._visitedIcos) rep._visitedIcos = new Set();
    fresh.forEach(e => rep._visitedIcos.add(e.ico));

    // Waypoints vừa đổi — buộc fetchRepRoute() tính lại qua TomTom thay vì dùng route cache cũ
    rep.route = null;
    rep.waypointRouteIdx = null;

    return true;
}
function bearing(a, b) {
    const toRad = d => d * Math.PI / 180;
    const dLon = toRad(b[1] - a[1]);
    const y = Math.sin(dLon) * Math.cos(toRad(b[0]));
    const x = Math.cos(toRad(a[0])) * Math.sin(toRad(b[0])) - Math.sin(toRad(a[0])) * Math.cos(toRad(b[0])) * Math.cos(dLon);
    return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
}
// Icon xe nhìn từ trên xuống, tự xoay theo hướng di chuyển — kiểu Bolt/Uber
function repIcon(color, angle, selected) {
    return L.divIcon({
        className: 'oc-rep-marker',
        html: `<div class='oc-rep-marker-wrap'>
                                                                                                                                    <div class='${selected ? 'oc-rep-pulse' : 'oc-rep-pulse-idle'}'></div>
                                                                                                                                    <div class='oc-rep-marker-rot' style='transform:rotate(${angle}deg)'>
                                                                                                                                      <svg viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                                        <path fill='${color}' stroke='#fff' stroke-width='1.4' stroke-linejoin='round' d='M12,1.5C9.5,1.5 7.6,3.2 7.3,5.6L6.6,11H5.5A1.5,1.5 0 0,0 4,12.5V19A1.5,1.5 0 0,0 5.5,20.5H6A1.5,1.5 0 0,0 7.5,22H8.5A1.5,1.5 0 0,0 10,20.5H14A1.5,1.5 0 0,0 15.5,22H16.5A1.5,1.5 0 0,0 18,20.5H18.5A1.5,1.5 0 0,0 20,19V12.5A1.5,1.5 0 0,0 18.5,11H17.4L16.7,5.6C16.4,3.2 14.5,1.5 12,1.5Z'></path>
                                                                                                                                        <path fill='#fff' opacity='.85' d='M8.7,5.8C8.9,4.3 10.2,3.2 12,3.2C13.8,3.2 15.1,4.3 15.3,5.8L15.9,10.3H8.1L8.7,5.8Z'></path>
                                                                                                                                      </svg>
                                                                                                                                    </div>
                                                                                                                                  </div>`,
        iconSize: [56, 56], iconAnchor: [28, 28]
    });
}
// Mã WMO của Open-Meteo → icon/nhãn tiếng Séc (mưa/nắng/tuyết…)
function weatherFromCode(code) {
    if (code === 0) return { icon: '☀️', label: 'Jasno' };
    if ([1, 2, 3].includes(code)) return { icon: '⛅', label: 'Zataženo' };
    if ([45, 48].includes(code)) return { icon: '🌫️', label: 'Mlha' };
    if ([51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return { icon: '🌧️', label: 'Déšť' };
    if ([71, 73, 75, 77, 85, 86].includes(code)) return { icon: '❄️', label: 'Sníh' };
    if ([95, 96, 99].includes(code)) return { icon: '⛈️', label: 'Bouřka' };
    return { icon: '🌡️', label: '—' };
}
async function fetchWeather(lat, lon) {
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`;
    const res = await fetch(url);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    const cw = data.current_weather;
    const { icon, label } = weatherFromCode(cw.weathercode);
    return { temp: Math.round(cw.temperature), icon, label };
}
const WEATHER_REFRESH_MS = 30000; // popup mở lâu vẫn nên cập nhật thời tiết, nhưng không gọi API mỗi tick (350ms)
function maybeRefreshRepWeather(rep, marker) {
    const now = Date.now();
    if (rep._weatherFetchedAt && now - rep._weatherFetchedAt < WEATHER_REFRESH_MS) return;
    rep._weatherFetchedAt = now;
    const ll = marker.getLatLng();
    fetchWeather(ll.lat, ll.lng).then(weather => {
        rep.lastWeather = weather;
        if (marker.isPopupOpen()) marker.setPopupContent(repPopupHtml(rep, weather));
    }).catch(e => console.warn('Không lấy được thời tiết:', e));
}
function repPopupHtml(rep, weather) {
    const weatherRow = weather
        ? `<div class='oc-rep-popup-row'>${weather.icon} ${weather.temp}°C — ${esc(weather.label)}</div>`
        : `<div class='oc-rep-popup-row oc-rep-popup-time'>Načítání počasí…</div>`;
    const stopsHtml = rep.waypointRouteIdx ? repStopsListHtml(rep) : '';
    return `<div class='oc-rep-popup'>
                                                                                                                                    <div class='oc-rep-popup-name'><svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z'/></svg>${esc(rep.name)}</div>
                                                                                                                                    ${weatherRow}
                                                                                                                                    <div class='oc-rep-popup-row oc-rep-popup-time'>Aktualizováno: ${new Date().toLocaleTimeString('cs-CZ')}</div>
                                                                                                                                    ${stopsHtml}
                                                                                                                                  </div>`;
}
function setTrackingUiVisible(visible) {
    const searchEl = document.querySelector('.leaflet-control-oc-search');
    const statsEl2 = document.querySelector('.leaflet-control-oc-stats');
    // Đang có routing → segmentace vốn đã ẩn riêng (openRoutePanel), tắt tracking không được hiện đè lại
    const routeActive = !!window.__ocSearch?.__isRouteMode?.();
    if (searchEl) searchEl.style.display = visible ? '' : 'none';
    if (statsEl2) statsEl2.style.display = (visible && !routeActive) ? '' : 'none';
    if (countBadgeEl) countBadgeEl.style.display = visible ? '' : 'none';
    if (visible && !routeActive) {
        // Khi statsEl2 đang display:none, repositionStats() đo được rect rỗng (0) và có thể để dock
        // kẹt ở width 0px. Sau khi hiện lại, phải tính lại ngay, không chờ user kéo map mới trigger reflow.
        requestAnimationFrame(() => { updateStats(); repositionStats(); });
    }
}
let preTrackingView = null;
let preTrackingCountryCode = null;
let routeFloatWasShown = false;
let repTrackingBtnEl = null;
// Thoát hẳn chế độ tracking — dùng chung cho cả bấm nút Tắt THẬT lẫn khi 1 rep bị server tự tắt do mất kết
// nối (tracking_disabled_reason='auto_no_signal', xem type 'repOffline'), lúc đó phải đẩy người dùng ra khỏi
// tracking luôn chứ không chỉ báo suông.
function exitTrackingMode() {
    clearInterval(repTimer); repTimer = null;
    // Báo C# tắt tracking_enabled ở Supabase cho các rep vừa track — không cần chờ phản hồi
    try { window.chrome?.webview?.postMessage?.(JSON.stringify({ type: 'trackingStop' })); } catch (_) { }
    // Dọn dẹp nhiều lớp phòng trường hợp marker đang có popup mở (đang focus) không được gỡ đúng cách
    repMarkers.forEach(m => {
        try { m.closePopup(); } catch (_) { }
        try { m.unbindPopup(); } catch (_) { }
        try { repLayerGroup.removeLayer(m); } catch (_) { }
        try { if (map.hasLayer(m)) map.removeLayer(m); } catch (_) { }
    });
    repLayerGroup.clearLayers();
    if (map.hasLayer(repLayerGroup)) map.removeLayer(repLayerGroup);
    clearRepPlan();
    try { map.closePopup(); } catch (_) { }
    repMarkers = [];
    MOCK_REPS.length = 0; // tránh callback bất đồng bộ (popupclose, poll vị trí) còn sót vẽ đè lại plan sau khi đã tắt
    repSpreadCounts = new Map(); // phiên tracking mới không cộng dồn số đếm giãn vị trí từ phiên cũ
    selectedRepId = null;
    // Đang có trasa hiển thị → khách hàng vốn đã ẩn để đỡ rối, không hiện lại đè lên
    if (!map.hasLayer(clusters) && !window.__ocSearch?.__isRouteLineActive?.()) clusters.addTo(map);
    setTrackingUiVisible(true);
    hideWeatherPanel();
    hideViewerPanel();
    hideRepsRosterPanel();
    try { window.__ocSearch?.__showTempAddrMarker?.(); } catch (_) { }
    try { window.__ocSearch?.__showRouteLine?.(); } catch (_) { }
    if (routeFloatWasShown) routeFloatEl.classList.add('show');
    routeFloatWasShown = false;
    // Trả lại đúng zoom/vị trí map như trước khi bật tracking
    if (preTrackingView) {
        map.flyTo(preTrackingView.center, preTrackingView.zoom, { animate: true, duration: 0.9, easeLinearity: 0.25 });
        preTrackingView = null;
    }
    // Trả lại biên giới quốc gia đúng như khách hàng đã focus trước khi bật tracking
    if (preTrackingCountryCode) { try { showCountryBoundary(preTrackingCountryCode); } catch (_) { } }
    preTrackingCountryCode = null;
    repTrackingBtnEl?.classList.remove('on');
}
// Gỡ đúng 1 rep khỏi tracking (marker + focus/plan nếu đang chọn rep đó) — giữ nguyên các rep khác vẫn đang
// track bình thường. Dùng khi 1 rep bị server tự tắt do mất kết nối (xem type 'repOffline'), không cần thoát
// cả phiên tracking chỉ vì 1 rep trong nhóm bị mất tín hiệu.
function removeRepFromTracking(code) {
    const idx = MOCK_REPS.findIndex(r => r.code === code);
    if (idx === -1) return;
    const marker = repMarkers[idx];
    if (marker) {
        try { marker.closePopup(); } catch (_) { }
        try { marker.unbindPopup(); } catch (_) { }
        try { repLayerGroup.removeLayer(marker); } catch (_) { }
        try { if (map.hasLayer(marker)) map.removeLayer(marker); } catch (_) { }
    }
    const wasSelected = selectedRepId === MOCK_REPS[idx].id;
    MOCK_REPS.splice(idx, 1);
    repMarkers.splice(idx, 1);
    if (wasSelected) {
        selectedRepId = null;
        clearRepPlan();
    }
    if (MOCK_REPS.length === 0) { exitTrackingMode(); return; }
    // Chỉ còn đúng 1 rep và không ai đang được focus riêng → tự vẽ luôn plan mặc định (giống lúc mới bật tracking)
    if (!selectedRepId && MOCK_REPS.length === 1 && MOCK_REPS[0].route) drawRepPlan(MOCK_REPS[0]);
}
// Nhiều rep chưa có ping GPS thật hôm nay đều đứng chung đúng 1 điểm xuất phát cố định — marker chồng khít
// lên nhau khiến chỉ bấm chọn được đúng 1 (marker trên cùng). Giãn nhẹ theo vòng tròn nhỏ quanh điểm trùng
// (chỉ đổi vị trí HIỂN THỊ ban đầu của marker, không đụng waypoints/route thật) để mỗi rep vẫn bấm riêng
// được — tự hết tác dụng ngay khi có ping GPS thật đầu tiên (applyRepPosition ghi đè curLat/curLon).
const REP_SPREAD_OFFSETS = [
    [0, 0], [0.00025, 0], [-0.00025, 0], [0, 0.00035], [0, -0.00035],
    [0.00025, 0.00035], [-0.00025, 0.00035], [0.00025, -0.00035], [-0.00025, -0.00035]
];
let repSpreadCounts = new Map();
function getSpreadLatLng(lat, lon) {
    const key = `${lat.toFixed(4)},${lon.toFixed(4)}`;
    const idx = repSpreadCounts.get(key) || 0;
    repSpreadCounts.set(key, idx + 1);
    const [dLat, dLon] = REP_SPREAD_OFFSETS[idx % REP_SPREAD_OFFSETS.length];
    return [lat + dLat, lon + dLon];
}
// Tạo marker + popup + các sự kiện (click focus, weather, history, visited icos) cho 1 rep — dùng chung cho cả
// lúc mới bật tracking (forEach toàn bộ MOCK_REPS) lẫn lúc 1 rep tự thêm lại sau khi kết nối lại (addRepBackToTracking).
function createRepMarker(rep) {
    // Vị trí ban đầu: đứng ở điểm xuất phát cho tới khi có ping GPS thật đầu tiên (xem pollRepPositions) —
    // giãn nhẹ nếu trùng vị trí với rep khác đã tạo marker trước đó.
    const [spreadLat, spreadLon] = getSpreadLatLng(rep.waypoints[0][0], rep.waypoints[0][1]);
    rep.curLat = spreadLat;
    rep.curLon = spreadLon;
    rep.angle = 0;
    const marker = L.marker([rep.curLat, rep.curLon], { icon: repIcon(rep.color, rep.angle), zIndexOffset: 1500 })
        .bindPopup(repPopupHtml(rep), { closeButton: true })
        .addTo(repLayerGroup);
    const refreshRepIcons = () => MOCK_REPS.forEach((r, j) => {
        const sel = r.id === selectedRepId;
        repMarkers[j].setIcon(repIcon(sel ? REP_COLOR_SELECTED : r.color, r.angle, sel));
    });
    marker.on('click', () => {
        marker.setPopupContent(repPopupHtml(rep));
        // bindPopup đã tự toggle mở/đóng trước khi tới đây — chỉ đồng bộ theo trạng thái thật của popup
        selectedRepId = marker.isPopupOpen() ? rep.id : (selectedRepId === rep.id ? null : selectedRepId);
        refreshRepIcons();
        // Obchodní zástupce demo chạy toàn bộ ở Séc — focus vào rep cũng phải sáng biên giới CZ như focus khách hàng
        try { if (marker.isPopupOpen()) showCountryBoundary('CZ'); } catch (_) { }

        if (marker.isPopupOpen()) {
            // Focus vào 1 rep → zoom ngay xuống đường người đó đang đi
            map.flyTo(marker.getLatLng(), Math.max(map.getZoom(), 16), { animate: true, duration: 0.7, easeLinearity: 0.25 });
            // Vẽ lại kế hoạch trasa (đường đi + zastávka đã/chưa đến) của rep đang focus
            drawRepPlan(rep);
            // Vẽ thêm đường đi THẬT đã di chuyển hôm nay (màu khác đường plan)
            if (rep.profileId) {
                requestRepHistory(rep.profileId, rep.planDate).then(res => {
                    if (selectedRepId !== rep.id || !marker.isPopupOpen()) return; // đã đổi focus/đóng, bỏ kết quả trễ
                    drawRepActualPath(rep, res.points);
                });
                // Zastávka nào đã ghé thật (bảng visits, join customers.ico) — cập nhật popup + chấm trên map.
                // Có ICO ngoài kế hoạch (rep tự ghé khách khác) → bổ sung zastávka mới rồi tính lại route.
                requestVisitedIcos(rep.profileId, rep.planDate).then(res => {
                    if (selectedRepId !== rep.id || !marker.isPopupOpen()) return; // đã đổi focus/đóng, bỏ kết quả trễ
                    rep._visitedIcos = new Set(res.icos || []);
                    const changed = mergeExtraStopsIntoRep(rep, res.extras);
                    if (changed) {
                        fetchRepRoute(rep).then(() => {
                            if (selectedRepId !== rep.id || !marker.isPopupOpen()) return;
                            marker.setPopupContent(repPopupHtml(rep, rep.lastWeather));
                            drawRepPlan(rep);
                        }).catch(e => console.warn('Không tính lại được route sau khi thêm zastávka ngoài kế hoạch:', e));
                    } else {
                        marker.setPopupContent(repPopupHtml(rep, rep.lastWeather));
                        drawRepPlan(rep);
                    }
                });
            }
            const ll = marker.getLatLng();
            fetchWeather(ll.lat, ll.lng).then(weather => {
                rep.lastWeather = weather;
                if (marker.isPopupOpen()) marker.setPopupContent(repPopupHtml(rep, weather));
            }).catch(e => console.warn('Không lấy được thời tiết:', e));
        }
    });
    repMarkers.push(marker);
}
// Rep vừa kết nối lại (tracking_disabled_reason từ 'auto_no_signal' về null) trong lúc đang tracking — tự
// thêm lại vào bản đồ, không cần bấm lại Tracking. Bỏ qua nếu rep đã có sẵn (vd chưa kịp gỡ khỏi lần trước).
function addRepBackToTracking(repData) {
    if (!repTimer || !repData || MOCK_REPS.some(r => r.code === repData.code)) return;
    const rep = { ...repData, color: REP_COLOR, _visitedIcos: new Set(repData.visitedIcos || []) };
    MOCK_REPS.push(rep);
    fetchRepRoute(rep).then(() => {
        createRepMarker(rep);
        if (!selectedRepId && MOCK_REPS.length === 1) drawRepPlan(rep);
    }).catch(e => console.warn('Không lấy được tuyến cho rep vừa kết nối lại:', e));
}
async function toggleRepTracking(btn) {
    if (repTimer) {
        exitTrackingMode();
        return;
    }
    btn.classList.add('on');
    btn.disabled = true;

    const { reps, emptyReason } = await requestRepsData();
    if (!btn.classList.contains('on')) return; // đã bấm tắt trong lúc đang chờ C#
    if (!reps.length) {
        // emptyReason phân biệt đúng theo cột Lark thiếu (Plán návštěvy/Kód provize) — không có thì dùng
        // thông báo chung (vd ICO không khớp SQL Server, không nằm trong 2 case trên).
        await showAlert(emptyReason || 'Dnes nejsou k dispozici žádná data o obchodním zástupci.');
        btn.classList.remove('on');
        btn.disabled = false;
        return;
    }

    let routes;
    try {
        routes = await Promise.all(MOCK_REPS.map(rep => fetchRepRoute(rep)));
    } catch (e) {
        console.warn('Không lấy được tuyến demo:', e);
        btn.classList.remove('on');
        btn.disabled = false;
        return;
    }
    btn.disabled = false;
    if (!btn.classList.contains('on')) return; // đã bấm tắt trong lúc đang tải

    // Lưu lại view hiện tại (vd đang zoom vào địa chỉ vừa tìm) để trả lại đúng như cũ khi tắt tracking
    preTrackingView = { center: map.getCenter(), zoom: map.getZoom() };
    preTrackingCountryCode = currentCountryCode;

    // Ẩn hết khách hàng, ô tìm kiếm, segmentace, badge tổng số khách, marker địa chỉ ngoài DB (nếu có) cho dễ nhìn tuyến tracking
    if (map.hasLayer(clusters)) map.removeLayer(clusters);
    setTrackingUiVisible(false);
    showWeatherPanel();
    showViewerPanel();
    showRepsRosterPanel(reps);

    // Rep đã sẵn tracking_disabled_reason='auto_no_signal' TRƯỚC KHI bấm Tracking (C# gửi kèm online=false) —
    // báo ngay từ đầu, gộp chung nếu nhiều hơn 1 người (đỡ dồn dập), không chờ 1 sự kiện repOffline sẽ không
    // bao giờ tới cho trường hợp này.
    const preOfflineReps = reps.filter(r => r.online === false);
    if (preOfflineReps.length > 0) {
        const names = preOfflineReps.map(r => r.name).join(', ');
        showAlert(preOfflineReps.length === 1
            ? `⚠️ ${names} nemá připojení — sledování se spustí po obnovení.`
            : `⚠️ ${names} nemají připojení — sledování se spustí po obnovení.`);
    }
    try { window.__ocSearch?.__hideTempAddrMarker?.(); } catch (_) { }
    try { window.__ocSearch?.__hideRouteLine?.(); } catch (_) { }
    routeFloatWasShown = routeFloatEl.classList.contains('show');
    routeFloatEl.classList.remove('show');

    // Đảm bảo group sạch trước khi thêm mới, phòng trường hợp có sót layer từ trước
    repLayerGroup.clearLayers();
    if (!map.hasLayer(repLayerGroup)) repLayerGroup.addTo(map);

    // MOCK_REPS đã chỉ chứa rep online (lọc từ lúc nhận repsData) — rep offline sẵn từ đầu không tạo marker,
    // chỉ hiện trong danh sách roster (chấm đỏ), tự thêm marker lại khi reconnect qua addRepBackToTracking.
    MOCK_REPS.forEach(createRepMarker);
    // Focus theo đúng zastávka thật (bỏ qua điểm bắt đầu/kết thúc cố định — không có gì để xem ở đó)
    // Dùng route THẬT (đường đã đi qua thật ngoài đời, có thể vòng xa hơn nhiều so với bounding box thẳng của các
    // zastávka) để tính bounds — chỉ tính theo toạ độ zastávka thì route thật lượn ra ngoài sẽ bị cắt mất.
    const focusPoints = routes.flat();
    const bounds = L.latLngBounds(focusPoints);
    const baseCenter = bounds.getCenter();
    // Luôn overview toàn bộ plan trước — zoom sát + mở popup chỉ khi user bấm chọn rep, không tự động
    const baseZoom = map.getBoundsZoom(bounds, false, L.point(60, 60));
    map.flyTo(baseCenter, baseZoom, { animate: true, duration: 0.9, easeLinearity: 0.25 });

    // Chỉ 1 rep hoạt động → vẽ luôn đường đi kế hoạch của rep đó (không mở popup, không zoom sát)
    if (MOCK_REPS.length === 1 && MOCK_REPS[0].route) {
        drawRepPlan(MOCK_REPS[0]);
    }

    pollRepPositions();
    repTimer = setInterval(pollRepPositions, POSITION_POLL_MS);
}

/* ===== GEOLOCATION ===== */
let meMarker = null;
const myLocIcon = L.divIcon({ className: 'oc-my-loc', html: "<div class='oc-my-loc-dot'></div><div class='oc-my-loc-pulse'></div>", iconSize: [36, 36], iconAnchor: [18, 18] });
let locateActive = false, locateBtnEl = null, lastMyPos = null;
function setLocateActive(on) { locateActive = !!on; if (locateBtnEl) locateBtnEl.classList.toggle('on', locateActive); }

// Máy không có card WiFi → Windows định vị qua IP, accuracy thường vài km–vài chục km (thay vì vài trăm mét khi có WiFi).
// JS không thể detect trực tiếp "có WiFi card hay không" (không có API), nên dùng accuracy làm ngưỡng xác định
// định vị có đáng tin không — vượt ngưỡng thì coi như không chính xác, dùng toạ độ mặc định thay thế.
const GEO_ACCURACY_THRESHOLD_M = 5000;
const GEO_FALLBACK_LATLNG = { lat: 50.002856, lng: 14.468774 }; // [C_Latitude]/[C_Longitude]

function onLocationFound(e) {
    const acc = e.accuracy || 0;
    const unreliable = acc > GEO_ACCURACY_THRESHOLD_M;
    const ll = unreliable ? L.latLng(GEO_FALLBACK_LATLNG.lat, GEO_FALLBACK_LATLNG.lng) : e.latlng;
    if (unreliable) console.warn(`Định vị không chính xác (accuracy=${Math.round(acc)}m) — dùng toạ độ mặc định.`);
    lastMyPos = ll;
    if (!meMarker) { meMarker = L.marker(ll, { icon: myLocIcon, zIndexOffset: 2000, interactive: false }).addTo(map); }
    else { meMarker.setLatLng(ll); }
    setLocateActive(true);
    map.flyTo(ll, Math.max(map.getZoom(), 15), { animate: true, duration: 0.9, easeLinearity: 0.25 });
    try { window.__ocSearch?.__resolvePendingMyLocation?.(ll); } catch (_) { }
    try { window.__ocSearch?.__tryComputeRoute?.(); } catch (_) { }
}
function onLocationError(e) {
    console.warn('Location error:', e);
    setLocateActive(false);
    try { window.__ocSearch?.__cancelPendingMyLocation?.(); } catch (_) { }
    try {
        const m = L.control({ position: 'bottomleft' });
        m.onAdd = () => {
            const el = L.DomUtil.create('div', 'leaflet-bar');
            el.style.padding = '6px 8px'; el.style.background = '#fff'; el.style.boxShadow = '0 1px 4px rgba(0,0,0,.2)';
            el.textContent = 'Nelze zjistit polohu.';
            setTimeout(() => map.removeControl(m), 2500);
            return el;
        };
        m.addTo(map);
    } catch (_) { }
}
map.on('locationfound', onLocationFound);
map.on('locationerror', onLocationError);
function doLocate() {
    setSelected(null);
    try { const box = window.__ocSearch?.querySelector?.('#ocSearchBox'); box?.blur(); } catch (_) { }
    if (pendingSelectOnce) { map.off('moveend', pendingSelectOnce); pendingSelectOnce = null; }
    map.locate({ setView: false, enableHighAccuracy: true, timeout: 10000 });
}
map.on('moveend', () => { if (!locateActive || !lastMyPos) return; const center = map.getCenter(); const d = center.distanceTo(lastMyPos); if (d > 150) setLocateActive(false); });
map.on('dragstart', () => { if (locateActive) setLocateActive(false); });

/* ===== CONTROLS ===== */
const ZoomControl = L.Control.extend({
    options: { position: 'bottomright' },
    onAdd: function () {
        const cluster = L.DomUtil.create('div', 'leaflet-control oc-zoom-cluster');

        // TODO: gắn chức năng theo dõi vị trí Obchodní zástupce di chuyển trên đường
        const carContainer = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-locate', cluster);
        const carBtn = L.DomUtil.create('button', '', carContainer);
        carBtn.title = 'Sledovat obchodního zástupce'; carBtn.setAttribute('aria-label', 'Sledovat obchodního zástupce');
        carBtn.innerHTML = `
                                                                                                                                    <svg viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                                      <path class='oc-gps-dot' d='M19.07,4.93L17.66,6.34C19.1,7.79 20,9.79 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12C4,7.92 7.05,4.56 11,4.07V6.09C8.16,6.57 6,9.03 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12C18,10.34 17.33,8.84 16.24,7.76L14.83,9.17C15.55,9.9 16,10.9 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12C8,10.14 9.28,8.59 11,8.14V10.28C10.4,10.63 10,11.26 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12C14,11.26 13.6,10.62 13,10.28V2H12A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,9.24 20.88,6.74 19.07,4.93Z'></path>
                                                                                                                                    </svg>`;
        L.DomEvent.disableClickPropagation(carBtn);
        L.DomEvent.on(carBtn, 'click', (ev) => { L.DomEvent.stop(ev); toggleRepTracking(carBtn); });
        repTrackingBtnEl = carBtn;

        const locateContainer = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-locate', cluster);
        const locateBtn = L.DomUtil.create('button', '', locateContainer);
        locateBtn.title = 'Moje poloha'; locateBtn.setAttribute('aria-label', 'Moje poloha');
        locateBtn.innerHTML = `
                                                                                                                                    <svg viewBox='0 0 24 24' aria-hidden='true'>
                                                                                                                                      <g fill='none' stroke-width='2' class='oc-gps-stroke'>
                                                                                                                                        <circle cx='12' cy='12' r='7'></circle>
                                                                                                                                        <line x1='12' y1='3'  x2='12' y2='5'></line>
                                                                                                                                        <line x1='12' y1='19' x2='12' y2='21'></line>
                                                                                                                                        <line x1='3'  y1='12' x2='5'  y2='12'></line>
                                                                                                                                        <line x1='19' y1='12' x2='21' y2='12'></line>
                                                                                                                                      </g>
                                                                                                                                      <circle cx='12' cy='12' r='4' class='oc-gps-dot'></circle>
                                                                                                                                    </svg>`;
        L.DomEvent.disableClickPropagation(locateBtn);
        L.DomEvent.on(locateBtn, 'click', (ev) => { L.DomEvent.stop(ev); doLocate(); });
        locateBtnEl = locateBtn;

        const wrap = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-zoom', cluster);
        const mkBtn = (title, svg, onClick) => {
            const b = L.DomUtil.create('button', 'oc-zoom-btn', wrap);
            b.title = title; b.innerHTML = svg; b.setAttribute('aria-label', title);
            L.DomEvent.disableClickPropagation(b);
            b.addEventListener('click', onClick);
            return b;
        };
        const svgPlus = `
                                                                                                                                    <svg viewBox='0 0 24 24' aria-hidden='true' xmlns='http://www.w3.org/2000/svg'>
                                                                                                                                      <path class='oc-zoom-glyph' d='M20 14H14V20H10V14H4V10H10V4H14V10H20V14Z'/>
                                                                                                                                    </svg>`;
        const svgMinus = `
                                                                                                                                    <svg viewBox='0 0 24 24' aria-hidden='true' xmlns='http://www.w3.org/2000/svg'>
                                                                                                                                      <path class='oc-zoom-glyph' d='M20 14H4V10H20'/>
                                                                                                                                    </svg>`;
        zoomInBtn = mkBtn('Přiblížit', svgPlus, () => map.zoomIn());
        zoomOutBtn = mkBtn('Oddálit', svgMinus, () => map.zoomOut());
        setTimeout(updateZoomButtons, 0);
        return cluster;
    }
});
const routeFloatEl = document.createElement('div');
routeFloatEl.className = 'oc-route-float-summary';
map.getContainer().appendChild(routeFloatEl);
L.DomEvent.disableClickPropagation(routeFloatEl);
function setFloatingRouteSummary(bodyHtml, showClose) {
    if (!bodyHtml) {
        routeFloatEl.classList.remove('show'); routeFloatEl.innerHTML = '';
        countBadgeEl?.classList.remove('oc-hidden');
        return;
    }
    routeFloatEl.innerHTML = bodyHtml + (showClose ? `
                                                                                                                        <button type='button' class='oc-route-float-close' title='Zavřít trasu' aria-label='Zavřít trasu'>
                                                                                                                          <svg viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z'/></svg>
                                                                                                                        </button>` : '');
    routeFloatEl.classList.add('show');
    countBadgeEl?.classList.add('oc-hidden');
    const closeBtn = routeFloatEl.querySelector('.oc-route-float-close');
    closeBtn?.addEventListener('click', () => {
        try { window.__ocSearch?.__closeRoutePanel?.(); } catch (_) { }
    });
}

countBadgeEl = document.createElement('div');
countBadgeEl.className = 'oc-count-badge';
map.getContainer().appendChild(countBadgeEl);
L.DomEvent.disableClickPropagation(countBadgeEl);
updateCountBadge();

// Panel thời tiết — thế chỗ ô tìm kiếm (đã ẩn) trong lúc tracking, hiện thời tiết tại vị trí hiện tại của mình
const weatherPanelEl = document.createElement('div');
weatherPanelEl.className = 'oc-weather-panel';
map.getContainer().appendChild(weatherPanelEl);
L.DomEvent.disableClickPropagation(weatherPanelEl);
async function showWeatherPanel() {
    weatherPanelEl.style.display = 'flex';
    weatherPanelEl.innerHTML = `<span class='oc-weather-loading'>Načítání počasí…</span>`;
    const useLocation = async (lat, lon) => {
        try {
            const w = await fetchWeather(lat, lon);
            weatherPanelEl.innerHTML = `<span class='oc-weather-icon'>${w.icon}</span><span class='oc-weather-temp'>${w.temp}°C</span><span class='oc-weather-label'>${esc(w.label)}</span>`;
        } catch (e) {
            weatherPanelEl.innerHTML = `<span class='oc-weather-loading'>Počasí nedostupné</span>`;
        }
    };
    if (lastMyPos) {
        useLocation(lastMyPos.lat, lastMyPos.lng);
    } else if (navigator.geolocation) {
        // Lấy toạ độ âm thầm — KHÔNG dùng map.locate() vì nó sẽ kích hoạt luôn hiệu ứng "Moje poloha" (flyTo/zoom/marker)
        navigator.geolocation.getCurrentPosition(
            (pos) => useLocation(pos.coords.latitude, pos.coords.longitude),
            () => { weatherPanelEl.innerHTML = `<span class='oc-weather-loading'>Počasí nedostupné</span>`; },
            { enableHighAccuracy: true, timeout: 10000 }
        );
    } else {
        weatherPanelEl.innerHTML = `<span class='oc-weather-loading'>Počasí nedostupné</span>`;
    }
}
function hideWeatherPanel() { weatherPanelEl.style.display = 'none'; }

// Border hiển thị số PC đang xem Tracking (Presence "tracking-viewers", xem RealtimeLocationService) — đối
// xứng panel thời tiết, verify trực quan cơ chế multi-PC (IsSoleViewer) thay vì chỉ xem log Debug.
const VIEWER_ICON_SVG = `<svg viewBox="0 0 24 24" width="18" height="18">
    <path fill="currentColor" d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
</svg>`;
const viewerPanelEl = document.createElement('div');
viewerPanelEl.className = 'oc-viewer-panel';
map.getContainer().appendChild(viewerPanelEl);
L.DomEvent.disableClickPropagation(viewerPanelEl);
function renderViewerCount(count) {
    viewerPanelEl.innerHTML = `<span class='oc-viewer-icon'>${VIEWER_ICON_SVG}</span><span class='oc-viewer-count'>${count}</span>`;
}
function showViewerPanel() {
    viewerPanelEl.style.display = 'flex';
    renderViewerCount(1); // mặc định 1 (chính mình) cho tới khi Presence đồng bộ xong (xem type 'viewerCount')
}
function hideViewerPanel() { viewerPanelEl.style.display = 'none'; }

// Danh sách obchodní zástupce có plan hôm nay — giữa panel thời tiết và panel người xem, hiện kể cả khi chỉ
// có 1 rep. Giữ nguyên rep trong danh sách kể cả khi mất kết nối (chỉ đổi chấm sang đỏ), không xoá khỏi danh
// sách như removeRepFromTracking làm với marker trên map — người dùng cần thấy rep nào đang mất kết nối.
let repsRoster = [];
const repsRosterPanelEl = document.createElement('div');
repsRosterPanelEl.className = 'oc-reps-roster-panel';
map.getContainer().appendChild(repsRosterPanelEl);
L.DomEvent.disableClickPropagation(repsRosterPanelEl);
function renderRepsRoster() {
    repsRosterPanelEl.innerHTML = repsRoster.map(r => `
        <span class='oc-rep-roster-chip'>
            <span class='oc-rep-roster-dot ${r.online ? 'oc-online' : 'oc-offline'}'></span>
            <span>${esc(r.name)}</span>
        </span>`).join('');
}
function showRepsRosterPanel(reps) {
    repsRoster = reps.map(r => ({ code: r.code, name: r.name, online: r.online !== false }));
    renderRepsRoster();
    repsRosterPanelEl.style.display = repsRoster.length > 0 ? 'flex' : 'none';
}
function hideRepsRosterPanel() {
    repsRoster = [];
    repsRosterPanelEl.style.display = 'none';
}
function setRepRosterOnline(code, online) {
    const entry = repsRoster.find(r => r.code === code);
    if (!entry) return;
    entry.online = online;
    renderRepsRoster();
}

// Modal thông báo tự vẽ — thay cho alert() gốc trình duyệt (tiêu đề "appassets.local says" không tự đổi được).
const modalOverlayEl = document.createElement('div');
modalOverlayEl.className = 'oc-modal-overlay';
modalOverlayEl.innerHTML = `<div class='oc-modal-card' role='alertdialog' aria-modal='true'>
    <div class='oc-modal-header'>
        <svg viewBox='0 0 24 24' fill='currentColor'><path d='M12 2 1 21h22L12 2zm0 6 7.53 13H4.47L12 8zm-1 3v4h2v-4h-2zm0 6v2h2v-2h-2z'/></svg>
        <span>Upozornění</span>
    </div>
    <div class='oc-modal-body'></div>
    <div class='oc-modal-footer'><button class='oc-modal-btn' type='button'>OK</button></div>
</div>`;
document.body.appendChild(modalOverlayEl);
L.DomEvent.disableClickPropagation(modalOverlayEl);
const modalBodyEl = modalOverlayEl.querySelector('.oc-modal-body');
let modalResolve = null;
// Timer tự đóng — luôn huỷ trong closeModal() (dù đóng bằng cách nào: OK/Esc/bấm ra ngoài/tự động hết giờ) để
// timer cũ không bao giờ còn sống sót đóng nhầm dialog KẾ TIẾP đang hiện (đã đổi nội dung/resolve khác).
let modalAutoCloseTimer = null;
function closeModal() {
    if (modalAutoCloseTimer) { clearTimeout(modalAutoCloseTimer); modalAutoCloseTimer = null; }
    modalOverlayEl.classList.remove('oc-show');
    modalResolve?.();
    modalResolve = null;
}
modalOverlayEl.querySelector('.oc-modal-btn').addEventListener('click', closeModal);
modalOverlayEl.addEventListener('mousedown', (ev) => { if (ev.target === modalOverlayEl) closeModal(); });
document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && modalOverlayEl.classList.contains('oc-show')) closeModal(); });
// Hàng đợi — nếu 2 nơi gọi showAlert() gần như cùng lúc (vd 2 rep rớt kết nối liên tiếp), lần gọi SAU không
// được ghi đè modalResolve của lần gọi TRƯỚC (sẽ làm lần trước treo vĩnh viễn, không bao giờ resolve, khiến
// code gọi nó — vd removeRepFromTracking — không bao giờ chạy tới). Xếp hàng: lần gọi sau chỉ thực sự hiện
// modal sau khi lần trước đã đóng (bấm OK/Esc/bấm ra ngoài/tự động hết giờ).
// Tự động đóng sau MODAL_AUTO_CLOSE_MS nếu người dùng không thao tác gì — tránh dồn hàng đợi dialog chồng lên
// nhau khi rep cứ mất/có kết nối liên tục lúc không ai đứng máy bấm OK.
const MODAL_AUTO_CLOSE_MS = 10000;
let modalQueue = Promise.resolve();
function showAlert(message) {
    const shown = modalQueue.then(() => new Promise((resolve) => {
        modalBodyEl.textContent = message;
        modalOverlayEl.classList.add('oc-show');
        modalResolve = resolve;
        modalAutoCloseTimer = setTimeout(closeModal, MODAL_AUTO_CLOSE_MS);
    }));
    modalQueue = shown;
    return shown;
}

function lon2tileX(lon, z) { return Math.floor((lon + 180) / 360 * Math.pow(2, z)); }
function lat2tileY(lat, z) {
    const r = lat * Math.PI / 180;
    return Math.floor((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2 * Math.pow(2, z));
}
function updateSatThumb() {
    if (!satBtnEl) return;
    const thumb = satBtnEl.querySelector('.oc-sat-thumb');
    if (!thumb) return;
    const c = map.getCenter();
    const z = 11;
    const x = lon2tileX(c.lng, z), y = lat2tileY(c.lat, z);
    // Nút luôn hiện thumbnail của chế độ SẼ chuyển sang (giống Google Maps)
    const url = isSatMode
        ? `https://api.tomtom.com/map/1/tile/basic/main/${z}/${x}/${y}.png?key=${TOMTOM_KEY}&tileSize=256&language=cs-CZ`
        : `https://api.tomtom.com/map/1/tile/sat/main/${z}/${x}/${y}.jpg?key=${TOMTOM_KEY}&tileSize=256`;
    thumb.style.backgroundImage = `url("${url}")`;
    satBtnEl.querySelector('.oc-sat-label').textContent = isSatMode ? 'Mapa' : 'Satelit';
}

const SatToggleControl = L.Control.extend({
    options: { position: 'bottomright' },
    onAdd: function () {
        const wrap = L.DomUtil.create('div', 'leaflet-control leaflet-control-oc-sat');
        const btn = L.DomUtil.create('button', 'oc-sat-btn', wrap);
        btn.type = 'button';
        btn.title = 'Přepnout mapa/satelit';
        btn.setAttribute('aria-label', 'Přepnout mapa/satelit');
        btn.innerHTML = `<div class='oc-sat-thumb'></div><span class='oc-sat-label'>Satelit</span>`;
        btn.addEventListener('click', () => { toggleSatMode(); updateSatThumb(); });
        satBtnEl = btn;
        L.DomEvent.disableClickPropagation(wrap);
        setTimeout(updateSatThumb, 0);
        map.on('moveend zoomend', debounce(updateSatThumb, 300));
        return wrap;
    }
});

map.addControl(new ZoomControl());
map.addControl(new SatToggleControl());
L.control.scale({ position: 'bottomleft', imperial: false, metric: true, maxWidth: 120 }).addTo(map);
map.on('zoomend', updateZoomButtons);
map.on('zoomstart', () => { _lastZoom = map.getZoom(); });
map.on('zoomend', () => { if (map.getZoom() > _lastZoom) scheduleEnsureSelectedPopup(80); });
clusters.on('animationend', () => scheduleEnsureSelectedPopup(40));

const T = { placeholder: 'Vyhledat ičo nebo název firmy', search: 'Hledat', directions: 'Trasa', clear: 'Vymazat', noResults: 'Žádné výsledky…', myLocation: 'Moje poloha' };

function getBaseList() {
    const base = baseListForFilters();
    if (!ACTIVE_FILTER_KEY) return base;
    if (ACTIVE_FILTER_KEY === 'vip') return base.filter(m => m.__isVIP);
    return base.filter(m => m.__segKey === ACTIVE_FILTER_KEY);
}

function setChipMode(on) {
    const wrap = window.__ocSearch; if (!wrap) return;
    const wrapBox = wrap.querySelector('#ocSearchWrap') || wrap;
    wrapBox.classList.toggle('chip-mode', !!on);
}

function openChipSuggestions() {
    try {
        const now = performance.now();
        if (now < __suppressSuggestUntil) return;
        const wrap = window.__ocSearch; if (!wrap) return;

        // Dùng đúng logic mở/đo kích thước bên trong onAdd (đồng bộ với lúc bấm chip lần đầu)
        if (typeof wrap.__openChipSuggestions === 'function') {
            wrap.__openChipSuggestions();
            return;
        }

        const listEl = wrap.querySelector('#ocSearchList');
        const emptyEl = wrap.querySelector('#ocSearchEmpty');
        const wrapBox = wrap.querySelector('#ocSearchWrap');

        matches = getBaseList();
        activeIdx = -1;

        if (emptyEl) emptyEl.style.display = 'none';
        if (typeof showClear === 'function') showClear(true);

        // 🔽 đánh dấu chip-mode
        setChipMode(true);

        listEl.style.display = 'block';
        wrapBox.classList.add('open');
        renderList([], 9999);
        listEl.scrollTop = 0;
    } catch (_) { }
}

