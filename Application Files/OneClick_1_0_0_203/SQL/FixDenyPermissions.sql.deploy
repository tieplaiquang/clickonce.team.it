-- =============================================
-- FixDenyPermissions.sql
-- Tạo tables và SPs để deny module/notification cho user cụ thể trong dept.
-- Chạy script này trong SQL Server Management Studio.
-- =============================================

-- ─── 1. Table UserModuleDenies ────────────────────────────────────────────
IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'UserModuleDenies')
BEGIN
	CREATE TABLE dbo.UserModuleDenies (
		DenyId    UNIQUEIDENTIFIER NOT NULL DEFAULT NEWID() PRIMARY KEY,
		UserId    UNIQUEIDENTIFIER NOT NULL,
		ModuleId  UNIQUEIDENTIFIER NOT NULL,
		CreatedAt DATETIME         NOT NULL DEFAULT GETDATE(),
		CONSTRAINT FK_UMD_User   FOREIGN KEY (UserId)   REFERENCES dbo.Users(UserId)     ON DELETE CASCADE,
		CONSTRAINT FK_UMD_Module FOREIGN KEY (ModuleId) REFERENCES dbo.Modules(ModuleId) ON DELETE CASCADE,
		CONSTRAINT UQ_UMD        UNIQUE (UserId, ModuleId)
	);
	PRINT 'Table UserModuleDenies: created.';
END
ELSE
	PRINT 'Table UserModuleDenies: already exists.';
GO

-- ─── 2. Table UserNotificationDenies ─────────────────────────────────────
IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'UserNotificationDenies')
BEGIN
	CREATE TABLE dbo.UserNotificationDenies (
		DenyId             UNIQUEIDENTIFIER NOT NULL DEFAULT NEWID() PRIMARY KEY,
		UserId             UNIQUEIDENTIFIER NOT NULL,
		NotificationTypeId UNIQUEIDENTIFIER NOT NULL,
		CreatedAt          DATETIME         NOT NULL DEFAULT GETDATE(),
		CONSTRAINT FK_UND_User   FOREIGN KEY (UserId)             REFERENCES dbo.Users(UserId)                         ON DELETE CASCADE,
		CONSTRAINT FK_UND_Notif  FOREIGN KEY (NotificationTypeId) REFERENCES dbo.NotificationTypes(NotificationTypeId) ON DELETE CASCADE,
		CONSTRAINT UQ_UND        UNIQUE (UserId, NotificationTypeId)
	);
	PRINT 'Table UserNotificationDenies: created.';
END
ELSE
	PRINT 'Table UserNotificationDenies: already exists.';
GO

-- ─── 3. usp_DenyModuleForUser ─────────────────────────────────────────────
IF OBJECT_ID('dbo.usp_DenyModuleForUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_DenyModuleForUser;
GO
CREATE PROCEDURE dbo.usp_DenyModuleForUser
	@UserId   UNIQUEIDENTIFIER,
	@ModuleId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	IF NOT EXISTS (SELECT 1 FROM dbo.UserModuleDenies WHERE UserId = @UserId AND ModuleId = @ModuleId)
		INSERT INTO dbo.UserModuleDenies (UserId, ModuleId) VALUES (@UserId, @ModuleId);
END
GO

-- ─── 4. usp_UndenyModuleForUser ───────────────────────────────────────────
IF OBJECT_ID('dbo.usp_UndenyModuleForUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_UndenyModuleForUser;
GO
CREATE PROCEDURE dbo.usp_UndenyModuleForUser
	@UserId   UNIQUEIDENTIFIER,
	@ModuleId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	DELETE FROM dbo.UserModuleDenies WHERE UserId = @UserId AND ModuleId = @ModuleId;
END
GO

-- ─── 5. usp_GetUserModuleDenies ───────────────────────────────────────────
IF OBJECT_ID('dbo.usp_GetUserModuleDenies', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_GetUserModuleDenies;
GO
CREATE PROCEDURE dbo.usp_GetUserModuleDenies
	@UserId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	SELECT ModuleId FROM dbo.UserModuleDenies WHERE UserId = @UserId;
END
GO

-- ─── 6. usp_DenyNotificationForUser ──────────────────────────────────────
IF OBJECT_ID('dbo.usp_DenyNotificationForUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_DenyNotificationForUser;
GO
CREATE PROCEDURE dbo.usp_DenyNotificationForUser
	@UserId             UNIQUEIDENTIFIER,
	@NotificationTypeId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	IF NOT EXISTS (SELECT 1 FROM dbo.UserNotificationDenies WHERE UserId = @UserId AND NotificationTypeId = @NotificationTypeId)
		INSERT INTO dbo.UserNotificationDenies (UserId, NotificationTypeId) VALUES (@UserId, @NotificationTypeId);
END
GO

-- ─── 7. usp_UndenyNotificationForUser ────────────────────────────────────
IF OBJECT_ID('dbo.usp_UndenyNotificationForUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_UndenyNotificationForUser;
GO
CREATE PROCEDURE dbo.usp_UndenyNotificationForUser
	@UserId             UNIQUEIDENTIFIER,
	@NotificationTypeId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	DELETE FROM dbo.UserNotificationDenies WHERE UserId = @UserId AND NotificationTypeId = @NotificationTypeId;
END
GO

-- ─── 8. usp_GetUserNotificationDenies ────────────────────────────────────
IF OBJECT_ID('dbo.usp_GetUserNotificationDenies', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_GetUserNotificationDenies;
GO
CREATE PROCEDURE dbo.usp_GetUserNotificationDenies
	@UserId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	SELECT NotificationTypeId FROM dbo.UserNotificationDenies WHERE UserId = @UserId;
END
GO

-- ─── 9. Cập nhật usp_GetUserModules: via Department + Direct, trừ deny ───
IF OBJECT_ID('dbo.usp_GetUserModules', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_GetUserModules;
GO
CREATE PROCEDURE dbo.usp_GetUserModules
	@UserId UNIQUEIDENTIFIER
AS
BEGIN
	SET NOCOUNT ON;
	SELECT DISTINCT m.ModuleId, m.ModuleKey, m.ModuleName
	FROM dbo.Modules m
	WHERE m.IsActive = 1
	  AND (
		  -- via Department
		  EXISTS (
			  SELECT 1 FROM dbo.DepartmentModules dm
			  INNER JOIN dbo.UserDepartments ud ON ud.DepartmentId = dm.DepartmentId
			  WHERE ud.UserId = @UserId AND dm.ModuleId = m.ModuleId
		  )
		  OR
		  -- direct (cấp thẳng cho user: Super admin, Admin)
		  EXISTS (
			  SELECT 1 FROM dbo.UserModules um
			  WHERE um.UserId = @UserId AND um.ModuleId = m.ModuleId
		  )
	  )
	  -- loại trừ những module bị deny cho user này
	  AND NOT EXISTS (
		  SELECT 1 FROM dbo.UserModuleDenies umd
		  WHERE umd.UserId = @UserId AND umd.ModuleId = m.ModuleId
	  );
END
GO

PRINT 'FixDenyPermissions.sql completed successfully.';
PRINT 'Tables: UserModuleDenies, UserNotificationDenies';
PRINT 'SPs: usp_DenyModuleForUser, usp_UndenyModuleForUser, usp_GetUserModuleDenies';
PRINT 'SPs: usp_DenyNotificationForUser, usp_UndenyNotificationForUser, usp_GetUserNotificationDenies';
PRINT 'SP updated: usp_GetUserModules (now excludes denied modules)';
