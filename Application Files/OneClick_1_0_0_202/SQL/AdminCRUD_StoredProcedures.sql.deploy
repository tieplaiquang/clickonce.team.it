USE [OCS]
GO

-- ============================================================
-- usp_UpdateUser
-- ============================================================
IF OBJECT_ID('dbo.usp_UpdateUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateUser;
GO
CREATE PROCEDURE dbo.usp_UpdateUser
    @UserId UNIQUEIDENTIFIER,
    @FullName NVARCHAR(200),
    @Email NVARCHAR(200)
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.Users SET FullName = @FullName, Email = @Email, UpdatedAt = SYSUTCDATETIME()
    WHERE UserId = @UserId;
END
GO

-- ============================================================
-- usp_DeleteUser
-- ============================================================
IF OBJECT_ID('dbo.usp_DeleteUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteUser;
GO
CREATE PROCEDURE dbo.usp_DeleteUser
    @UserId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.UserRoles    WHERE UserId = @UserId;
    DELETE FROM dbo.UserNotificationPermissions WHERE UserId = @UserId;
    DELETE FROM dbo.Users WHERE UserId = @UserId;
END
GO

-- ============================================================
-- usp_CreateRole
-- ============================================================
IF OBJECT_ID('dbo.usp_CreateRole', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_CreateRole;
GO
CREATE PROCEDURE dbo.usp_CreateRole
    @RoleName NVARCHAR(100),
    @Description NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;
    INSERT INTO dbo.Roles (RoleId, RoleName, Description, IsActive, CreatedAt)
    VALUES (NEWID(), @RoleName, @Description, 1, SYSUTCDATETIME());
END
GO

-- ============================================================
-- usp_UpdateRole
-- ============================================================
IF OBJECT_ID('dbo.usp_UpdateRole', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateRole;
GO
CREATE PROCEDURE dbo.usp_UpdateRole
    @RoleId UNIQUEIDENTIFIER,
    @RoleName NVARCHAR(100),
    @Description NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.Roles SET RoleName = @RoleName, Description = @Description WHERE RoleId = @RoleId;
END
GO

-- ============================================================
-- usp_DeleteRole
-- ============================================================
IF OBJECT_ID('dbo.usp_DeleteRole', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteRole;
GO
CREATE PROCEDURE dbo.usp_DeleteRole
    @RoleId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.RoleModules WHERE RoleId = @RoleId;
    DELETE FROM dbo.UserRoles   WHERE RoleId = @RoleId;
    UPDATE dbo.Roles SET IsActive = 0 WHERE RoleId = @RoleId;
END
GO

-- ============================================================
-- usp_CreateModule
-- ============================================================
