GO

-- ============================================================
-- usp_UpdateModule
-- ============================================================
IF OBJECT_ID('dbo.usp_UpdateModule', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateModule;
GO
CREATE PROCEDURE dbo.usp_UpdateModule
    @ModuleId UNIQUEIDENTIFIER,
    @ModuleKey NVARCHAR(100),
    @ModuleName NVARCHAR(200)
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.Modules SET ModuleKey = @ModuleKey, ModuleName = @ModuleName WHERE ModuleId = @ModuleId;
END
GO

-- ============================================================
-- usp_DeleteModule
-- ============================================================
IF OBJECT_ID('dbo.usp_DeleteModule', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteModule;
GO
CREATE PROCEDURE dbo.usp_DeleteModule
    @ModuleId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.RoleModules WHERE ModuleId = @ModuleId;
    UPDATE dbo.Modules SET IsActive = 0 WHERE ModuleId = @ModuleId;
END
GO

-- ============================================================
-- usp_GetUserDirectModules  (module cấp trực tiếp cho user)
-- ============================================================
IF OBJECT_ID('dbo.usp_GetUserDirectModules', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_GetUserDirectModules;
GO
CREATE PROCEDURE dbo.usp_GetUserDirectModules
    @UserId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    -- Nếu có bảng UserModules thì dùng bảng đó
    -- Nếu chưa có, trả về rỗng (module permission quản lý qua Role)
    IF OBJECT_ID('dbo.UserModules', 'U') IS NOT NULL
    BEGIN
        SELECT m.ModuleId, m.ModuleKey, m.ModuleName
        FROM dbo.Modules m
        INNER JOIN dbo.UserModules um ON m.ModuleId = um.ModuleId
        WHERE um.UserId = @UserId AND m.IsActive = 1;
    END
    ELSE
    BEGIN
        SELECT m.ModuleId, m.ModuleKey, m.ModuleName
        FROM dbo.Modules m
        WHERE 1 = 0; -- trả về rỗng
    END
END
GO

-- ============================================================
-- usp_AssignModuleToUser
-- ============================================================
IF OBJECT_ID('dbo.usp_AssignModuleToUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_AssignModuleToUser;
GO
CREATE PROCEDURE dbo.usp_AssignModuleToUser
    @UserId UNIQUEIDENTIFIER,
    @ModuleId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    IF OBJECT_ID('dbo.UserModules', 'U') IS NULL
    BEGIN
        CREATE TABLE dbo.UserModules (
            UserId UNIQUEIDENTIFIER NOT NULL,
            ModuleId UNIQUEIDENTIFIER NOT NULL,
            AssignedAt DATETIME2 DEFAULT SYSUTCDATETIME(),
            PRIMARY KEY (UserId, ModuleId)
        );
    END
    IF NOT EXISTS (SELECT 1 FROM dbo.UserModules WHERE UserId = @UserId AND ModuleId = @ModuleId)
        INSERT INTO dbo.UserModules (UserId, ModuleId) VALUES (@UserId, @ModuleId);
END
GO

-- ============================================================
-- usp_RemoveModuleFromUser
-- ============================================================
IF OBJECT_ID('dbo.usp_RemoveModuleFromUser', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_RemoveModuleFromUser;
GO
CREATE PROCEDURE dbo.usp_RemoveModuleFromUser
    @UserId UNIQUEIDENTIFIER,
    @ModuleId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    IF OBJECT_ID('dbo.UserModules', 'U') IS NOT NULL
        DELETE FROM dbo.UserModules WHERE UserId = @UserId AND ModuleId = @ModuleId;
END
GO

-- ============================================================
-- usp_CreateNotificationType
-- ============================================================
IF OBJECT_ID('dbo.usp_CreateNotificationType', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_CreateNotificationType;
GO
CREATE PROCEDURE dbo.usp_CreateNotificationType
    @NotificationKey NVARCHAR(100),
    @Name NVARCHAR(200),
    @Description NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;
    INSERT INTO dbo.NotificationTypes (NotificationTypeId, NotificationKey, Name, Description, IsActive, CreatedAt)
    VALUES (NEWID(), @NotificationKey, @Name, @Description, 1, SYSUTCDATETIME());
END
GO

-- ============================================================
-- usp_UpdateNotificationType
-- ============================================================
IF OBJECT_ID('dbo.usp_UpdateNotificationType', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_UpdateNotificationType;
GO
CREATE PROCEDURE dbo.usp_UpdateNotificationType
    @NotificationTypeId UNIQUEIDENTIFIER,
    @NotificationKey NVARCHAR(100),
    @Name NVARCHAR(200),
    @Description NVARCHAR(500)
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE dbo.NotificationTypes
    SET NotificationKey = @NotificationKey, Name = @Name, Description = @Description
    WHERE NotificationTypeId = @NotificationTypeId;
END
GO

-- ============================================================
-- usp_DeleteNotificationType
-- ============================================================
IF OBJECT_ID('dbo.usp_DeleteNotificationType', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_DeleteNotificationType;
GO
CREATE PROCEDURE dbo.usp_DeleteNotificationType
    @NotificationTypeId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    DELETE FROM dbo.UserNotificationPermissions WHERE NotificationTypeId = @NotificationTypeId;
    UPDATE dbo.NotificationTypes SET IsActive = 0 WHERE NotificationTypeId = @NotificationTypeId;
END
GO

-- ============================================================
-- usp_GetRoleNotificationPermissions
-- ============================================================
IF OBJECT_ID('dbo.usp_GetRoleNotificationPermissions', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_GetRoleNotificationPermissions;
GO
CREATE PROCEDURE dbo.usp_GetRoleNotificationPermissions
    @RoleId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    IF OBJECT_ID('dbo.RoleNotificationPermissions', 'U') IS NOT NULL
    BEGIN
        SELECT nt.NotificationTypeId, nt.NotificationKey, nt.Name, nt.Description
        FROM dbo.NotificationTypes nt
        INNER JOIN dbo.RoleNotificationPermissions rnp ON nt.NotificationTypeId = rnp.NotificationTypeId
        WHERE rnp.RoleId = @RoleId AND nt.IsActive = 1;
    END
    ELSE
    BEGIN
        SELECT NotificationTypeId, NotificationKey, Name, Description
        FROM dbo.NotificationTypes WHERE 1 = 0;
    END
END
GO

-- ============================================================
-- usp_AssignNotificationToRole
-- ============================================================
IF OBJECT_ID('dbo.usp_AssignNotificationToRole', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_AssignNotificationToRole;
GO
CREATE PROCEDURE dbo.usp_AssignNotificationToRole
    @RoleId UNIQUEIDENTIFIER,
    @NotificationTypeId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    IF OBJECT_ID('dbo.RoleNotificationPermissions', 'U') IS NULL
    BEGIN
        CREATE TABLE dbo.RoleNotificationPermissions (
            RoleId UNIQUEIDENTIFIER NOT NULL,
            NotificationTypeId UNIQUEIDENTIFIER NOT NULL,
            AssignedAt DATETIME2 DEFAULT SYSUTCDATETIME(),
            PRIMARY KEY (RoleId, NotificationTypeId)
        );
    END
    IF NOT EXISTS (SELECT 1 FROM dbo.RoleNotificationPermissions WHERE RoleId = @RoleId AND NotificationTypeId = @NotificationTypeId)
        INSERT INTO dbo.RoleNotificationPermissions (RoleId, NotificationTypeId) VALUES (@RoleId, @NotificationTypeId);
END
GO

-- ============================================================
-- usp_RemoveNotificationFromRole
-- ============================================================
IF OBJECT_ID('dbo.usp_RemoveNotificationFromRole', 'P') IS NOT NULL DROP PROCEDURE dbo.usp_RemoveNotificationFromRole;
GO
CREATE PROCEDURE dbo.usp_RemoveNotificationFromRole
