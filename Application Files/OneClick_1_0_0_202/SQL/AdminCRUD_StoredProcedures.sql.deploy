    @NotificationTypeId UNIQUEIDENTIFIER
AS
BEGIN
    SET NOCOUNT ON;
    IF OBJECT_ID('dbo.RoleNotificationPermissions', 'U') IS NOT NULL
        DELETE FROM dbo.RoleNotificationPermissions WHERE RoleId = @RoleId AND NotificationTypeId = @NotificationTypeId;
END
GO
